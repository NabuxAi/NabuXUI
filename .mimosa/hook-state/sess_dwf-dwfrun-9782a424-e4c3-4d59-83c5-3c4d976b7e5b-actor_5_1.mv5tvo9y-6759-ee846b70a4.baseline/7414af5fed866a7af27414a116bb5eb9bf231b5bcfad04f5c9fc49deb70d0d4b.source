<style>
    .enss-wrap {
        --enss-fg: #1c1917; --enss-muted: #78716c; --enss-border: #e7e5e4;
        --enss-bg: #fffdf9; --enss-card: #ffffff; --enss-accent: #b45309;
        --enss-bar: #1c1917; --enss-chip: #f5f0eb; --enss-noise: #d6d3d1;
        display: grid; gap: 1rem;
        font-family: 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
        color: var(--enss-fg);
    }
    html[data-theme="dark"] .enss-wrap {
        --enss-fg: #fafaf9; --enss-muted: #a8a29e; --enss-border: #292524;
        --enss-bg: #171412; --enss-card: #1c1917; --enss-accent: #f59e0b;
        --enss-bar: #0c0a09; --enss-chip: #231e1a; --enss-noise: #44403c;
    }
    @media (prefers-color-scheme: dark) {
        html:not([data-theme="light"]) .enss-wrap {
            --enss-fg: #fafaf9; --enss-muted: #a8a29e; --enss-border: #292524;
            --enss-bg: #171412; --enss-card: #1c1917; --enss-accent: #f59e0b;
            --enss-bar: #0c0a09; --enss-chip: #231e1a; --enss-noise: #44403c;
        }
    }
    .enss-stage {
        position: relative; border-radius: 1.25rem; border: 1px solid var(--enss-border);
        background: var(--enss-bg); padding: clamp(1.1rem, 4%, 2.2rem);
        display: grid; gap: clamp(1rem, 4%, 1.8rem);
    }
    /* Letterbox bars — the screen this picture plays on. */
    .enss-stage::before, .enss-stage::after {
        content: ''; position: absolute; inset-inline: 0; block-size: .55rem;
        background: var(--enss-bar); z-index: 1; pointer-events: none;
    }
    .enss-stage::before { inset-block-start: 0; border-start-start-radius: 1.1rem; border-start-end-radius: 1.1rem; }
    .enss-stage::after { inset-block-end: 0; border-end-start-radius: 1.1rem; border-end-end-radius: 1.1rem; }

    .enss-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1rem; }
    .enss-slate { font-size: .72rem; font-weight: 800; letter-spacing: .22em;
                  text-transform: uppercase; color: var(--enss-accent); }
    .enss-roll { font-size: .74rem; color: var(--enss-muted); font-variant-numeric: tabular-nums; }

    .enss-acts { display: grid; gap: clamp(.9rem, 3.5%, 1.4rem); }
    .enss-act {
        display: grid; gap: .5rem; padding: clamp(.9rem, 3.5%, 1.25rem);
        border: 1px solid var(--enss-border); border-radius: 1rem;
        background: var(--enss-card);
        opacity: 0; scale: .92; filter: blur(9px);
        transition: opacity .9s var(--nx-spring-soft), scale .9s var(--nx-spring-soft),
                    filter .9s var(--nx-spring-soft);
        transition-delay: calc(var(--j, 0) * 120ms);
    }
    .enss-act[data-in="true"] { opacity: 1; scale: 1; filter: blur(0); }
    .enss-act:not([data-in="true"]) { transition: none; }
    .enss-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .8rem; }
    .enss-no { font-family: Georgia, 'Times New Roman', serif; font-style: italic;
               font-size: 1.05rem; font-weight: 700; color: var(--enss-accent); }
    .enss-act:lang(fa) .enss-no { font-style: normal; font-family: inherit; }
    .enss-act-label { font-size: .68rem; font-weight: 800; letter-spacing: .18em;
                      color: var(--enss-muted); }
    .enss-place { font-size: .68rem; font-weight: 700; letter-spacing: .08em;
                  color: var(--enss-muted); margin-inline-start: auto; font-variant-numeric: tabular-nums; }
    @media (max-width: 560px) { .enss-place { margin-inline-start: 0; } }
    .enss-title { margin: 0; font-size: clamp(1.15rem, 3.4vw, 1.5rem); font-weight: 800;
                  line-height: 1.3; letter-spacing: -.01em; }
    .enss-body { margin: 0; font-size: .85rem; line-height: 1.85; color: var(--enss-muted);
                 max-inline-size: 64ch; }
    .enss-chips { display: flex; flex-wrap: wrap; gap: .45rem; margin-block-start: .2rem; }
    .enss-chip { padding: .28rem .7rem; border-radius: 999px; background: var(--enss-chip);
                 border: 1px solid var(--enss-border); font-size: .72rem; font-weight: 700; }

    .enss-ctl { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.4rem; }
    .enss-again { display: inline-flex; align-items: center; gap: .45rem; padding: .55rem 1.1rem;
        border-radius: 999px; border: 1px solid var(--enss-border); background: var(--enss-bg);
        color: inherit; font: 700 .8rem/1 inherit; cursor: pointer;
        transition: border-color .15s ease, color .15s ease; }
    .enss-again:hover { border-color: var(--enss-accent); color: var(--enss-accent); }
    .enss-again:focus-visible { outline: 2px solid var(--enss-accent); outline-offset: 2px; }
    .enss-again svg { inline-size: .9rem; block-size: .9rem; stroke: currentColor; stroke-width: 2;
                      fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .enss-hint { margin: 0; font-size: .74rem; color: var(--enss-muted); }
    @media (prefers-reduced-motion: reduce) {
        .enss-act { opacity: 1; scale: 1; filter: none; transition: none; }
        .enss-again { transition: none; }
    }
</style>

<section class="pg-box" style="gap: 1.25rem"
    x-data="{
        shown: [false, false, false], io: null,
        init() {
            this.io = new IntersectionObserver((entries) => {
                entries.forEach((e) => {
                    if (!e.isIntersecting) return;
                    this.shown[Number(e.target.dataset.act)] = true;
                });
            }, { threshold: 0.35 });
            this.$refs.acts.querySelectorAll('[data-act]').forEach((el) => this.io.observe(el));
        },
        destroy() { if (this.io) this.io.disconnect(); },
        replay() {
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
                this.shown = [true, true, true];
                return;
            }
            this.shown = [false, false, false];
            requestAnimationFrame(() => requestAnimationFrame(() => {
                this.$refs.acts.querySelectorAll('[data-act]').forEach((el) => {
                    const r = el.getBoundingClientRect();
                    const onScreen = r.top < innerHeight * 0.7 && r.bottom > innerHeight * 0.3;
                    if (onScreen) this.shown[Number(el.dataset.act)] = true;
                });
            }));
        },
    }">
    <div>
        <h3 class="pg-title" style="font-size: var(--nx-text-xl)"><?php echo e($say('A story that pulls into focus', 'روایتی که فوکوس می‌شود')); ?></h3>
        <p style="margin: .25rem 0 0; color: var(--nx-text-muted)">
            <?php echo e($say('Atlas Rail 1.0 told in three acts on a letterboxed stage: each act enters like a shot pulled from a distance — scale 0.92 to 1, an opacity fade and a blur burning off on the repo’s soft spring, the moment it scrolls 35% into view. Replay runs the picture again, staggering the acts on screen; off-screen acts still wait for their scroll cue.', 'اتلس ریل ۱٫۰ در سه پرده روی یک استیج لترباکس: هر پرده مثل شاتی از دور وارد فوکوس می‌شود — مقیاس ۰٫۹۲ به ۱، محوشدنِ شفافیت و بلوری که می‌سوزد، روی فنر soft ریپو، درست وقتی ۳۵٪ اش وارد دید می‌شود. ری‌پلی کل فیلم را دوباره اجرا می‌کند و پرده‌های روی صفحه را پله‌ای می‌آورد؛ پرده‌های بیرونِ دید همچنان منتظر نوبت اسکرول می‌مانند.')); ?>

        </p>
    </div>

    <div class="enss-wrap">
        <div class="enss-stage">
            <div class="enss-head">
                <span class="enss-slate"><?php echo e($say('Atlas Rail — the pitch reel', 'اتلس ریل — ریل ارائه')); ?></span>
                <span class="enss-roll"><?php echo e($say('reel 1 of 1 · 3 acts · soft spring', 'ریل ۱ از ۱ · ۳ پرده · فنر soft')); ?></span>
            </div>
            <div class="enss-acts" x-ref="acts">
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php $__currentLoopData = $acts; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $j => $a): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
                    <article class="enss-act" data-act="<?php echo e($j); ?>" x-bind:data-in="shown[<?php echo e($j); ?>] ? 'true' : 'false'"
                        style="--j: <?php echo e($j); ?>">
                        <div class="enss-meta">
                            <span class="enss-no"><?php echo e($j === 0 ? 'I' : ($j === 1 ? 'II' : 'III')); ?></span>
                            <span class="enss-act-label"><?php echo e($say($a['act'][0], $a['act'][1])); ?></span>
                            <span class="enss-place"><?php echo e($say($a['place'][0], $a['place'][1])); ?></span>
                        </div>
                        <h4 class="enss-title"><?php echo e($say($a['title'][0], $a['title'][1])); ?></h4>
                        <p class="enss-body"><?php echo e($say($a['body'][0], $a['body'][1])); ?></p>
                        <div class="enss-chips">
                            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php $__currentLoopData = $a['chips'][0]; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $chip): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
                                <span class="enss-chip"><?php echo e($say($chip[0], $chip[1])); ?></span>
                            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::endLoop(); ?><?php endif; ?><?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::closeLoop(); ?><?php endif; ?>
                        </div>
                    </article>
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::endLoop(); ?><?php endif; ?><?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::closeLoop(); ?><?php endif; ?>
            </div>
        </div>

        <div class="enss-ctl">
            <button type="button" class="enss-again" x-on:click="replay()">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                <?php echo e($say('Run the reel again', 'ریل را دوباره اجرا کن')); ?>

            </button>
            <p class="enss-hint"><?php echo e($say('each act: scale .92 → 1 · blur 9px → 0 · --nx-spring-soft · IO 0.35 per act', 'هر پرده: scale ۰٫۹۲ → ۱ · بلور ۹px → ۰ · --nx-spring-soft · آستانهٔ IO ۰٫۳۵ برای هر پرده')); ?></p>
        </div>
    </div>
</section>
