import '@nabuxai/ui-react/css';
import { glassPane, liquidLens } from '@nabuxai/ui-core';

const lab = document.getElementById('lab')!;
lab.innerHTML = `
<style>
  body { margin: 0; font: 16px system-ui; background: #fff; }
  .bg { position: relative; padding: 20px; background: repeating-linear-gradient(90deg, #000 0 2px, transparent 2px 14px), repeating-linear-gradient(0deg, #e33 0 2px, #fff 2px 14px); }
  .words { font: 800 44px/1 system-ui; color: #111; margin: 0; }
  .pane { position: absolute; left: 40px; top: 30px; width: 220px; height: 110px; }
  .host { position: relative; margin-top: 20px; background: #fff; }
  .host-content { padding: 16px; font: 700 28px/1.3 system-ui; background: #fff; }
  .lens-el { position: absolute; left: 60px; top: 10px; width: 160px; height: 70px; border-radius: 35px; }
</style>
<div class="bg">
  <p class="words">Liquid 液体 سائل Flüssig líquido</p>
  <p class="words">Refraction at the rim</p>
  <div class="nx-glass pane" data-preset="clear" id="pane"></div>
</div>
<div class="host" id="host">
  <div class="host-content" id="content">The quick brown fox jumps over the lazy dog · 敏捷的棕色狐狸 · روباه قهوه‌ای</div>
  <span class="nx-lens lens-el" id="lens"></span>
</div>`;

const params = new URLSearchParams(location.search);
const num = (k: string, d: number) => (params.has(k) ? Number(params.get(k)) : d);
glassPane(document.getElementById('pane')!, { bezel: num('bezel', 20), refraction: num('refr', -14), curvature: num('curv', 0.7), zoom: num('zoom', 1) });
liquidLens(document.getElementById('content')!, { lens: document.getElementById('lens')!, bezel: num('lbezel', 12), refraction: num('lrefr', 8), zoom: num('lzoom', 1.2), curvature: num('lcurv', 0.7), chroma: num('chroma', 0) });
