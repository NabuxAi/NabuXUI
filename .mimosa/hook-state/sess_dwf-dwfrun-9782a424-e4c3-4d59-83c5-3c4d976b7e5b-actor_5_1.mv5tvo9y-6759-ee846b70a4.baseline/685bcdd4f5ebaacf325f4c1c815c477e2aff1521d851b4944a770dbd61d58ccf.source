
<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames(([
    'label' => null,
    'action' => null,
    'tone' => 'accent',
    'trigger' => 72,
    'segments' => 12,
    'height' => null,
    'icon' => 'zap',
]));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter(([
    'label' => null,
    'action' => null,
    'tone' => 'accent',
    'trigger' => 72,
    'segments' => 12,
    'height' => null,
    'icon' => 'zap',
]), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>
<?php
    $vars = collect([
        'block-size' => $height,
    ])->filter(fn ($v) => $v !== null && $v !== '')->map(fn ($v, $k) => "{$k}: {$v}")->implode('; ');
?>
<div <?php echo e($attributes->class('nx-pull-cord')->merge([
    'data-tone' => $tone !== 'accent' ? $tone : null,
    'style' => $vars ?: null,
])); ?> x-data="nxPullCord(<?php echo \Illuminate\Support\Js::from(['trigger' => (int) $trigger, 'segments' => (int) $segments, 'action' => $action])->toHtml() ?>)" wire:ignore.self>
    <svg class="nx-pull-cord-rope" aria-hidden="true" fill="none"><path /></svg>
    <button type="button" class="nx-pull-cord-knob"
        aria-label="<?php echo e($label ?? __('nabuxui::ui.pullCord')); ?>">
        <?php echo e(\NabuXUI\NabuXUI::icon($icon)); ?>

    </button>
</div>
