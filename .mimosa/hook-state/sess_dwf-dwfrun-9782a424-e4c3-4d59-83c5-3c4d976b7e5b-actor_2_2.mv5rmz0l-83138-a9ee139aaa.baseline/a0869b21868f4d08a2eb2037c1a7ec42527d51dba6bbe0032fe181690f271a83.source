interface BuildResult {
  summary: string;
  files: string[];
  notes: string;
}

interface ReviewFinding {
  /** مسیر فایل و در صورت لزوم شماره خط. */
  file: string;
  /** یک جمله: مشکل چیست. */
  problem: string;
  /** فقط برای چیزهایی که می‌شکنند یا نتیجهٔ غلط می‌دهند «high». */
  severity: "low" | "medium" | "high";
}

interface ReviewResult {
  findings: ReviewFinding[];
  overall: string;
}

interface WorkflowReport {
  conclusion: string;
  findings: Array<{ where: string; what: string; evidence: string; status: "verified" | "unconfirmed"; severity: "low" | "medium" | "high" }>;
  verified: string[];
  notCovered: string[];
}

const CONTEXT = `مخزن: NabuXUI — سیستم طراحی با یک هستهٔ مشترک (CSS + JS) برای Livewire، React/Inertia، و اکنون مستندسازی Vue و Svelte.
- apps/showcase: سایت نمونه (Vite + React). صفحه در دو زبان فارسی/انگلیسی با LangContext در apps/showcase/src/lang.tsx (الگوی localStorage را همان‌جا ببین).
- apps/showcase/src/Section.tsx: کامپوننت Section و Snippet — Snippet امروز تب‌های react/blade/inertia دارد.
- apps/showcase/src/App.tsx: هدر (Header)، سکشن‌ها، سوییچ زبان موجود.
- docs/BLOCKS.md: سند ساخت بلوک‌ها — هر بلوک سه‌باره با یک هستهٔ مشترک (CSS مشترک + React + Livewire/Blade).
- packages/core/src/css/blocks/*.css و packages/livewire/resources/views/components/*.blade.php: منبع راست کدهای نمونه.
- هفت بلوک تازه که باید در مستندات بیایند: chain-selector، language-menu، theme-switch، promo-bar، chip-filter، stat-strip، sort-pill (به‌علاوه بلوک‌های موجود مثل fold-menu، mega-menu، audio-room).

قواعد:
- قبل از هر ویرایش فایل را تازه بخوان؛ یک session موازی روی همین مخزن کار می‌کند و گاهی وسط کار کامیت می‌زند.
- فقط فایل‌های تعیین‌شدهٔ خودت را ویرایش کن.
- سبک مخزن: متن‌های UI دوزبانه (فارسی/انگلیسی) با useTr یا tr(a, b)؛ توکن‌های CSS؛ هیچ hex مستقیم.
- اگر چیزی ممکن نبود یا تناقضی دیدی، دور نزن — همان‌جا گزارشش کن.`;

phase("ساخت سوییچر حالت‌ها و بخش فریم‌ورک‌ها");
const builderPromise = agent("سازندهٔ سوییچر", {
  system:
    "تو مهندس ارشد فرانت‌اند هستی که روی showcase مخزن NabuXUI کار می‌کنی؛ تغییرها کوچک، دقیق و هم‌سبک با کد موجودند. اگر قواعد ناسازگار بودند، به‌جای دور زدن گزارشش کن.",
}).ask<BuildResult>(
  `${CONTEXT}

# مأموریت تو: سوییچر سراسری حالت‌ها در showcase
کاربر می‌خواهد در صفحهٔ اصلی، حالت‌های React / Inertia / Livewire / Vue / Svelte را جابه‌جا ببیند و همهٔ نمونه‌کدها با انتخابش عوض شوند.

۱. در apps/showcase/src/lang.tsx (یا فایل همسایهٔ تازه‌ای که از آن import می‌شود) یک FrameworkContext اضافه کن:
   - type Framework = 'react' | 'inertia' | 'livewire' | 'vue' | 'svelte'
   - useFramework() و setFramework، با ذخیره در localStorage کلید 'nabuxui.showcase.framework' (همان الگوی readLang موجود).
۲. در apps/showcase/src/Section.tsx: Snippet را تغییر بده تا به‌جای تب‌های ثابت، «کد حالت فعال» را نشان دهد:
   - props را به { react, blade, inertia?, vue?, svelte? } گسترش بده و یک برچسب کوچک بالای کد بگذار که نام حالت فعال را نشان می‌دهد (به همان زبان صفحه).
   - fallback هوشمند: inertia نبود → کد react با یک خط کامنت بالای آن که می‌گوید «Inertia: همان کامپوننت داخل صفحهٔ Inertia خودت». vue و svelte نبود → کد blade با کامنت بالای آن: «Vue/Svelte: هستهٔ NabuXUI یک CSS مشترک است؛ markup پایه همین خروجی Blade است و فقط CSS را import می‌کنی» (کامنت به زبان فعال صفحه). کامنت‌ها را داخل خود رشتهٔ کد نگذار — به‌صورت عنصر جدا بالای pre رندر کن.
   - جابه‌جایی حالت نباید تب‌های دیگر را از بین ببرد؛ فقط نمایش فعال عوض می‌شود.
۳. در apps/showcase/src/App.tsx: یک سوییچ فشرده در هدر اضافه کن (کنار سوییچ زبان) — از SegmentedControl با size="sm" و data-size مناسب استفاده کن (از @nabuxai/ui-react) با پنج گزینه React / Inertia / Livewire / Vue / Svelte؛ در موبایل اگر جا نشد بگذار مخفی شود (الگوی data-desktop موجود در همان فایل را ببین) تا هدر نریزد. حالت فعال از FrameworkContext می‌آید.
۴. یک سکشن تازهٔ «فریم‌ورک‌ها» بساز: apps/showcase/src/sections/frameworks.tsx با export function FrameworksSection(): زیر Hero و پیش از بقیهٔ سکشن‌ها در App رندر شود (خودت App.tsx را برای این دو خط ویرایش کن — فقط همین).
   - داخلش یک Section با سه Demo از بلوک‌های تازه (ChipFilter، StatStrip، SortPill از @nabuxai/ui-react) و Snippet پنج‌حالتهٔ واقعی: برای هر سه بلوک، کد واقعی React و Blade را از packages/react/src/blocks/chip-filter.tsx (و stat-strip، sort-pill) و packages/livewire/resources/views/components/*.blade.php بردار؛ برای inertia نسخهٔ react با کامنت؛ برای vue و svelte یک SFC/فایل واقعی و ساده بنویس (markup = خروجی Blade با حذف دستورات Blade و Alpine، اسکریپت = state ساده Vue/Svelte) — باید کد واقعیِ قابل‌کپی باشد، نه توضیح.
   - عنوان و توضیح دوزبانه؛ eyebrow مثل بقیهٔ سکشن‌ها.
۵. id سکشن را 'frameworks' بگذار و آن را به فهرست SECTIONS در App.tsx هم اضافه کن (بعد از ناوبری) تا در پالت دستور و مگامنو هم بیاید — آیکون 'grid' یا مشابه.

فقط این فایل‌ها را دست بزن: lang.tsx (یا فایل تازهٔ context)، Section.tsx، App.tsx، sections/frameworks.tsx (تازه).
خروجی: summary، files، notes (هر نکته‌ای برای بازبین).`,
);

phase("نوشتن مستندات کامل فریم‌ورک‌ها");
const docsPromise = agent("نویسندهٔ مستندات", {
  system:
    "تو نویسندهٔ مستندات فنی ارشد هستی؛ سند می‌نویسی که دقیق، کوتاه و قابل‌اجرا باشد و هیچ ادعایی را بدون خواندن کد واقعی ننویسی. به فارسی می‌نویسی.",
}).ask<BuildResult>(
  `${CONTEXT}

# مأموریت تو: docs/FRAMEWORKS.md
سند کاملی برای «استفادهٔ NabuXUI در هر حالت» بنویس — docs/BLOCKS.md موجود را بخوان تا لحن و ساختار هم‌سبک باشد (فایل تازه است، BLOCKS را ویرایش نکن).

ساختار پیشنهادی (بازنویسی با سلیقهٔ خودت اشکالی ندارد):
1. نقشهٔ کلی: یک هستهٔ مشترک (CSS توکن‌ها و حرکت + JS رفتارها) و لایه‌های بومی — جدول مقایسهٔ پنج حالت.
2. نصب: Livewire (پکیج composer، @nabuxuiHead، @nabuxuiScripts — از packages/livewire واقعی چک کن)، React/Next و Inertia (npm @nabuxai/ui-react + import css + NabuXUIProvider — از packages/react/src/internal/provider.tsx و README/کیفیت کد واقعی چک کن)، Vue و Svelte (استفاده از CSS مشترک + markup: مسیر پشتیبانی‌شده را صادقانه توضیح بده — بدون wrapper رسمی؛ دقیقاً همان‌طور که هست).
3. برای هر حالت: یک نمونهٔ کامل قابل‌کپی برای سه بلوک chip-filter، stat-strip و sort-pill (کد واقعی را از منابع بردار؛ برای Vue/Svelte SFC واقعی با state ساده).
4. تم روشن/تیره: themeScript در head، کلید localStorage 'nabu.theme'، توکن‌ها (از packages/core/src/js/theme.ts و کاتالوگ توکن‌ها در CSS).
5. راست‌به‌چپ: dir=rtl، متغیر --nx-dir، ضرب حرکت‌ها (از docs/BLOCKS.md).
6. جدول کاتالوگ بلوک‌ها: هر بلوک یک سطر — نام، تگ یک‌خطی، نام کامپوننت React، تگ Blade، نیاز به JS رفتاری.
7. لینک‌داخلی به docs/BLOCKS.md برای راهنمای ساخت بلوک تازه.

صداقت مهم است: چیزی که پشتیبانی رسمی ندارد را «wrapper رسمی» ننویس. همهٔ کدهای سند را از فایل‌های واقعی بردار، نه از حافظه.
فقط docs/FRAMEWORKS.md را بساز. خروجی: summary، files، notes.`,
);

const [built, docs] = await Promise.all([builderPromise, docsPromise]);
report({ step: "build", summary: built.summary, files: built.files });
report({ step: "docs", summary: docs.summary, files: docs.files });

phase("بازخوانی مستقل تغییرها");
const review = await agent("بازبین مستقل", {
  system:
    "تو بازبین مستقلی که این کدها را ننوشته؛ فایل‌ها را کامل می‌خوانی و فقط مشکلات واقعی را گزارش می‌کنی. هیچ فایلی را ویرایش نمی‌کنی.",
}).ask<ReviewResult>(
  `${CONTEXT}

این فایل‌های تازه/تغییریافته را کامل بخوان و فقط مشکلات واقعی را گزارش کن:
- ${built.files.join("\n- ")}
- ${docs.files.join("\n- ")}

چیزهایی که دنبالشان باش: اجرا نشدن (import غلط، JSX/TSX معیوب)، سوییچ حالت که در RTL یا موبایل می‌شکند، fallback نادرست در Snippet، localStorage با الگوی موجود نخواندن/ننوشتن، کد نمونهٔ سند که با فایل‌های واقعی بلوک‌ها نخواند (اینجا صفر تحمل است — هر snippet سند را با منبعش مقایسه کن)، و ادعای پشتیبانیِ ناکذب‌شده برای Vue/Svelte.
برای هر مورد: file، problem، severity. اگر سالم است findings خالی و overall یک جملهٔ قضاوتی.`,
);
report({ step: "review", overall: review.overall, findings: review.findings });

phase("رفع یافته‌های واقعی");
const fixer = agent("رفع‌کننده", {
  system:
    "تو رفع‌کنندهٔ مخزن NabuXUI هستی؛ فقط مشکلات واقعیِ گزارش‌شده را در فایل‌های همین کار رفع می‌کنی. مورد غلط یا خارج از محدوده را رد می‌کنی و می‌گویی چرا.",
});
const toFix = review.findings.filter((f) => f.severity !== "low");
if (toFix.length > 0) {
  await fixer.ask(
    `بازبین مستقل این موارد را گزارش کرده؛ موارد واقعی را رفع کن و برای هر مورد بگو «رفع شد» یا «رد شد — چرا»:
${JSON.stringify(toFix, null, 1)}

فقط این فایل‌ها را می‌توانی ویرایش کنی: ${[...built.files, ...docs.files, "apps/showcase/src/App.tsx", "apps/showcase/src/Section.tsx"].join("، ")}`,
  );
} else {
  log("یافتهٔ فنی برای رفع نبود");
}

phase("چک‌های تایپ و بیلد تا سبز شدن");
const checks: Array<{ name: string; args: string[] }> = [
  { name: "typecheck react", args: ["--filter", "@nabuxai/ui-react", "typecheck"] },
  { name: "typecheck livewire", args: ["--filter", "@nabuxai/ui-livewire-build", "typecheck"] },
  { name: "build livewire dist", args: ["--filter", "@nabuxai/ui-livewire-build", "build"] },
  { name: "build react dist", args: ["--filter", "@nabuxai/ui-react", "build"] },
  { name: "build showcase", args: ["--filter", "showcase", "build"] },
];
let green = false;
const gateLog: string[] = [];
for (let round = 1; round <= 3 && !green; round++) {
  let failed: Array<{ name: string; tail: string }> = [];
  for (const c of checks) {
    const r = await world.run("pnpm", c.args, { timeoutMs: 600000 });
    gateLog.push(`${c.name} → exit ${r.exitCode}`);
    if (r.exitCode !== 0) {
      failed = [{ name: c.name, tail: (r.stderr || r.stdout).slice(-3500) }];
      break;
    }
  }
  if (failed.length === 0) {
    green = true;
    break;
  }
  log(`دور ${round}: ${failed[0]?.name} قرمز بود؛ در حال رفع`);
  await fixer.ask(
    `این چک قرمز است:
${JSON.stringify(failed, null, 1)}

فقط اگر خطا به کار این workflow (سوییچر فریم‌ورک‌ها، sections/frameworks.tsx، مستندات) مربوط است رفعش کن؛ اگر از تغییرات نیمه‌کارهٔ session موازی در فایل‌های دیگر است، دست نزن و در خروجی بنویس «خارج از محدوده».`,
  );
}

phase("کامیت و پوش به گیت‌هاب");
let pushed = false;
let pushDetail = "پوش انجام نشد";
if (green) {
  const status = await world.run("git", ["status", "--porcelain"]);
  if (status.stdout.trim() === "") {
    pushDetail = "دردست‌کردگی برای کامیت نبود — چیزی برای پوش نبود";
  } else {
    const add = await world.run("git", ["add", "-A"]);
    gateLog.push(`git add → exit ${add.exitCode}`);
    const commit = await world.run("git", [
      "commit",
      "-m",
      "showcase: global framework switcher (react/inertia/livewire/vue/svelte) + frameworks section + FRAMEWORKS.md",
    ]);
    gateLog.push(`git commit → exit ${commit.exitCode} — ${(commit.stdout || commit.stderr).trim().slice(0, 300)}`);
    let push = await world.run("git", ["push", "origin", "main"]);
    if (push.exitCode !== 0) {
      const pull = await world.run("git", ["pull", "--rebase", "origin", "main"]);
      gateLog.push(`git pull --rebase → exit ${pull.exitCode}`);
      push = await world.run("git", ["push", "origin", "main"]);
    }
    gateLog.push(`git push → exit ${push.exitCode}`);
    pushed = push.exitCode === 0;
    pushDetail = pushed
      ? `پوش شد: ${((await world.run("git", ["log", "-1", "--format=%h %s"])).stdout || "").trim()}`
      : `پوش شکست خورد: ${(push.stderr || "").slice(-500)}`;
  }
} else {
  pushDetail = "چون چک‌ها سبز نشدند، کامیت و پوش انجام نشد";
}
log(pushDetail);
report({ step: "push", pushed, detail: pushDetail, gates: gateLog });

phase("تهیهٔ گزارش نهایی");
const findings: WorkflowReport["findings"] = [
  ...review.findings.map((f) => ({
    where: f.file,
    what: f.problem,
    evidence: `بازبینی مستقل: ${review.overall}`,
    status: (toFix.some((t) => t.file === f.file && t.problem === f.problem) ? "verified" : "unconfirmed") as "verified" | "unconfirmed",
    severity: f.severity,
  })),
];
if (!green) {
  findings.push({
    where: "gates",
    what: "چک‌های تایپ/بیلد پس از سه دور هنوز قرمزند؛ کامیت و پوش انجام نشد",
    evidence: gateLog.join("، "),
    status: "verified",
    severity: "high",
  });
}
if (!pushed && green) {
  findings.push({
    where: "git push",
    what: pushDetail,
    evidence: gateLog.filter((g) => g.startsWith("git")).join("، "),
    status: "verified",
    severity: "high",
  });
}

const result: WorkflowReport = {
  conclusion: green
    ? `سوییچر سراسری حالت‌ها (React / Inertia / Livewire / Vue / Svelte) به showcase اضافه شد، بخش نمونهٔ فریم‌ورک‌ها با سه بلوک تازه ساخته شد، docs/FRAMEWORKS.md نوشته شد، و ${pushed ? "همه‌چیز کامیت و به origin/main پوش شد." : "چک‌ها سبز شدند اما پوش نشد — جزئیات در findings."}`
    : "سوییچر و مستندات ساخته شدند اما چک‌ها سبز نشدند و پوش انجام نشد — جزئیات در findings.",
  findings,
  verified: [...gateLog, ...checks.map((c) => `pnpm ${c.args.join(" ")}`)],
  notCovered: [
    "بازبینی بصری سوییچر و سکشن فریم‌ورک‌ها در مرورگر — بعد از workflow به‌صورت دستی انجام می‌شود",
    "اجرای واقعی پروژه‌های Vue و Svelte — پشتیبانی‌شان از مسیر CSS مشترک مستند شده، نه wrapper رسمی",
  ],
};

const md = [
  "# سوییچر فریم‌ورک‌ها، مستندات و پوش",
  "",
  result.conclusion,
  "",
  "## چه ساخته شد",
  `- سوییچر: ${built.summary}`,
  `- مستندات: ${docs.summary}`,
  "",
  "## بازبینی مستقل",
  review.overall,
  ...(review.findings.length > 0 ? ["", ...review.findings.map((f) => `- [${f.severity}] ${f.file}: ${f.problem}`)] : []),
  "",
  "## چک‌ها و گیت",
  ...gateLog.map((g) => `- ${g}`),
  "",
  "## گیت",
  pushDetail,
  "",
  "## پوشش‌نیافته",
  ...result.notCovered.map((n) => `- ${n}`),
].join("\n");
await artifact.markdown("report", md, {
  title: "گزارش سوییچر فریم‌ورک‌ها و پوش",
  description: "سوییچر پنج‌حالته، سکشن فریم‌ورک‌ها، مستندات کامل و نتیجهٔ پوش",
  primary: true,
});

return result;