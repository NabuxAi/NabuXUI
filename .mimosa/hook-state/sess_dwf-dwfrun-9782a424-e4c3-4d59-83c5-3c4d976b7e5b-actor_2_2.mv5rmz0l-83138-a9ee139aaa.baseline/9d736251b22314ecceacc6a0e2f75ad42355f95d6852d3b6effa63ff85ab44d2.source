interface PhaseResult {
  /** فایل‌های ساخته/تغییر یافته */
  files: string[];
  ok: boolean;
  /** یادداشت به فارسی */
  notes: string;
}
interface VerifyFinding {
  what: string;
  evidence: string;
  severity: "low" | "medium" | "high";
}
interface JudgeVerdict {
  shot: string;
  pass: boolean;
  issues: string;
}
interface WorkflowReport {
  conclusion: string;
  findings: VerifyFinding[];
  verified: string[];
  notCovered: string[];
}

artifact.table("issues", {
  title: "موارد باز موج امکانات",
  description: "ایرادهای بازبینی مرورگری و داوری بصری.",
  columns: [
    { field: "what", label: "مورد" },
    { field: "evidence", label: "شاهد" },
    { field: "severity", label: "شدت" },
  ],
  key: "what",
});

const SHARED = [
  "قواعد مشترک:",
  "- هر صفحه یک Filament Page v5 است در playground/app/Filament/Pages/ با navigationGroup «ابزارها» (یا گروهی که در brief گفته شده)، navigationLabel فارسی، آیکن، و ویو در playground/resources/views/filament/pages/. الگوی صفحهٔ زنده: playground/app/Filament/Pages/NabuXuiPlayground.php و Dashboard.php را بخوان.",
  "- API کامپوننت nx را از سورسش بخوان (packages/livewire/resources/views/components/<name>.blade.php و Alpine آن در packages/livewire/resources/js) — از حافظه حدس نزن. هرجا کامپوننت رویداد dispatch می‌کند، در صفحه با x-on/$listeners به اکشن Livewire وصل کن.",
  "- بدون ارجاع به ایران/تهران؛ نام‌ها و شهرها بین‌المللی (استانبول، برلین، دو…) — در متن فارسی «استانبول» مجاز است. اعداد در متن فارسی با ارقام فارسی.",
  "- php -l بعد از هر فایل؛ آخر کار «php artisan route:list» باید route صفحهٔ تو را نشان بدهد.",
].join("\n");

phase("دیتای پشتیبان: ایمیل، گفت‌وگو، رویداد");
const data = await agent("سازنده-دیتا", {
  system: "تو مهندس Laravel این ریپو هستی (playground/، sqlite). مدل/مایگریشن/سیدر تمیز می‌نویسی و تا اجرا سبز نشود ول نمی‌کنی.",
}).ask<PhaseResult>(
  [
    "سه مدل تازه + دیتا بساز (الگوی موجود: app/Models/Product.php و database/seeders/NabuxSeeder.php):",
    "1) Email: subject، sender_name، sender_email، body text، folder string (inbox/archive)، is_read bool، received_at datetime — ۹ رکورد (۲ ناخوانده).",
    "2) Conversation: title، participant_name، avatar_color string؛ و ChatMessage: conversation_id، is_mine bool، body text، sent_at datetime — دو گفت‌وگو با ۴-۵ پیام هرکدام.",
    "3) CalendarEvent: title، event_date date، event_time string (مثل '10:30')، color string (blue/orange/green/indigo) — ۷ رویداد پخش در این هفته.",
    "همه idempotent در NabuxSeeder اضافه شوند (اول delete). «php artisan migrate --force» و «php artisan db:seed --class=NabuxSeeder» کد صفر بدهند.",
    "خروجی {files, ok, notes}.",
  ].join("\n"),
);

phase("هشت سازندهٔ موازی: صفحات زنده و سیاست‌ها");
const PAGES = [
  {
    id: "kanban",
    brief: "صفحهٔ «برد تسک‌ها»: کانبان واقعی روی مدل Task موجود. کامپوننت <x-nx::kanban> را از سورس بخوان (columns/value/events چه می‌خواهد؟) و به Task ها وصل کن؛ جابه‌جایی کارت بین ستون‌ها باید status رکورد را در دیتابیس عوض کند (اکشن Livewire + wire:key تا مورف سالم بماند). سه ستون todo/doing/done با شمارنده؛ کارت: عنوان، اولویت badge، فردا/دو-روز دیگر.",
  },
  {
    id: "email",
    brief: "صفحهٔ «ایمیل»: صندوق ورودی با <x-nx::email> (سورسش را بخوان — لیست + خواندن؟) یا لیست سفارشی از رکوردهای Email. کلیک روی ایمیل = باز شدن بدنه در پنل کنار + علامت‌گذاری خوانده‌شده (اکشن Livewire که is_read را می‌زند)؛ شمارندهٔ ناخوانده در ناوبری با badge.",
  },
  {
    id: "calendar",
    brief: "صفحهٔ «تقویم»: <x-nx::calendar> یا calendar-events کامپوننتش را از سورس بخوان؛ رویدادهای CalendarEvent این هفته را بده؛ کنار تقویم لیست «در راه» با رنگ‌های رکوردها. اگر کامپوننت month-view با دیتای JSON می‌خواهد، از blade با @json پر کن.",
  },
  {
    id: "chat",
    brief: "صفحهٔ «گفت‌وگو»: <x-nx::chat> را از سورس بخوان؛ دو گفت‌وگوی سیدشده را نشان بده؛ ارسال پیام در صفحه (ورودی + دکمه) با اکشن Livewire پیام is_mine=true در دیتابیس ذخیره کند و لیست به‌روز شود (afterStateUpdated یا wire:model + submit).",
  },
  {
    id: "files",
    brief: "صفحهٔ «فایل‌ها»: <x-nx::file-manager> را از سورس بخوان؛ یک درخت پوشه/فایل نمونه (آرایه در PHP، بدون دیتابیس) بده و breadcrumb/انتخاب پوشه را کارا کن (Alpine داخلی کامپوننت کافی است؛ اکشن Livewire لازم نیست مگر کامپوننت رویداد بدهد).",
  },
  {
    id: "analytics",
    brief: "صفحهٔ «تحلیل‌ها»: سه ویژن از دیتای واقعی Order/Product با کامپوننت‌های nx chart (donut-chart برای status سفارش‌ها، bar-chart برای فروش ۷ روز اخیر، sparkline در کارت جمع) — داده‌ها را سرور با NabuXUI::donut/areaPath یا props کامپوننت‌ها بساز (سورس کامپوننت‌ها را بخوان). اعداد با formatNumber.",
  },
  {
    id: "settings",
    brief: "صفحهٔ «تنظیمات»: فرم ذخیره‌شدنی با فیلدهای nx (NxToggle «اعلان‌ها»، NxSegmented «تراکم رابط»، NxSelect «منطقهٔ زمانی» بدون Asia/Tehran، NxSlider «حجم صدا») که در یک جدول settings (فایل/دیتابیس) می‌ماند — مایگریشن settings (key/value) بساز… نه، مایگریشن تازه لازم نیست: از مدل cache/آرایهٔ ثابت کلاس استفاده کن؛ دکمهٔ «ذخیره» مقادیر را نگه دارد و پس از reload هم بماند (session یا فایل storage/app/settings.json با Storage::). ساده، واقعی، بدون جادو.",
  },
  {
    id: "policies",
    brief: "سیاست‌های دسترسی: UserPolicy (فقط خود کاربر یا ایمیل admin@nabux.test می‌تواند ویرایش کند)، TaskPolicy/ProductPolicy/OrderPolicy (همه‌چیز برای همه در دموی این ریپو باز است ولی از Policy می‌گذرد تا اتصال فیلامنت عملی شود) + ثبت ModelPolicyها (Laravel خودش کشف می‌کند) و در ریسورس‌ها فقط اگر لازم شد can() اضافه کن. راستی‌آزمایی با «php artisan tinker --execute=...»: Policy::check برای کاربر عادی vs admin. به هیچ ریسورس دیگری دست نزن.",
  },
];
const built = await Promise.all(
  PAGES.map((p) =>
    agent(`سازنده-${p.id}`, {
      system:
        "تو سازندهٔ صفحات Filament v5 با کامپوننت‌های NabuXUI در این ریپو هستی. API هر کامپوننت nx را از سورسش می‌خوانی نه از حافظه؛ قرارداد صفحهٔ v5 (content(Schema) یا ویوی سفارشی + InteractsWithSchemas/اکشن‌ها) را از Dashboard.php و NabuXuiPlayground.php همین ریپو برمی‌داری. تا php -l و route سبز نشود ول نمی‌کنی.",
    }).ask<PhaseResult>(`${SHARED}\n\nوظیفهٔ تو: ${p.brief}\nخروجی {files, ok, notes}.`),
  ),
);

phase("بازبینی مرورگری موج امکانات");
const browser = await agent("بازبین-مرورگر", {
  system:
    "تو راستی‌آزمای مرورگری با playwright هستی (در /tmp/nx-shooter آماده). ادعا بدون شاهد ممنوع؛ هر مورد با اسکرین‌شات در /tmp/nx-admin-more/ یا متن DOM پشتوانه می‌شود.",
}).ask<{ ok: boolean; findings: VerifyFinding[]; shots: string[] }>(
  [
    "ورود: admin@nabux.test / nabux-demo روی http://127.0.0.1:8765/filament/login. اسلاگ هر صفحه را از nav کلیک کن، حدس نزن.",
    "بررسی‌ها (هرکدام اسکرین‌شات):",
    "1) برد تسک‌ها: سه ستون با کارت‌های سیدشده؛ یک کارت را از todo به doing ببر (درگ یا دکمهٔ کامپوننت هرچه هست)؛ بعد reload کن — جابه‌جایی مانده؟",
    "2) ایمیل: ایمیل ناخوانده را باز کن → بدنه دیده می‌شود و badge ناخوانده یکی کم می‌شود؟",
    "3) تقویم: رویدادهای هفته روی ماه دیده می‌شوند؟",
    "4) گفت‌وگو: یک پیام بفرست → در لیست می‌آید و بعد از reload هم هست؟",
    "5) فایل‌ها: پوشه‌ها باز می‌شوند؟",
    "6) تحلیل‌ها: نمودارها با اعداد واقعی رندر شده‌اند؟",
    "7) تنظیمات: یک تاگل بزن و ذخیره کن → بعد از reload مقدار مانده؟",
    "8) تم تیره یک اسکرین‌شات از هرکدام که خوانا باشد.",
    "خروجی {ok, findings, shots} به فارسی؛ findings فقط مشکلات واقعی.",
  ].join("\n"),
);

phase("داوری بصری و گزارش");
const judge = await agent("داور-نهایی", {
  system:
    "تو داور پذیرش بصری هستی و فقط از تصویر قضاوت می‌کنی. چیدمان شکسته، متن ناخوانا، همپوشانی، تم نشکسته = مردود؛ تفاوت سلیقه‌ای جزئی = قبول.",
}).ask<{ verdicts: JudgeVerdict[] }>(
  `این تصاویر را با Read ببین و حکم بده:\n${browser.shots.join("\n")}\nخروجی فقط JSON: {verdicts:[{shot, pass, issues}]} به فارسی.`,
);

const failed = judge.verdicts.filter((v) => !v.pass);
for (const f of browser.findings) report({ what: f.what, evidence: f.evidence, severity: f.severity }, "issues");
for (const v of failed) report({ what: `داوری ${v.shot}`, evidence: v.issues, severity: "medium" }, "issues");

await artifact.markdown(
  "report",
  [
    "# ادمین نابو: موج امکانات",
    "",
    `**وضعیت: ${data.ok && built.every((b) => b.ok) && browser.ok && failed.length === 0 ? "سبز" : "با مورد باز"}** — ۷ صفحهٔ زندهٔ تازه + سیاست‌های دسترسی.`,
    "",
    "## صفحات",
    ...PAGES.map((p, i) => `- ${built[i].ok ? "✅" : "❌"} **${p.id}** — ${built[i].notes || "—"}`),
    `- ${data.ok ? "✅" : "❌"} دیتا — ${data.notes}`,
    "",
    "## بازبینی مرورگری",
    ...browser.findings.map((f) => `- ${f.severity === "high" ? "🔴" : f.severity === "medium" ? "🟠" : "🟡"} ${f.what} — ${f.evidence}`),
    ...(browser.findings.length === 0 ? ["- هیچ مشکلی پیدا نشد."] : []),
    "",
    "## داوری بصری",
    ...judge.verdicts.map((v) => `- ${v.pass ? "✅" : "❌"} ${v.shot}${v.issues ? " — " + v.issues : ""}`),
  ].join("\n"),
  { title: "گزارش موج امکانات ادمین نابو", description: "کانبان، ایمیل، تقویم، گفت‌وگو، فایل‌ها، تحلیل‌ها، تنظیمات + سیاست‌ها", primary: true },
);

const problems = [
  ...(data.ok ? [] : ["دیتا ناتمام"]),
  ...built.filter((b) => !b.ok).map((b, i) => `ناقص: ${PAGES[i].id}`),
  ...browser.findings.map((f) => f.what),
  ...failed.map((v) => `داوری: ${v.shot}`),
];

return {
  conclusion:
    problems.length === 0
      ? "موج امکانات ادمین کامل شد و سرِ زنده راستی‌آزمایی شد: برد کانبان با جابه‌جایی پایدار، ایمیل با خواندن و badge زنده، تقویم رویدادها، گفت‌وگو با ارسال پیام ماندگار، فایل‌ها، تحلیل‌های واقعی، تنظیمات ماندگار، و سیاست‌های دسترسی."
      : `موج امکانات با ${problems.length} مورد باز: ${problems.slice(0, 4).join("؛ ")}.`,
  findings: [
    ...browser.findings,
    ...failed.map((v) => ({ what: `داوری تصویر ${v.shot}`, evidence: v.issues, severity: "medium" as const })),
    ...(data.ok ? [] : [{ what: "دیتا", evidence: data.notes, severity: "high" as const }]),
    ...built.filter((b) => !b.ok).map((b, i) => ({ what: `ناقص: ${PAGES[i].id}`, evidence: b.notes, severity: "high" as const })),
  ],
  verified: [
    "migrate + db:seed کد صفر (world.run)",
    "php -l و route:list توسط هر سازنده روی صفحهٔ خودش",
    "بازبینی مرورگری authed: درگ کانبان + reload، باز کردن ایمیل و badge، ارسال پیام + reload، تنظیمات + reload، تحلیل‌ها، تیره + داوری بصری مستقل",
  ],
  notCovered: [
    "آپلود واقعی فایل در صفحهٔ فایل‌ها (درخت نمونهٔ ثابت است)",
    "چند کاربر هم‌زمان و realtime (پوش/اکو) — همه‌چیز پس از reload همگام می‌شود",
    "موج‌های بعدی: نقش‌ها و مجوزهای ریزتر، ویجت‌های قابل‌جابه‌جایی داشبورد",
  ],
};