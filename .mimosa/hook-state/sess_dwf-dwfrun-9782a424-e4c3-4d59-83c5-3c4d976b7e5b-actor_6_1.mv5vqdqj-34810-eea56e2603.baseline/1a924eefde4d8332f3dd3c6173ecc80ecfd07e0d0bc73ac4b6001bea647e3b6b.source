const RULES = [
  "قواعد سخت (تخلف = بازسازی):",
  "- دوزبانه با الگوی $say؛ اعداد فارسی در رشته‌های fa؛ بدون lorem ipsum؛ متن محصولی واقعی با نام‌های جهانی.",
  "- هرگز نام ایران/تهران یا نمونهٔ ایرانی؛ مثال‌ها جهانی.",
  "- استایل اسکوپ با پیشوند کلاس یکتا برای هر دمو؛ id های SVG (گرادیان/فیلتر/mask/clipPath) حتماً پیشونددار.",
  "- آینهٔ تیره دو بار: html[data-theme=dark] و @media (prefers-color-scheme: dark) با html:not([data-theme=light]).",
  "- بدون position:fixed (sticky مجاز)؛ بدون wire:؛ تعامل فقط Alpine داخل پارشال؛ هرگز data-nx-reveal؛ هرگز {{ داخل <style>.",
  "- prefers-reduced-motion: انیمیشن/حلقه‌ها متوقف یا به حالت نهایی؛ حلقه‌های RAF/انیمیشن خارج از دید مکث شوند (IntersectionObserver).",
  "- ویژگی‌های منطقی برای RTL؛ در 375px سرریز افقی نده؛ حروف‌چینی فارسی نشکن (split حرف‌به‌حرف فقط لاتین؛ فارسی سطح واژه).",
  "",
  "سه خانوادهٔ باگ که در موج‌های قبل رخ داد — این بار ممنوع مطلق:",
  "۱) هرگز {!! json_encode !!} خام داخل x-data/x-bind — همیشه {{ json_encode([...], JSON_UNESCAPED_UNICODE) }} تا e() کوتیشن‌ها را &quot; کند.",
  "۲) هرگز $cleanup — وجود خارجی ندارد. پاک‌سازی: io/t/raf را فیلد کن و در init بساز، در destroy() ببند (this.io?.disconnect()، clearTimeout، cancelAnimationFrame، removeEventListener).",
  "۳) اگر template literal چندخطی داری (شیدر/HTML قالب)، توازن پرانتز/بک‌تیک پایانش را دوبار بشمار — «}`));» دو پرانتز می‌خواهد وقتی دو فراخوانی باز است.",
  "",
  "- اگر قاعده‌ای با واقعیت ریپو ناسازگار بود، در notes صادقانه بگو — دور نزن.",
].join("\n");

function buildPrompt(g: (typeof GROUPS)[number]): string {
  const demos = g.demos.map((d) => "- " + d.slug + " — " + d.titleFa + " / " + d.titleEn + ": " + d.spec).join("\n");
  return [
    "گروه «" + g.labelFa + "» برای کاتالوگ /components با " + g.demos.length + " دموی تازه — سرور dev از قبل روی " + BASE + " بالاست؛ ری‌استارت نکن. ریشهٔ ریپو همان جایی است که فرمان‌ها را در آن اجرا می‌کنی.",
    "",
    "فایل مانیفست تازه: " + g.manifest + " — نام فایل تعیین‌کنندهٔ id گروه «" + g.id + "» است (پیشینهٔ نام‌گذاری: Charts-plus.php و Icon-motion.php) و __group برچسب گروه: fa «" + g.labelFa + "» / en «" + g.labelEn + "».",
    "docs هر مدخل = " + g.docs + ".",
    "",
    "دموها (دقیقاً همین اسلاگ‌ها، همین ترتیب):",
    demos,
    "",
    "پیش از نوشتن، الگوها را بخوان:",
    "- مانیفست: playground/app/Support/Demos/Android.php (شکل مدخل) و playground/app/Support/Demos/Carbon.php (شکل نقشهٔ کد پنج‌فریم‌ورکی — این موج دقیقاً همین شکل را می‌خواهد).",
    "- پارشال: playground/resources/views/demos/components/icon-motion/draw-entrance.blade.php (الگوی init/destroy استاندارد با IntersectionObserver) و shaders/ripple-pond.blade.php (الگوی canvas + RAF + پاک‌سازی کامل).",
    "",
    "هر دمو = یک مدخل کامل در مانیفست + پارشال playground/resources/views/demos/components/" + g.id + "/{slug}.blade.php:",
    "- title / oneLiner دوزبانه با لحن فروشنده؛ icon فقط از فهرست مجاز؛ js درست/غلط؛ props سه تا پنج ردیف واقعی با note دوزبانه.",
    "- code نقشهٔ کامل پنج‌کلیدی مثل کربن: livewire (جفت fa/en) + inertia + react + vue + svelte — هر قطعه همان سناریوی اصلی دمو را در آن فریم‌ورک می‌سازد (خودکفا با استایل داخل خودش).",
    "",
    "راهنمای اختصاصی این گروه: " + g.hint,
    "",
    RULES,
    "",
    "آیکن‌های مجاز کاتالوگ: " + ICONS + ".",
    "",
    "بعد از هر دمو این دو را بزن تا سبز شود و بعد بروی بعدی:",
    "- php -l " + g.manifest,
    "- curl -s -o /dev/null -w '%{http_code}' " + BASE + "/components/" + g.id + "/{slug} باید ۲۰۰ باشد.",
    "و پیش از تحویل، برای هر دمو یک بار خطای کنسول را هم بگیر (با یک اسکریپت playwright کوچک: pageerror + console.error بعد از networkidle + ۱٫۲ ثانیه) — اگر خطایی دیدی همان‌جا درست کن؛ curlِ ۲۰۰ به‌تنهایی کافی نیست.",
    "",
    "خروجی فقط JSON {files, slugs, ok, notes} — slugs دقیقاً همین اسلاگ‌ها؛ notes فارسی و کوتاه.",
  ].join("\n");
}

phase("شمارش پیش از ساخت و ساخت شش خانوادهٔ تازه");
const before = await world.run("php", [
  "playground/artisan",
  "tinker",
  "--execute=echo count(App\\Support\\DemoCatalog::flat()).' '.count(App\\Support\\DemoCatalog::groups());",
]);
const totalDemos = GROUPS.reduce((n, g) => n + g.demos.length, 0);
// دروازهٔ شمارش «مطلق» است: ۳۴۶/۳۵ پایان موج ۳ + ۲۸ دمو در ۶ گروه تازه = ۳۷۴/۴۱.
// (خواندن پایه پویا در اجرای قبلی خالی برگشت و دروازه را مسموم می‌کرد.)
const expectedDemos = 374;
const expectedGroups = 41;
log("شمارش فعلی: " + (before.stdout.trim().split("\n").pop() ?? "—") + " — " + GROUPS.length + " سازنده به‌موازاتی، هدف نهایی " + expectedDemos + "/" + expectedGroups);
const settled = await Promise.allSettled(
  GROUPS.map((g) =>
    agent("سازنده-" + g.id, {
      system:
        "تو سازندهٔ گروه‌های دموی کتابخانهٔ NabuXUI هستی (الگوی موج‌های قبلی: کربن، هیروها، icon-motion). یک اجرای قبلی ناتمام مانده: ممکن است مانیفست گروه تو و پارشال‌هایی از قبل موجود باشند — اول بازرسی کن (php -l و curl تک‌تک اسلاگ‌ها) و فقط جاافتاده‌ها/خراب‌ها را کامل یا درست کن؛ کارِ سالم را دوباره نساز. فایل‌ها را یک‌به‌یک و افزایشی بساز؛ اگر قاعده‌ای ناسازگار با واقعیت ریپو بود اسکیلیت کن، دور نزن.",
    }).ask<PhaseResult>(buildPrompt(g)),
  ),
);
const builders = settled.map((s, i) => {
  const g = GROUPS[i];
  if (s.status === "fulfilled") return s.value;
  report({ what: "سازندهٔ " + g.id + " ناتمام ماند", evidence: String(s.reason).slice(0, 300), severity: "high" }, "issues");
  return { files: [], slugs: g.demos.map((d) => d.slug), ok: false, notes: "اجنت شکست خورد: " + String(s.reason).slice(0, 200) } as PhaseResult;
});

phase("دروازه‌های قطعی: لینت مانیفست‌ها و شمارش دموها");
const allPages: { group: string; slug: string }[] = GROUPS.flatMap((g) => g.demos.map((d) => ({ group: g.id, slug: d.slug })));
const manifestFiles = GROUPS.map((g) => g.manifest);
let gateProblems: string[] = [];
for (const m of manifestFiles) {
  const r = await world.run("php", ["-l", m]);
  if (r.exitCode !== 0) {
    gateProblems.push(m);
    report({ what: "لینت PHP خراب: " + m, evidence: r.stdout.trim().split("\n").slice(-2).join(" "), severity: "high" }, "issues");
  }
}
for (let round = 1; round <= 2 && gateProblems.length > 0; round++) {
  const still: string[] = [];
  for (const [i, m] of gateProblems.entries()) {
    await agent("اصلاح‌گر-لینت-" + i + "-" + round, {
      system: "تو تعمیرکار PHP/Blade این ریپو هستی؛ فقط مانیفست تعیین‌شده را درست کن و سبک موج‌های موجود را حفظ کن.",
    }).ask("php -l روی " + m + " خطا می‌دهد. درستش کن تا لینت سبز شود و ساختار مدخل‌ها سالم بماند.");
    const r = await world.run("php", ["-l", m]);
    if (r.exitCode !== 0) still.push(m);
  }
  gateProblems = still;
}
const expectedPerGroup = GROUPS.map((g) => g.id + " → " + g.demos.length + " دمو: " + g.demos.map((d) => d.slug).join("، ")).join(" ؛ ");
let counted = "";
for (let round = 1; round <= 2; round++) {
  const t = await world.run("php", [
    "playground/artisan",
    "tinker",
    "--execute=echo count(App\\Support\\DemoCatalog::flat()).' '.count(App\\Support\\DemoCatalog::groups());",
  ]);
  counted = t.stdout.trim().split("\n").pop() ?? "";
  if (counted === expectedDemos + " " + expectedGroups) break;
  report({ what: "شمارش دموها ناهماهنگ: " + counted, evidence: "انتظار: " + expectedDemos + " " + expectedGroups, severity: "high" }, "issues");
  await agent("اصلاح‌گر-شمارش-" + round, {
    system: "تو تعمیرکار مانیفست‌های دمو در این ریپو هستی. مانیفست‌ها ممکن است از یک اجرای ناتمام قبلی نیمه‌پر باشند — بازرسی کن و فقط مدخل‌های جاافتاده را اضافه کن.",
  }).ask(
    "شمارش کاتالوگ " + counted + " شد ولی انتظار دقیقاً " + expectedDemos + " دمو در " + expectedGroups + " گروه است. انتظار هر مانیفست: " + expectedPerGroup +
      ". مانیفست‌های این موج (" + manifestFiles.join("، ") + ") را با همین فهرست مقایسه کن و فقط مدخل‌های جاافتاده را به همان سبک اضافه کن (اسلاگ/ترتیب/شکل دقیقاً همین).",
  );
}
log("شمارش کاتالوگ باید " + expectedDemos + " " + expectedGroups + " باشد");

phase("زلزدن هر نمونهٔ ایرانی از فایل‌های تازه");
const iranTargets = [
  ...GROUPS.map((g) => "playground/resources/views/demos/components/" + g.id),
  ...manifestFiles,
];
const iran = await world.run("grep", ["-rEni", "ایران|تهران|Iran|Tehran", ...iranTargets]);
if (iran.exitCode === 0) {
  const hitFiles = [...new Set(iran.stdout.trim().split("\n").filter(Boolean).map((l) => l.split(":")[0] ?? ""))].filter(Boolean);
  report({ what: "نمونهٔ ایرانی در فایل‌های تازه", evidence: iran.stdout.trim().split("\n").slice(0, 4).join(" | "), severity: "high" }, "issues");
  for (const [i, f] of hitFiles.entries()) {
    await agent("پاک‌ساز-ایران-" + i, {
      system: "تو ویراستار محتوای دموهای این ریپو هستی؛ سیاست: صفر ارجاع به ایران/تهران در دموها — مثال‌ها جهانی.",
    }).ask("در " + f + " الگوی ایران/تهران/Iran/Tehran پیدا شده (خودت grep کن). همه را با معادل جهانی عوض کن؛ فقط همین فایل.");
  }
  const recheck = await world.run("grep", ["-rEni", "ایران|تهران|Iran|Tehran", ...iranTargets]);
  if (recheck.exitCode === 0) {
    report({ what: "پاک‌سازی ایرانی ناتمام", evidence: recheck.stdout.trim().split("\n").slice(0, 3).join(" | "), severity: "medium" }, "issues");
  }
} else {
  log("پویش بدون-ایران پاک بود");
}

phase("پویش HTTP هر صفحهٔ تازه و اصلاح تا ۲۰۰");
let broken: { group: string; slug: string; code: string }[] = [];
for (const p of allPages) {
  const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", BASE + "/components/" + p.group + "/" + p.slug]);
  const code = r.stdout.trim();
  if (code !== "200") {
    broken.push({ ...p, code });
    report({ what: p.group + "/" + p.slug + " کد " + code, evidence: "curl → " + code, severity: "high" }, "issues");
  }
}
log("پویش اول: " + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰");
for (let round = 1; round <= 2 && broken.length > 0; round++) {
  const still: typeof broken = [];
  for (const b of broken) {
    await agent("اصلاح‌گر-" + b.group + "-" + b.slug + "-" + round, {
      system:
        "تو تعمیرکار Blade این ریپو هستی؛ فقط دموی تعیین‌شده را درست کن (الگوها: مانیفست گروه و پارشال‌های هم‌گروه؛ شکل مدخل و نقشهٔ کد پنج‌فریم‌ورکی از Carbon.php). قواعد موج و سه ممنوعیت باگ (json خام در x-data، $cleanup، پرانتز template literal) را نگه دار.",
    }).ask(
      "صفحهٔ " + BASE + "/components/" + b.group + "/" + b.slug + " کد " + b.code + " می‌دهد. مدخل و پارشال را وارسی و اصلاح کن تا ۲۰۰ بدهد. اگر نشد صادقانه بگو.",
    );
    const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", BASE + "/components/" + b.group + "/" + b.slug]);
    if (r.stdout.trim() !== "200") still.push(b);
  }
  broken = still;
}
log("پس از اصلاح: " + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰");

phase("بازبینی مرورگری: پویش کنسول همهٔ صفحه‌ها، عکاسی و انگلیسی");
const browser = await agent("بازبین-مرورگر", {
  system:
    "تو راستی‌آزمای مرورگری با playwright هستی. در /tmp/nx-shooter آماده است: node /tmp/nx-shooter/shoot.mjs <url> <outBase> سه عکس light/dark/mobile با اسکرول پیش از عکس می‌گیرد. ادعا بدون شاهد ممنوع؛ چیزی را که ندیدی گزارش نکن.",
}).ask<BrowserReview>(
  [
    "پوشهٔ /tmp/nx-wave4 را بساز (mkdir -p). صفحات: " + BASE + "/components/{group}/{slug}",
    "",
    "۱) پویش کنسول روی «همهٔ» " + allPages.length + " صفحه: با یک اسکریپت playwright برای هر صفحه pageerror + console.error را بعد از networkidle + ۱٫۵ ثانیه جمع کن — هر خطایی یعنی باگ واقعی (Alpine/سینتکس)؛ فهرست کامل صفحه‌ها: " +
      allPages.map((p) => p.group + "/" + p.slug).join("، "),
    "۲) عکاسی کامل (سه‌عکسی shoot.mjs) از دو دموی اول هر گروه: " +
      GROUPS.map((g) => g.demos.slice(0, 2).map((d) => g.id + "/" + d.slug).join("، ")).join(" · "),
    "۳) تعامل‌های کلیدی را عملاً اجرا کن و شاهد بگیر: درگ مکعب flip-cube بچرخد، open-box باز شود، confetti-burst با کلیک ذره بریزد، split-flap متن عوض کند، drag-spring رها شود و بلرزد، image-accordion با فلش کیبورد جابه‌جا شود، live-ticker ارقام بچرخند (پیش از هر تعامل عنصر را scrollIntoViewIfNeeded کن وگرنه کلیک به خلا می‌خورد!).",
    "۴) انگلیسی: دموی اول هر گروه با ?lang=en — یک عکس روشن (فایل *-en.png)؛ متن کامل انگلیسی و LTR.",
    "۵) سرریز ۳۷۵px را همان اسکریپت پویش کنسول گزارش کند (scrollWidth در برابر clientWidth).",
    "",
    "نام‌گذاری: /tmp/nx-wave4/{group}-{slug}-light.png و -dark.png و -mobile.png؛ EN هم *-en.png؛ شات‌های تعاملی هم *-interact.png.",
    "خروجی فقط JSON {ok, findings:[{what, evidence, severity}], shots:[همهٔ مسیرها]} — findings فارسی.",
  ].join("\n"),
);

phase("اصلاح ایرادهای باز و بازتأیید");
const actionable = (browser.findings ?? []).filter((f) => f.severity !== "low").slice(0, 10);
if (actionable.length > 0) {
  for (const [i, f] of actionable.entries()) {
    const target = f.evidence.match(/\/tmp\/nx-wave4\/([a-z0-9-]+)-[a-z]+\.png/);
    const guess = target?.[1] ?? "";
    const page = allPages.find((p) => guess.startsWith(p.group + "-" + p.slug));
    await agent("اصلاح‌گر-" + i, {
      system:
        "تو تعمیرکار دموهای این ریپو هستی؛ فقط مورد اشاره‌شده را اصلاح کن. سه ممنوعیت باگ موج: json خام در x-data (از {{ json_encode(..., JSON_UNESCAPED_UNICODE) }})، $cleanup ممنوع (init/destroy)، پرانتزهای template literal را بشمار. برای اطمینان دوباره عکس/پروب بگیر و ببین. نتیجه را کوتاه بگو.",
    }).ask(
      "ایراد در دمو" + (page ? " " + page.group + "/" + page.slug : "") + ": " + f.what + " — شاهد: " + f.evidence + ". درستش کن و با ابزار خودت (عکس یا پروب) تأیید کن.",
    );
    if (page) {
      const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", BASE + "/components/" + page.group + "/" + page.slug]);
      if (r.stdout.trim() !== "200") {
        report({ what: "بعد از اصلاح " + page.group + "/" + page.slug + " صفحه ۲۰۰ نیست", evidence: "curl → " + r.stdout.trim(), severity: "high" }, "issues");
      }
    }
  }
} else {
  log("ایراد با شدت بالا/متوسط پیدا نشد — اصلاح لازم نبود");
}

phase("داوری بصری مستقل");
const judgeShots = (browser.shots ?? [])
  .filter((s) => s.startsWith("/tmp/nx-wave4/") && !s.includes("-mobile") && !s.endsWith("-interact.png") && !s.endsWith("-en.png"))
  .slice(0, 16);
let verdicts: JudgeVerdict[] = [];
if (judgeShots.length > 0) {
  const judge = await agent("داور-بصری", {
    system: "تو داور پذیرش بصری هستی و فقط از تصویر قضاوت می‌کنی؛ ادعای ندیده ممنوع. چیدمان شکسته/ناخوانا/تم تیرهٔ خراب/سرریز = مردود؛ سلیقهٔ جزئی = قبول.",
  }).ask<{ verdicts: JudgeVerdict[] }>(
    "این عکس‌ها را با Read یکی‌یکی ببین و دربارهٔ هرکدام حکم بده:\n" + judgeShots.join("\n") +
      "\nخروجی فقط JSON: {verdicts:[{shot, pass, issues}]} — issues فارسی.",
  );
  verdicts = judge.verdicts ?? [];
  for (const v of verdicts.filter((v) => !v.pass)) {
    report({ what: "داوری بصری مردود: " + v.shot, evidence: v.issues, severity: "medium" }, "issues");
  }
} else {
  report({ what: "عکسی برای داوری نماند", evidence: "بازبین مرورگر شاتی برنگرداند", severity: "high" }, "issues");
}

const failedBuilders = builders.filter((b) => !b.ok);
const problems = [
  ...broken.map((b) => b.group + "/" + b.slug + " کد " + b.code),
  ...failedBuilders.map((b) => "سازندهٔ ناقص: " + b.notes),
  ...(browser.findings ?? []).filter((f) => f.severity !== "low").map((f) => f.what),
  ...verdicts.filter((v) => !v.pass).map((v) => "داوری: " + v.shot),
];

await artifact.markdown(
  "report",
  [
    "# موج انیمیشن‌ها و قابلیت‌ها",
    "",
    "**" + allPages.length + " دموی تازه در ۶ گروه**: ورودها، هاورها، پس‌زمینه‌های محیطی، تایپوگرافی جنبشی، ریزتعامل‌ها و عمق سه‌بعدی CSS — هر کدام با تکه‌کد پنج‌فریم‌ورکی.",
    "",
    "پویش HTTP: " + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰ — شمارش کاتالوگ " + counted + " (هدف " + expectedDemos + "/" + expectedGroups + ").",
    "",
    "## سازندگان",
    ...GROUPS.map((g, i) => {
      const b = builders[i];
      const names = g.demos.map((d) => d.titleFa).join("، ");
      return "- " + (b.ok ? "✅" : "❌") + " **" + g.labelFa + "** (" + g.demos.length + " دمو): " + names + (b.ok ? "" : " — " + b.notes);
    }),
    "",
    "## بازبینی مرورگری (پویش کنسول تمام‌صفحه + تعامل‌های واقعی)",
    ...((browser.findings ?? []).length === 0 ? ["- مشکلی پیدا نشد."] : (browser.findings ?? []).map((f) => "- " + (f.severity === "high" ? "🔴" : f.severity === "medium" ? "🟠" : "🟡") + " " + f.what + " — " + f.evidence)),
    "",
    "## داوری بصری مستقل (" + verdicts.length + " عکس)",
    ...verdicts.map((v) => "- " + (v.pass ? "✅" : "❌") + " " + v.shot + (v.issues ? " — " + v.issues : "")),
  ].join("\n"),
  { title: "گزارش موج انیمیشن‌ها و قابلیت‌ها", description: allPages.length + " دموی تازه در ۶ گروه — از ساخت تا داوری بصری", primary: true },
);

const report_: WorkflowReport = {
  conclusion:
    problems.length === 0
      ? "موج انیمیشن‌ها و قابلیت‌ها کامل شد: " + allPages.length + " دموی تازه در ۶ گروه با تکه‌کد پنج‌فریم‌ورکی؛ لینت، شمارش، پویش HTTP، پویش کنسول تمام‌صفحه، سیاست بدون-ایران، تعامل‌های واقعی و داوری بصری همه سبز."
      : "موج انجام شد (" + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰) اما " + problems.length + " مورد باز دارد: " + problems.slice(0, 5).join("؛ ") + ".",
  findings: [
    ...broken.map((b) => ({ what: b.group + "/" + b.slug + " کد " + b.code, evidence: "curl", severity: "high" as const })),
    ...failedBuilders.map((b) => ({ what: "سازندهٔ ناقص", evidence: b.notes, severity: "high" as const })),
    ...(browser.findings ?? []),
    ...verdicts.filter((v) => !v.pass).map((v) => ({ what: "داوری تصویر " + v.shot, evidence: v.issues, severity: "medium" as const })),
  ],
  verified: [
    "php -l روی هر ۶ مانیفست + حلقهٔ اصلاح تا ۲ دور",
    "شمارش قطعی کاتالوگ با tinker (هدف " + expectedDemos + "/" + expectedGroups + " — دیدیم: " + counted + ")",
    "curl تک‌تک " + allPages.length + " صفحهٔ تازه + حلقهٔ اصلاح تا ۲ دور",
    "گrep بدون-ایران روی پارشال‌ها و مانیفست‌ها",
    "پویش کنسول (pageerror + console.error) روی «همهٔ» " + allPages.length + " صفحه + عکاسی روشن/تیره/موبایل نمونه‌ها + EN + اجرای واقعی تعامل‌های کلیدی (درگ/کانفتی/اسپلیت‌فلپ/آکاردئون/تیکر)",
    "داوری بصری مستقل داور تازه روی " + verdicts.length + " عکس",
  ],
  notCovered: [
    "عکاسی سه‌تمِ هر صفحه نبود — نمونه‌ای از هر گروه؛ پویش کنسول و سرریز اما تمام‌صفحه بود",
    "پورت دموها به پکیج‌های React/Vue هنوز منتقل نشده — فعلاً دموی پلی‌گراوندند (تکه‌کد پنج‌فریم‌ورکی در هر دمو هست)",
  ],
};
return report_;
