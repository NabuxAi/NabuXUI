#!/usr/bin/env bash
#
# bin/sync-flavors — mirror every built SPA flavor from apps/*/dist into the
# Laravel playground's public tree, one address per framework:
#
#   apps/showcase/dist     -> playground/public/react        (/react)
#   apps/admin/dist        -> playground/public/react/admin  (/react/admin)
#   apps/admin-vue/dist    -> playground/public/vue          (/vue)
#   apps/admin-svelte/dist -> playground/public/svelte       (/svelte)
#   apps/inertia/dist      -> playground/public/inertia      (/inertia)
#
# The apps keep their build output in place (apps/<app>/dist); this script
# only mirrors it, so re-run it after rebuilding any app. rsync --delete
# keeps the public copies exact. The react sync excludes "admin" so it can
# never wipe the nested /react/admin copy, whichever order runs in, and
# "._lab" stays out of the public tree (dev-lab content, not for serving).
#
# ADAPTER — absolute asset URLs. Every app builds with vite base './', so
# the dist index.html references "./assets/…". That is correct for any
# *sub-path* URL (/react/settings resolves ./assets against /react/), but
# the advertised root URLs have no trailing slash: on "/react" a browser
# resolves "./assets/x.js" against "/" → "/assets/x.js" → 404, and on
# "/react/admin" it resolves to "/react/assets/…" — the showcase's asset
# namespace. Rewriting the references to root-absolute "/<prefix>/…"
# during the sync fixes both, from any URL shape, without touching the
# apps' vite configs or rebuilds. playground/Dockerfile mirrors this
# rewrite for the image — keep the two in sync.
#
# The inertia copy skips index.html (the standalone dev shell) and gains a
# directory index.php instead: /inertia is answered by the Inertia
# controllers through the inertia-root Blade view, and under
# `php artisan serve` a bare directory request only reaches the app when
# an index.php sits inside it (see the heredoc below).
#
# Nothing here builds anything. If a dist is missing, build it first:
#   pnpm install --filter <app>... --no-frozen-lockfile
#   pnpm --filter <app> build
# (the apps' vite builds consume packages/*/dist, so build those too —
# `pnpm --filter <app>... build` does the whole chain topologically).

set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
public="$repo/playground/public"

sync_flavor() {
    local src="$1" dst="$2" url_prefix="$3"
    shift 3

    if [ ! -f "$src/index.html" ] && [ ! -f "$src/.vite/manifest.json" ]; then
        echo "sync-flavors: missing build output in $src — build the app first" >&2
        exit 1
    fi

    mkdir -p "$dst"
    rsync -a --delete "$@" "$src/" "$dst/"

    # Rewrite "./assets/…" -> "/<url-prefix>/assets/…" in the SPA shell (see
    # ADAPTER above). sed -i.bak + rm works on both BSD and GNU sed.
    if [ -f "$dst/index.html" ]; then
        sed -i.bak -E "s#(src|href)=\"\./#\\1=\"${url_prefix}/#g" "$dst/index.html"
        rm -f "$dst/index.html.bak"
    fi
    echo "synced $src -> $dst"
}

sync_flavor "$repo/apps/showcase/dist"     "$public/react"        /react        --exclude=admin --exclude=_lab
# rsync's exclude also protects a receiver-side _lab from --delete, so drop
# any copy left by an older sync run explicitly.
rm -rf "$public/react/_lab"
sync_flavor "$repo/apps/admin/dist"        "$public/react/admin" /react/admin
sync_flavor "$repo/apps/admin-vue/dist"    "$public/vue"         /vue
sync_flavor "$repo/apps/admin-svelte/dist" "$public/svelte"      /svelte
sync_flavor "$repo/apps/inertia/dist"      "$public/inertia"     /inertia      --exclude=index.html

# /inertia must boot the app (its controllers answer), so the directory
# needs a PHP index — not the dist's standalone dev shell. Written inline
# on purpose: no extra untracked file for image builds cloned from git to
# depend on (playground/Dockerfile writes the same file — keep in sync).
cat > "$public/inertia/index.php" <<'PHP'
<?php

/**
 * The directory index for the copied Inertia build (public/inertia).
 *
 * /inertia is answered by the Inertia controllers, never by a static shell —
 * the real entry is the inertia-root Blade view, which resolves the hashed
 * client bundle from public/inertia/.vite/manifest.json. This file exists
 * only so a request for the bare /inertia directory still reaches Laravel's
 * front controller under `php artisan serve` (and under any web server whose
 * directory-index lands here): the built-in server serves a directory's
 * index.* instead of falling through to the router, and the app must boot
 * for the route to hit the controller. Generated by bin/sync-flavors.sh and
 * playground/Dockerfile.
 */

require __DIR__.'/../index.php';
PHP

echo "sync-flavors: all five flavors copied."
