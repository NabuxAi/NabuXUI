
<?php
    $fa = app()->getLocale() === 'fa';
    $say = fn (string $en, string $faText) => $fa ? $faText : $en;
    $num = fn (string $s): string => $fa
        ? strtr($s, ['0' => '۰', '1' => '۱', '2' => '۲', '3' => '۳', '4' => '۴', '5' => '۵', '6' => '۶', '7' => '۷', '8' => '۸', '9' => '۹'])
        : $s;
?>

<style>
    .cgl-root {
        --cgl-fg: #1c1917; --cgl-muted: #78716c; --cgl-border: #e7e5e4;
        --cgl-bg: #fafaf9; --cgl-accent: #4f46e5;
        --cgl-font: 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
        display: grid; gap: 1rem; font-family: var(--cgl-font); color: var(--cgl-fg);
    }
    html[data-theme="dark"] .cgl-root {
        --cgl-fg: #fafaf9; --cgl-muted: #a8a29e; --cgl-border: #292524;
        --cgl-bg: #1c1917; --cgl-accent: #a5b4fc;
    }
    @media (prefers-color-scheme: dark) {
        html:not([data-theme="light"]) .cgl-root {
            --cgl-fg: #fafaf9; --cgl-muted: #a8a29e; --cgl-border: #292524;
            --cgl-bg: #1c1917; --cgl-accent: #a5b4fc;
        }
    }
    .cgl-stage {
        display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr);
        gap: 1.1rem; align-items: center;
    }
    .cgl-card {
        position: relative; inline-size: min(100%, 24.5rem); aspect-ratio: 1.62 / 1;
        border-radius: 1.25rem; overflow: clip; cursor: pointer; outline: none;
        border: 1px solid rgba(255, 255, 255, .16);
        background: #0b1020;
        box-shadow: 0 24px 48px -24px rgba(2, 6, 23, .55);
        transform: perspective(950px) rotateX(var(--cgl-rx, 0deg)) rotateY(var(--cgl-ry, 0deg));
        --cgl-px: 0; --cgl-py: 0; --cgl-mx: 50%; --cgl-my: 42%;
        --cgl-rot: 105deg; --cgl-g: 0;
        container-type: inline-size; touch-action: manipulation;
    }
    .cgl-card:focus-visible {
        box-shadow: 0 0 0 2px var(--cgl-accent), 0 24px 48px -24px rgba(2, 6, 23, .55);
    }
    .cgl-art { position: absolute; inset: -6%; inline-size: 112%; block-size: 112%;
               transform: translate3d(calc(var(--cgl-px) * 10px), calc(var(--cgl-py) * 10px), 0); }
    .cgl-glare {
        position: absolute; inset: 0; pointer-events: none; opacity: var(--cgl-g);
        background: radial-gradient(46% 62% at var(--cgl-mx) var(--cgl-my),
                    rgba(255, 255, 255, .38), rgba(255, 255, 255, .06) 55%, transparent 72%);
        mix-blend-mode: soft-light;
    }
    .cgl-glare::before {
        content: ''; position: absolute; inset: -45%;
        background: linear-gradient(90deg, transparent 26%, rgba(255, 255, 255, .5) 48%,
                    rgba(255, 255, 255, .08) 56%, transparent 78%);
        transform: rotate(var(--cgl-rot)); filter: blur(2px);
    }
    .cgl-glare::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(24% 34% at var(--cgl-mx) var(--cgl-my), rgba(255, 255, 255, .55), transparent 70%);
        mix-blend-mode: overlay;
    }
    .cgl-meta {
        position: absolute; inset-block-start: 1rem; inset-inline: 1.15rem; z-index: 2;
        display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: .6rem;
        color: #e7ecff; transform: translate3d(calc(var(--cgl-px) * 22px), calc(var(--cgl-py) * 22px), 0);
    }
    .cgl-bank { display: grid; gap: .15rem; font-size: .68rem; letter-spacing: .1em;
                text-transform: uppercase; color: #aab6e0; }
    html[dir="rtl"] .cgl-bank { letter-spacing: 0; }
    .cgl-bank strong { font-size: .95rem; letter-spacing: 0; color: #f2f5ff; }
    .cgl-chip {
        inline-size: 2.5rem; aspect-ratio: 1.45; border-radius: .35rem;
        background: linear-gradient(135deg, #fde68a, #b45309 60%, #fbbf24);
    }
    .cgl-num {
        position: absolute; inset-block-start: 46%; inset-inline: 1.15rem; z-index: 2;
        font-size: clamp(.95rem, 4.6cqi, 1.22rem); font-weight: 600; letter-spacing: .12em;
        color: #f2f5ff; font-variant-numeric: tabular-nums; direction: ltr;
        transform: translate3d(calc(var(--cgl-px) * 22px), calc(var(--cgl-py) * 22px), 0);
    }
    html[dir="rtl"] .cgl-num { text-align: end; }
    .cgl-who {
        position: absolute; inset-block-end: 1rem; inset-inline: 1.15rem; z-index: 2;
        display: flex; align-items: flex-end; justify-content: space-between; gap: .8rem;
        color: #c7d0ee; transform: translate3d(calc(var(--cgl-px) * 22px), calc(var(--cgl-py) * 22px), 0);
    }
    .cgl-who small { display: block; font-size: .6rem; letter-spacing: .12em;
                     text-transform: uppercase; color: #8b96c2; }
    html[dir="rtl"] .cgl-who small { letter-spacing: 0; }
    .cgl-who b { font-size: .82rem; font-weight: 600; color: #eef2ff; }
    .cgl-btn {
        position: relative; z-index: 3; display: inline-flex; align-items: center; gap: .4rem;
        padding: .5rem .95rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .28);
        background: rgba(10, 14, 34, .55); color: #f2f5ff; cursor: pointer;
        font: 600 .74rem var(--cgl-font); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        transform: translate3d(calc(var(--cgl-px) * 34px), calc(var(--cgl-py) * 34px), 0);
        transition: background-color .18s ease, border-color .18s ease;
    }
    .cgl-btn:hover { background: rgba(79, 70, 229, .5); border-color: #a5b4fc; }
    .cgl-btn:focus-visible { outline: 2px solid #a5b4fc; outline-offset: 2px; }
    .cgl-btn svg { inline-size: .85rem; block-size: .85rem; stroke: currentColor; stroke-width: 2;
                   fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .cgl-aside {
        display: grid; gap: .55rem; align-content: center;
        padding: .9rem 1rem; border: 1px solid var(--cgl-border);
        border-radius: 1rem; background: var(--cgl-bg); margin: 0;
    }
    .cgl-aside dt { font-size: .66rem; letter-spacing: .07em; text-transform: uppercase;
                    color: var(--cgl-muted); }
    html[dir="rtl"] .cgl-aside dt { letter-spacing: 0; }
    .cgl-aside dd { margin: 0 0 .35rem; font-size: .84rem; font-weight: 600; }
    .cgl-aside dd .val { color: var(--cgl-accent); font-variant-numeric: tabular-nums; }
    .cgl-hint { margin: 0; font-size: .74rem; color: var(--cgl-muted); text-align: center; }
    @media (max-width: 640px) {
        .cgl-stage { grid-template-columns: 1fr; }
        .cgl-aside { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: .4rem .9rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        .cgl-card { transform: none; --cgl-g: .85; --cgl-mx: 30%; --cgl-my: 26%; --cgl-rot: 115deg; }
        .cgl-art, .cgl-meta, .cgl-num, .cgl-who, .cgl-btn { transform: none; }
    }
</style>

<section class="pg-box cgl-root" style="gap: 1rem"
    x-data="{
        raf: 0, io: null, t: 0, mq: null, visible: true, live: false,
        tx: .5, ty: .5, cx: .5, cy: .5,
        init() {
            this.mq = matchMedia('(prefers-reduced-motion: reduce)');
            this.io = new IntersectionObserver((entries) => {
                this.visible = entries[0].isIntersecting;
                if (!this.visible) { this.live = false; cancelAnimationFrame(this.raf); }
            }, { threshold: 0.05 });
            this.io.observe(this.$refs.card);
        },
        move(e) {
            if (this.mq.matches) return;
            const r = this.$refs.card.getBoundingClientRect();
            this.tx = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
            this.ty = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
            this.live = true; this.run();
        },
        pose() {
            if (this.mq.matches) return;
            this.tx = .68; this.ty = .32; this.live = true; this.run();
        },
        press() {
            if (this.mq.matches) return;
            this.tx = .74; this.ty = .28; this.live = true; this.run();
            clearTimeout(this.t);
            this.t = setTimeout(() => { this.tx = .5; this.ty = .5; this.live = false; this.run(); }, 620);
        },
        leave() { this.tx = .5; this.ty = .5; this.live = false; this.run(); },
        run() {
            cancelAnimationFrame(this.raf);
            if (!this.visible) return;
            const loop = () => {
                this.cx += (this.tx - this.cx) * .16;
                this.cy += (this.ty - this.cy) * .16;
                this.apply();
                const settling = Math.abs(this.tx - this.cx) + Math.abs(this.ty - this.cy) > .002;
                if (!this.live && !settling) { this.cx = this.tx; this.cy = this.ty; this.apply(); return; }
                this.raf = requestAnimationFrame(loop);
            };
            this.raf = requestAnimationFrame(loop);
        },
        apply() {
            const el = this.$refs.card;
            const px = this.cx - .5, py = this.cy - .5;
            const rot = Math.atan2(py, px) * 57.2958 + 90;
            el.style.setProperty('--cgl-rx', (py * -10).toFixed(2) + 'deg');
            el.style.setProperty('--cgl-ry', (px * 12).toFixed(2) + 'deg');
            el.style.setProperty('--cgl-px', px.toFixed(3));
            el.style.setProperty('--cgl-py', py.toFixed(3));
            el.style.setProperty('--cgl-mx', (this.cx * 100).toFixed(1) + '%');
            el.style.setProperty('--cgl-my', (this.cy * 100).toFixed(1) + '%');
            el.style.setProperty('--cgl-rot', rot.toFixed(1) + 'deg');
            el.style.setProperty('--cgl-g', (this.live || Math.abs(px) + Math.abs(py) > .01 ? 1 : 0));
        },
        destroy() {
            cancelAnimationFrame(this.raf);
            clearTimeout(this.t);
            if (this.io) this.io.disconnect();
        },
    }">
    <div>
        <h3 class="pg-title" style="font-size: var(--nx-text-xl)"><?php echo e($say('A card that catches the light', 'کارتی که نور را می‌گیرد')); ?></h3>
        <p style="margin: .25rem 0 0; color: var(--nx-text-muted)">
            <?php echo e($say('Move the pointer across the slab: the glare streak rotates to atan2 of your angle around the centre while the scene, the embossed label and the freeze button each drift a different distance toward your hand — a lerp loop that only runs while you are over the card or it is settling back. Focus tilts it into a posed angle; a tap sweeps the glare once.', 'نشانگر را روی کارت بچرخانید: نوار گلیر با atan2 زاویهٔ شما حول مرکز می‌چرخد و صحنه، برچسب حک‌شده و دکمهٔ انجماد هرکدام به فاصله‌ای متفاوت به سمت دست شما می‌لغزند — یک حلقهٔ lerp که فقط وقتی روی کارت هستید یا کارت دارد به جای خود برمی‌گردد اجرا می‌شود. فوکوس کارت را در زاویه‌ای نشسته می‌کند؛ یک تپ، گلیر را یک بار جارو می‌کند.')); ?>

        </p>
    </div>

    <div class="cgl-stage">
        <div class="cgl-card" x-ref="card" tabindex="0"
            role="group"
            x-bind:aria-label="<?php echo \Illuminate\Support\Js::from($say('Meridian Bank Horizon travel card', 'کارت سفر هورایزن بانک مریدین'))->toHtml() ?>"
            x-on:pointermove="move($event)"
            x-on:pointerleave="leave()"
            x-on:pointerdown="press()"
            x-on:focus="pose()"
            x-on:blur="leave()">
            <svg class="cgl-art" viewBox="0 0 400 250" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="cgl-sky" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#312e81"/>
                        <stop offset=".55" stop-color="#1e1b4b"/>
                        <stop offset="1" stop-color="#0b1020"/>
                    </linearGradient>
                    <linearGradient id="cgl-ridge" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#6366f1"/>
                        <stop offset="1" stop-color="#312e81"/>
                    </linearGradient>
                </defs>
                <rect width="400" height="250" fill="url(#cgl-sky)"/>
                <circle cx="322" cy="58" r="26" fill="#e0e7ff" opacity=".92"/>
                <circle cx="322" cy="58" r="38" fill="#a5b4fc" opacity=".25"/>
                <path d="M0 190 L84 118 L148 172 L216 108 L300 178 L360 140 L400 168 V250 H0 Z" fill="#1e1b4b"/>
                <path d="M0 214 L70 168 L150 206 L240 158 L330 200 L400 172 V250 H0 Z" fill="url(#cgl-ridge)" opacity=".85"/>
                <g fill="#e0e7ff" opacity=".8">
                    <circle cx="46" cy="40" r="1.4"/><circle cx="98" cy="26" r="1.1"/><circle cx="160" cy="46" r="1.3"/>
                    <circle cx="212" cy="22" r="1.1"/><circle cx="268" cy="42" r="1.4"/><circle cx="366" cy="30" r="1.2"/>
                </g>
            </svg>
            <div class="cgl-glare" aria-hidden="true"></div>

            <div class="cgl-meta">
                <div class="cgl-bank">
                    <strong><?php echo e($say('Meridian Bank', 'بانک مریدین')); ?></strong>
                    <span><?php echo e($say('Horizon · Travel', 'هورایزن · سفر')); ?></span>
                </div>
                <div class="cgl-chip" aria-hidden="true"></div>
            </div>

            <div class="cgl-num"><?php echo e($say('5312&nbsp;&nbsp;••••&nbsp;&nbsp;••••&nbsp;&nbsp;7890', '۵۳۱۲&nbsp;&nbsp;••••&nbsp;&nbsp;••••&nbsp;&nbsp;۷۸۹۰')); ?></div>

            <div class="cgl-who">
                <div>
                    <small><?php echo e($say('Card holder', 'دارندهٔ کارت')); ?></small>
                    <b><?php echo e($say('Alex Moreau', 'الکس مورو')); ?></b>
                </div>
                <div>
                    <small><?php echo e($say('Expires', 'انقضا')); ?></small>
                    <b><?php echo e($say('09/29', '۰۹/۲۹')); ?></b>
                </div>
                <button type="button" class="cgl-btn" x-on:pointerdown.stop x-on:pointermove.stop>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    <?php echo e($say('Freeze', 'انجماد')); ?>

                </button>
            </div>
        </div>

        <dl class="cgl-aside">
            <div>
                <dt><?php echo e($say('Glare angle', 'زاویهٔ گلیر')); ?></dt>
                <dd><span class="val">atan2 ±<?php echo e($num('90')); ?>°</span> — <?php echo e($say('streak follows the pointer', 'نوار دنبال نشانگر')); ?></dd>
            </div>
            <div>
                <dt><?php echo e($say('Depth layers', 'لایه‌های عمق')); ?></dt>
                <dd>
                    <?php echo e($say('scene', 'صحنه')); ?> <span class="val"><?php echo e($num('10')); ?>px</span> ·
                    <?php echo e($say('label', 'برچسب')); ?> <span class="val"><?php echo e($num('22')); ?>px</span> ·
                    <?php echo e($say('button', 'دکمه')); ?> <span class="val"><?php echo e($num('34')); ?>px</span>
                </dd>
            </div>
            <div>
                <dt><?php echo e($say('Tilt', 'شیب')); ?></dt>
                <dd><span class="val"><?php echo e($num('10')); ?>° × <?php echo e($num('12')); ?>°</span> — <?php echo e($say('perspective 950px', 'پرسپکتیو ۹۵۰px')); ?></dd>
            </div>
            <div>
                <dt><?php echo e($say('Loop', 'حلقه')); ?></dt>
                <dd><?php echo e($say('lerp .16 · parks off screen', 'lerp برابر ۰٫۱۶ · پارک خارج از دید')); ?></dd>
            </div>
        </dl>
    </div>

    <p class="cgl-hint">
        <?php echo e($say('hover or focus the card · tap sweeps the glare once · still sheen under reduced motion', 'هاور یا فوکوس روی کارت · یک تپ گلیر را جارو می‌کند · در حرکت کاهش‌یافته برق ثابت')); ?>

    </p>
