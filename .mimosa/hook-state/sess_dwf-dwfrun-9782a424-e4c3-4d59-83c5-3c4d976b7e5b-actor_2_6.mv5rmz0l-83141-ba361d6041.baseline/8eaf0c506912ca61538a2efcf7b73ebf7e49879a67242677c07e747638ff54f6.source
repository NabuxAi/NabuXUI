            sunset: ['#f97316', '#ec4899', '#8b5cf6'],
            ocean: ['#38bdf8', '#6366f1', '#0ea5e9'],
        },
        init() {
            this.io = new IntersectionObserver((entries) => {
                this.running = entries[0].isIntersecting;
            }, { threshold: 0.15 });
            this.io.observe(this.$refs.stage);
        },
        destroy() { if (this.io) this.io.disconnect(); },
    }">
