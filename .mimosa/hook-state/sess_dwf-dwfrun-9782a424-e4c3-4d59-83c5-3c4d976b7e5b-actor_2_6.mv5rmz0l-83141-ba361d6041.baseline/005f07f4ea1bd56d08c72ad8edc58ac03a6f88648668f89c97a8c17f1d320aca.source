await agent("معمار تجارت").ask(
  "هسته‌ی تجارت (هم‌ارزی ووکامرس) را در " + CMS + " روی لایه‌ی WP-parity موجود بساز. WP-parity قبلاً لند شده (comments/terms/options/wp-json) — روی آن بساز، فایل‌هایش را بازنویسی نکن.\n\n" +
  "طراحی:\n" +
  "1. migrations/0004_woo.sql: commerce_products(id, content_id FK NULLABLE UNIQUE, sku TEXT UNIQUE, title, slug UNIQUE, price_minor INTEGER, sale_price_minor INTEGER NULL, currency TEXT DEFAULT 'IRT', stock INTEGER NULL, stock_managed INTEGER DEFAULT 0, weight_grams INTEGER NULL, attributes TEXT(JSON) DEFAULT '{}', images TEXT(JSON) DEFAULT '[]', status TEXT DEFAULT 'publish', created_at, updated_at)؛ orders(id, number TEXT UNIQUE, status TEXT CHECK pending|processing|on-hold|completed|cancelled|refunded|failed, currency, subtotal_minor, discount_minor, shipping_minor, total_minor, coupon_code TEXT NULL, customer TEXT(JSON) {name,email,phone,address}, billing/shipping همان JSON، payment_method TEXT, payment_ref TEXT NULL, created_at, updated_at)؛ order_items(id, order_id FK, product_id FK, title_snapshot, unit_minor, quantity, total_minor)؛ coupons(id, code UNIQUE, kind percent|fixed_minor, value INTEGER, min_total_minor NULL, usage_limit NULL, used_count DEFAULT 0, active)؛ woo_api_keys(id, key_id TEXT UNIQUE, consumer_key_hash, consumer_secret_hash, scopes, created_at)؛ woo_webhooks(id, url, secret, topics TEXT(JSON), active). دسته‌ی محصول = همان terms با taxonomyهای product_cat/product_tag (seed کن) — رابطه از term_relationships با content یا مستقیم product؟ اگر product بدون content باشد نگاشت مستقیم: commerce_product_terms(product_id, term_id).\n" +
  "2. API داخلی /api/v1/commerce/*: GET products و products/:id عمومی (published) با فیلتر دسته/جستجو/صفحه‌بندی X-Total-Count؛ CRUD ادمین (write)؛ POST orders عمومی: سرور قیمت‌ها را از DB می‌گیرد (قیمت کلاینت هرگز معتبر نیست)، کوپن را اعمال و usage را atomic زیاد می‌کند، سفارش pending می‌سازد با number ترتیبی (مثل NBX-1001)، rate-limit per-IP مثل login؛ GET orders/:number عمومی فقط با email مطابق (lookup بدون لوث)؛ ادمین: لیست، PATCH status با ماشین وضعیت درست (completed→کم کردن stock اگر managed، refunded→برگشت stock و invalid کوپن استفاده)، ابطال کوپن.\n" +
  "3. درگاه پرداخت: صفت/مدل ساده — POST payments/:gateway/callback با HMAC (secret از options) برای تایید بیرونی؛ داخلی: 'cod' و 'bank-transfer' (آفلاین) از روز اول.\n" +
  "4. نظرات محصول = همان comments روی content مرتبط؛ اگر product بدون content، endpoint نمایش reviews از comments با نگاشت دستی فعلاً ممنوع — مستند کن.\n" +
  "5. تست‌ها: چرخه‌ی کامل (محصول→سفارش با قیمت سرور→کوپن→completed→stock کم شد→refunded→stock برگشت)، دسته‌بندی، عمومی/ادمین visibility، rate-limit، ماشین وضعیت (انتقال غیرمجاز 400).\n" + RULES,
);
const wooOk = await gate("هسته-تجارت", "cargo", ["test", "--manifest-path", CMS + "/Cargo.toml"], 900000, "تست‌های هسته تجارت را سبز کن — سازگار با لایه WP موجود.");

