/* ═══ فاز ۵: وب‌هوک ووکامرس + ایمپورت CSV ═══ */
phase("وب‌هوک‌ها و ایمپورت ووکامرس");
report({ module: "وب‌هوک-و-ایمپورت", stage: "در ساخت" });
await agent("معمار وب‌هوک").ask(
  "خروجی رویداد و ایمپورت را در " + CMS + " کامل کن.\n\n" +
  "1. وب‌هوک‌های ووکامرسی: CRUD ادمین /wp-json/wc/v3/webhooks (topic مثل order.created, product.updated)؛ رویدادها (order.created/updated، product.created/updated، coupon.used) بعد از هر mutation با ارسال POST به URL ثبت‌شده + امضای X-WC-Webhook-Signature = base64(HMAC-SHA256(body, secret)) — دقیقاً مثل ووکامرس؛ تحویل async (tokio spawn، تلاش دوباره تا ۳ بار با backoff)؛ گارد SSRF: URL باید https و NOT آی‌پی خصوصی/loopback (resolve نکن — فقط بررسی متنی URL و رنج آی‌پی literal)؛ لاگ نتیجه در جدول کوچک webhook_deliveries.\n" +
  "2. همین رویدادها روی باس هوک داخلی هم emit شوند (commerce.catalog namespace موجود) تا افزونه‌های native هم بگیرند.\n" +
  "3. ایمپورت CSV محصولات ووکامرس: CLI `nabux-cms import-woo-csv <file>` + POST /api/v1/import/woo-csv (ادمین، multipart): ستون‌های استاندارد خروجی ووکامرس (ID, Type, SKU, Name, Published, Regular price, Sale price, Stock, Categories (comma list), Images, Attribute 1 name/value…) → upsert با SKU؛ گزارش شمارش درج/بروزرسانی/رد.\n" +
  "4. fixtures/tests/fixtures/woo-products.csv نمونه (۵ ردیف، فارسی) + تست: ایمپورت → محصولات با دسته‌ها و تصویر قابل GET، اجرای دوباره idempotent، وب‌هوک order.created امضا درست دارد (بادی و secret ثابت تست)، رد SSRF به http://127.0.0.1.\n" + RULES,
);
const hookOk = await gate("وب‌هوک-و-ایمپورت", "cargo", ["test", "--manifest-path", CMS + "/Cargo.toml"], 900000, "تست‌های وب‌هوک/ایمپورت را سبز کن.");

/* ═══ فاز ۶: اتصال فروشگاه به هسته‌ی زنده ═══ */
phase("اتصال فروشگاه به هسته");
report({ module: "اتصال", stage: "در ساخت" });
await agent("اتصال‌دهنده").ask(
  "فروشگاه " + WEB + " را به هسته‌ی تجارت وصل کن (همان قراردادی که در src/lib/commerce.ts گذاشتی).\n\n" +
  "1. src/lib/commerce.ts: وقتی CMS_URL ست است، محصولات از GET /api/v1/commerce/products (عمومی) می‌آیند (با همان نرمالایز کالکشن‌ها: data→Product)؛ بدون CMS_URL همان کالکشن‌های SSG؛ سفارش: POST به CMS_URL/api/v1/commerce/orders با بادی از توابع خالص موجود؛ پاسخ {number,total} در UI (صفحه‌ی تایید با شماره سفارش بلوک invoice سبک)؛ خطا→ پیام فارسی روشن.\n" +
  "2. صفحه‌ی وضعیت سفارش: /[locale]/order/[number]?email= — GET عمومی هسته با تطابق ایمیل؛ نمایش وضعیت با چیپ‌های nx (پردازش/تکمیل/مرجوع…).\n" +
  "3. checkout به کانکتور commerce در submit.ts هم وصل بماند (فرم تماس مستقل از سفارش).\n" +
  "4. تست: ماک fetch در سطح ماژول (بدون شبکه) برای هر دو مسیر live/fallback؛ تست dist: صفحه‌ی فروشگاه با CMS_URL غایب از کالکشن‌ها می‌آید.\n" + RULES,
);
const wireOk = await gate("اتصال", "pnpm", ["--dir", WEB, "build"], 600000, "بیلد اتصال را سبز کن.");
if (wireOk) await gate("اتصال", "pnpm", ["--dir", WEB, "test"], 300000, "تست‌های اتصال را سبز کن.");

/* ═══ فاز ۷: بازبینی مستقل و رفع ═══ */
phase("بازبینی مستقل تجارت");
const reviewer = agent("بازبین مستقل تجارت", {
  system:
    "بازبین امنیت تجارت هستی با چشم تازه؛ هیچ فایلی را ویرایش نمی‌کنی. یافته با مسیر و شاهد؛ چیزی را که بررسی نکردی گزارش نکن. فارسی پاسخ بده.",
});
const reviewRaw: unknown = await reviewer.ask(
  "کل لایه‌ی تجارت را در " + CMS + " (commerce، wc/v3، وب‌هوک‌ها، ایمپورت) و اتصال " + WEB + " را بخوان و با به‌خطرترین سناریوها بسنج:\n" +
  "- قیمت/موجودی فقط از سمت سرور؟ هر مسیر تزریق قیمت کلاینت؟\n" +
  "- کوپن: race condition روی used_count؟ محدودیت минیمم سفارش؟ brute-force کد؟\n" +
  "- سفارش: spam/rate-limit؟ لوث‌شدن اطلاعات سفارش بیگانه از طریق order lookup با ایمیل؟\n" +
  "- کلیدهای ck_/cs_: مقایسه timing-safe؟ نشت در لاگ/پاسخ؟ scope واقعی دارد؟\n" +
  "- وب‌هوک: SSRF گارد واقعی؟ امضا درست HMAC؟ replay؟\n" +
  "- ماشین وضعیت سفارش: انتقال‌های ممنوع واقعاً 400؟ stock دوبار کم نشد؟\n" +
  "- فساد wc/v3: بدون احراز همه‌چیز 401 ووکامرسی درست؟\n" +
  "- تست‌ها assertion واقعی؟\n" +
  "فقط یافته‌های واقعی؛ سلیقه سبک را low یا حذف.",
);
function asFindings(raw: unknown): ReviewFinding[] | null {
  if (Array.isArray(raw)) return raw as ReviewFinding[];
  if (typeof raw === "string") {
    const m = /\[[\s\S]*\]/.exec(raw);
    if (m && m[0]) {
      try {
        const parsed: unknown = JSON.parse(m[0]);
        if (Array.isArray(parsed)) return parsed as ReviewFinding[];
      } catch { /* نه JSON */ }
    }
  }
  return null;
}
let findings: ReviewFinding[] = asFindings(reviewRaw) ?? [];
if (findings.length === 0 && !Array.isArray(reviewRaw)) {
  const retryRaw: unknown = await reviewer.ask(
    "پاسخ قبلی آرایه نبود. فقط و فقط آرایه‌ی JSON با کلیدهای where, what, severity (low|medium|high), fix_hint برگردان؛ بدون متن اضافه؛ نبود یافته = []",
  );
  findings = asFindings(retryRaw) ?? [];
}
log(`بازبینی تجارت: ${findings.length} یافته`);
const heavy = findings.filter((f) => f.severity !== "low");
if (heavy.length > 0) {
  await fixer.ask(
    "این یافته‌های تجاری متوسط/بالا را ریشه‌ای حل کن (ریپو در خود یافته آمده):\n" + JSON.stringify(heavy, null, 2) + "\n" + RULES,
  );
  const t1 = await world.run("cargo", ["test", "--manifest-path", CMS + "/Cargo.toml"], { timeoutMs: 900000 });
  const t2 = await world.run("pnpm", ["--dir", WEB, "build"], { timeoutMs: 600000 });
  log(`بازگیت: cargo=${t1.exitCode === 0 ? "پاس" : "شکست"} pnpm=${t2.exitCode === 0 ? "پاس" : "شکست"}`);
}

/* ═══ فاز ۸: تحویل ═══ */
phase("تحویل و کامیت");
await world.run("git", ["-C", CMS, "add", "-A"]);
const c1 = await world.run("git", ["-C", CMS, "commit", "-m", "commerce: هسته‌ی ووکامرس — محصولات/سفارش/کوپن/درگاه + فساد wc/v3 و Store API + وب‌هوک‌های امضادار + ایمپورت CSV"]);
await world.run("git", ["-C", WEB, "add", "-A"]);
const c2 = await world.run("git", ["-C", WEB, "commit", "-m", "storefront: فروشگاه + سبد + تسویه روی بلوک‌های NabuXUI و اتصال به هسته تجارت"]);
log(`کامیت‌ها: cms=${c1.exitCode === 0 ? "زده شد" : "چیزی نبود/ناموفق"} web=${c2.exitCode === 0 ? "زده شد" : "چیزی نبود/ناموفق"}`);

await artifact.markdown("report", [
  "# ووکامرس کامل + فروشگاه — گزارش",
  "",
  "- فروشگاه (shop/product/cart/checkout/order در fa/en/ar): " + (shopOk ? "پاس" : "شکست"),
  "- هسته‌ی تجارت (محصولات/سفارش/کوپن/درگاه/stock): " + (wooOk ? "پاس" : "شکست"),
  "- فساد wc/v3 + Store API: " + (wcOk ? "پاس" : "شکست"),
  "- وب‌هوک‌های امضادار + ایمپورت CSV: " + (hookOk ? "پاس" : "شکست"),
  "- اتصال زنده‌ی فروشگاه: " + (wireOk ? "پاس" : "شکست"),
  "",
  "## یافته‌های بازبین",
  ...(findings.length === 0 ? ["- یافته‌ای نبود."] : findings.map((f) => "- **" + f.severity + "** · `" + f.where + "` — " + f.what)),
].join("\n"), { title: "گزارش ووکامرس و فروشگاه", description: "هم‌ارزی ووکامرس در nabux-cms + فروشگاه nabux-web", primary: true });

return {
  conclusion:
    "لایه‌ی تجارت کامل شد: هسته‌ی ووکامرس (محصولات با SKU/قیمت minor/انباری، سفارش با ماشین وضعیت و کسر/بازگشت انبار، کوپن، درگاه‌های cod/bank-transfer + callback امضادار)، فساد کامل wc/v3 و Store API با احراز ck/cs، وب‌هوک‌های ووکامرسی با امضای X-WC-Webhook-Signature، ایمپورت CSV محصولات، و فروشگاه سه‌زبانه روی بلوک‌های NabuXUI که بدون هسته از SSG و با هسته از API زنده می‌آید. کامیت‌ها: cms=" + (c1.exitCode === 0 ? "زده شد" : "ناموفق") + " web=" + (c2.exitCode === 0 ? "زده شد" : "ناموفق") + ".",
  findings,
  verified: [
    "cargo test بعد از هر فاز هسته (تجارت، فساد، وب‌هوک/ایمپورت)",
    "pnpm build + test برای فروشگاه و اتصال",
    "بازبینی مستقل امنیت تجارت + بازگیت پس از رفع",
  ],
  notCovered: [
    "اجرای افزونه‌های PHP ووکامرس — طبق معماری، ادغام از طریق wc/v3 + وب‌هوک + ایمپورت است نه مفسر PHP",
    "درگاه‌های پرداخت واقعی (ایرانی/بین‌المللی) — قرارداد callback HMAC آماده؛ اتصال هر درگاه کار جداگانه",
    "استقرار — دیپلوی سرخط جداگانه انجام می‌شود",
  ],
};