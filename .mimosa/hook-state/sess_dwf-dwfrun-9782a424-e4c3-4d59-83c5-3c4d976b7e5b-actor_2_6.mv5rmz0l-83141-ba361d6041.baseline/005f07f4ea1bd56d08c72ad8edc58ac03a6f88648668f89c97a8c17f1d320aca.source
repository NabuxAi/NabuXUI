interface ReviewFinding {
  /** مسیر فایل (با شماره خط اگر مربوط است). */
  where: string;
  /** یک جمله: مشکل چیست. */
  what: string;
  /** شدت؛ high فقط برای از دست رفتن داده یا رخنه امنیتی واقعی. */
  severity: "low" | "medium" | "high";
  /** راهنمای کوتاه اصلاح. */
  fix_hint: string;
}

const CMS = "/Users/mrchatgpt/Sites/nabux-cms";
const WEB = "/Users/mrchatgpt/Sites/nabux-web";
const NX = "/Users/mrchatgpt/Sites/NabuXUI";

const RULES = [
  "قوانین مشترک:",
  "- فقط در ریپوی مأموریتت بنویس؛ خواندن " + NX + " آزاد؛ ریپوی دیگر را دست نزن.",
  "- اول CONVENTIONS.md ریپو را بخوان و پیروی کن.",
  "- تست‌ها قطعی: بدون شبکه/زمان واقعی/ترتیب. cargo test و pnpm test را خودت اجرا نکن — گردش کار گیت می‌گذارد (cargo check و pnpm build مجاز).",
  "- SQL همیشه پارامتری؛ رمز/توکن در لاگ ممنوع؛ خطاها با شکل قراردادی ریپو.",
  "- پاسخ نهایی فارسی و مختصر: چه ساخت، چه تستی، انحراف‌ها.",
].join("\n");

const fixer = agent("تعمیرکار", {
  system:
    "مهندس ارشد Rust/TypeScript هستی. خطا را از ریشه حل می‌کنی، نه با تضعیف تست یا دور زدن گیت. اگر گیت صادقانه ممکن نیست، صریح بنویس و اسکیلیت کن. فارسی و مختصر.",
});

artifact.board("modules", {
  key: "module",
  status: "stage",
  columns: ["در صف", "در ساخت", "گیت", "آماده"],
  cardTitle: "module",
});

for (const m of ["فروشگاه", "هسته-تجارت", "فساد-wc", "وب‌هوک-و-ایمپورت", "اتصال", "بازبینی"]) {
  report({ module: m, stage: "در صف" });
}

/* The command name must be a literal at each world.run call site. */
async function gateRaw(cmd: "cargo" | "pnpm", args: string[], timeoutMs: number): Promise<{ exitCode: number; stderr: string; stdout: string }> {
  if (cmd === "cargo") return world.run("cargo", args, { timeoutMs });
  return world.run("pnpm", args, { timeoutMs });
}

async function gate(label: string, cmd: "cargo" | "pnpm", cmdArgs: string[], timeoutMs: number, hint: string): Promise<boolean> {
  report({ module: label, stage: "گیت" });
  for (let round = 1; round <= 3; round++) {
    const r = await gateRaw(cmd, cmdArgs, timeoutMs);
    if (r.exitCode === 0) {
      log(`${label}: گیت پاس${round > 1 ? " (راند " + round + ")" : ""}`);
      report({ module: label, stage: "آماده" });
      return true;
    }
    log(`${label}: شکست — راند ${round} از ۳`);
    await fixer.ask(
      `گیت «${label}» (${cmd} ${cmdArgs.join(" ")}) شکست خورد (راند ${round} از 3). ریپوی مربوطه: ` +
      (cmd === "cargo" ? CMS : WEB) + "\n" +
      (r.stderr || r.stdout).slice(-4000) + "\n\n" + hint + "\n" + RULES,
    );
  }
  log(`${label}: پس از ۳ راند نگرفت`);
  return false;
}

/* ═══ فاز ۱: فروشگاه روی بلوک‌های NabuXUI (nabux-web) ═══ */
phase("فروشگاه روی بلوک‌ها");
report({ module: "فروشگاه", stage: "در ساخت" });
await agent("معمار فروشگاه").ask(
  "ویترین فروشگاه را در " + WEB + " بساز — با تمام بلوک‌های NabuXUI، سه زبان fa/en/ar، RTL-first.\n\n" +
  "از این به بعد دامنه‌ی تجارتِ خانواده همین فروشگاه است؛ داده‌ها بعداً از هسته می‌آید (فاز اتصال) ولی از امروز قرارداد را درست بنداز.\n\n" +
  "کارها:\n" +
  "1. src/lib/commerce.ts: تایپ‌های Product (id, slug, title, price, salePrice?, currency, images[], stock, categories[], attributes{}) و Cart (آیتم‌ها در localStorage با کلید nx-cart) + توابع خالص: جمع سبد، اعتبار کوپن (خالص محلی فعلاً)، ساخت بادی سفارش {items:[{product_id, quantity}], coupon?, customer{...}}.\n" +
  "2. صفحات: /[locale]/shop گرید محصولات با کارت‌های شیشه‌ای + product-card بلوک‌ها + چیپ دسته؛ /[locale]/shop/[slug] صفحه‌ی محصول (گالری، قیمت با nx-number رولینگ، ویژگی‌ها چیپ، دکمه‌ی افزودن به سبد nx-button data-status morph، محصولات مرتبط)؛ /[locale]/cart سبد (بصری از localStorage، فقط یک اسکریپت کوچک، بدون فریمورک)؛ /[locale]/checkout فرم (مشخصات + ارسال + درگاه بعداً) که POST /api/submit/commerce یا endpoint تجارت را می‌خواند — فعلاً به src/lib/commerce.ts::submitOrder که اگر COMMERCE_URL نبود خطای صریح بدهد.\n" +
  "3. دیتای نمونه: src/content/products/ (۶ محصول واقعی‌نما فارسی/انگلیسی — از خانواده نبکس الهام بگیر) + نگاشت در source.ts.\n" +
  "4. سبد یک اسکریپت کوچک vanilla در nx-behaviours استایل (≤۱۲۰ خط) — React جزیره نزن.\n" +
  "5. تست‌ها: توابع commerce.ts (جمع/کوپن/بادی)، تست dist: /fa/shop رندر شده و کارت محصول و قیمت دارد.\n" + RULES,
);
const shopOk = await gate("فروشگاه", "pnpm", ["--dir", WEB, "build"], 600000, "بیلد فروشگاه را سبز کن.");
if (shopOk) await gate("فروشگاه", "pnpm", ["--dir", WEB, "test"], 300000, "تست‌های فروشگاه را سبز کن.");

/* ═══ فاز ۲: صبر برای اتمام کار WP-parity روی هسته ═══ */
phase("هماهنگی با لایه‌ی وردپرس روی هسته");
let wpReady = false;
for (let i = 1; i <= 25; i++) {
  const wpFile = await world.run("ls", [CMS + "/migrations/0003_wp.sql"]);
  const st = await world.run("git", ["-C", CMS, "status", "--porcelain"]);
  if (wpFile.exitCode === 0 && st.stdout.trim().length === 0) { wpReady = true; log("لایه‌ی وردپرس آماده (درخت تمیز)"); break; }
  log(`هسته هنوز مشغول (تلاش ${i} از ۲۵) — ۱۲۰ ثانیه صبر`);
  await world.run("sleep", ["120"]);
}
if (!wpReady) log("هشدار: پس از ۵۰ دقیقه درخت هسته هنوز تمیز نشد — فاز تجارت با هماهنگی متن ادامه می‌دهد");

/* ═══ فاز ۳: هسته‌ی تجارت (ووکامرس) در nabux-cms ═══ */
phase("هسته‌ی تجارت ووکامرس");
