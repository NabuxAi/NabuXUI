<?php endif; ?>
<?php $component->withAttributes(['x-ref' => 'count','value' => \Illuminate\View\Compilers\BladeCompiler::sanitizeComponentAttribute($unread),'locale' => \Illuminate\View\Compilers\BladeCompiler::sanitizeComponentAttribute($locale),'reveal' => \Illuminate\View\Compilers\BladeCompiler::sanitizeComponentAttribute(false),'wire:ignore' => true]); ?>
