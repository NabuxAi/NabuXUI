interface Proposal {
  /** اسلاگ kebab-case یکتا در گروه */
  slug: string;
  titleFa: string;
  titleEn: string;
  oneLinerFa: string;
  oneLinerEn: string;
}
interface ResearchOut {
  system: string;
  elements: Proposal[];
}
interface PhaseResult {
  files: string[];
  slugs: string[];
  ok: boolean;
  notes: string;
}
interface VerifyFinding {
  what: string;
  evidence: string;
  severity: "low" | "medium" | "high";
}
interface JudgeVerdict {
  shot: string;
  pass: boolean;
  issues: string;
}
interface WorkflowReport {
  conclusion: string;
  findings: VerifyFinding[];
  verified: string[];
  notCovered: string[];
}

artifact.table("issues", {
  title: "موارد باز سیستم‌های طراحی",
  description: "خطاهای HTTP باقی‌مانده و ایرادهای داوری بصری.",
  columns: [
    { field: "what", label: "مورد" },
    { field: "evidence", label: "شاهد" },
    { field: "severity", label: "شدت" },
  ],
  key: "what",
});

/** چیزهایی که همین حالا داریم — پیشنهادها نباید تکراری باشند. */
const INVENTORY = [
  "actions: border-button, fill-button, flip-button, metal-button, blob-button, transaction-button, file-drop, interests-picker, label-creator, pixel-loader, parametric-loader",
  "agent: thinking-trace, streaming-text, tool-call, approval-card, thinking-orbs, code-block, diff-viewer, json-viewer, terminal",
  "android: buttons, fab, chips, selection, slider, cards, bottom-sheet, navigation-bar, app-bar, snackbar, dialog, search, progress, dynamic-color, home-screen",
  "base: button, input, textarea, select, checkbox, switch, radio-group, slider, field, icon, card, dialog, drawer, popover, tooltip, tabs, accordion, avatar, avatar-group, badge, chip, status-badge, progress, progress-ring, spinner, skeleton, toaster, alert, breadcrumbs, pagination, steps, kbd, divider, header, nav-menu, mobile-menu, segmented, sparkline, stat-card, empty-state",
  "cards: stacked-scroll-cards, ring-carousel, expandable-stack, orbit-showcase, team-cards, depth-carousel, cycle-stack, elastic-grid, workflow-card, feature-card, pit-slider, precision-slider, infinite-grid, invoice, product-card, order-tracking, profile-card, wizard",
  "charts-plus: stacked-area, stacked-bar, composed-chart, brush-chart, forecast-line, radar-chart, radial-bar, chart-loading",
  "data: multi-select, status-badge, data-table, heatmap, metric-chart, bar-chart, analytics-card, dot-matrix-chart, donut-chart, usage-card, currency-converter, workspace-shell, branch-connector, curved-timeline, comparison-table, support-agent-card, kanban, calendar, timeline-feed, file-manager, email, todo, gantt, gauge, tree-view",
  "effects: border-beam, goo-stack, glitch-text, typewriter, resizable-panels, scroll-progress, auto-height, dynamic-island, spotlight-tour, image-reveal",
  "glass: glass-panel, glass-button, glass-segmented, glass-dock, glass-tab-bar, glass-switch, glass-slider, reading-glass, liquid-ripple",
  "interact: hold-to-confirm, slide-to-confirm, inline-edit, odometer, undo-snackbar, sortable-list, lightbox, compare-slider, swipe-actions, password-strength, pull-cord",
  "ios: controls, tab-bar, nav-bar, search-field, sheet, alert, context-menu, picker, widgets, progress, liquid-glass, home-screen",
  "macos: window, menu-bar, dock, controls, sidebar, sheet-alert, popover, widgets, spotlight, notifications, desktop",
  "menus: admin-shell, admin-sidebar, admin-topbar, fold-menu, mega-menu, stack-menu, morph-menu, stacked-accordion, morph-tabs, dock-panels, activity-dropdown, member-selector, chain-selector, language-menu, theme-switch, promo-bar, chip-filter, sort-pill, stat-strip, audio-room, voice-recorder, registration-card",
  "pickers: combobox, tag-input, context-menu, hover-card, bottom-sheet, date-range-picker, time-picker, number-field, gradient-studio",
  "text: text-hero, roll-text, hover-reveal, scroll-text-reveal, scroll-scramble, pulse-button, backdrop, dither-backdrop",
  "windows: window-chrome, acrylic-mica, buttons, selection, command-bar, navigation-view, tab-view, dialogs, progress, expander, desktop",
].join("\n");

const SYSTEMS = [
  {
    id: "carbon",
    name: "IBM Carbon",
    labelFa: "آی‌بی‌ام — کربن",
    hints: "پالت آبی‌خاکستری (#0f62fe آبی کربن، سطوح #f4f4f4/#161616)، گوشه‌های تخت (بدون گردی)، تایپ IBM Plex، شبکهٔ ۲rem، آیکن‌های خطی هندسی. المان‌های شاخص: Data Table با toolbar و batch actions، UI Shell (سربرگ تیره + ساید‌ناو)، Tile (clickable/selectable)، Structured List، Inline Notification، Progress Indicator پله‌ای، Tagهای رنگی دسته‌بندی، Tabs با indicator خطی، Combo Button.",
    docs: "https://carbondesignsystem.com",
  },
  {
    id: "polaris",
    name: "Shopify Polaris",
    labelFa: "شاپیفای — پولاریس",
    hints: "پالت سبز شاپیفای (#008060)، سطوح خاکستری سرد روشن، گردی ۸-۱۲px، تایپ Inter-مانند، سایه‌های خیلی نرم. المان‌های شاخص: Index Table با bulk select و pagination، Resource List با media و actions، Filters bar با chips، Banner (informational/success/critical)، Setting Toggle (کارت خاموش/روشن با توضیح)، Page header (title + primary action + breadcrumbs)، Sectioned Card، Empty State با CTA.",
    docs: "https://polaris.shopify.com",
  },
  {
    id: "atlassian",
    name: "Atlassian Design System",
    labelFa: "اطلس‌آثار (اطلس‌سین)",
    hints: "پالت آبی اطلسیان (#0052CC / B40000 قرمز)، سطوح خنثی، گردی ۳-۶px، تایپ Charlie/Inter. المان‌های شاخص: Page Header (تیتر + اکشن‌ها + تب‌ها)، Lozenge (برچسب وضعیت نیم‌گرد)، Section Message (پیام با آیکن و اکشن، چهار شدت)، Flag (توست با آیکن مربعی رنگی)، Inline Message (خطی داخل محتوا)، Spotlight (روشنایی مودال روی هدف آنبوردینگ)، Side Navigation (آیتم‌ها با پیشوند آیکن مربعی)، Empty State با تصویر خطی.",
    docs: "https://atlassian.design",
  },
  {
    id: "lightning",
    name: "Salesforce Lightning",
    labelFa: "سیلزفورس — لایتنینگ",
    hints: "پالت اقیانوسی (#0176D3 آبی، #04844B سبز)، سطوح #f3f3f3/#FFFFFF، گردی 0.25rem، خطوط جداکنندهٔ پررنگ‌تر، تایپ SalesForce Sans-مانند. المان‌های شاخص: Path (نوار افقی مراحل فروش با رنگ‌های مارکتینگ)، Record Home (سربرگ رکورد با آیکن + Highlights panel)، Related List (لیست مرتبط با سربرگ آیکن‌دار)، Docked Utility Bar (نوار ابزار چسبیده پایین با پنل‌ها)، Welcome Mat (آنبوردینگ چک‌لیستی با تصویر)، Scoped Tabs (تب‌های رنگی رکورد)، Pill Container (pillهای حذف‌شدنی).",
    docs: "https://www.lightningdesignsystem.com",
  },
  {
    id: "primer",
    name: "GitHub Primer",
    labelFa: "گیت‌هاب — پرایمر",
    hints: "پالت خاکستری + سبز success (#1A7F37)، بنفش done (#8250DF)، قرمز closed، گردی 6px، خطوط جداکنندهٔ مو، حالت‌های open/closed/merged با آیکن‌های دایره‌ای. المان‌های شاخص: Issue List (ردیف‌های عنوان + متا + لیبل‌ها)، State Labels (Open/Closed/Merged با آیکن)، Label Chips (رنگی با حاشیه)، PR Timeline Items (خط عمودی + آیکن‌های رویداد)، Reaction Bar (😃🚀eyes با شمارنده), Filter/Action Bar (جست‌وجو + لیبل‌ها + مرتب‌سازی)، File Tree سایدبار، Counter Badge.",
    docs: "https://primer.style",
  },
];

phase("کشف شکاف‌ها در پنج سیستم طراحی");
const proposals = await Promise.all(
  SYSTEMS.map((s) =>
    agent(`پژوهشگر-${s.id}`, {
      system:
        "تو پژوهشگر سیستم‌های طراحی هستی. با WebSearch سرچ کن، ولی خروجی نهایی را از دانش خودت + سرچ ترکیب کن: ۹ المانِ شاخص و قابل‌تشخیصِ «" + s.name + "» که در فهرست موجود ما نباشند. اسلاگ‌ها kebab-case و کوتاه.",
    }).ask<ResearchOut>(
      `سیستم هدف: ${s.name} — امضای بصری: ${s.hints}\nمستندات: ${s.docs}\n\nفهرست چیزی که همین حالا داریم (پیشنهادت نباید معادل این‌ها باشد):\n${INVENTORY}\n\n` +
        `۹ المان انتخاب کن که: (۱) بلافاصله «فلان سیستم» را لو بدهد، (۲) در فهرست بالا نباشد یا نسخهٔ سیستمیِ کاملاً متفاوتی داشته باشد، (۳) هرکدام در یک دموی تک‌صفحه‌ای web (HTML/CSS/Alpine) قابل بازسازی باشد — بدون بک‌اند.\n` +
        `خروجی فقط JSON: {system: "${s.id}", elements: [{slug, titleFa, titleEn, oneLinerFa, oneLinerEn}]} — oneLinerها ۱-۲ جملهٔ فروشنده مثل موج قبلی.`,
    ),
  ),
);

phase("ساخت پنج گروه دمو");
const builders = await Promise.all(
  SYSTEMS.map((s, i) => {
    const group = s.id;
    const elements = proposals[i].elements;
    return agent(`سازنده-${group}`, {
      system:
        "تو سازندهٔ گروه‌های دموی کتابخانه در این ریپو هستی (الگوی موج پیشین: گروه‌های android/ios/windows/macos). dev server روی http://127.0.0.1:8765 بالاست — رستارت نکن. مدخل‌ها و پارشال‌ها را می‌نویسی و تا هر صفحه ۲۰۰ ندهد ول نمی‌کنی.",
    }).ask<PhaseResult>(
      [
        `گروه تازهٔ «${s.name}» برای کاتالوگ /components با ${elements.length} دمو. الگوها را بخوان:`,
        `- مانیفست: playground/app/Support/Demos/Android.php (شکل مدخل: title/oneLiner/js/docs/icon/props/code + __group) — فایل تو: playground/app/Support/Demos/${s.id.charAt(0).toUpperCase() + s.id.slice(1)}.php که id گروهش «${group}» می‌شود؛ __group: ${JSON.stringify(s.labelFa)} / en: ${s.name}.`,
        `- پارشال: playground/resources/views/demos/components/android/buttons.blade.php و glass/glass-dock.blade.php (کالبد $fa/$say، استایل اسکوپ با پیشوند یکتا، آینهٔ تیره دو بار: html[data-theme=dark] + prefers-color-scheme با html:not([data-theme=light])، prefers-reduced-motion).`,
        `- آیکن‌های مجاز (۵۶ آیکن هسته): check, x, plus, minus, chevron-down, chevron-up, chevron-right, chevron-left, arrow-right, arrow-left, arrow-up, trend-up, trend-down, external-link, search, copy, heart, star, sun, moon, info, check-circle, alert-circle, alert-triangle, upload, file, paperclip, mic, stop, play, pause, menu, sparkles, globe, home, sliders, user, users, bell, trash, edit, grid, chart, zap, shield, layers, message, lock, mail, command, cpu, wand, settings, folder, music, image.`,
        "",
        `امضای بصری سیستم (وفادار بساز): ${s.hints}`,
        `المان‌ها (دقیقاً همین اسلاگ‌ها): ${JSON.stringify(elements)}`,
        "",
        "قواعد سخت:",
        "- هر دمو = مدخل مانیفست + پارشال demos/components/" + group + "/<slug>.blade.php؛ هر پارشال ۱-۲ سناریوی تعاملی واقعی + ردیف گونه‌ها؛ بدون lorem ipsum، متن محصولی معقول فارسی/انگلیسی با $say؛ اعداد فارسی در رشته‌های fa.",
        "- RTL با ویژگی‌های منطقی؛ موبایل ۳۷۵px سرریز ندهد؛ بدون position: fixed؛ بدون wire: (تعامل فقط Alpine داخلی پارشال)؛ هرگز data-nx-reveal به این صفحات اضافه نکن (با مورف Livewire محتوا برای همیشه غیب می‌شود).",
        "- هرگز «{{» داخل بلوک <style> ننویس؛ @media/@keyframes مجاز است.",
        "- docs هر مدخل = لینک رسمی همین المان در مستندات سیستم (" + s.docs + ").",
        "- بعد از هر فایل: curl -s -o /dev/null -w %{http_code} صفحهٔ دمو باید ۲۰۰ بدهد (500 = خطای Blade، درستش کن).",
        "خروجی {files, slugs, ok, notes} به فارسی — slugs دقیقاً همان اسلاگ‌های مانیفست.",
      ].join("\n"),
    );
  }),
);

phase("پویش HTTP و اصلاح");
const allPages: { group: string; slug: string }[] = builders.flatMap((b, i) =>
  b.slugs.map((slug) => ({ group: SYSTEMS[i].id, slug })),
);
log(`پویش ${allPages.length} دموی تازه`);
let broken: { group: string; slug: string; code: string }[] = [];
for (const it of allPages) {
  const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", `http://127.0.0.1:8765/components/${it.group}/${it.slug}`]);
  const code = r.stdout.trim();
  if (code !== "200") {
    broken.push({ group: it.group, slug: it.slug, code });
    report({ what: `${it.group}/${it.slug} کد ${code}`, evidence: `curl → ${code}`, severity: "high" }, "issues");
  }
}
for (let round = 1; round <= 2 && broken.length > 0; round++) {
  const still: typeof broken = [];
  for (const b of broken) {
    const file = `playground/resources/views/demos/components/${b.group}/${b.slug}.blade.php`;
    await agent(`اصلاح‌گر-${b.group}-${b.slug}-${round}`, { system: "تو تعمیرکار Blade این ریپو هستی؛ فقط فایل تعیین‌شده." }).ask(
      `صفحهٔ /components/${b.group}/${b.slug} کد ${b.code} می‌دهد؛ فایل ${file}. خطا را درست کن تا ۲۰۰ بدهد؛ اگر نشد صادقانه بگو.`,
    );
    const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", `http://127.0.0.1:8765/components/${b.group}/${b.slug}`]);
    if (r.stdout.trim() !== "200") still.push(b);
  }
  broken = still;
}

phase("بازبینی مرورگری و داوری");
const browser = await agent("بازبین-مرورگر", {
  system:
    "تو راستی‌آزمای مرورگری با playwright هستی (در /tmp/nx-shooter آماده: playwright نصب است؛ اسکریپت shoot.mjs با اسکرولِ پیش از عکس موجود است). ادعا بدون تصویر ممنوع.",
}).ask<{ ok: boolean; findings: VerifyFinding[]; shots: string[] }>(
  [
    "ورود: admin@nabux.test / nabux-demo روی http://127.0.0.1:8765/filament/login برای کوکی، و بعد صفحه‌های دمو را ببین (لاگین برای دموها لازم نیست ولی کوکی زبان را می‌سازد).",
    "از هر پنج گروه ۲ صفحهٔ نمونه را با shoot.mjs عکاسی کن (روشن + یک عکس تیره از یکی) در /tmp/nx-designs/ و با چشم نگاه کن: چیدمان، تیره، RTL، سرریز ۳۷۵ نه — فقط دسکتاپ روشن/تیره کافی است.",
    "خطاهای کنسول هر صفحه را هم جمع کن (pageerror).",
    "خروجی {ok, findings:[{what, evidence, severity}], shots:[مسیر عکس‌ها]} به فارسی.",
  ].join("\n"),
);

phase("داوری بصری و گزارش");
const judge = await agent("داور-نهایی", {
  system: "تو داور پذیرش بصری هستی و فقط از تصویر قضاوت می‌کنی؛ ادعای ندیده ممنوع. چیدمان شکسته/ناخوانا/تم شکسته = مردود؛ سلیقهٔ جزئی = قبول.",
}).ask<{ verdicts: JudgeVerdict[] }>(
  `این تصاویر را با Read ببین و حکم بده:\n${browser.shots.join("\n")}\nخروجی فقط JSON: {verdicts:[{shot, pass, issues}]} به فارسی.`,
);
const failedShots = judge.verdicts.filter((v) => !v.pass);
for (const v of failedShots) report({ what: `داوری ${v.shot}`, evidence: v.issues, severity: "medium" }, "issues");

await artifact.markdown(
  "report",
  [
    "# موج سیستم‌های طراحی: کربن، پولاریس، اطلسیان، لایتنینگ، پرایمر",
    "",
    `**${allPages.length} دموی تازه در ۵ گروه** — ${broken.length === 0 ? "همه ۲۰۰" : `${broken.length} صفحه خراب`}.`,
    "",
    ...SYSTEMS.map((s, i) => {
      const b = builders[i];
      const els = (proposals[i].elements ?? []).map((e) => e.titleFa).join("، ");
      return `- ${b.ok ? "✅" : "❌"} **${s.name}** (${b.slugs.length} دمو): ${els || b.notes}`;
    }),
    "",
    "## بازبینی مرورگری",
    ...browser.findings.map((f) => `- ${f.severity === "high" ? "🔴" : f.severity === "medium" ? "🟠" : "🟡"} ${f.what} — ${f.evidence}`),
    ...(browser.findings.length === 0 ? ["- مشکلی پیدا نشد."] : []),
    "",
    "## داوری بصری",
    ...judge.verdicts.map((v) => `- ${v.pass ? "✅" : "❌"} ${v.shot}${v.issues ? " — " + v.issues : ""}`),
  ].join("\n"),
  { title: "گزارش موج سیستم‌های طراحی", description: "کربن، پولاریس، اطلسیان، لایتنینگ، پرایمر — کشف شکاف تا داوری", primary: true },
);

const problems = [
  ...broken.map((b) => `${b.group}/${b.slug} کد ${b.code}`),
  ...builders.filter((b) => !b.ok).map((b) => `سازنده ناقص: ${b.notes}`),
  ...browser.findings.map((f) => f.what),
  ...failedShots.map((v) => `داوری: ${v.shot}`),
];

return {
  conclusion:
    problems.length === 0
      ? `موج سیستم‌های طراحی کامل شد: ${allPages.length} دموی تازه در ۵ گروه (کربن، پولاریس، اطلسیان، لایتنینگ، پرایمر) با پژوهش شکاف، پوست وفادار به هر سیستم، پویش HTTP سبز و داوری بصری قبول.`
      : `موج انجام شد اما ${problems.length} مورد باز دارد: ${problems.slice(0, 4).join("؛ ")}.`,
  findings: [
    ...broken.map((b) => ({ what: `${b.group}/${b.slug} کد ${b.code}`, evidence: "curl", severity: "high" as const })),
    ...builders.filter((b) => !b.ok).map((b) => ({ what: "سازنده ناقص", evidence: b.notes, severity: "high" as const })),
    ...browser.findings,
    ...failedShots.map((v) => ({ what: `داوری تصویر ${v.shot}`, evidence: v.issues, severity: "medium" as const })),
  ],
  verified: [
    `curl تک‌تک ${allPages.length} صفحهٔ تازه (world.run) + حلقهٔ اصلاح تا ۲ دور`,
    "php-level چک توسط سازنده‌ها در حین کار",
    "بازبینی مرورگری playwright روی نمونه‌های هر گروه (روشن/تیره) + خطاهای کنسول + داوری بصری مستقل",
  ],
  notCovered: [
    "بازبینی ۳۷۵px و زبان انگلیسی به‌صورت سراسری — نمونه‌ای سنجیده شد",
    "پورت این المان‌ها به پکیج‌های React/Vue — فعلاً دموی پلی‌گراوندند",
  ],
};