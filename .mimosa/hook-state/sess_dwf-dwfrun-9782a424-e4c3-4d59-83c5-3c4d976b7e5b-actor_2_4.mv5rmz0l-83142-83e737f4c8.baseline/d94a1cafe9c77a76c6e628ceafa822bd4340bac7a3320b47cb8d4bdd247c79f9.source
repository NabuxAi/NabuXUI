interface PageVerdict {
  /** کدام صفحه بررسی شد (URL). */
  page: string;
  /** مسیر فایل اسکرین‌شات ذخیره‌شده. */
  shot: string;
  /** pass یعنی صفحه سالم رندر شده؛ fail یعنی مشکل دیداری پیدا شده. */
  verdict: "pass" | "fail";
  /** مشکلات مشخص دیده‌شده در اسکرین‌شات؛ در حالت pass خالی. */
  issues: string[];
}

const pages = [
  {
    key: "landing",
    name: "بازبین لندینگ",
    url: "http://localhost:3000/",
    focus:
      "صفحه اصلی سایت (تم تیره). چون فایل nabuxui.css از نو وندور شده، باید مطمئن شویم هیچ رگرسیون دیداری رخ نداده: هرو با ویدیو و تیتر گرادیانی، نوار پیمایش شیشه‌ای، کارت‌های شیشه‌ای محصولات، نوار آمار، فوتر. fullPage اسکرین‌شات بگیر.",
  },
  {
    key: "login",
    name: "بازبین صفحه ورود",
    url: "http://localhost:3000/app/login",
    focus:
      "صفحه ورود پنل (auth-card روی backdrop-aurora). مهم‌ترین نکته: روی دکمه بنفش submit باید متن «Sign in» کاملاً پیدا باشد (قبلاً نامرئی بود). کارت دو ستونه، پلیت برند با درخشش، فیلدهای ایمیل/رمز سالم باشند.",
  },
  {
    key: "rtl",
    name: "بازبین حالت راست‌به‌چپ",
    url: "http://localhost:3000/ar/app",
    focus:
      "داشبورد پنل در لوکال عربی (RTL). باید کل چیدمان آینه شود: سایدبار سمت راست، متن‌های عربی، چیپ‌ها و کارت‌ها مرتب، هیچ سرریز یا هم‌پوشانی. چارت میله‌ای و دونات باید رندر شوند (اگر وسط انیمیشن بودند مشکلی نیست، فقط مطمئن شو کادرها سالم‌اند).",
  },
];

phase("بررسی سه صفحه با مرورگر");
const verdicts: PageVerdict[] = [];
for (const p of pages) {
  const v = await agent(p.name).ask<PageVerdict>(
    `یک بازبین بصری وب هستی؛ هیچ فایلی را ویرایش نمی‌کنی. صفحه «${p.url}» را در مرورگر ZCode باز کن، اسکرین‌شات بگیر، خودت تصویر را ببین و حکم بده.\n\n` +
      `چه چیزهایی باید سالم باشد: ${p.focus}\n\n` +
      `مراحل دقیق — همه через ابزار mcp__node_repl__js (هر فراخوانی کرنل تازه دارد؛ bootstrap را در هر فراخوانی تکرار کن):\n\n` +
      "1) bootstrap:\n" +
      "```js\n" +
      'const browserPluginRoot = process.env.ZCODE_PLUGIN_ROOT ?? process.env.CLAUDE_PLUGIN_ROOT;\n' +
      'if (!browserPluginRoot) throw new Error("Browser plugin root is unavailable");\n' +
      'const { join } = await import("node:path");\n' +
      'const { pathToFileURL } = await import("node:url");\n' +
      'const browserClientUrl = pathToFileURL(join(browserPluginRoot, "scripts", "browser-client.mjs")).href;\n' +
      'const { setupBrowserRuntime } = await import(browserClientUrl);\n' +
      "await setupBrowserRuntime({ globals: globalThis });\n" +
      'const browser = await agent.browsers.getForUrl("' + p.url + '");\n' +
      "```\n\n" +
      "2) تب: `const tabs = await browser.tabs.list();` — اگر تبی با URL شروع‌شده با http://localhost:3000 بود با `browser.tabs.get(id)` بگیر، وگرنه `browser.tabs.new()`. سپس `await tab.setViewportSize({ width: 1440, height: 900 });`\n\n" +
      "3) ناوبری: `await tab.goto(\"" + p.url + "\");` بعد `await tab.playwright.waitForLoadState({ state: \"domcontentloaded\" });` بعد `await tab.playwright.waitForTimeout(3000);`\n\n" +
      "4) توقف انیمیشن‌ها برای شات تمیز:\n" +
      "```js\n" +
      "await tab.playwright.evaluate(() => {\n" +
      "  const s = document.createElement('style');\n" +
      "  s.textContent = '*, *::before, *::after { animation-play-state: paused !important; }';\n" +
      "  document.head.appendChild(s);\n" +
      "});\n" +
      "```\n" +
      "بعد `await tab.playwright.waitForTimeout(600);`\n\n" +
      "5) اسکرین‌شات: " +
      (p.key === "landing"
        ? "`const png = await tab.screenshot({ fullPage: true });`"
        : "`const png = await tab.screenshot();`") +
      " و ذخیره: `const { writeFileSync } = await import(\"node:fs\"); writeFileSync(\"/tmp/nabuxai-shots/" + p.key + "-final.png\", png);` (اول اگر لازم است mkdirSync برای /tmp/nabuxai-shots با recursive). اگر خطای screenshot دیدی، ۳ ثانیه صبر کن و حداکثر ۳ بار دوباره تلاش کن.\n\n" +
      "6) با ابزار Read فایل PNG را ببین و با دقت قضاوت کن: چیدمان شکسته؟ متن نامرئی یا بریده؟ هم‌پوشانی؟ سرریز افقی؟ عنصر گم‌شده؟ فقط مشکلات واقعی و مشخص را بنویس؛ سلیقه‌ای قضاوت نکن.\n\n" +
      "اگر صفحه اصلاً باز نشد (خطای شبکه) بعد از ۲ تلاش، verdict را fail بگذار و مشکل را بنویس. زبان پاسخ: فارسی.",
  );
  verdicts.push(v);
  report(v);
  log(`${p.key}: ${v.verdict === "pass" ? "سالم" : "دارای مشکل"} — ${v.issues.length} مورد`);
}

await artifact.markdown(
  "report",
  [
    "# راستی‌آزمایی بصری nabuxai.com",
    "",
    ...verdicts.map((v) =>
      v.verdict === "pass"
        ? `- ✅ **${v.page}** — سالم رندر شد. (اسکرین‌شات: \`${v.shot}\`)`
        : `- ❌ **${v.page}** — مشکل: ${v.issues.join(" · ")} (اسکرین‌شات: \`${v.shot}\`)`,
    ),
  ].join("\n"),
  { title: "گزارش راستی‌آزمایی بصری", description: "نتیجه بررسی سه صفحه پس از رفرش CSS و ساخت پنل", primary: true },
);

const broken = verdicts.filter((v) => v.verdict === "fail");
return {
  conclusion:
    broken.length === 0
      ? "هر سه صفحه (لندینگ، ورود، RTL عربی) سالم رندر شدند؛ رگرسیون دیداری از رفرش CSS دیده نشد."
      : `${broken.length} صفحه از ۳ مشکل دیداری دارد: ${broken.map((b) => b.page).join("، ")}.`,
  findings: verdicts.map((v) => ({
    where: v.page,
    what: v.verdict === "pass" ? "صفحه سالم رندر شد" : v.issues.join(" · "),
    evidence: `اسکرین‌شات: ${v.shot}`,
    status: "verified" as const,
    severity: (v.verdict === "pass" ? "low" : "medium") as "low" | "medium",
  })),
  verified: ["اسکرین‌شات واقعی هر سه صفحه در مرورگر گرفته و توسط زیرمجموعه بازبین دیده و قضاوت شد"],
  notCovered: ["صفحات usage و settings و register به‌طور تصادفی در جریان کار قبلی به‌صورت بصری تایید شده‌اند اما در این اجرا دوباره بررسی نشدند"],
};