  "2. فونت‌ها از fontsource (variable اگر هست): Vazirmatn، Inter، Bricolage Grotesque اگر موجود بود وگرنه Inter برای display، JetBrains Mono — بیلد باید آفلاین قطعی باشد.\n" +
  "3. CSS دیزاین‌سیستم را وندور کن: کپی " + NX + "/packages/core/dist/nabuxui.css به src/styles/nabuxui.css (و در Layout ایمپورت شود) + لایه‌ی اپ سبک به سبک " + OLD_SITE + "/styles/globals.css فقط با توکن‌های --nx-* (هیچ هگز خام).\n" +
  "4. رفتارهای بلوک (reveal + spotlight) را به‌صورت یک اسکریپت کلاینت کوچک بنویس (src/scripts/nx-behaviours.ts) — منطق همان " + OLD_SITE + "/lib/nx-hooks.js است؛ هیچ کتابخانه‌ی حرکتی اضافه نکن.\n" +
  "5. Layout.astro پایه: html با data-theme=\"dark\"، dir/lang بر اساس locale (fa/ar → rtl)، متاها، nx-js/nx-live به‌محض بارگذاری اسکریپت.\n" +
  "6. ساختار i18n دستی: /fa (پیش‌فرض)، /en، /ar — دیکشنری JSON در src/i18n/.\n" +
  "7. CONVENTIONS.md (پشته، چیدمان، قواعد توکن‌محوری، سبک تست، قاعده‌ی «جزیره فقط اگر اجباری»)، README فارسی، .gitignore (dist/، node_modules/، .data/)، git init + کامیت اول.\n" +
  "8. tests/smoke.test.mjs: فایل nabuxui.css وندورشده کلاس‌های nx-admin و nx-auth-card و nx-stat-strip را دارد و دیکشنری‌های سه زبان کلیدهای یکسان دارند.\n" +
  "9. pnpm install و مطمئن شو pnpm build پاس است (تست را خودت اجرا نکن — گیت گردش کار می‌زند).\n" + RULES,
);
const explorer = agent("فهرست‌بردار");
const inventoryP = explorer.ask<ModuleInfo[]>(
  "فهرست‌برداری کامل ماژول‌ها/اپ‌های خانواده‌ی نبکس در " + SITES + " — فقط خواندن، هیچ فایلی را تغییر نده.\n\n" +
  "برای هر پروژه‌ی مرتبط (همه‌ی Nabu*/Nabux*/nabux* + zoeyhq + mrchatgpt + NabuCRM و همه‌ی واریانت‌هایش NabuCRM-*):\n" +
  "- README / PRODUCT_SPEC.md / PROJECT_PROGRESS.md / CLAUDE.md / package.json / composer.json / Dockerfile را نگاه کن (خلاصه‌خوانی؛ فایل‌های بزرگ را کامل نخوان).\n" +
  "- برای هرکدام: پشته، نقش، چه چیزی می‌تواند به «سایت عمومی» بدهد (محتوا/محصول/پشتیبانی/چت/جستجو…) و چه رویدادهایی را برای «ثبت خروجی سایت» می‌پذیرد (فرم تماس→لید CRM، سفارش→Store، تیکت→Desk…).\n" +
  "- حداکثر ۲۰ ماژول مرتبط را برگردان؛ پروژه‌های بی‌ربط به سایت را ذکر نکن. اگر API/webhook واقعی در مستنداتشان پیدا کردی، در events دقیقش را بنویس (مثلا «NabuPilot: POST /webhook/leads با بادی {…}»).\n" +
  "فارسی و مختصر پاسخ بده — فقط آرایه‌ی نتیجه طبق قرارداد.",
);
/* پادزهر: اگر عامل به‌جای آرایه متن برگرداند، JSON داخلش را می‌گیریم و یک بار
   دوباره می‌پرسیم — همان الگویی که در گردش کار هسته لازم شد. */
function asArrayRaw(raw: unknown): unknown[] | null {
  if (Array.isArray(raw)) return raw;
  if (typeof raw === "string") {
    const m = /\[[\s\S]*\]/.exec(raw);
    if (m && m[0]) {
      try {
        const parsed: unknown = JSON.parse(m[0]);
        if (Array.isArray(parsed)) return parsed;
      } catch { /* متن JSON نبود */ }
    }
  }
  return null;
}
const [scaffoldDone, invRaw] = await Promise.all([scaffoldP, inventoryP]);
let inventory: ModuleInfo[] = (asArrayRaw(invRaw) ?? []) as ModuleInfo[];
if (!Array.isArray(invRaw)) {
  const retryRaw: unknown = await explorer.ask(
    "پاسخ قبلی‌ت به‌صورت آرایه نرسید. همین فهرست را این بار فقط و فقط به شکل آرایه‌ی JSON برگردان — بدون هیچ متن اضافه — با دقیقاً کلیدهای name, stack, role, siteGives, events برای هر آیتم.",
  );
  inventory = (asArrayRaw(retryRaw) ?? []) as ModuleInfo[];
}
log(`فهرست: ${inventory.length} ماژول شناسایی شد (${inventory.map((m) => m.name).slice(0, 6).join("، ")}…)`);

