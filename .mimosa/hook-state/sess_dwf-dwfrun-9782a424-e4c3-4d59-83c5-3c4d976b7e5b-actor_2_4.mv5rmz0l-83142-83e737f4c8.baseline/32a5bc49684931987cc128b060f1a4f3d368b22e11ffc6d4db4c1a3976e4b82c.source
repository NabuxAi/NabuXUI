report({ module: "سئو", stage: "در ساخت" });
await agent("مهندس سئو").ask(
  "لایه‌ی سئو و سرعت را کامل کن.\n\n" + INTENT + "\n\n" +
  "کارهای تو:\n" +
  "1. کامپوننت SEO.astro: title/description/canonical/og/twitter + JSON-LD (Organization در خانه، Article در مقاله، ItemList در گرید ماژول‌ها) + hreflang سه‌زبان با x-default=en.\n" +
  "2. public/robots.txt + sitemap تولیدشده در بیلد از همه‌ی صفحات سه زبان (integrations یا اسکریپت بیلد؛ بدون وابستگی سنگین اگر نشد دستی در اندپوینت getStaticPaths).\n" +
  "3. سرعت: فونت با font-display مناسب، preconnect حذف (همه local)، CSS وندور فقط یک بار، هیچ JS کلاینت جز nx-behaviours، لینیط تصاویر اگر تصویری هست.\n" +
  "4. rss.xml فارسی/انگلیسی از مقاله‌ها.\n" +
  "5. tests/seo.test.mjs روی dist: sitemap هر سه locale را دارد، rss معتبر XML است، canonical و hreflang در خانه هست، هیچ <script src> جز nx-behaviours در HTML خانه نیست (صفر-جاوااسکریپت بودن محتوا اثبات شود).\n" + RULES,
);
const seoOk = await g("سئو", ["build"], 600000, "بیلد سئو را سبز کن.");
if (seoOk) await g("سئو", ["test"], 300000, "تست‌های سئو روی dist را سبز کن.");

/* ═══ فاز ۸: راستی‌آزمایی بصری ═══ */
phase("راستی‌آزمایی بصری در مرورگر");
report({ module: "بصری", stage: "در ساخت" });
const visualAgent = agent("بازبین بصری");
const visualRaw: unknown = await visualAgent.ask<VisualVerdict>(
  "سایت ساخته‌شده در " + WEB + " را در مرورگر راستی‌آزمایی کن. هیچ فایل سورسی را ویرایش نکن (گزارش بده).\n\n" +
  "1. با Bash سرور preview را ببر بالا: cd " + WEB + " && pnpm preview --port 4321 (پس‌زمینه) و صبر کن بالا بیاید (curl 127.0.0.1:4321).\n" +
  "2. با ابزار mcp__node_repl__js مرورگر ZCode را باز کن (الگوی bootstrap: process.env.ZCODE_PLUGIN_ROOT → scripts/browser-client.mjs → setupBrowserRuntime → agent.browsers.getForUrl('http://127.0.0.1:4321'))؛ تب 1440x900.\n" +
  "3. صفحات: /fa (پیش‌فرض)، /en، /ar، /fa/contact و یک مقاله. قبل از هر اسکرین‌شات انیمیشن‌ها را pause کن (استایل animation-play-state) و کمی صبر کن تا revealها تمام شوند (اگر چیزی در opacity صفر گیر کرد، ۲.۵ ثانیه صبر و دوباره شات — CSS خودش failsafe دارد).\n" +
  "4. هر شات را با nodeRepl.emitImage ببین و قضاوت کن: چیدمان شکسته؟ متن نامرئی/بریده؟ RTL درست آینه شده؟ بلوک‌ها استایل دارند؟ فقط مشکل واقعی و مشخص گزارش کن.\n" +
  "5. شات‌ها در /tmp/nabuxweb-shots/ ذخیره (mkdir -p). آخر کار سرور preview را بکش (kill).\n" +
  "فارسی پاسخ بده.",
);
function asVerdict(raw: unknown): VisualVerdict | null {
  if (typeof raw === "object" && raw !== null && "verdict" in raw) return raw as VisualVerdict;
  if (typeof raw === "string") {
    const m = /\{[\s\S]*\}/.exec(raw);
    if (m && m[0]) {
      try {
        const parsed: unknown = JSON.parse(m[0]);
        if (typeof parsed === "object" && parsed !== null && "verdict" in parsed) return parsed as VisualVerdict;
      } catch { /* متن JSON نبود */ }
    }
  }
  return null;
}
let visual = asVerdict(visualRaw);
if (!visual) {
  const retryRaw: unknown = await visualAgent.ask(
    "پاسخ قبلی‌ت ساخت‌یافته نبود. فقط و فقط یک JSON برگردان — بدون متن اضافه — با این کلیدها: verdict (pass|fail)، issues (آرایه‌ی رشته)، shots (آرایه‌ی مسیر اسکرین‌شات‌ها).",
  );
  visual = asVerdict(retryRaw);
}
if (!visual) {
  log("بازبین بصری نتیجه‌ی ساخت‌یافته نداد — به‌عنوان مشکل ثبت می‌شود تا از گزارش پنهان نماند");
  visual = { verdict: "fail", issues: ["پاسخ بازبین بصری ساخت‌یافته نبود؛ راستی‌آزمایی بصری انجام‌نشده ماند — چک دستی لازم است"], shots: [] };
}
log(`بازبینی بصری: ${visual.verdict === "pass" ? "پاس" : "دارای مشکل"}`);
const realVisualIssues = visual.issues.filter((i) => i.indexOf("ساخت‌یافته نبود") === -1);
if (visual.verdict !== "pass" && realVisualIssues.length > 0) {
  await fixer.ask(
    "بازبین بصری این مشکلات را در " + WEB + " دید؛ ریشه‌ای حل کن:\n" + realVisualIssues.join("\n") + "\n" + RULES,
  );
  await g("بصری", ["build"], 600000, "پس از رفع مشکلات بصری، بیلد را دوباره سبز کن.");
} else if (visual.verdict === "pass") {
  report({ module: "بصری", stage: "آماده" });
}

/* ═══ فاز ۹: بازبینی مستقل ═══ */
phase("بازبینی مستقل نهایی");
const reviewer = agent("بازبین مستقل", {
  system:
    "بازبین معماری و کد هستی با چشم تازه؛ هیچ فایلی را ویرایش نمی‌کنی. یافته را با مسیر و شاهد بنویس؛ آن‌چه را بررسی نکردی گزارش نکن. فارسی پاسخ بده.",
});
const reviewRaw: unknown = await reviewer.ask(
  "کل " + WEB + " را بخوان (src/، tests/، docs/، astro.config) و با هدف کاربر بسنج. docs/modules.md و رجیستری کانکتورها را با واقعیت فهرست زیر مقایسه کن:\n" +
  JSON.stringify(inventory.map((m) => ({ name: m.name, events: m.events })), null, 2) + "\n\n" +
  "چک‌لیست: هدلس بودن واقعی (هیچ داده‌ای هاردکد نشده که باید از هسته بیاید)؟ فال‌بک SSG سالم؟ صفر-جاوااسکریپت بودن محتوا؟ فقط توکن‌های --nx-* (هگز خام = یافته)؟ RTL بدون تقلب physical؟ امنیت اندپوینت submit (ولیدیشن، honeypot، نشت خطا)؟ تست‌ها assertion واقعی دارند؟ تناقض با CONVENTIONS.md؟",
);
function asFindings(raw: unknown): ReviewFinding[] | null {
  if (Array.isArray(raw)) return raw as ReviewFinding[];
  if (typeof raw === "string") {
    const m = /\[[\s\S]*\]/.exec(raw);
    if (m && m[0]) {
      try {
        const parsed: unknown = JSON.parse(m[0]);
        if (Array.isArray(parsed)) return parsed as ReviewFinding[];
      } catch { /* متن JSON نبود */ }
    }
  }
  return null;
}
let findings: ReviewFinding[] = asFindings(reviewRaw) ?? [];
if (findings.length === 0 && !Array.isArray(reviewRaw)) {
  const retryRaw: unknown = await reviewer.ask(
    "پاسخ قبلی‌ت به‌صورت آرایه نرسید. همین یافته‌ها را این بار فقط و فقط به شکل آرایه‌ی JSON برگردان — بدون هیچ متن اضافه — با دقیقاً کلیدهای where, what, severity (low|medium|high), fix_hint. اگر یافته‌ای نداشتی، آرایه‌ی خالی [] بفرست.",
  );
  findings = asFindings(retryRaw) ?? [];
  if (findings.length === 0 && !Array.isArray(retryRaw)) {
    log("بازبین مستقل نتیجه‌ی ساخت‌یافته نداد — در گزارش ثبت می‌شود");
  }
}
log(`بازبینی مستقل: ${findings.length} یافته`);
const heavy = findings.filter((f) => f.severity !== "low");
if (heavy.length > 0) {
  await fixer.ask(
    "بازبین مستقل این یافته‌ها را در " + WEB + " گزارش کرده؛ متوسط و بالاتر را ریشه‌ای حل کن:\n" + JSON.stringify(heavy, null, 2) + "\n" + RULES,
  );
  const reb = await world.run("pnpm", ["--dir", WEB, "build"], { timeoutMs: 600000 });
  const ret = await world.run("pnpm", ["--dir", WEB, "test"], { timeoutMs: 300000 });
  log(`بازگیت: build=${reb.exitCode === 0 ? "پاس" : "شکست"} test=${ret.exitCode === 0 ? "پاس" : "شکست"}`);
}

/* ═══ فاز ۱۰: تحویل ═══ */
phase("تحویل: کامیت و گزارش");
await world.run("git", ["-C", WEB, "add", "-A"]);
const commit = await world.run("git", ["-C", WEB, "commit", "-m", "nabux-web: لایه وب هدلس — Astro استاتیک‌اول + بلوک‌های NabuXUI + کلاینت هسته با فال‌بک + کانکتور ماژول‌ها + سئو"]);
const du = await world.run("du", ["-sh", WEB + "/dist"]);
const distSize = /[\d.]+[KM]?/.exec(du.stdout);
const lines: string[] = [
  "# nabux-web — لایه‌ی وب هدلس خانواده نبکس",
  "",
  "ریپو: `" + WEB + "` · کامیت: " + (commit.exitCode === 0 ? "زده شد" : "ناموفق") + " · حجم dist: **" + (distSize && distSize[0] ? distSize[0] + "B" : "نامشخص") + "**",
  "",
  "## فازها",
  "- اسکلت Astro 5 (استاتیک‌اول، فونت local، CSS وندور NabuXUI): " + (skelOk ? "پاس" : "شکست"),
  "- قرارداد ماژول‌ها و رجیستری کانکتور: " + (contractOk ? "پاس" : "شکست"),
  "- کلاینت هدلس + فال‌بک SSG: " + (clientOk ? "پاس" : "شکست"),
  "- صفحه‌ها (خانه/مقاله/ماژول‌ها/تماس/404 در fa/en/ar): " + (pagesOk ? "پاس" : "شکست"),
  "- کانکتورها (submit + outbox): " + (connOk ? "پاس" : "شکست"),
  "- سئو (sitemap/hreflang/JSON-LD/rss/صفر-JS): " + (seoOk ? "پاس" : "شکست"),
  "- راستی‌آزمایی بصری: " + (visual.verdict === "pass" ? "پاس" : "رفع شد/گزارش شد"),
  "",
  "## ماژول‌های پشتیبانی‌شده",
  ...inventory.map((m) => "- **" + m.name + "** — " + m.role + " (رویدادها: " + (m.events.length > 0 ? m.events.join("، ") : "—") + ")"),
  "",
  "## یافته‌های بازبین مستقل",
];
if (findings.length === 0) lines.push("- یافته‌ای نبود.");
for (const f of findings) lines.push("- **" + f.severity + "** · `" + f.where + "` — " + f.what);
await artifact.markdown("report", lines.join("\n"), {
  title: "گزارش ساخت nabux-web",
  description: "لایه وب هدلس روی بلوک‌های NabuXUI — " + inventory.length + " ماژول در رجیستری",
  primary: true,
});

return {
  conclusion:
    "لایه‌ی وب هدلس nabux-web ساخته شد: Astro 5 استاتیک‌اول (HTML صفر-جاوااسکریپت) روی CSS وندور NabuXUI در سه زبان fa/en/ar با RTL، کلاینت تایپ‌شده‌ی هسته‌ی nabux-cms با فال‌بک SSG، و رجیستری کانکتور برای " + inventory.length + " ماژول واقعی خانواده (خروجی سایت با outbox مقاوم برای ثبت به CRM/Store/Chat/Desk می‌رود). گیت‌ها: build و test هر فاز + بازبینی مستقل + بازبینی بصری مرورگر. اسکرین‌شات‌ها: /tmp/nabuxweb-shots/.",
  findings,
  verified: [
    "pnpm build و pnpm test بعد از هر فاز",
    "تست‌های dist: RTL فارسی، sitemap سه‌زبان، صفر <script src> در HTML خانه",
    "راستی‌آزمایی بصری واقعی در مرورگر (صفحات fa/en/ar/contact/مقاله) با اسکرین‌شات",
    "بازبینی مستقل کد توسط عامل تازه + بازگیت پس از رفع",
  ],
  notCovered: [
    "اتصال زنده به هسته nabux-cms (در حال ساخت توسط گردش کار موازی؛ کلاینت روی قرارداد API نوشته شده و با فال‌بک کار می‌کند)",
    "webhookهای واقعی ماژول‌ها (endpoints از env؛ مقادیر نمونه در .env.example)",
    "استقرار (خروجی استاتیک بعداً یا روی CDN یا سرو با خود باینری Rust)",
    "لوکال fa در سایت قدیمی nabuxai.com — این ریپو جایگزین آینده است، مهاجرت محتوا جداگانه",
  ],
} satisfies WorkflowReportShape;