interface ModuleInfo {
  /** نام پروژه/ماژول (نام پوشه در ~/Sites). */
  name: string;
  /** پشته‌ی فنی در یک خط. */
  stack: string;
  /** نقش محصول در یک جمله. */
  role: string;
  /** چه چیزهایی می‌تواند به سایت بدهد (محتوا، محصول، پشتیبانی…). */
  siteGives: string[];
  /** چه رویدادهایی را می‌پذیرد/ثبت می‌کند (فرم، سفارش، لید…). */
  events: string[];
}

interface ReviewFinding {
  /** مسیر فایل (با شماره خط اگر مربوط است). */
  where: string;
  /** یک جمله: مشکل چیست. */
  what: string;
  /** شدت؛ high فقط برای از دست رفتن داده یا رخنه امنیتی واقعی. */
  severity: "low" | "medium" | "high";
  /** راهنمای کوتاه اصلاح. */
  fix_hint: string;
}

interface VisualVerdict {
  /** pass یعنی صفحات کلیدی سالم رندر شدند. */
  verdict: "pass" | "fail";
  /** مشکلات مشخص؛ در حالت pass خالی. */
  issues: string[];
  /** مسیر اسکرین‌شات‌های ذخیره‌شده. */
  shots: string[];
}

interface WorkflowReportShape {
  conclusion: string;
  findings: ReviewFinding[];
  verified: string[];
  notCovered: string[];
}

const WEB = "/Users/mrchatgpt/Sites/nabux-web";
const NX = "/Users/mrchatgpt/Sites/NabuXUI";
const OLD_SITE = "/Users/mrchatgpt/Sites/Nabuxai.com";
const SITES = "/Users/mrchatgpt/Sites";

const INTENT = [
  "هدف نهایی کاربر: یک سیستم وب کاملاً هدلس که (۱) همه‌ی ماژول‌ها و اپ‌های خانواده‌ی نبکس را ساپورت کند — هر ماژول بتواند به سایت محتوا/قابلیت بدهد و خروجی سایت (فرم، لید، سفارش…) برای ثبت به ماژول درست ارسال شود؛",
  "(۲) رندر SSR/SSG با جدیدترین و سریع‌ترین ترکیب ممکن باشد (تصمیم: Astro 5 استاتیک‌اول با HTML صفر-جاوااسکریپت + endpointهای سروری؛ جزیره‌ی React فقط اگر واقعاً لازم شد)؛",
  "(۳) از المان‌های دیزاین‌سیستم NabuxXUI در همه‌جا استفاده شود (CSS وندور‌شده از " + NX + "/packages/core/dist/nabuxui.css).",
].join(" ");

const RULES = [
  "قوانین کار:",
  "- فقط داخل " + WEB + " بنویس. خواندن " + NX + " و " + OLD_SITE + " و " + SITES + " آزاد، ویرایش‌شان ممنوع (nabux-cms مال گردش کار دیگری است؛ به هیچ عنوان دست نزن).",
  "- اول CONVENTIONS.md ریپو را بخوان و پیروی کن؛ تغییرش دادی همان‌جا ثبت کن.",
  "- بیلد باید بدون شبکه‌ی فونت/CDN قطعی باشد (فونت‌ها از fontsource).",
  "- تست‌ها با node:test در tests/ — قطعی، بدون شبکه، بدون زمان واقعی.",
  "- پاسخ نهایی فارسی و مختصر: چه ساخت، چه تستی، تصمیم‌های مهم.",
].join("\n");

const fixer = agent("تعمیرکار", {
  system:
    "مهندس ارشد وب (Astro/TS) هستی. خطا را از ریشه حل می‌کنی، نه با حذف تست یا دور زدن گیت. " +
    "اگر گیت صادقانه قابل پاس نیست، صریح بنویس و اسکیلیت کن؛ پاسخ جعلی ممنوع. فارسی و مختصر.",
});

artifact.board("modules", {
  key: "module",
  status: "stage",
  columns: ["در صف", "در ساخت", "گیت", "آماده"],
  cardTitle: "module",
});

const STAGES = ["اسکلت", "فهرست", "قرارداد", "کلاینت", "صفحه‌ها", "کانکتور", "سئو", "بصری"];
for (const m of STAGES) report({ module: m, stage: "در صف" });

async function g(label: string, cmdArgs: string[], timeoutMs: number, hint: string): Promise<boolean> {
  report({ module: label, stage: "گیت" });
  for (let round = 1; round <= 3; round++) {
    const r = await world.run("pnpm", ["--dir", WEB, ...cmdArgs], { timeoutMs });
    if (r.exitCode === 0) {
      log(`${label}: گیت پاس شد${round > 1 ? " (راند " + round + ")" : ""}`);
      report({ module: label, stage: "آماده" });
      return true;
    }
    log(`${label}: گیت شکست — راند ${round} از ۳`);
    await fixer.ask(
      `گیت «${label}» (pnpm ${cmdArgs.join(" ")}) در ${WEB} شکست خورده (راند ${round} از 3):\n\n` +
      "خروجی:\n" + (r.stderr || r.stdout).slice(-4000) + "\n\n" + hint + "\n" + RULES,
    );
  }
  log(`${label}: پس از ۳ راند نگرفت`);
  return false;
}

/* ═══ فاز ۱: اسکلت + فهرست (موازی) ═══ */
phase("اسکلت Astro و فهرست‌برداری ماژول‌ها");
