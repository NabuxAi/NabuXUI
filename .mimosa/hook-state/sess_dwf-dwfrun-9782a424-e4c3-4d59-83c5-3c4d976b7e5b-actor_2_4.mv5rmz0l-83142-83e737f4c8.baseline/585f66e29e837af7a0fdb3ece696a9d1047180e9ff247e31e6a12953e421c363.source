
<?php
    $fa = app()->getLocale() === 'fa';
    $say = fn (string $en, string $faText) => $fa ? $faText : $en;

    $bandA = $fa ? 'نبوکس‌یوآی · تایپوگرافی جنبشی · سرعت را حس کن · ' : 'NABUXUI · KINETIC TYPE · FEEL THE VELOCITY · ';
    $bandB = $fa ? 'اسکرول تندتر · نوار تندتر · ' : 'SCROLL HARDER · BAND FASTER · ';
?>

<style>
    .knvb-root {
        --knvb-bg: #ffffff; --knvb-ink: #1c1917; --knvb-muted: #78716c;
        --knvb-border: #e7e5e4; --knvb-card: #fafaf9; --knvb-accent: #d97706;
        display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.1rem;
        font-family: 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
        color: var(--knvb-ink);
    }
    html[data-theme="dark"] .knvb-root {
        --knvb-bg: #171514; --knvb-ink: #fafaf9; --knvb-muted: #a8a29e;
        --knvb-border: #292524; --knvb-card: #1c1917; --knvb-accent: #f59e0b;
    }
    @media (prefers-color-scheme: dark) {
        html:not([data-theme="light"]) .knvb-root {
            --knvb-bg: #171514; --knvb-ink: #fafaf9; --knvb-muted: #a8a29e;
            --knvb-border: #292524; --knvb-card: #1c1917; --knvb-accent: #f59e0b;
        }
    }
    .knvb-scroll {
        block-size: 11rem; overflow-y: auto; overscroll-behavior: contain;
        padding: 1.1rem 1.25rem; border: 1px solid var(--knvb-border);
        border-radius: .9rem; background: var(--knvb-card);
        scrollbar-width: thin; scrollbar-color: var(--knvb-border) transparent;
    }
    .knvb-scroll::-webkit-scrollbar { inline-size: 6px; }
    .knvb-scroll::-webkit-scrollbar-thumb { border-radius: 999px; background: var(--knvb-border); }
    .knvb-log-title { margin: 0 0 .6rem; font-size: .95rem; font-weight: 800; }
    .knvb-log { margin: 0; display: grid; gap: .55rem; font-size: .88rem;
                line-height: 1.85; color: var(--knvb-ink); }
    .knvb-log b { color: var(--knvb-accent); }
    .knvb-band {
        overflow: clip; border-block: 1px solid var(--knvb-border);
        padding-block: .55rem; user-select: none;
        font-weight: 900; line-height: 1.25; letter-spacing: .01em;
        font-size: clamp(1.45rem, 5vw, 2.7rem); white-space: nowrap;
    }
    .knvb-band[data-rev] { color: var(--knvb-accent); }
    .knvb-track { display: flex; inline-size: max-content; will-change: transform;
                  align-items: center; }
    .knvb-track span { padding-inline: .18em; }
    .knvb-dock {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
        gap: .55rem 1.1rem; padding: .55rem 1.05rem; border-radius: 999px;
        background: var(--knvb-card); border: 1px solid var(--knvb-border);
        inline-size: fit-content; margin-inline: auto;
        font: 600 .8rem/1.4 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
    }
    .knvb-meter { display: inline-flex; align-items: center; gap: .5rem;
                  color: var(--knvb-ink); }
    .knvb-meter b {
        font-variant-numeric: tabular-nums; min-inline-size: 12ch; text-align: center;
        color: var(--knvb-accent); direction: ltr;
    }
    .knvb-dir { display: inline-flex; }
    .knvb-dir svg { inline-size: .95rem; block-size: .95rem; stroke: var(--knvb-accent);
                    stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round;
                    transition: transform .18s ease; }
    .knvb-dir[data-rev] svg { transform: rotate(180deg); }
    .knvb-hint { margin: 0; font-size: .74rem; color: var(--knvb-muted); text-align: center;
                 font-family: ui-monospace, monospace; }
    @media (prefers-reduced-motion: reduce) {
        .knvb-track { transform: none !important; }
        .knvb-dir svg { transition: none; }
    }
</style>

<section class="pg-box" style="gap: 1.25rem"
    x-data="{
        pos: [0, 0], vel: [0, 0], last: null, raf: 0, io: null, mq: null, onMq: null,
        visible: true, speed: 0,
        fa: <?php echo \Illuminate\Support\Js::from($fa)->toHtml() ?>,
        faDigits(s) { return this.fa ? s.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]).replace('.', '٫') : s; },
        get meterLabel() {
            const v = Math.abs(this.speed).toFixed(1);
            return this.faDigits(v) + (this.fa ? ' پیکسل بر فریم' : ' px/frame');
        },
        get reversing() { return this.speed < -0.6; },
        onScroll(e) {
            const y = e.target.scrollTop;
            const dv = this.last === null ? 0 : y - this.last;
            this.last = y;
            this.vel[0] += dv * 0.35;   // flick = jump, pause = calm
            this.vel[1] -= dv * 0.35;   // the second band mirrors it
        },
        frame() {
            [this.$refs.trackA, this.$refs.trackB].forEach((t, k) => {
                this.vel[k] = this.vel[k] * 0.92 + (k ? -0.6 : 0.6); // decay to the calm base
                const half = t.scrollWidth / 2;
                this.pos[k] = ((this.pos[k] + this.vel[k]) % half + half) % half; // seamless wrap
                t.style.transform = 'translateX(' + (-this.pos[k]).toFixed(1) + 'px)';
            });
            this.speed = this.vel[0];
            this.raf = requestAnimationFrame(() => this.frame());
        },
        run() {
            cancelAnimationFrame(this.raf);
            if (this.mq.matches || !this.visible) return;
            this.raf = requestAnimationFrame(() => this.frame());
        },
        init() {
            this.mq = matchMedia('(prefers-reduced-motion: reduce)');
            this.onMq = () => this.run();
            this.mq.addEventListener('change', this.onMq);
            this.io = new IntersectionObserver((entries) => {
                this.visible = entries[0].isIntersecting;
                this.run();
            }, { threshold: 0.1 });
            this.io.observe(this.$el);
            this.run();
        },
        destroy() {
            cancelAnimationFrame(this.raf);
            if (this.io) this.io.disconnect();
            if (this.mq && this.onMq) this.mq.removeEventListener('change', this.onMq);
        },
    }">
    <div>
        <h3 class="pg-title" style="font-size: var(--nx-text-xl)"><?php echo e($say('Type that takes its speed from your thumb', 'تایپی که سرعتش را از انگشت شما می‌گیرد')); ?></h3>
        <p style="margin: .25rem 0 0; color: var(--nx-text-muted)">
            <?php echo e($say('The changelog pane is the throttle: scroll velocity lands straight on both bands — one runs with the flick, one against it. A jump sends them racing, a pause lets the damping pull them back to a calm drift, and scrolling up drives them in reverse. Pixel math and a modulo on half the track keep the wrap seamless and the direction right under RTL too.', 'قاب تغییرنامه دریچهٔ گاز است: سرعت اسکرول مستقیم روی هر دو نوار می‌نشیند — یکی با جهش می‌دود، یکی خلافش. پرش سریع نوارها را می‌پراند، مکث می‌گذارد میرایی‌شان به رانِ آرام برگردد و اسکرول به بالا معکوس می‌راند. ریاضیات پیکسلی و مدولو روی نیم‌مسیر، پیچش را بی‌درز و جهت را در RTL هم درست نگه می‌دارد.')); ?>

        </p>
    </div>

    <div class="knvb-root">
        <div class="knvb-scroll" x-ref="scroller" x-on:scroll.passive="onScroll" lang="<?php echo e($fa ? 'fa' : 'en'); ?>">
            <h4 class="knvb-log-title"><?php echo e($say('Meridian Cloud — release notes 4.2', 'مریدین کلاد — یادداشت‌های انتشار ۴٫۲')); ?></h4>
            <p class="knvb-log">
                <b><?php echo e($say('This sprint went global:', 'این اسپرینت جهانی شد:')); ?></b>
                <?php echo e($say('the timeline view shipped to every workspace, offline sync landed on mobile, and the new export engine cut PDF times in half. Teams in Berlin, Nairobi and Seoul stress-tested every entry point before rollout. The shared motion tokens arrived second, then the audit log, and yesterday the public build reached every region. Scroll harder — the band answers your thumb. Pause, and the damping eases it back to a calm drift; scroll up, and both bands reverse against you.', 'نمای خط‌زمانی به همهٔ فضاهای کاری رسید، همگام‌سازی آفلاین روی موبایل فرود آمد و موتور صادرات جدید زمان PDF را نصف کرد. تیم‌های برلین، نایروبی و سئول پیش از عرضه هر نقطهٔ ورودی را زیر فشار آزمودند. توکن‌های حرکتِ اشتراکی دوم رسیدند، بعد گزارش حسابرسی و دیروز ساخت عمومی به همهٔ مناطق رسید. تندتر اسکرول کنید — نوار جواب انگشتتان را می‌دهد. مکث کنید تا میرایی‌اش به رانِ آرام برگردد؛ به بالا اسکرول کنید تا هر دو نوار خلاف شما بروند.')); ?>

            </p>
        </div>

        <div class="knvb-band" aria-hidden="true"><div class="knvb-track" x-ref="trackA">
            <span><?php echo e(str_repeat($bandA, 3)); ?></span><span><?php echo e(str_repeat($bandA, 3)); ?></span>
        </div></div>
        <div class="knvb-band" data-rev aria-hidden="true"><div class="knvb-track" x-ref="trackB">
            <span><?php echo e(str_repeat($bandB, 4)); ?></span><span><?php echo e(str_repeat($bandB, 4)); ?></span>
        </div></div>

        <div class="knvb-dock">
            <span class="knvb-meter">
                <span class="knvb-dir" x-bind:data-rev="reversing ? '' : null">
                    <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
                </span>
                <b x-text="meterLabel"></b>
            </span>
            <span style="color: var(--knvb-muted)"><?php echo e($say('flick = jump · pause = calm', 'جهش = پرش · مکث = آرام')); ?></span>
        </div>

        <p class="knvb-hint">
            <?php echo e($say('Δscroll × .35 · damping .92 · modulo half-track wrap · rAF parked off screen · stilled under reduced motion', 'Δscroll × ۰٫۳۵ · میرایی ۰٫۹۲ · پیچش مدولویی نیم‌مسیر · rAF پارک‌شده بیرون دید · ساکن در حرکت کاهش‌یافته')); ?>

        </p>
    </div>
</section>
