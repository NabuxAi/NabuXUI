interface PhaseResult {
  /** فایل‌های ساخته/تغییریده‌شده، مسیر نسبت به ریشهٔ ریپو */
  files: string[];
  /** نام کامپوننت‌های صادرشدهٔ React همین خانواده */
  exports: string[];
  /** true فقط وقتی همهٔ لایه‌های خانواده کامل شد */
  ok: boolean;
  /** یادداشت فارسی برای گزارش نهایی */
  notes: string;
}
interface VerifyFinding {
  /** یک جمله: چه چیزی مشکل است */
  what: string;
  /** شاهد: خروجی دستور، خطای کنسول یا مسیر عکس */
  evidence: string;
  severity: "low" | "medium" | "high";
}
interface BrowserReview {
  ok: boolean;
  findings: VerifyFinding[];
  /** مسیر عکس‌های گرفته‌شده زیر /tmp/nx-pkgs/ */
  shots: string[];
}
interface JudgeVerdict {
  /** مسیر عکسی که داور دید */
  shot: string;
  pass: boolean;
  /** ایرادها به فارسی؛ خالی اگر قبول */
  issues: string;
}
interface WorkflowReport {
  conclusion: string;
  findings: VerifyFinding[];
  verified: string[];
  notCovered: string[];
}

artifact.table("issues", {
  title: "موارد باز به‌روزرسانی پکیج‌ها",
  description: "خطاهای build/typecheck/test، خطاهای کنسول showcase و ایرادهای داوری.",
  columns: [
    { field: "what", label: "مورد" },
    { field: "evidence", label: "شاهد" },
    { field: "severity", label: "شدت" },
  ],
  key: "what",
});

/** چهارده خانوادهٔ موج‌های ۱-۳ که باید بلاک کتابخانه‌ای شوند. */
const FAMILIES = [
  { id: "heroes", show: "HeroesBlocks", labelFa: "هیروها", labelEn: "Heroes", js: false, spec: "از دموهای گروه heroes پلی‌گراوند تقطیر کن: HeroSpotlight (نورافکن موس + پس‌زمینهٔ مش)، HeroSplit (متن + ماکاپ کج با هاله و چیپ‌های شناور)، HeroMarquee (تیتر + نوار بی‌نهایت لوگو). props: عنوان/زیرعنوان/لیبل دکمه‌ها/لوگوها؛ i18n با useT." },
  { id: "navbars", show: "NavbarsBlocks", labelFa: "نوبارها", labelEn: "Navbars", js: false, spec: "NavbarFloating (قرص شناور با اندیکاتور لغزان و جمع‌شدن با اسکرول داخل ظرف)، NavbarGlass (شیشه‌ای روی هیرو)، NavbarMega (مگامنوی هاوری با Escape). هرکدام با لینک‌ها/لوگو/CTA به‌عنوان props." },
  { id: "footers", show: "FootersBlocks", labelFa: "فوترها", labelEn: "Footers", js: false, spec: "FooterWordmark (وردمارک غول outline + ستون‌های لینک)، FooterNewsletter (فرم ایمیل با اعتبارسنجی و پیام موفقیت)، FooterMinimal (تک‌سطری با نقطهٔ وضعیت)." },
  { id: "cta", show: "CtaBlocks", labelFa: "دعوت به کنش", labelEn: "CTA", js: false, spec: "CtaGradient (بنر گرادیانی با جاروی نور + دو دکمه)، CtaTerminal (دستور نصب تایپ‌شونده + دکمهٔ کپی با تیک)، CtaImage (پس‌زمینهٔ صحنه‌ای SVG + آمار)." },
  { id: "scroll", show: "ScrollBlocks", labelFa: "اسکرول", labelEn: "Scroll", js: true, spec: "رفتار مشترک هسته scrollStage(el, {mode}) برای پیشرفت اسکرولِ داخل-تدی (sticky/horizontal/zoom). کامپوننت‌ها: ScrollStack (کارت‌های انبارشونده sticky)، ScrollHorizontal (گالری افقی رانده‌شده با اسکرول عمودی)، ScrollRoadmap (خط پیشرفت + ایستگاه‌ها)." },
  { id: "icons", show: "Icons3dBlocks", labelFa: "آیکون‌های سه‌بعدی", labelEn: "3D icons", js: false, spec: "Icon3d (آیکون SVG سه‌بعدی تک با name/size/tilt — دست‌کم ۱۰ نام: rocket, chart, shield, cloud, message, gear, lock, camera, battery, search) + Icon3dRow (ردیف قابلیت با تیلت هاور). گرادیان‌ها با id یکتا (useId)." },
  { id: "icon-motion", show: "IconMotionBlocks", labelFa: "آیکون‌های متحرک", labelEn: "Animated icons", js: true, spec: "رفتار هسته drawIn(el, {stagger}) برای ترسیم stroke-dash با IntersectionObserver. کامپوننت‌ها: IconDraw (ست آیکون خطی ترسیم‌شونده در دید)، IconToggleState (قلب/زنگ/بوکمارک مورف حالت با aria-pressed)، IconLoop (اسپینرهای حلقه‌ای درون دکمه/کارت وضعیت)." },
  { id: "text-fx", show: "TextFxBlocks", labelFa: "جادوی متن", labelEn: "Text FX", js: false, spec: "TextGradientFlow (گرادیان جاری درون حروف + سرعت)، TextOutlineFill (دورق که با hover/scroll پر می‌شود)، TextExtrude (برجستهٔ سه‌بعدی با تیلت موس). فارسی: هیچ‌جا حرف‌به‌حرف نشکن — سطح واژه." },
  { id: "loaders", show: "LoadersBlocks", labelFa: "بارگذارها", labelEn: "Loaders", js: false, spec: "LoaderOrbit (نقطه‌های مداری درون دکمهٔ واقعی‌کار)، LoaderRing (حلقهٔ مورف با درصد و حالت خطا)، LoaderLiquid (پُرشدن مایع با موج). همه با label و حالت‌های idle/running/success/error." },
  { id: "motion-fx", show: "MotionFxBlocks", labelFa: "حرکت‌های تعاملی", labelEn: "Motion FX", js: true, spec: "رفتار هسته pointerSpot(el, {radius}) برای نورافکن دنبال‌کننده. کامپوننت‌ها: SpotlightGrid (گرید کارت با نورافکن)، CursorHalo (حلقهٔ کرسر با حالت‌ها — بدون position:fixed، فقط داخل ظرف خودش)، MarqueeRows (دیوار مارکی چندردیفه با جهت/سرعت)." },
  { id: "maps", show: "MapsBlocks", labelFa: "نقشه", labelEn: "Maps", js: false, spec: "نقشهٔ SVG دست‌ساز شهر (بی‌نام/جهانی) به‌صلهٔ دیتا. MarkerMap (مارکرها با پاپ‌اور)، RouteMap (مسیر ترسیم‌شونده + ایستگاه‌ها + ETA)، StoreLocator (لیست + فیلتر + انتخاب). همه SVG inline با id های useId." },
  { id: "shaders", show: "ShadersBlocks", labelFa: "شیدرها", labelEn: "Shaders", js: true, spec: "رفتار هسته shaderStage(el, {frag, speed, fallback}) بویلرپلیت WebGL1: کامپایل، RAF با توقف در خارج دید و prefers-reduced-motion، فالبک گرادیان، پاک‌سازی کامل. کامپوننت‌ها: ShaderPlasma، ShaderNoise (اسلایدر مقیاس/سرعت)، ShaderRipples (کلیک = موج)." },
  { id: "flows", show: "FlowsBlocks", labelFa: "جریان‌های واقعی", labelEn: "Real flows", js: false, spec: "FlowOnboarding (چهارقدمی با نوار پیشرفت، چیپ‌های انتخاب، خلاصه)، FlowCheckout (سبد→آدرس→پرداخت→تأیید با اعتبارسنجی)، FlowAuthCode (کد ۶رقمی با اتوفوکوس و تایمر). state داخل کامپوننت، انیمیشن قدم با translate." },
  { id: "sections", show: "SectionsBlocks", labelFa: "بخش‌های لندینگ", labelEn: "Landing sections", js: false, spec: "PricingTable (سه پلن + تاگل ماهانه/سالانه + ردیف مقایسه)، FaqSection (آکاردئون نرم تک‌بازشونده)، StatsBand (شمارنده‌های در-دید با useBehavior(reveal))، LogosTrust (گرید لوگو grayscale→رنگ)، TestimonialWall (نقل‌قول درشت + گرید ستاره‌دار)." },
] as const;

const RULES = [
  "قواعد سخت (قرارداد docs/BLOCKS.md — قبل از هر چیز کاملش را بخوان):",
  "- CSS داخل @layer nx.components در فایل packages/core/src/css/blocks/" + "<group>.css" + "؛ فقط توکن‌ها (بدون hex خام)، دو تم، اسم کلاس nx-<block> و nx-<block>-<part>، وضعیت با data-*.",
  "- حرکت: فنرهای استاندارد (--nx-spring-*)، هر جابه‌جایی × var(--nx-motion)، ویژگی‌های منطقی و --nx-dir برای جهت، انیمیشن transform/opacity نه layout.",
  "- رفتار JS هسته: (el, options) => cleanup با پاک‌سازی کامل (شنونده/RAF/observer)؛ الگو: packages/core/src/js/blocks/effects.ts.",
  "- React: کامپوننت‌های تابعی با forwardRef اگر ref معنا دارد، useBehavior برای رفتارها، useT/i18n برای متن‌ها، SmartLink برای لینک‌ها؛ الگو: packages/react/src/blocks/glass.tsx و text.tsx.",
  "- کد از صفر — از دموی پلی‌گراوند «حس و رفتار» را می‌گیری نه کدش را کپی؛ متن‌ها واقعی و جهانی؛ هرگز ایران/تهران.",
  "- هرگز {!! json_encode !!} بحثی نیست (این TS است)؛ تمیز و typecheck-پاک بنویس: strict."
].join("\n");

function buildPrompt(f: (typeof FAMILIES)[number]): string {
  return [
    "خانوادهٔ «" + f.labelFa + "» را به بلاک کتابخانه‌ای تبدیل کن — این موج «به‌روزرسانی پکیج‌ها» است: قابلیت‌هایی که تا حالا فقط دموی پلی‌گراوند بودند باید وارد @nabuxai/ui-core و @nabuxai/ui-react شوند.",
    "",
    "اسکفولد از قبل ساخته شده: فایل‌های خالی و import ها/ثبت‌های showcase موجودند — فقط محتوای فایل‌های خودت را پر کن و هیچ فایل اشتراکی (index ها، App.tsx) را دست نزن.",
    "",
    "فایل‌های تو (همه از قبل خالی/استاب‌اند):",
    "- packages/core/src/css/blocks/" + f.id + ".css" + (f.js ? "\n- packages/core/src/js/blocks/" + f.id + ".ts" : " (رفتار JS برای این خانواده لازم نیست)") ,
    "- packages/react/src/blocks/" + f.id + ".tsx",
    "- apps/showcase/src/blocks/" + f.id + ".tsx (export function " + f.show + "() — استاب return null دارد؛ با دموی واقعی ۲-۴ نمونهٔ خانواده جایگزین کن)",
    "",
    "چه بسازی: " + f.spec,
    "",
    "الگوها را قبل از نوشتن بخوان:",
    "- قرارداد کامل: docs/BLOCKS.md (بخش feel و polish — دقیقاً رعایت شود)",
    "- CSS بلاک: packages/core/src/css/blocks/glass.css و interact.css",
    "- رفتار هسته: packages/core/src/js/blocks/effects.ts و interact.ts" + (f.js ? "" : " (این خانواده رفتار نمی‌خواهد)"),
    "- بلاک React: packages/react/src/blocks/glass.tsx و text.tsx و effects.tsx",
    "- دموی showcase: apps/showcase/src/blocks/glass.tsx و effects.tsx (بافت Section/نمونه‌ها را از آن‌ها بگیر)",
    "- دموی مرجع حس/رفتار در پلی‌گراوند: playground/resources/views/demos/components/" + f.id + "/*.blade.php",
    "",
    RULES,
    "",
    "پس از پر کردن فایل‌ها، این سه را بزن و خطاها را همان‌جا درست کن (خروجی‌ها را بخوان و اصلاح کن تا سبز شود):",
    "- pnpm --filter @nabuxai/ui-core build",
    "- pnpm --filter @nabuxai/ui-react typecheck && pnpm --filter @nabuxai/ui-react build",
    "- pnpm --filter showcase build",
    "",
    "خروجی فقط JSON {files, exports, ok, notes} — exports نام کامپوننت‌های React صادرشده؛ notes فارسی و کوتاه.",
  ].join("\n");
}

phase("اسکفولد مشترک: فایل‌های استاب، ثبت‌ها و نسخه‌ها");
const scaffold = await agent("اسکفول‌ساز", {
  system:
    "تو مهندس ارشد این مونوریپو هستی. این مرحله فقط زیرساخت است: استاب‌ها باید همان لحظه build شوند تا سازنده‌ها بعداً فقط فایل خودشان را پر کنند. به فایل‌های اشتراکی دست می‌زنی اما با کمترین تغییر ممکن.",
}).ask<PhaseResult>(
  [
    "برای ۱۴ خانوادهٔ تازهٔ بلاک، اسکفولد بساز:",
    "",
    "۱) فایل‌های استاب:",
    "- packages/core/src/css/blocks/<id>.css برای هر ۱۴ id: فقط «@layer nx.components { /* TODO */ }»",
    "- packages/core/src/js/blocks/<id>.ts فقط برای id های دارای رفتار (scroll، icon-motion، motion-fx، shaders): فایل خالی معتبر (بدون export لازم نیست ولی باید compile شود)",
    "- packages/react/src/blocks/<id>.tsx برای هر ۱۴: فایل خالی معتبر TSX (بدون export)",
    "- apps/showcase/src/blocks/<id>.tsx: «export function <Show>() { return null; }» با نام‌های: " + FAMILIES.map((f) => f.show).join("، "),
    "",
    "۲) ثبت‌ها (فایل‌های اشتراکی — فقط سطرهای لازم را اضافه کن، به ترتیب الفبا در محل مناسب):",
    "- packages/core/src/css/index.css: @import هر ۱۴ css تازه",
    "- packages/core/src/js/index.ts: export * from './blocks/<id>' فقط برای ۴ id رفتاردار",
    "- packages/react/src/index.ts: export * from './blocks/<id>' برای هر ۱۴",
    "- apps/showcase/src/App.tsx: import هر ۱۴ <Show> + افزودن به BLOCK_GROUPS با id یکتا (مثل 'heroes-blocks')، برچسب fa/en از فهرست زیر و آیکن از آیکن‌های هسته: " +
      FAMILIES.map((f) => f.id + "→«" + f.labelFa + "»/" + f.labelEn).join("، "),
    "",
    "۳) نسخه‌ها: در packages/core/package.json و packages/react/package.json نسخه را 0.1.0 → 0.2.0 کن (بقیهٔ فیلدها دست نخورد).",
    "",
    "۴) راستی‌آزمایی استاب‌ها — هر سه باید بی‌خطا سبز شود (سپس خروجی خطا را درست کن):",
    "- pnpm --filter @nabuxai/ui-core build",
    "- pnpm --filter @nabuxai/ui-react typecheck && pnpm --filter @nabuxai/ui-react build && pnpm --filter @nabuxai/ui-react test",
    "- pnpm showcase:build",
    "",
    "id های ۱۴گانه به همین ترتیب: " + FAMILIES.map((f) => f.id).join("، "),
    "خروجی فقط JSON {files, exports, ok, notes} به فارسی (exports می‌تواند خالی باشد).",
  ].join("\n"),
);
if (!scaffold.ok) {
  report({ what: "اسکفولد ناتمام", evidence: scaffold.notes, severity: "high" }, "issues");
}
log("اسکفولد " + (scaffold.ok ? "سبز" : "ناقص") + " شد؛ ۱۴ سازندهٔ خانواده شروع می‌کنند");

phase("ساخت چهارده خانوادهٔ پکیجی به‌موازاتی");
const settled = await Promise.allSettled(
  FAMILIES.map((f) =>
    agent("سازنده-" + f.id, {
      system:
        "تو سازندهٔ بلاک‌های کتابخانهٔ NabuXUI هستی — کد production-grade که کاربران پکیج مصرفش می‌کنند. فقط فایل‌های خانوادهٔ خودت را پر کن؛ index ها و App.tsx از قبل ثبت شده‌اند و دست نمی‌زنی. اگر قراردادی ناسازگار بود اسکیلیت کن، دور نزن.",
    }).ask<PhaseResult>(buildPrompt(f)),
  ),
);
const builders = settled.map((s, i) => {
  const f = FAMILIES[i];
  if (s.status === "fulfilled") return s.value;
  report({ what: "سازندهٔ " + f.id + " ناتمام ماند", evidence: String(s.reason).slice(0, 300), severity: "high" }, "issues");
  return { files: [], exports: [], ok: false, notes: "اجنت شکست خورد: " + String(s.reason).slice(0, 200) } as PhaseResult;
});

phase("دروازه‌های ساخت پکیج‌ها و حلقهٔ اصلاح");
async function gate(label: string, args: string[]): Promise<string> {
  const r = await world.run("pnpm", args, { timeoutMs: 600000 });
  if (r.exitCode !== 0) {
    report({ what: label + " خراب", evidence: (r.stdout + r.stderr).trim().split("\n").slice(-6).join(" | ").slice(0, 400), severity: "high" }, "issues");
    return label;
  }
  log(label + " سبز");
  return "";
}
let failed: string[] = [];
for (let round = 1; round <= 3; round++) {
  failed = (
    await Promise.all([
      gate("core build", ["--filter", "@nabuxai/ui-core", "build"]),
      gate("react typecheck", ["--filter", "@nabuxai/ui-react", "typecheck"]),
      gate("react build", ["--filter", "@nabuxai/ui-react", "build"]),
      gate("react test", ["--filter", "@nabuxai/ui-react", "test"]),
      gate("showcase build", ["--filter", "showcase", "build"]),
    ])
  ).filter(Boolean);
  if (failed.length === 0) break;
  log("دور " + round + ": " + failed.join(" و ") + " خراب — اصلاح می‌شود");
  const out = await world.run("pnpm", ["--filter", "@nabuxai/ui-react", "typecheck"], { timeoutMs: 600000 });
  await agent("اصلاح‌گر-ساخت-" + round, {
    system:
      "تو تعمیرکار TypeScript/CSS این مونوریپو هستی. فقط فایل‌های مربوط به خطاها را درست کن (بلاک‌های تازه در packages/core و packages/react و apps/showcase). قرارداد docs/BLOCKS.md و الگوی بلاک‌های موجود را حفظ کن؛ فایل index/App فقط اگر مشکل از ثبت است دست بخورد.",
  }).ask(
    "این دروازه‌ها خراب‌اند: " + failed.join("، ") + ". آخرین خروجی خطا:\n" + (out.stdout + out.stderr).trim().split("\n").slice(-40).join("\n").slice(0, 2000) +
      "\nخطاها را یکی‌یکی درست کن تا همهٔ پنج دروازه سبز شود.",
  );
}
log("دروازه‌ها: " + (failed.length === 0 ? "همه سبز" : failed.join("، ") + " هنوز خراب"));

phase("زلزدن هر نمونهٔ ایرانی از فایل‌های تازه");
const newPkgFiles = [
  "packages/core/src/css/blocks",
  "packages/core/src/js/blocks",
  "packages/react/src/blocks",
  "apps/showcase/src/blocks",
];
const iran = await world.run("grep", ["-rEni", "ایران|تهران|Iran|Tehran", ...newPkgFiles]);
if (iran.exitCode === 0) {
  const hitFiles = [...new Set(iran.stdout.trim().split("\n").filter(Boolean).map((l) => l.split(":")[0] ?? ""))].filter(Boolean);
  report({ what: "نمونهٔ ایرانی در فایل‌های پکیج", evidence: iran.stdout.trim().split("\n").slice(0, 4).join(" | "), severity: "high" }, "issues");
  for (const [i, f] of hitFiles.entries()) {
    await agent("پاک‌ساز-ایران-" + i, {
      system: "تو ویراستار محتوای پکیج هستی؛ سیاست: صفر ارجاع به ایران/تهران — مثال‌ها جهانی.",
    }).ask("در " + f + " الگوی ایران/تهران/Iran/Tehran هست (خودت grep کن). با معادل جهانی عوض کن؛ فقط همین فایل.");
  }
} else {
  log("پویش بدون-ایران پاک بود");
}

phase("بازبینی مرورگری showcase: هر ۱۴ بخش تازه");
const browser = await agent("بازبین-پکیج", {
  system:
    "تو راستی‌آزمای مرورگری با playwright هستی. showcase با vite preview سرو می‌شود؛ خودت بالا بیاور و در پایان ببند. ادعا بدون شاهد ممنوع.",
}).ask<BrowserReview>(
  [
    "۱) سرور: pnpm --filter showcase preview -- --port 5198 را در پس‌زمینه اجرا کن (build از قبل سبز است)؛ صبر کن تا http://localhost:5198 جواب بدهد.",
    "۲) از هر ۱۴ بخش تازهٔ بلاک (از منوی showcase — گروه‌های تازهٔ ۰.۲) یک اسکرین‌شات fullPage از خود بخش (نه کل صفحه) بگیر در /tmp/nx-pkg/<id>-light.png؛ برای پنج تای اول (heroes، shaders، sections، flows، motion-fx) یک نسخهٔ تیره هم (دکمهٔ تم یا html[data-theme=dark] در localStorage/attribute — تم سوییچ هسته را از خود صفحه استفاده کن): <id>-dark.png.",
    "۳) خطای کنسول: pageerror و console.error هر ۱۴ بخش را جمع کن — هیچ خطایی قابل‌قبول نیست.",
    "۴) تعامل‌های نمونه: تاگل قیمت PricingTable بچرخد، FAQ باز شود، شیدر کلیک موج بیندازد (عنصر را scrollIntoViewIfNeeded کن)، FlowOnboarding دو قدم جلو رود — هرکدام یک شات *-interact.png.",
    "۵) انگلیسی/فارسی: سوییچ زبان showcase را بزن و یک شات EN از heroes و sections بگیر (<id>-en.png)؛ متن‌ها باید کامل ترجمه باشند.",
    "۶) سرور را kill کن.",
    "",
    "خروجی فقط JSON {ok, findings:[{what, evidence, severity}], shots:[مسیرها]} — findings فارسی.",
  ].join("\n"),
);

phase("اصلاح ایرادهای showcase و بازتأیید ساخت");
const actionable = (browser.findings ?? []).filter((f) => f.severity !== "low").slice(0, 8);
if (actionable.length > 0) {
  for (const [i, f] of actionable.entries()) {
    await agent("اصلاح‌گر-showcase-" + i, {
      system:
        "تو تعمیرکار بلاک‌های showcase هستی؛ فقط مورد اشاره‌شده را در packages/ یا apps/showcase درست کن و قرارداد BLOCKS.md را نگه دار. پس از اصلاح pnpm --filter showcase build را سبز کن و با عکس/پروب تأیید کن.",
    }).ask("ایراد: " + f.what + " — شاهد: " + f.evidence + ". درست کن، تأیید کن، کوتاه نتیجه بگو.");
  }
  const re = await world.run("pnpm", ["--filter", "showcase", "build"], { timeoutMs: 600000 });
  if (re.exitCode !== 0) {
    report({ what: "showcase build پس از اصلاح خراب", evidence: (re.stdout + re.stderr).trim().split("\n").slice(-4).join(" | "), severity: "high" }, "issues");
  }
} else {
  log("ایراد showcase با شدت بالا/متوسط پیدا نشد");
}

phase("داوری بصری مستقل");
const judgeShots = (browser.shots ?? []).filter((s) => s.startsWith("/tmp/nx-pkg/") && !s.endsWith("-interact.png")).slice(0, 20);
let verdicts: JudgeVerdict[] = [];
if (judgeShots.length > 0) {
  const judge = await agent("داور-بصری", {
    system: "تو داور پذیرش بصری هستی و فقط از تصویر قضاوت می‌کنی؛ ادعای ندیده ممنوع. چیدمان شکسته/ناخوانا/تم تیرهٔ خراب/سرریز = مردود؛ سلیقهٔ جزئی = قبول. این بلاک‌های کتابخانه‌اند: یکدستی با زبان طراحی NabuXUI هم مهم است.",
  }).ask<{ verdicts: JudgeVerdict[] }>(
    "این عکس‌ها را با Read یکی‌یکی ببین و دربارهٔ هرکدام حکم بده:\n" + judgeShots.join("\n") +
      "\nخروجی فقط JSON: {verdicts:[{shot, pass, issues}]} — issues فارسی.",
  );
  verdicts = judge.verdicts ?? [];
  for (const v of verdicts.filter((v) => !v.pass)) {
    report({ what: "داوری بصری مردود: " + v.shot, evidence: v.issues, severity: "medium" }, "issues");
  }
} else {
  report({ what: "عکسی برای داوری نماند", evidence: "بازبین شاتی برنگرداند", severity: "high" }, "issues");
}

const failedBuilders = builders.filter((b) => !b.ok);
const problems = [
  ...failed.map((g) => "دروازهٔ " + g),
  ...failedBuilders.map((b) => "سازندهٔ ناقص: " + b.notes),
  ...(browser.findings ?? []).filter((f) => f.severity !== "low").map((f) => f.what),
  ...verdicts.filter((v) => !v.pass).map((v) => "داوری: " + v.shot),
];

await artifact.markdown(
  "report",
  [
    "# به‌روزرسانی پکیج‌ها — ۱۴ خانوادهٔ تازه در ui-core و ui-react",
    "",
    "**نسخهٔ پکیج‌ها 0.1.0 → 0.2.0.** قابلیت‌های موج‌های ۱-۳ که تا حالا فقط دموی پلی‌گراوند بودند، حالا بلاک کتابخانه‌ای واقعی‌اند: CSS در @nabuxai/ui-core، رفتارهای مشترک (scrollStage، drawIn، pointerSpot، shaderStage) و کامپوننت‌های React در @nabuxai/ui-react + بخش‌های showcase.",
    "",
    "دروازه‌های ساخت: " + (failed.length === 0 ? "هر پنج دروازه سبز (core build، react typecheck/build/test، showcase build)" : "باز: " + failed.join("، ")) + ".",
    "",
    "## خانواده‌ها",
    ...FAMILIES.map((f, i) => {
      const b = builders[i];
      return "- " + (b.ok ? "✅" : "❌") + " **" + f.labelFa + "** (" + f.id + ")" + (b.exports.length ? " → " + b.exports.join("، ") : "") + (b.ok ? "" : " — " + b.notes);
    }),
    "",
    "## بازبینی showcase",
    ...((browser.findings ?? []).length === 0 ? ["- مشکلی پیدا نشد."] : (browser.findings ?? []).map((f) => "- " + (f.severity === "high" ? "🔴" : f.severity === "medium" ? "🟠" : "🟡") + " " + f.what + " — " + f.evidence)),
    "",
    "## داوری بصری مستقل (" + verdicts.length + " عکس)",
    ...verdicts.map((v) => "- " + (v.pass ? "✅" : "❌") + " " + v.shot + (v.issues ? " — " + v.issues : "")),
  ].join("\n"),
  { title: "گزارش به‌روزرسانی پکیج‌ها 0.2.0", description: "۱۴ خانوادهٔ بلاک تازه در ui-core/ui-react + showcase — از اسکفولد تا داوری", primary: true },
);

const report_: WorkflowReport = {
  conclusion:
    problems.length === 0
      ? "به‌روزرسانی پکیج‌ها کامل شد: ۱۴ خانوادهٔ تازه به‌صورت بلاک کتابخانه‌ای (CSS هسته + ۴ رفتار مشترک + بلاک‌های React + showcase)، نسخه‌ها 0.2.0، هر پنج دروازهٔ ساخت سبز و داوری بصری قبول."
      : "موج انجام شد اما " + problems.length + " مورد باز دارد: " + problems.slice(0, 5).join("؛ ") + ".",
  findings: [
    ...failed.map((g) => ({ what: "دروازهٔ " + g + " خراب", evidence: "pnpm", severity: "high" as const })),
    ...failedBuilders.map((b) => ({ what: "سازندهٔ ناقص", evidence: b.notes, severity: "high" as const })),
    ...(browser.findings ?? []),
    ...verdicts.filter((v) => !v.pass).map((v) => ({ what: "داوری تصویر " + v.shot, evidence: v.issues, severity: "medium" as const })),
  ],
  verified: [
    "پنج دروازهٔ قطعی با world.run: pnpm build/typecheck/test برای core و react + showcase build (+ حلقهٔ اصلاح تا ۳ دور)",
    "گrep بدون-ایران روی همهٔ فایل‌های تازهٔ پکیج",
    "بازبینی مرورگری vite preview: اسکرین‌شات هر ۱۴ بخش + تیره + EN + تعامل‌های واقعی (تاگل قیمت، FAQ، موج شیدر، دو قدم ویزارد) + خطاهای کنسول",
    "داوری بصری مستقل روی " + verdicts.length + " عکس",
  ],
  notCovered: [
    "بلاک‌های موج ۴ (entrances/hover-fx/ambient/kinetic/micro-fx/depth-3d) هنوز در حال ساخت‌اند و در این به‌روزرسانی نیستند — پورتشان موج بعدی",
    "پورت Vue/Svelte برای این خانواده‌ها (طبق معماری، CSS هسته را مستقیم مصرف می‌کنند — تکه‌کد در دموها هست ولی کامپوننت آماده نه)",
    "به‌روزرسانی وابستگی‌های خارجی (react/vite/…) — عمداً دست نخورد تا ریسک شکست صفر باشد",
  ],
};
return report_;
