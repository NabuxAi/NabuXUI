
<?php
    $fa = app()->getLocale() === 'fa';
    $say = fn (string $en, string $faText) => $fa ? $faText : $en;

    // Latin: letter-level units. Persian: word-level — letters stay joined.
    $units = $fa ? ['قلم', 'فنری', 'اسپرینگ‌تایپ'] : str_split('SPRINGTYPE');
    $plainTitle = $fa ? 'قلم فنری اسپرینگ‌تایپ' : 'SPRINGTYPE';
    $kicker = $say('SPRINGTYPE FOUNDRY · AMSTERDAM & SEOUL', 'حروف‌نگارِ اسپرینگ‌تایپ · آمستردام و سئول');
?>

<style>
    .knel-root {
        --knel-bg: #fffbf5; --knel-stage: #fff; --knel-ink: #292524; --knel-muted: #79716b;
        --knel-border: #eee0cf; --knel-accent: #e11d48;
        display: grid; gap: 1.25rem;
        font-family: 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
        color: var(--knel-ink);
    }
    html[data-theme="dark"] .knel-root {
        --knel-bg: #1c1416; --knel-stage: #22181b; --knel-ink: #fafaf9; --knel-muted: #b8a8a4;
        --knel-border: #3d2c30; --knel-accent: #fb7185;
    }
    @media (prefers-color-scheme: dark) {
        html:not([data-theme="light"]) .knel-root {
            --knel-bg: #1c1416; --knel-stage: #22181b; --knel-ink: #fafaf9; --knel-muted: #b8a8a4;
            --knel-border: #3d2c30; --knel-accent: #fb7185;
        }
    }
    .knel-stage {
        display: grid; gap: 1.5rem; justify-items: center;
        padding: clamp(1.6rem, 5vw, 2.8rem) 1.15rem 1.6rem;
        border: 1px solid var(--knel-border); border-radius: 1.25rem;
        background:
            radial-gradient(120% 80% at 50% -10%, color-mix(in oklab, var(--knel-accent) 7%, transparent), transparent 60%),
            var(--knel-stage);
        overflow: clip;
    }
    .knel-kicker { margin: 0; font-size: .72rem; font-weight: 700;
                  letter-spacing: .16em; color: var(--knel-muted); text-align: center; }
    .knel-title {
        margin: 0; display: flex; flex-wrap: wrap; justify-content: center;
        gap: 0 .05em; font-weight: 900; line-height: 1.3;
        font-size: clamp(2rem, 9vw, 4.2rem); letter-spacing: .015em;
        max-inline-size: 100%; cursor: default; touch-action: manipulation;
    }
    [dir="rtl"] .knel-title { gap: 0 .4em; }
    .knel-u { position: relative; display: inline-block; white-space: pre;
              will-change: transform; }
    .knel-u:hover { z-index: 1; }
    .knel-sub { margin: 0; font-size: .82rem; color: var(--knel-muted); text-align: center; }
    .knel-dock {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
        gap: .6rem 1.1rem; padding: .55rem 1rem; border-radius: 999px;
        background: var(--knel-stage); border: 1px solid var(--knel-border);
        inline-size: fit-content; margin-inline: auto;
        font: 600 .8rem/1.4 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
    }
    .knel-wob { display: inline-flex; align-items: center; gap: .6rem; color: var(--knel-ink); }
    .knel-wob input { inline-size: 9rem; accent-color: var(--knel-accent); cursor: pointer; }
    .knel-wob input:focus-visible { outline: 2px solid var(--knel-accent); outline-offset: 3px; }
    .knel-wob b { font-variant-numeric: tabular-nums; min-inline-size: 4ch; text-align: center;
                  color: var(--knel-accent); direction: ltr; }
    .knel-hint { margin: 0; font-size: .74rem; color: var(--knel-muted); text-align: center;
                 font-family: ui-monospace, monospace; }
    @media (prefers-reduced-motion: reduce) {
        .knel-u { transform: none !important; }
    }
</style>

<section class="pg-box" style="gap: 1.25rem"
    x-data="{
        units: [], raf: 0, io: null, mq: null, onMq: null, visible: true,
        k: 170, c: 10,
        fa: <?php echo \Illuminate\Support\Js::from($fa)->toHtml() ?>,
        faDigits(s) { return this.fa ? s.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]) : s; },
        get wobLabel() { return this.faDigits(String(this.c)); },
        shape(e) { return 'scaleX(' + (1 + .5 * e).toFixed(3) + ') scaleY(' + (1 - .24 * e).toFixed(3) + ')'; },
        enter(i) {
            const u = this.units[i];
            if (this.mq.matches) { u.el.style.transform = this.shape(1); return; }
            u.over = true; this.run();
        },
        leave(i) {
            const u = this.units[i];
            if (this.mq.matches) { u.el.style.transform = ''; return; }
            u.over = false; this.run();
        },
        frame() {
            let live = false;
            const dt = 1 / 60;
            this.units.forEach((u) => {
                const target = u.over ? 1 : 0;
                u.v += (this.k * (target - u.e) - this.c * u.v) * dt;   // damped spring
                u.e += u.v * dt;
                if (Math.abs(u.v) < .002 && Math.abs(target - u.e) < .002) { u.v = 0; u.e = target; }
                else live = true;
                u.el.style.transform = u.e === 0 ? '' : this.shape(u.e);
            });
            if (!live) { this.raf = 0; return; }   // every spring settled → park the loop
            this.raf = requestAnimationFrame(() => this.frame());
        },
        run() {
            cancelAnimationFrame(this.raf); this.raf = 0;
            if (this.mq.matches || !this.visible) return;
            this.raf = requestAnimationFrame(() => this.frame());
        },
        init() {
            this.mq = matchMedia('(prefers-reduced-motion: reduce)');
            this.onMq = () => {
                if (this.mq.matches) this.units.forEach((u) => { u.el.style.transform = ''; u.over = false; u.e = 0; u.v = 0; });
                this.run();
            };
            this.mq.addEventListener('change', this.onMq);
            this.io = new IntersectionObserver((entries) => {
                this.visible = entries[0].isIntersecting;
                this.run();
            }, { threshold: 0.15 });
            this.io.observe(this.$refs.stage);
            this.units = [...this.$refs.title.querySelectorAll('.knel-u')].map((el) => ({ el, e: 0, v: 0, over: false }));
        },
        destroy() {
            cancelAnimationFrame(this.raf);
            if (this.io) this.io.disconnect();
            if (this.mq && this.onMq) this.mq.removeEventListener('change', this.onMq);
        },
    }">
    <div>
        <h3 class="pg-title" style="font-size: var(--nx-text-xl)"><?php echo e($say('Letters that snap back like rubber', 'حروفی که مثل لاستیک برمی‌گردند')); ?></h3>
        <p style="margin: .25rem 0 0; color: var(--nx-text-muted)">
            <?php echo e($say('Hover a unit and it pulls into a stretched shape; let go and a real damped spring — stiffness 170, damping from the Wobble slider — wobbles it back onto its baseline. Latin units are letters; Persian units are whole words, never broken letters. The frame loop parks itself once every spring has settled, sleeps off screen, and under reduced motion the stretch lands instantly with no shimmy.', 'واحدی را هاور کنید تا کشیده شود؛ رها کنید تا یک فنر میرای واقعی — سختی ۱۷۰، میرایی از اسلایدر لرزش — آن را لرزاند و سر خطش بنشاند. واحد لاتین حرف است؛ واحد فارسی واژهٔ کامل، بدون شکستن حروف. حلقهٔ فریمی وقتی همهٔ فنرها بنشینند پارک می‌شود، بیرون از دید می‌خوابد و در حرکت کاهش‌یافته کشش بی‌لرزش و لحظه‌ای فرود می‌آید.')); ?>

        </p>
    </div>

    <div class="knel-root">
        <div class="knel-stage" x-ref="stage">
            <p class="knel-kicker"><?php echo e($kicker); ?></p>
            <h4 class="knel-title" x-ref="title" aria-label="<?php echo e($plainTitle); ?>">
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php $__currentLoopData = $units; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $i => $u): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
                    <span class="knel-u" aria-hidden="true"
                        x-on:pointerenter="enter(<?php echo e($i); ?>)" x-on:pointerleave="leave(<?php echo e($i); ?>)"><?php echo e($u); ?></span>
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::endLoop(); ?><?php endif; ?><?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::closeLoop(); ?><?php endif; ?>
            </h4>
            <p class="knel-sub">
                <?php echo e($say('Variable fonts with a bounce — drag your pointer across the wordmark.', 'قلم‌های متغیر با جهش — نشانگر را روی واژه‌نگار بکشید.')); ?>

            </p>
        </div>

        <div class="knel-dock">
            <label class="knel-wob">
                <?php echo e($say('Wobble', 'لرزش')); ?>

                <input type="range" min="4" max="24" step="1" value="10" x-model.number="c">
                <b x-text="wobLabel"></b>
            </label>
            <span style="color: var(--knel-muted)"><?php echo e($say('low damping = long shimmy', 'میرایی کم = لرزش بلندتر')); ?></span>
        </div>

        <p class="knel-hint">
            <?php echo e($say('k 170 · c from slider · scaleX 1.5 / scaleY .76 · idle-parked rAF · instant under reduced motion', 'k برابر ۱۷۰ · c از اسلایدر · scaleX ۱٫۵ / scaleY ۰٫۷۶ · rAF پارک‌شده در سکون · بی‌لرزش در حرکت کاهش‌یافته')); ?>

        </p>
    </div>
</section>
