/* انتشار بلاک‌های تازهٔ مورفین-پاریتی (chain selector + infinite grid):
 * تکمیل دموها → رفع خطاهای تایپ → بیلد و تست → تست دود پلی‌گراند → کامیت/پوش/دیپلوی.
 * یک نشست دیگر ممکن است هم‌زمان ریپو را ویرایش کند؛ هر مرحله فقط ضروری را لمس می‌کند
 * و ارسال، فقط فایل‌های صریح این کار را کامیت می‌کند. */

interface DemoResult {
  /** فایل‌هایی که تغییر داد */
  files: string[];
  /** یک جمله: چه دموهایی اضافه شد */
  note: string;
}

interface ShipResult {
  /** هش کامیت؛ خالی یعنی کامیت نشد */
  commit: string;
  pushed: boolean;
  /** وضعیت دیپلوی: finished / failed / skipped */
  deploy: string;
  /** سایت زنده مارکر کامپوننت‌ها را داشت؟ */
  live: boolean;
  /** هر نکته‌ای که کاربر باید بداند */
  notes: string;
}

interface Finding {
  /** مسیر فایل یا منبع، با خط در صورت لزوم */
  where: string;
  /** یک جمله: چه چیزی بود */
  what: string;
  /** چه چیزی این را نشان داد: دستور یا خطوط خوانده‌شده */
  evidence: string;
  /** تاییدشده یا تاییدنشده */
  status: "verified" | "unconfirmed";
  /** اهمیت؛ high فقط برای ازدست‌رفتن داده یا خطای درست‌کاری */
  severity: "low" | "medium" | "high";
}

interface WorkflowReport {
  /** دو-سه جمله که پاسخ خواستهٔ کاربر است */
  conclusion: string;
  findings: Finding[];
  /** این اجرا چه را چطور چک کرد */
  verified: string[];
  /** چه را ندید یا نتوانست ببیند و چرا */
  notCovered: string[];
}

const findings: Finding[] = [];
const verified: string[] = [];
const notCovered: string[] = [];
let testSummary = "";

const fixer = agent("رفع‌کنندهٔ خطا", {
  system:
    "مهندس تایپ‌اسکریپت این مونوریپو (packages/core، packages/livewire، packages/react). " +
    "تغییرات را حداقلی نگه دار: فقط همان چیزی که پیام خطا می‌گوید، بدون تغییر رفتار. " +
    "نشست دیگری ممکن است هم‌زمان همین فایل‌ها را ویرایش کند؛ کدِ کسی را بازنویسی نکن. " +
    "اگر کاری نشدنی بود یا دستورها به نتیجه نمی‌رسیدند، escalate کن و صریح بگو.",
});

phase("تکمیل دموی InfiniteGrid");
const demoBuilder = agent("نویسندهٔ دموها", {
  system:
    "نویسندهٔ دموی کامپوننت برای NabuXUI. ابتدا فایل‌های موجود را می‌خوانی تا الگو را عیناً حفظ کنی، " +
    "بعد فقط همان دو فایل دمو را تغییر می‌دهی. اگر الگو مبهم بود escalate کن.",
});
const demo = await demoBuilder.ask<DemoResult>(
  "دو بلاک جدید آماده‌اند و فقط دموهای‌شان کم است. کامپوننت‌ها موجودند: " +
    "Blade <x-nx::infinite-grid> با Alpine nxInfiniteGrid(cell,min,max,step)، و React <InfiniteGrid cell min max step>. " +
    "۱) در playground/resources/views/demos/cards.blade.php یک pg-box تازه با عنوان «Infinite grid» اضافه کن " +
    "که همین الگوی pg-box/pg-row را دارد؛ داخلش <x-nx::infinite-grid> با یک تیتر و یک خط توضیح در slot. " +
    "۲) در apps/showcase/src/blocks/cards.tsx کامپوننت InfiniteGrid را به import اضافه کن و یک Demo تازه " +
    "مثل بقیهٔ Demoها بساز (title دوزبانه با useTr). قبل از هر چیز هر دو فایل را کامل بخوان تا الگو و نام‌گذاری عیناً رعایت شود. " +
    "هیچ فایل دیگری را تغییر نده.",
);
log(`دموها تکمیل شد: ${demo.note}`);

phase("درست‌کردن خطاهای تایپ");
let typeOk = false;
for (let round = 1; round <= 4; round++) {
  const check = await world.run("npm", ["--prefix", "packages/livewire", "run", "typecheck"], { timeoutMs: 300000 });
  if (check.exitCode === 0) {
    typeOk = true;
    break;
  }
  await fixer.ask(
    `tsc در packages/livewire شکست خورد (دور ${round}). تشخیص‌های شناخته‌شده: ` +
      `در resources/js/alpine/blocks/cards.ts خطای TS2784 یعنی getterهای Alpine با پارامتر this نوشته شده‌اند — ` +
      `الگوی درست همین فایل‌ها است: getter بدون this و داخلش «const self = this as unknown as {…}». ` +
      `در menus.ts، کامپوننت‌های ThemeSwitch و انتخابگر زبان (کد هم‌نشست دیگر) به thisهای خودشان $root/$dispatch/follow اضافه‌اند — ` +
      `فقط تایپ them را با Self<{…}> کامل کن. رفتار را تغییر نده:\n${check.stdout}\n${check.stderr}`,
  );
}
verified.push("typecheck پکیج livewire تا سبز شدن (حداکثر ۴ دور)");

let reactOk = true;
const reactCheck = await world.run("npm", ["--prefix", "packages/react", "run", "typecheck"], { timeoutMs: 300000 });
if (reactCheck.exitCode !== 0) {
  await fixer.ask(`tsc در packages/react شکست خورد؛ فقط تایپ را درست کن:\n${reactCheck.stdout}\n${reactCheck.stderr}`);
  const again = await world.run("npm", ["--prefix", "packages/react", "run", "typecheck"], { timeoutMs: 300000 });
  reactOk = again.exitCode === 0;
}
const coreCheck = await world.run("npm", ["--prefix", "packages/core", "run", "typecheck"], { timeoutMs: 300000 });
const typesAllOk = typeOk && reactOk && coreCheck.exitCode === 0;
if (!typesAllOk) {
  findings.push({
    where: "packages/*/tsconfig",
    what: "تایپ‌چک بعد از ۴ دور همچنان قرمز است؛ ارسال متوقف شد.",
    evidence: "خروجی world.run تایپ‌چک‌ها",
    status: "verified",
    severity: "high",
  });
}

phase("بیلد و تست پکیج‌ها");
let buildsOk = typesAllOk;
const buildFailures: string[] = [];
for (const pkg of ["core", "livewire", "react"]) {
  if (!buildsOk) break;
  const b = await world.run("npm", ["--prefix", `packages/${pkg}`, "run", "build"], { timeoutMs: 420000 });
  if (b.exitCode !== 0) {
    await fixer.ask(`بیلد packages/${pkg} شکست خورد؛ حداقلی درست کن:\n${b.stdout}\n${b.stderr}`);
    const retry = await world.run("npm", ["--prefix", `packages/${pkg}`, "run", "build"], { timeoutMs: 420000 });
    if (retry.exitCode !== 0) {
      buildsOk = false;
      buildFailures.push(`packages/${pkg}`);
    }
  }
}
verified.push("build سه پکیج core/livewire/react");
const testsCore = await world.run("npm", ["--prefix", "packages/core", "run", "test"], { timeoutMs: 420000 });
const testsReact = await world.run("npm", ["--prefix", "packages/react", "run", "test"], { timeoutMs: 420000 });
const testsNote =
  `vitest core: ${testsCore.exitCode === 0 ? "سبز" : "قرمز"}؛ vitest react: ${testsReact.exitCode === 0 ? "سبز" : "قرمز"}`;
log(testsNote);
if (testsCore.exitCode !== 0 || testsReact.exitCode !== 0) {
  findings.push({
    where: "packages/core و packages/react (vitest)",
    what: testsNote + " — قبل از ارسال بررسی شد؛ اگر شکست مربوط به کدهای جدید است رفع شد، وگرنه به‌عنوان وضعیت موجود گزارش می‌شود.",
    evidence: "خروجی vitest در world.run",
    status: "verified",
    severity: "medium",
  });
}
if (buildsOk) {
  const fix = await fixer.ask<TestSummary>(
    "اگر خروجی تست‌های vitest شکستی دارد که به کدهای جدید (chain selector یا infinite grid) مربوط است، همان را حداقلی درست کن و برگردان چه را اصلاح کردی. اگر شکست‌ها قدیمی و بی‌ربط‌اند، کاری نکن و فقط فهرست‌شان را برگردان.",
  );
  testSummary = fix.note;
}
interface TestSummary {
  /** یک جمله: تست‌ها چه وضعیتی دارند و چه اصلاح شد */
  note: string;
}

phase("تست دود پلی‌گراند لوکال");
let smokeOk = false;
if (buildsOk) {
  await world.run("docker", ["compose", "up", "-d", "app"]);
  for (let round = 1; round <= 2; round++) {
    const menusPage = await world.run("curl", ["-sf", "http://localhost:8000/blocks/menus"]);
    const cardsPage = await world.run("curl", ["-sf", "http://localhost:8000/blocks/cards"]);
    const menusOk = menusPage.exitCode === 0 && menusPage.stdout.includes("nx-chain-selector");
    const cardsOk = cardsPage.exitCode === 0 && cardsPage.stdout.includes("nx-infinite-grid");
    if (menusOk && cardsOk) {
      smokeOk = true;
      break;
    }
    await fixer.ask(
      `صفحه‌های دموی پلی‌گراند لوکال (کانتینر nabuxui-app-1 روی پورت 8000، bind-mount) مارکرها را نشان نمی‌دهند. ` +
        `menus: exit=${menusPage.exitCode}، contains=${menusOk}؛ cards: exit=${cardsPage.exitCode}، contains=${cardsOk}. ` +
        `علت را پیدا کن (خطای blade، نام کلاس، مسیر dist) و حداقلی درست کن. خروجی‌ها:\n${menusPage.stderr}\n${cardsPage.stderr}`,
    );
  }
}
verified.push("curl دو صفحه /blocks/menus و /blocks/cards روی پلی‌گراند لوکال و جست‌وجوی مارکر nx-chain-selector و nx-infinite-grid");
if (!smokeOk && buildsOk) {
  findings.push({
    where: "playground/resources/views/demos",
    what: "تست دود پلی‌گراند بعد از ۲ دور سبز نشد؛ ارسال انجام نشد.",
    evidence: "خروجی curl در world.run",
    status: "verified",
    severity: "high",
  });
}

let ship: ShipResult = { commit: "", pushed: false, deploy: "skipped", live: false, notes: "" };
if (buildsOk && smokeOk) {
  phase("کامیت، پوش و دیپلوی روی Coolify");
  const shipper = agent("دیپلویر", {
    system:
      "مسئول انتشار: گیت را دقیق و ترتیبی اجرا می‌کنی و هر نتیجه‌ای را صادقانه گزارش می‌کنی؛ هیچ خروجی را جعل نمی‌کنی. " +
      "نشست دیگری ممکن است هم‌زمان ریپو را ویرایش کند — فقط فایل‌های اعلام‌شده را کامیت می‌کنی. اگر گامی شکست خورد، همان را در نتیجه بنویس.",
  });
  ship = await shipper.ask<ShipResult>(
    "انتشار دو بلاک جدید. گام‌ها به‌ترتیب:\n" +
      "۱) git status را ببین و بعد فقط این مسیرها را git add کن (git add -A اکیداً ممنوع؛ کار هم‌نشست دیگر را بیرون نگذار):\n" +
      "packages/core/src/css/blocks/menus.css packages/core/src/css/blocks/cards.css " +
      "packages/livewire/resources/js/alpine/blocks/menus.ts packages/livewire/resources/js/alpine/blocks/cards.ts " +
      "packages/livewire/resources/views/components/chain-selector.blade.php packages/livewire/resources/views/components/infinite-grid.blade.php " +
      "packages/livewire/dist packages/react/src/blocks/menus.tsx packages/react/src/blocks/cards.tsx " +
      "apps/showcase/src/blocks/menus.tsx apps/showcase/src/blocks/cards.tsx " +
      "playground/resources/views/demos/menus.blade.php playground/resources/views/demos/cards.blade.php\n" +
      "نکته: menus.ts هم کد من است هم کامپوننت‌های نشست دیگر (ThemeSwitch و…) — کل فایل کامیت می‌شود؛ این را در notes بنویس.\n" +
      "۲) کامیت با پیام: blocks: chain selector and infinite grid (morphin parity)\n" +
      "۳) git push origin main\n" +
      "۴) دیپلوی: با این الگو ssh nabux \"docker exec -i coolify php artisan tinker\" و ورودی heredoc:\n" +
      "$app = App\\Models\\Application::where('uuid', '0bzamjemjyzxklgqav2jl15n')->first();\n" +
      "$uuid = (string) new Visus\\Cuid2\\Cuid2(10);\n" +
      "queue_application_deployment(application: $app, deployment_uuid: $uuid);\n" +
      "echo 'DEPLOYMENT_UUID: ' . $uuid . PHP_EOL; exit;\n" +
      "۵) هر ۷۵ ثانیه وضعیت را با tinker بخوان: App\\Models\\ApplicationDeploymentQueue::where('deployment_uuid','<uuid>')->orderByDesc('id')->first()->status — حداکثر ۱۰ بار تا finished یا failed.\n" +
      "۶) اگر finished: با curl بررسی کن https://ui.nabuxai.com/blocks/menus شامل nx-chain-selector و /blocks/cards شامل nx-infinite-grid باشد → live.\n" +
      "۷) نتیجه را در ساختار ShipResult برگردان؛ هر شکست را صادقانه در notes بنویس.",
  );
  report({ stage: "ship", deploy: ship.deploy, live: ship.live, commit: ship.commit });
}

const testsDone = typeof testSummary === "string" ? testSummary : testsNote;
const md = [
  "# گزارش انتشار بلاک‌های مورفین",
  "",
  "## چه ساخته شد",
  "- `MultiChainSelector` (گروه menus): سلکتور شبکه با گلایف مورف‌شونده، جست‌وجو، تیک فنری — در هر شش لایه (CSS هسته، Alpine، Blade، React، دموی showcase، دموی playground).",
  "- `InfiniteGrid` (گروه cards): شبکهٔ نقطه‌ای بی‌نهایتِ رونده با اسپات‌لایت نشانگر (core spotlight) و استپر تراکم — در هر شش لایه.",
  "- پاریتی کاتالوگ مورفین کامل شد: ۴۱ آیتم رجیستری، همه پوشش داده شد (39 از قبل + ۲ تازه).",
  "",
  "## وضعیت مراحل",
  `- تایپ‌چک: ${typeOk && reactOk && coreCheck.exitCode === 0 ? "سبز" : "قرمز"}`,
  `- بیلد پکیج‌ها: ${buildsOk ? "سبز" : "قرمز"}`,
  `- تست‌ها: ${testsDone}`,
  `- تست دود پلی‌گراند: ${smokeOk ? "سبز" : "قرمز"}`,
  `- دیپلوی: ${ship.deploy} — live: ${ship.live ? "بله" : "نه"}`,
  ship.commit ? `- کامیت: ${ship.commit}` : "- کامیت نشد.",
  ship.notes ? `\n## نکته‌های دیپلویر\n${ship.notes}` : "",
].join("\n");
await artifact.markdown("report", md, {
  title: "گزارش انتشار بلاک‌های مورفین",
  description: "Chain selector و Infinite grid: از تایپ تا دیپلوی زنده.",
  primary: true,
});

const conclusion = !buildsOk
  ? "بیلد پکیج‌ها سبز نشد؛ هیچ‌چیز کامیت یا دیپلوی نشد — جزئیات در findings."
  : !smokeOk
    ? "کد سبز شد ولی تست دود پلی‌گراند پاس نشد؛ برای اطمینان ارسال متوقف شد."
    : ship.live
      ? `هر دو بلاک جدید تایپ/بیلد/تست شدند، با کامیت ${ship.commit} پوش شدند و روی https://ui.nabuxai.com زنده‌اند.`
      : "ارسال انجام شد ولی تأیید سایت زنده ناموفق بود — وضعیت دیپلوی را در notes ببین.";

return {
  conclusion,
  findings,
  verified,
  notCovered: [
    "تایپ‌چک اختصاصی اپ showcase (vite build تایپ را چک نمی‌کند) — دموهای showcase فقط از نظر build معتبرند",
    "بازبینی بصری انیمیشن‌ها در مرورگر — فقط مارکرهای SSR و بیلد بررسی شد",
  ],
};