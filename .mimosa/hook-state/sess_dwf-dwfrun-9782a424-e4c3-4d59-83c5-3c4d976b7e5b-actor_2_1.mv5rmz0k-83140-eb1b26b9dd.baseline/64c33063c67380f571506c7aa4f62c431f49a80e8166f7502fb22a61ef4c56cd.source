interface ImplResult {
  /** دو سه جمله: چه ساخته شد و حرکتش چطور است. */
  summary: string;
  /** مسیر فایل‌هایی که ساختی/ویرایش کردی. */
  files: string[];
  /** نکته یا ریسکی برای یکپارچه‌ساز/بازبین. */
  notes: string;
}

interface ReviewFinding {
  /** مسیر فایل و در صورت لزوم شماره خط. */
  file: string;
  /** یک جمله: مشکل چیست. */
  problem: string;
  severity: "low" | "medium" | "high";
}

interface ReviewResult {
  findings: ReviewFinding[];
  overall: string;
}

interface WorkflowReport {
  conclusion: string;
  findings: Array<{ where: string; what: string; evidence: string; status: "verified" | "unconfirmed"; severity: "low" | "medium" | "high" }>;
  verified: string[];
  notCovered: string[];
}

const CONTEXT = `مخزن: NabuXUI (monorepo pnpm) — سیستم طراحی با یک زبان حرکت مشترک برای Livewire و React و (از طریق CSS مشترک) Vue/Svelte.
الهام این کار: گالری «Animated Backgrounds» سایت motionsites.ai — سیاه‌چاله، ذرات، موج ابریشم، ابرها — که آنجا به‌صورت ویدیوی پولی فروخته می‌شود؛ ما معادل کد-بومی و سبک آن را می‌سازیم: بلوک‌های پس‌زمینهٔ متحرک خالص CSS (و در یک مورد رفتار JS کوچک از هسته) که پشت هر محتوایی می‌نشینند.

فایل‌هایی که باید قبل از نوشتن بخوانی:
- docs/BLOCKS.md — قواعد ساخت بلوک (لایه‌ها، فنرها، --nx-motion، RTL، reveal).
- packages/core/src/css/blocks/glass.css — برای دیدن سبک کامنت بنر و @layer nx.components.
- packages/core/src/css/components/hero.css — پس‌زمینه‌های Aurora/Beams/Dots/Grid/Stars فعلیِ hero؛ بگذار الهام بگیری اما بلوک تازه مستقل است و کلاس‌هایش با پیشوند nx-backdrop- شروع می‌شوند.
- packages/core/src/css/base.css و tokens.css — توکن‌ها، --nx-dir، --nx-motion.
- packages/react/src/blocks/glass.tsx — الگوی کامپوننت React بلوک.
- packages/livewire/resources/views/components/backdrop.blade.php و dither-backdrop.blade.php — از قبل وجود دارند! اول بخوانشان؛ اگر همان نیاز را می‌پوشانند، فقط variant تازه به همان فایل‌ها اضافه کن، نه فایل تازه.

قواعد سخت:
- فقط فایل‌های تعیین‌شدهٔ خودت. فایل‌های مشترک (index.css، index.ts ها، App.tsx) را ویرایش نکن — یکپارچه‌ساز وصل می‌کند.
- توکن‌ها فقط؛ بدون hex مستقیم (رنگ‌ها از --nx-lapis-500، --nx-violet-500، --nx-cyan-500، --nx-gold-500 و color-mix).
- هر انیمیشن بی‌نهایت زیر prefers-reduced-motion: reduce متوقف یا به fade ساده تبدیل شود؛ فاصله‌های حرکت در --nx-motion ضرب شوند.
- aria-hidden="true" روی لایه‌های تزئینی و pointer-events: none؛ محتوا بالای آن‌ها.
- با grep مطمئن شو نام کلاس‌های تازه با هیچ کلاس موجود برخورد ندارد.`;

const VARIANTS = [
  {
    key: "aurora",
    title: "آرورا",
    spec: `# پس‌زمینهٔ «آرورا» — پرده‌های گرادیانی شناور
سه لایهٔ بیضی‌مانند بزرگ با گرادیان‌های رنگی توکنی (لپیسی/بنفش/فیروزه‌ای)، هرکدام blur(60px~90px) و opacity کم، با انیمیشن آهستهٔ drift/rotate بی‌نهایت (مدت 20s~35s، easing سهوی، تفاوت فاز بین لایه‌ها). ترکیب روی هم باید در هر دو تم روشن و تیره خوانا باشد (در تیره opacity بیشتر، در روشن کمتر — با توکن‌های موجود تم). زیر reduce: حرکت متوقف و فقط گرادیان ساکن.`,
  },
  {
    key: "starfield",
    title: "میدان ستاره",
    spec: `# پس‌زمینهٔ «میدان ستاره» — ستاره‌های پارالاکس‌دار، CSS خالص
سه لایهٔ box-shadow نقاط ستاره (هر لایه با اندازه/چگالی متفاوت: دور/ریز/کم‌نور، میانه، نزدیک/درشت/پرنور) که با انیمیشن translate عمودیِ بی‌نهایت و سرعت‌های متفاوت حس عمق می‌دهند (پارالاکس). رنگ ستاره‌ها از توکن متن/سطح. جلوهٔ چشمک‌زن اختیاری روی لایهٔ نزدیک با انیمیشن opacity دیرتکرار. زیر reduce: انیمیشن‌ها متوقف.`,
  },
  {
    key: "mesh",
    title: "مش گرادیان",
    spec: `# پس‌زمینهٔ «مش گرادیان» — لکه‌های رنگی روان
چهار-پنج radial-gradient با رنگ‌های توکنی در نقاط مختلف، هرکدام در یک div لایه‌ای که با انیمیشن آهستهٔ translate/scale جابه‌جا می‌شود و با filter: blur و mix-blend-mode (مثلاً soft-light یا screen بسته به تم) ترکیب می‌شود؛ نتیجه حس mesh gradient زنده. زیر reduce: ساکن.`,
  },
  {
    key: "dither",
    title: "دایتر موج‌دار",
    spec: `# پس‌زمینهٔ «دایتر موج‌دار» — بافت نقطه‌ای متحرک
بافت نقطه‌ای با background-image از radial-gradient تکرارشونده (نقطه‌های ریز توکنی) روی دو لایه با زاویه‌های متفاوت که با انیمیشن background-position موج‌مانند جابه‌جا می‌شوند؛ یک mask گرادیانی لبه‌ها را محو می‌کند تا حس دایتر/ریتم بدهد. اول dither-backdrop.blade.php موجود را بخوان — اگر قابل توسعه است همان را گسترش بده وگرنه variant تازه. زیر reduce: ساکن.`,
  },
];

phase("ساخت چهار پس‌زمینهٔ متحرک به‌موازات");
log("چهار سازنده روی آرورا، میدان ستاره، مش و دایتر کار می‌کنند");
const impls = await Promise.all(
  VARIANTS.map((v) =>
    agent(`سازندهٔ ${v.title}`, {
      system:
        "تو مهندس ارشد دیزاین‌سیستم NabuXUI هستی؛ CSS خالص و سبک با توکن‌های مخزن می‌نویسی و به زبان حرکت آن پایبندی. اگر چیزی ناسازگار بود، دور نزن و گزارشش کن.",
    }).ask<ImplResult>(
      `${CONTEXT}

# مأموریت تو: ${v.title}
${v.spec}

خروجی مورد انتظار:
1. یک بخش تازه در فایل CSS بلوک‌های پس‌زمینه (packages/core/src/css/blocks/backdrops.css — فایل تازه؛ اگر تصمیم گرفتی variant موجود را توسعه بده، همان فایل موجود را ویرایش کن و در notes بگو). ساختار مشترک: .nx-backdrop (ظرف position:isolate با اسلات محتوا) و .nx-backdrop-{variant} لایه‌های تزئینی aria-hidden. کامنت بنر توضیحی مثل بقیهٔ بلوک‌ها.
2. کامپوننت React در packages/react/src/blocks/backdrops.tsx (تازه): Backdrop با props { variant?: 'aurora' | 'starfield' | 'mesh' | 'dither' | 'plain', children, className? } که فقط markup می‌ریزد (لایه‌ها را از CSS بساز، نه به‌صورت divهای بی‌شمار — یک div با چند span لایه کافی است). اگر فایل به‌دلیل سازندهٔ دیگر وجود داشت، بخش خودت را جدا و بدون دست‌زدن به بخش او اضافه کن (فایل تازه است؛ تداخل کم است ولی محتاط باش).
3. Blade در packages/livewire/resources/views/components/backdrop-{variant}.blade.php (فایل تازه برای هر variant) — فقط markup و @props ساده ([children slot، class])؛ JS رفتاری لازم نیست مگر واقعاً بخواهی (در notes بگو).
4. Alpine: اگر JS رفتاری لازم نشد، فایل نساز؛ اگر شد در notes توضیح بده (یکپارچه‌ساز وصل می‌کند).

در پایان: summary، files، notes (نام دقیق exportهای React).`,
    ),
  ),
);
impls.forEach((r, i) => {
  const v = VARIANTS[i];
  if (v) report({ variant: v.key, summary: r.summary, files: r.files, notes: r.notes });
});

phase("وصل‌کردن به ایمپورت‌ها و دموها");
const wiring = await agent("یکپارچه‌ساز", {
  system:
    "تو یکپارچه‌ساز مخزن NabuXUI هستی؛ قبل از هر ویرایش فایل را تازه می‌خوانی و فقط تغییر خودت را می‌گذاری.",
}).ask<string>(
  `چهار پس‌زمینهٔ متحرک ساخته شدند. این اتصال‌ها را انجام بده — قبل از هر ویرایش فایل را تازه بخوان:
${JSON.stringify(impls.map((r, i) => ({ variant: VARIANTS[i]?.key, files: r.files, notes: r.notes })), null, 1)}

1. packages/core/src/css/index.css — @import برای backdrops.css (اگر فایل تازه است) بعد از بقیهٔ import های blocks.
2. packages/react/src/index.ts — export * from './blocks/backdrops' (نام دقیق فایل را از notes/فایل واقعی بردار).
3. packages/livewire/resources/js/index.ts — اگر سازنده‌ای رفتار Alpine ساخته، import و نصبش کن؛ وگرنه دست نزن.
4. apps/showcase/src/blocks/backdrops.tsx — فایل تازه: export function BackdropsSection() یا BackdropDemos() (با Section/Demo/useTr الگوی بقیهٔ فایل‌های blocks): چهار Demo، هرکدام یک Backdrop variant با چند خط محتوای نمونه روی آن (مثلاً یک عنوان و دکمه) — عنوان‌ها دوزبانه. سپس در apps/showcase/src/App.tsx فقط import و رندر آن کنار بقیهٔ Sections (پیش از MenusBlocks مناسب است).
5. playground/resources/views/demos/backdrops.blade.php — فایل تازه با چهار باکس pg-box (الگوی demos/menus.blade.php) — هر variant با محتوای نمونه؛ اگر صفحهٔ دمو در playground ناوبری دارد (بررسی کن: routes یا فهرست دموها) به آن هم اضافه کن، وگرنه فقط فایل را بساز و در notes بگو.
خروجی: «فایل → چه تغییر کرد» به‌علاوهٔ هر مشکلی.`,
);
report({ step: "wiring", summary: wiring });
log("اتصال‌ها انجام شد");

phase("بازخوانی مستقل کدهای تازه");
const reviewFiles = impls.flatMap((r) => r.files).concat([
  "packages/core/src/css/index.css",
  "packages/react/src/index.ts",
  "apps/showcase/src/blocks/backdrops.tsx",
  "apps/showcase/src/App.tsx",
]);
const review = await agent("بازبین مستقل", {
  system:
    "تو بازبین مستقلی که هیچ‌کدام از این کدها را ننوشته. فقط فایل‌ها را می‌خوانی و مشکلات واقعی را گزارش می‌کنی؛ هیچ فایلی را ویرایش نمی‌کنی.",
}).ask<ReviewResult>(
  `این فایل‌های تازه را کامل بخوان و فقط مشکلات واقعی را گزارش کن — اجرا را می‌شکنند، دسترس‌پذیری خراب، حرکت با زبان مخزن ناسازگار (فنرها/--nx-motion/reduce)، انیمیشن بی‌نهایتی که زیر prefers-reduced-motion می‌ماند، hex مستقیم به‌جای توکن، تکرار کلاس با کدهای موجود، یا markup معیوب:

${reviewFiles.map((f) => `- ${f}`).join("\n")}

برای هر مورد: file، problem، severity (فقط برای شکستن اجرا «high»). اگر سالم است findings خالی و overall یک جملهٔ قضاوتی.`,
);
report({ phase: "review", overall: review.overall, findings: review.findings });

phase("رفع یافته‌های واقعی بازبینی");
const fixer = agent("رفع‌کننده", {
  system:
    "تو رفع‌کنندهٔ مخزن NabuXUI هستی؛ فقط مشکلات گزارش‌شدهٔ مرتبط با فایل‌های تازهٔ این کار را رفع می‌کنی؛ مورد غلط یا خارج از محدوده را رد می‌کنی و می‌گویی چرا. اگر چکی غیرقابل‌عبور بود، به‌جای جعل، صریح بگو.",
});
const toFix = review.findings.filter((f) => f.severity !== "low");
if (toFix.length > 0) {
  await fixer.ask(
    `بازبین این موارد را گزارش کرده. واقعی‌ها را رفع کن؛ غلط‌ها را رد کن و بگو چرا:
${JSON.stringify(toFix, null, 1)}

فقط فایل‌های تازهٔ پس‌زمینه‌ها و اتصال‌های مستقیم‌شان را ویرایش کن. خروجی: برای هر مورد «رفع شد / رد شد — دلیل».`,
  );
} else {
  log("یافتهٔ فنی برای رفع نبود");
}

phase("تایپ‌چک و بیلد تا سبز شدن");
const checks = [
  { name: "typecheck react", args: ["--filter", "@nabuxai/ui-react", "typecheck"] },
  { name: "typecheck livewire", args: ["--filter", "@nabuxai/ui-livewire-build", "typecheck"] },
  { name: "build livewire dist", args: ["--filter", "@nabuxai/ui-livewire-build", "build"] },
  { name: "build react dist", args: ["--filter", "@nabuxai/ui-react", "build"] },
  { name: "build showcase", args: ["--filter", "showcase", "build"] },
];
let attempts: Array<{ round: number; passed: boolean; detail: string }> = [];
let gateLog: string[] = [];
let green = false;
for (let round = 1; round <= 4 && !green; round++) {
  const failed: Array<{ name: string; stderr: string }> = [];
  for (const c of checks) {
    const r = await world.run("pnpm", c.args, { timeoutMs: 600000 });
    gateLog.push(`${c.name} → exit ${r.exitCode}`);
    if (r.exitCode !== 0) {
      failed.push({ name: c.name, stderr: (r.stderr || r.stdout).slice(-3500) });
      break;
    }
  }
  if (failed.length === 0) {
    green = true;
    attempts.push({ round, passed: true, detail: "هر پنج چک سبز" });
    break;
  }
  attempts.push({ round, passed: false, detail: failed.map((f) => f.name).join("، ") });
  log(`دور ${round}: ${failed.map((f) => f.name).join("، ")} قرمز؛ رفع می‌کنم`);
  await fixer.ask(
    `این چک قرمز است:
${JSON.stringify(failed, null, 1)}

فقط خطاهای مربوط به کار این workflow (پس‌زمینه‌ها و اتصال‌ها) را رفع کن. اگر خطا از تغییرات session موازی در فایل‌های دیگر است، دست نزن و بنویس «خارج از محدوده».`,
  );
}

phase("کامیت و پوش به گیت‌هاب");
let pushed = false;
let pushDetail = "پوش انجام نشد";
if (green) {
  const status = await world.run("git", ["status", "--porcelain"]);
  if (status.stdout.trim() === "") {
    pushDetail = "چیزی برای کامیت نبود";
  } else {
    await world.run("git", ["add", "-A"]);
    const commit = await world.run("git", [
      "commit",
      "-m",
      "blocks: animated backdrops (aurora/starfield/mesh/dither) from motionsites.ai — CSS-native, reduced-motion safe",
    ]);
    gateLog.push(`git commit → exit ${commit.exitCode}`);
    let push = await world.run("git", ["push", "origin", "main"]);
    if (push.exitCode !== 0) {
      await world.run("git", ["pull", "--rebase", "origin", "main"]);
      push = await world.run("git", ["push", "origin", "main"]);
    }
    gateLog.push(`git push → exit ${push.exitCode}`);
    pushed = push.exitCode === 0;
    pushDetail = pushed
      ? `پوش شد: ${(await world.run("git", ["log", "-1", "--format=%h %s"])).stdout.trim()}`
      : `پوش شکست خورد: ${(push.stderr || "").slice(-400)}`;
  }
} else {
  pushDetail = "چک‌ها سبز نشدند؛ پوش نشد";
}
log(pushDetail);
report({ step: "push", pushed, detail: pushDetail });

phase("تهیهٔ گزارش نهایی");
const verified = green ? [...checks.map((c) => `pnpm ${c.args.join(" ")}`), ...gateLog.filter((g) => g.startsWith("git"))] : gateLog;
const result: WorkflowReport = {
  conclusion: green
    ? `چهار پس‌زمینهٔ متحرک (آرورا، میدان ستاره، مش، دایتر) — معادل کد-بومی گالری motionsites.ai — در core/react/livewire ساخته و وصل شد؛ پنج چک سبز شد و ${pushed ? "به origin/main پوش شد." : "پوش نشد — جزئیات در findings."}`
    : "چهار پس‌زمینه ساخته و وصل شد اما چک‌ها سبز نشدند و پوش انجام نشد.",
  findings: [
    ...review.findings.map((f) => ({
      where: f.file,
      what: f.problem,
      evidence: `بازبینی مستقل: ${review.overall}`,
      status: (toFix.some((t) => t.file === f.file && t.problem === f.problem) ? "verified" : "unconfirmed") as "verified" | "unconfirmed",
      severity: f.severity,
    })),
    ...attempts
      .filter((a) => !a.passed)
      .map((a) => ({
        where: "gates",
        what: `دور ${a.round}: ${a.detail}`,
        evidence: "خروجی pnpm به رفع‌کننده داده شد",
        status: "verified" as const,
        severity: (green ? "medium" : "high") as "medium" | "high",
      })),
  ],
  verified,
  notCovered: [
    "بازبینی بصری حرکت‌ها در مرورگر (هر چهار variant در دو تم) — بعد از workflow دستی انجام می‌شود",
    "اثر عملکردی انیمیشن‌های بی‌نهایت روی CPU/GPU در سخت‌افزار کم‌توان — طراحی CSS-خالص و opacity/transform-only نگه داشته شد اما بنچ نشد",
  ],
};

const md = [
  "# پس‌زمینه‌های متحرک MotionSites",
  "",
  result.conclusion,
  "",
  "## variantها",
  ...impls.map((r, i) => `- **${VARIANTS[i]?.title ?? "?"}** — ${r.summary}`),
  "",
  "## اتصال‌ها",
  wiring,
  "",
  "## بازبینی مستقل",
  review.overall,
  ...(review.findings.length > 0 ? ["", ...review.findings.map((f) => `- [${f.severity}] ${f.file}: ${f.problem}`)] : []),
  "",
  "## چک‌ها",
  ...gateLog.map((g) => `- ${g}`),
  "",
  "## گیت",
  pushDetail,
].join("\n");
await artifact.markdown("report", md, {
  title: "گزارش پس‌زمینه‌های متحرک",
  description: "چهار variant، اتصال‌ها، بازبینی، چک‌ها و نتیجهٔ پوش",
  primary: true,
});

return result;