/**
 * پنل مدیریت نابو + دموهای مستقل کامپوننت‌ها
 *
 * سه تحویل: (۱) قطعات جدید پنل (admin-shell، kanban، calendar، chat،
 * timeline-feed، invoice، auth-card) در هسته/Livewire/React؛ (۲) صفحهٔ دموی
 * مستقل برای هر کامپوننت در پلی‌گراوند؛ (۳) پنل مدیریت کامل مثل Vuexy در دو
 * طعمِ کارا (Livewire و React) با سبک و حرکت خودمان و دوزبانهٔ fa/en.
 */

interface BuildResult {
  /** نام‌های قابل‌نمایش هر ویژگی ساخته‌شده (فارسی). */
  features: string[];
  /** مسیرهای workspace-relative که ساختی یا ویرایشستی. */
  filesTouched: string[];
  /** نکته‌ها برای عامل‌های بعدی (فارسی): قرارداد کلاس‌ها، فایل‌های stub، رنگ‌ها و… */
  notes: string;
}

interface Finding {
  /** مسیر نسبی + شمارهٔ خط در صورت امکان: "packages/…/foo.css:42". */
  where: string;
  /** یک جمله: مشکل چیست (نه چگونه حل شود). */
  what: string;
  /** شاهد: خطوط خوانده‌شده یا خروجی دستوری که مشکل را نشان داد. */
  evidence: string;
  /** اهمیت؛ "high" فقط برای خرابی واقعی/داده. */
  severity: "low" | "medium" | "high";
}

interface FixResult {
  /** یافته‌هایی که واقعاً رفع شدند. */
  fixed: Finding[];
  /** یافته‌هایی که رفع نشدند با دلیل. */
  remaining: Finding[];
  filesTouched: string[];
  notes: string;
}

interface Confirmation {
  /** همان where یافتهٔ بررسی‌شده. */
  where: string;
  /** همان what یافتهٔ بررسی‌شده. */
  what: string;
  /** آیا رفع واقعاً انجام شده و درست است؟ */
  confirmed: boolean;
  note: string;
}

interface CommitResult {
  /** هش کامیت (خالی اگر نشد). */
  commitHash: string;
  /** آیا push موفق بود؟ */
  pushed: boolean;
  notes: string;
}

interface DocResult {
  /** مسیر سند نسبت به workspace. */
  adminDocPath: string;
  /** متن markdown گزارش نهایی به فارسی. */
  reportMarkdown: string;
  notes: string;
}

interface ReaderFeedback {
  /** جاهایی که خواننده گیر کرد یا مبهم بود. */
  unclear: string[];
  /** چیزهایی که در گزارش کم بود و خواننده انتظارش را داشت. */
  missing: string[];
}

const COMMON = `
## زمینهٔ مشترک (برای همهٔ وظایف این اجرا)
مخزن: NabuXUI در ریشهٔ workspace — مونوریپوی سیستم طراحی نابو (پن‌پالت pnpm + composer).
- هسته: packages/core (CSS توکن‌ها/حرکت در src/css، رفتارهای JS فریم‌ورک‌نا وابسته در src/js).
- React: packages/react (components در src/components، بلوک‌ها در src/blocks، خروجی‌ها از src/index.ts).
- Livewire/Blade: packages/livewire (کامپوننت‌ها در resources/views/components به‌شکل <x-nx::…>، رفتارهای Alpine در resources/js/alpine — الگوی نصب‌کردن در resources/js/index.ts).
- پلی‌گراوند Laravel: playground (روت‌ها routes/web.php، ویوها resources/views، اجزای Livewire در app/Livewire).
- اپ نمایشی React: apps/showcase (الگوی دو-زبانه‌سازی و theme در src/lang.tsx و src/App.tsx).

قبل از هر کاری این‌ها را بخوان:
1. docs/BLOCKS.md — قرارداد ساخت بلوک: کلاس‌های nx-<block>/nx-<block>-<part>، توکن‌ها (--nx-surface و… نه رنگ خام)، قواعد حرکت (فنرها، --nx-motion، --nx-dir)، پولیش، دسترس‌پذیری و چک‌های تحویل.
2. docs/FRAMEWORKS.md — معماری «یک هسته، پنج حالت» و الگوی دوزبانه fa/en و RTL.
3. یک بلوک موجود مشابه را کامل بخوان (مثلاً packages/livewire/resources/views/components/data-table.blade.php و معادل React در packages/react/src/blocks/data.tsx) و همان سطح کیفیت را تولید کن.

میلهٔ کیفیت (حس انیمیشنی خودمان، بدون اغراق):
- روشن/تیره هر دو از توکن‌ها؛ RTL با propertyهای منطقی و --nx-dir (بدون margin-left چپ‌دست)؛ LTR هم باید درست باشد.
- اعداد فارسی با numberParts/localeDigits (React) یا NabuXUI::formatNumber (Blade)؛ متن دوزبانه fa/en.
- حرکت فنری/FLIP مثل بلوک‌های موجود؛ در prefers-reduced-motion خودکار بی‌اثر می‌شود (از توکن‌ها استفاده کن، انیمیشن دستی نپیچ).
- دسترس‌پذیری: role/aria درست، پیمایش کیبورد، فوکوس؛ برای overlayها از الگوی popover بومی مثل sort-pill استفاده کن.
- خروجی نهایی هر وظیفه: دقیقاً JSON مطابق اسکیمای خواسته‌شده، فیلدها را پر کن و محتوای فایل را در JSON برنگردان.

## ممنوعیت‌های هم‌زمانی (خیلی مهم)
یک workflow موازی دیگر همین حالا روی پس‌زمینه‌های متحرک (backdrops) کار می‌کند. این فایل‌ها را هرگز ویرایش نکن: packages/core/src/css/blocks/backdrops.css، packages/react/src/blocks/backdrops.tsx، packages/livewire/resources/views/components/backdrop-aurora.blade.php و backdrop-dither.blade.php و backdrop-mesh.blade.php و backdrop-starfield.blade.php. خط @import مربوط به backdrops.css در packages/core/src/css/index.css را هم دست‌نخورده بگذار. از آن‌ها در فایل‌های تازه «استفاده» آزاد است، ویرایششان ممنوع.
- هیچ دستور git نزن (no commit/push/checkout/rebase) — کامیت فاز پایانی بر عهدهٔ عامل کامیت‌کار است.
- قبل از ویرایش هر فایلِ موجود، نسخهٔ تازه‌اش را بخوان و کوچک‌ترین ویرایش ممکن را بزن.
`;

const NO_FAKE = "اگر شرط یا درخواستی غیرقابل‌اجراست یا با هم تناقض دارد، صادقانه بگو و escalate کن؛ هرگز نتیجه را جعل نکن.";

function short(out: string): string {
  return out.length > 3000 ? out.slice(-3000) : out;
}

artifact.table("features", {
  title: "قطعات و صفحه‌های ساخته‌شده",
  columns: [
    { field: "feature", label: "ویژگی" },
    { field: "area", label: "بخش" },
    { field: "status", label: "وضعیت" },
  ],
  key: "feature",
});

function reportFeatures(result: BuildResult, area: string): void {
  for (const feature of result.features) {
    report({ feature, area, status: "آماده" }, "features");
  }
}

/* ───────────────────────── فاز ۱: قطعات جدید ───────────────────────── */

phase("ساخت قطعات جدید پنل به‌موازات");

const shellBuilder = agent("سازندهٔ پوستهٔ پنل", {
  system: "سازندهٔ کامپوننت سیستم طراحی NabuXUI هستی؛ با قرارداد docs/BLOCKS.md و حس حرکتی همین مخزن کار می‌کنی. " + NO_FAKE,
});
const boardBuilder = agent("سازندهٔ کانبان و تقویم", {
  system: "سازندهٔ کامپوننت سیستم طراحی NabuXUI هستی؛ با قرارداد docs/BLOCKS.md و حس حرکتی همین مخزن کار می‌کنی. " + NO_FAKE,
});
const chatBuilder = agent("سازندهٔ گفتگو و جریان", {
  system: "سازندهٔ کامپوننت سیستم طراحی NabuXUI هستی؛ با قرارداد docs/BLOCKS.md و حس حرکتی همین مخزن کار می‌کنی. " + NO_FAKE,
});
const invoiceBuilder = agent("سازندهٔ فاکتور و ورود", {
  system: "سازندهٔ کامپوننت سیستم طراحی NabuXUI هستی؛ با قرارداد docs/BLOCKS.md و حس حرکتی همین مخزن کار می‌کنی. " + NO_FAKE,
});

const builderBrief = (extra: string) => `${COMMON}
## وظیفهٔ تو (فقط فایل تازه بساز؛ فایل مشترک موجود را ویرایش نکن — یکپارچه‌سازِ فاز بعد وصل می‌کند)
قطعات زیر را در هر سه لایه بساز: CSS در packages/core/src/css/blocks/<name>.css، Blade در packages/livewire/resources/views/components/<name>.blade.php، React در packages/react/src/blocks/<file>.tsx (خروجی‌های named). اگر رفتار JS لازم شد: رفتار هسته در packages/core/src/js/ (فایل تازه) و پوشش Alpine در packages/livewire/resources/js/alpine/blocks/<name>.ts (فایل تازه، بدون ثبت در index.ts). data-table و sort-pill را به‌عنوان مرجع کیفیت و امضای API ببین.
${extra}
موارد تحویل: دمو درون‌سازی نشده لازم نیست (صفحهٔ دمو فاز بعدی می‌سازد)؛ فقط مطمئن شو import/export و نوع‌ها کامل و تمیزند. یه نمونهٔ کوتاه استفاده (snippet) را در نوتی‌ها بیاور.
${NO_FAKE}`;

const [shell, board, chat, invoice] = await Promise.all([
  shellBuilder.ask<BuildResult>(builderBrief(`
۱) nx-admin-shell — پوستهٔ پنل مدیریت: سایدبار تاشو (کلپس با انیمیشن عرض، نشانگر آیتم فعال با فنر indicator، گروه‌بندی آیتم‌ها، لوگو، حالت موبایل = drawer) + تاپ‌بار (جای search/command، theme-toggle، language-menu، activity-dropdown، avatar منو) + ناحیهٔ محتوا. باید همهٔ صفحهٔ پنل را قاب بگیرد و در RTL/LTR آینه شود. React: AdminShell + AdminSidebar + AdminTopbar.
۲) nx-timeline-feed — جریان فعالیت عمودی: ردیف‌های آیکون+متن+زمان نسبی با reveal پلکانی، خط اتصال گرادیانی، چند tone (موفق/هشدار/اطلاع).`)),
  boardBuilder.ask<BuildResult>(builderBrief(`
۱) nx-kanban — برد ستونی: ستون‌ها با سربرگ و شمارندهٔ رولینگ، کارت‌ها با درگ‌اند‌دراپ بومی HTML5 (جابه‌جایی FLIP)، افزودن کارت سریع، نقطهٔ placeholder متحرک، منوی سه‌نقطه‌ای هر کارت با popover. state از props/Livewire بیاید.
۲) nx-calendar — تقویم ماهانه: گرید ماه با نشانهٔ امروز، رویدادها به‌شکل چیپ‌های رنگی در خانه‌ها، سوئیچ ماه قبلی/بعدی با انیمیشن جهت‌دار (احترام به --nx-dir)، نمای روز انتخاب‌شده. محور date handling را ساده و بدون وابستگی خارجی نگه دار.`)),
  chatBuilder.ask<BuildResult>(builderBrief(`
۱) nx-chat — رابط گفتگو: ستون گفتگوها (جست‌وجو + خوانده‌نشده) + رشتهٔ پیام‌ها (حباب‌ها با انیمیشن ورود، تاریخ‌ جداکننده) + composer (textarea رشدنده + دکمهٔ ارسال با انیمیشن، نشانگر typing سه‌نقطه‌ای). state لوکال/prop؛ بک‌اند نداریم.
۲) nx-invoice — سند فاکتور: سربرگ برند، طرفین، ردیف‌ اقلام با reveal پلکانی، جمع‌ها با عدد رولینگ، وضعیت پرداخت با status-badge، استایل چاپ (@media print).`)),
  invoiceBuilder.ask<BuildResult>(builderBrief(`
۱) nx-auth-card — کارت ورود/ثبت‌نام/فراموشی: چیدمان دوستونه (پنل برند متحرک با backdrop تزئینی + فرم)، فرم‌ها با field/input موجود، حالات login/register/forgot، لینک‌های ردو، دکمهٔ submit با حالت loading (الگوی transaction-button لازم نیست، خودت ساده نگه دار).
۲) nx-empty-state — حالت خالی زیبا برای صفحه‌های پنل (آیکون متحرک CSS + عنوان + توضیح + CTA) که در صفحه‌های بی‌داده به کار می‌رود.`)),
]);

log("چهار سازندهٔ قطعات تمام کردند؛ اتصال به بسته‌ها و اسکلت کاتالوگ دموها شروع می‌شود");

/* ───────────── فاز ۲: اتصال قطعات + اسکلت کاتالوگ دموها (موازی) ───────────── */

phase("اتصال قطعات به بسته‌ها و اسکلت کاتالوگ دموها");

const integrator = agent("یکپارچه‌ساز قطعات", {
  system: "یکپارچه‌ساز سیستم طراحی NabuXUI هستی؛ سیم‌کشی ایمپورت/اکسپورت را دقیق و حداقلی انجام می‌دهی. " + NO_FAKE,
});
const catalogSkeleton = agent("سازندهٔ کاتالوگ دموها", {
  system: "توسعه‌دهندهٔ Laravel/Livewire در پلی‌گراوند NabuXUI هستی؛ صفحات دمو با کیفیت مستندسازی واقعی می‌سازی. " + NO_FAKE,
});

const [wireUp, skeleton] = await Promise.all([
  integrator.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: سیم‌کشی قطعات تازه (خروجی سازنده‌ها پایین) به بسته‌ها
این چهار سازنده فایل‌های تازه ساخته‌اند:
- پوسته: ${JSON.stringify(shell)}
- کانبان/تقویم: ${JSON.stringify(board)}
- گفتگو/جریان: ${JSON.stringify(chat)}
- فاکتور/ورود: ${JSON.stringify(invoice)}
انجام بده (قبل از هر ویرایش فایل را تازه بخوان):
1. packages/core/src/css/index.css — یک @import برای هر CSS تازه (بعد از بلوک‌های موجود؛ خط backdrops را جابه‌جا نکن).
2. packages/react/src/index.ts — export همهٔ کامپوننت‌های React تازه (الگوی موجود را عیناً رعایت کن).
3. packages/livewire/resources/js/index.ts — نصب installerهای Alpine تازه (هر سازنده که فایل alpine/blocks تازه ساخته).
4. اگر سازنده‌ای رفتار هستهٔ تازه در packages/core/src/js ساخته، از بستهٔ هسته هم export شود.
5. برای smoke: pnpm -r --filter ./packages/** run typecheck و بعد pnpm -r --filter ./packages/** run build را اجرا کن؛ خطاهای سیم‌کشی/تایپ را تا سبز شدن رفع کن (فقط در فایل‌های همین اجرا؛ فایل‌های backdrop ممنوع).
${NO_FAKE}`),
  catalogSkeleton.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: اسکلت «کاتالوگ دموهای مستقل کامپوننت‌ها» در پلی‌گراوند
هدف: هر کامپوننت یک صفحهٔ دموی مستقل با سناریوی واقعی داشته باشد.
1. روتهای /components (کاتالوگ) و /components/{group}/{slug} (دموی تک‌کامپوننت) در playground/routes/web.php (این فایل فقط مال توئی در این فاز).
2. کاتالوگ: Livewire جدید App\\Livewire\\ComponentCatalog + ویو — گرید کارت کامپوننت‌ها با جست‌وجوی زنده (input موجود)، فیلتر گروه با chip-filter، نشان JS/خالص-CSS از کاتالوگ FRAMEWORKS.md.
3. منیفست به‌شکل فایل‌های مستقل: playground/app/Support/Demos/<Group>.php که آرایهٔ ['slug' => ['title' => [fa,en], 'oneLiner' => [fa,en], 'js' => bool, 'docs' => …]] برمی‌گرداند؛ کاتالوگ همهٔ فایل‌های این پوشه را با glob ادغام می‌کند (نویسنده‌های گروه بعداً فایل گروه خودشان را می‌سازند).
4. صفحهٔ دموی تک: App\\Livewire\\ComponentDemo + ویوی الگو — عنوان و معرفی دوزبانه، ناحیهٔ «سناریوهای واقعی» که ویوی partial واقعی demos/components/{group}/{slug}.blade.php را include می‌کند، جدول props مهم، تکه‌کد قابل‌کپی (pre + copy-button موجود)، دکمهٔ قبل/بعد در همان گروه، لینک بازگشت به کاتالوگ. دوزبانه با session locale مثل الگوی زبان پلی‌گراوند (language-menu موجود).
5. یک نمونهٔ کامل بساز (slug=button در گروه base با فایل منیفست و ویوی دمو) تا الگو برای بقیه روشن باشد.
6. در welcome پلی‌گراوند (resources/views/welcome.blade.php) بخش لینک‌ها: کاتالوگ دموها + (بعداً) پنل مدیریت — فقط اگر welcome ساختار لینک دارد؛ اگر نداری یک کارت سادهٔ تمیز اضافه کن.
${NO_FAKE}`),
]);

reportFeatures(shell, "قطعات جدید");
reportFeatures(board, "قطعات جدید");
reportFeatures(chat, "قطعات جدید");
reportFeatures(invoice, "قطعات جدید");
reportFeatures(wireUp, "اتصال بسته‌ها");
reportFeatures(skeleton, "کاتالوگ دموها");

const newComponentsBlade = [...shell.filesTouched, ...board.filesTouched, ...chat.filesTouched, ...invoice.filesTouched]
  .filter((p) => p.startsWith("packages/livewire/resources/views/components/"))
  .map((p) => p.replace("packages/livewire/resources/views/components/", "").replace(".blade.php", ""));

/* ───── فاز ۳: دموهای هر گروه + اسکلت پنل لاراول + اسکلت پنل React (موازی) ───── */

phase("نوشتن دموی مستقل هر گروه و اسکلت هر دو پنل");

const demoTextActions = agent("نویسندهٔ دموهای متن و کنش", {
  system: "نویسندهٔ دموی کامپوننت در پلی‌گراوند NabuXUI هستی؛ دمو باید «کاربرد واقعی» را نشان دهد نه فقط پراپ‌ها. " + NO_FAKE,
});
const demoCardsData = agent("نویسندهٔ دموهای کارت و داده", {
  system: "نویسندهٔ دموی کامپوننت در پلی‌گراوند NabuXUI هستی؛ دمو باید «کاربرد واقعی» را نشان دهد نه فقط پراپ‌ها. " + NO_FAKE,
});
const demoMenusGlass = agent("نویسندهٔ دموهای منو و شیشه", {
  system: "نویسندهٔ دموی کامپوننت در پلی‌گراوند NabuXUI هستی؛ دمو باید «کاربرد واقعی» را نشان دهد نه فقط پراپ‌ها. " + NO_FAKE,
});
const demoBase = agent("نویسندهٔ دموهای پایه", {
  system: "نویسندهٔ دموی کامپوننت در پلی‌گراوند NabuXUI هستی؛ دمو باید «کاربرد واقعی» را نشان دهد نه فقط پراپ‌ها. " + NO_FAKE,
});
const livewireAdminArchitect = agent("معمار پنل لاراول", {
  system: "معمار اپلیکیشن Laravel/Livewire هستی؛ پنل مدیریت کامل با سبک NabuXUI می‌سازی. " + NO_FAKE,
});
const reactAdminArchitect = agent("معمار پنل React", {
  system: "معمار اپ React/Vite هستی؛ اپ پنل مدیریت با کامپوننت‌های @nabuxai/ui-react می‌سازی. " + NO_FAKE,
});

const demoBrief = (groups: string, extraNew: string) => `${COMMON}
## وظیفهٔ تو: دموی مستقل تک‌تک کامپوننت‌های گروه‌های ${groups}
اسکلت کاتالوگ آماده است: ${JSON.stringify(skeleton)}
۱) فهرست کامپوننت‌های هر گروه را از ls packages/livewire/resources/views/components و جدول کاتالوگ docs/FRAMEWORKS.md بگیر.
۲) برای هر کامپوننت: مدخل منیفست در playground/app/Support/Demos/<Group>.php + ویوی دمو در playground/resources/views/demos/components/<group>/<slug>.blade.php مطابق الگوی نمونهٔ button که در اسکلت ساخته شده.
۳) هر دمو دو-سه «سناریوی واقعی» داشته باشد (مثلاً data-table = لیست کاربران با جست‌وجو/مرتب‌سازی و دیالوگ تأیید حذف؛ chip-filter = فیلتر فروشگاه واقعی). متن‌ها fa، اعداد فارسی، سناریوها متنوع و معنادار — نه سه بار همان کامپوننت با پراپ متفاوت. تکه‌کد قابل‌کپی هم از همان سناریوها.
۴) دموها را با اجرای دم سرور پلی‌گراوند (php artisan serve یا vite) چک نکن — کافی است blade سالم باشد؛ چک بصری بعد از اجرا انجام می‌شود.
${extraNew}
فقط فایل‌های گروه خودت را بساز؛ فایل‌های گروه‌های دیگر و فایل‌های مشترک را ویرایش نکن. ${NO_FAKE}`;

const pDemoTextActions = demoTextActions.ask<BuildResult>(demoBrief(
  "text و actions",
  `۵) این کامپوننت‌های تازهٔ همین اجرا هم در گروه‌های تو جا می‌گیرند و دمو می‌خواهند: ${JSON.stringify(newComponentsBlade)} — هرکدام که ماهیت متن/کنش دارد (مثل auth-card اگر در لیست است) در گروه درستش بگذار.`,
));
const pDemoCardsData = demoCardsData.ask<BuildResult>(demoBrief(
  "cards و data",
  `۵) این کامپوننت‌های تازهٔ همین اجرا هم دمو می‌خواهند: ${JSON.stringify(newComponentsBlade)} — kanban/calendar/timeline-feed در data، invoice در cards (اگر در لیست‌اند).`,
));
const pDemoMenusGlass = demoMenusGlass.ask<BuildResult>(demoBrief(
  "menus و glass",
  `۵) این کامپوننت‌های تازهٔ همین اجرا هم دمو می‌خواهند: ${JSON.stringify(newComponentsBlade)} — admin-shell در menus (اگر در لیست است).`,
));
const pDemoBase = demoBase.ask<BuildResult>(demoBrief(
  "base (کامپوننت‌های پایه: button، icon، input، select، checkbox، switch، radio-group، slider، field، textarea، card، dialog، drawer، popover، tooltip، tabs، accordion، avatar، avatar-group، badge، chip، status-badge، progress، progress-ring، spinner، skeleton، toaster، alert، breadcrumbs، pagination، steps، kbd، divider، header، nav-menu، mobile-menu، segmented، sparkline، stat-card، empty-state تازه)",
  `۶) گروه base بزرگ است؛ حداکثر ~۲۲ کامپوننتِ پرکاربرد پنل را با دموی باکیفیت بساز (button، input/select، dialog/drawer، tabs، avatar/badge، toaster، progress/spinner، pagination، steps، stat-card، empty-state و…) و بقیه را فقط در منیفست فهرست کن با docs کوتاه تا در کاتالوگ دیده شوند.`,
));

const pLivewireAdmin = livewireAdminArchitect.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: پنل مدیریت Livewire — چیدمان، داشبورد، احراز هویت، دوزبانگی
مشابه قالب‌های admin مثل Vuexy اما با کامپوننت‌ها و حرکت خودمان. قطعات تازه: ${JSON.stringify([...shell.features, ...board.features, ...chat.features, ...invoice.features])} و نکته‌های سازنده: ${shell.notes} ${chat.notes}
۱) روتهای /admin… را در playground/routes/web.php اضافه کن (این فایل الان مال توست؛ ویرایش نویسندهٔ کاتالوگ را خراب نکن — تازه بخوان).
۲) چیدمان با <x-nx::admin-shell>: سایدبار با گروه‌ها (داشبورد، تحلیل‌ها، کاربران، کانبان، تقویم، گفتگو، فاکتور، پروفایل، تنظیمات) + تاپ‌بار با command، theme-toggle، language-menu (fa/en واقعی: app locale در session + رندر مجدد)، activity-dropdown، منوی avatar.
۳) App\\Livewire\\Admin\\* برای هر صفحه + یک layout مشترک blade. داشبورد را کامل بساز: stat-strip/ستات‌کارت‌ها با اعداد رولینگ، metric-chart، dot-matrix-chart یا heatmap، timeline-feed، usage-card، کارت خوش‌آمد با backdrop تزئینی.
۴) صفحات دیگر را stub کن (عنوان + empty-state تازه) تا ناوبری کامل کار کند؛ دو عامل بعدی صفحات را پر می‌کنند — فایل‌های stub را در نوتی‌ها دقیق فهرست کن.
۵) احراز هویت: /login و /register و /forgot-password با auth-card تازه (فقط UI، بدون بک‌اند واقعی) + حالت «خروج» که به login برمی‌گردد.
۶) فایل‌های زبان: playground/lang برای fa و en — و مهم: کلیدهای همهٔ صفحات (داشبورد تا تنظیمات و گفتگو و فاکتور) را از پیش کامل بساز تا پرکننده‌های بعدی فقط مصرف کنند و فایل زبان را ویرایش نکنند.
${NO_FAKE}`);

const pReactAdmin = reactAdminArchitect.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: اپ پنل React — apps/admin از صفر
آینهٔ پنل Livewire با همان صفحات، با کامپوننت‌های @nabuxai/ui-react. الگوی تنظیمات vite/tsconfig/پروایدر را از apps/showcase کپی کن (themeScript، NabuXUIProvider، الگوی دوزبانهٔ src/lang.tsx).
۱) apps/admin بساز: package.json (نامش را "admin" بگذار تا pnpm --filter admin کار کند)، vite.config.ts (پورت 5174)، tsconfig، index.html، src/main.tsx (CSS هسته + themeScript + provider با locale="fa")، روتینگ hash سبک بدون وابستگی (#/users و…)، AdminShell از بسته (AdminShell/AdminSidebar/AdminTopbar که همین اجرا ساخته: ${JSON.stringify(shell.features)} — قرارداد import از notes: ${shell.notes}).
۲) رجیستری صفحات + داشبورد کامل (همان ساختار داشبورد Livewire: ستات‌ها، metric-chart، heatmap/dot-matrix، timeline-feed، usage-card) + بقیه صفحات stub با empty-state تازه.
۳) دوزبانه fa/en با الگوی showcase (کپی ساختار زبان) + سوییچ با LanguageMenu — و مهم: کلیدهای همهٔ صفحات را از پیش در فایل زبان کامل بساز تا پرکننده‌های بعدی فقط مصرف کنند و فایل زبان را ویرایش نکنند.
۴) در package.json ریشه اسکریپت "admin": "pnpm --filter admin dev" اضافه کن؛ pnpm install را در ریشه اجرا کن تا workspace لینک شود؛ بعد pnpm --filter admin run build را تا سبز شدن.
۵) فایل‌های stub را در نوتی‌ها فهرست کن.
${NO_FAKE}`);

const [demoText, demoCards, demoMenus, demoBaseR, livewireAdmin, reactAdmin] = await Promise.all([
  pDemoTextActions, pDemoCardsData, pDemoMenusGlass, pDemoBase, pLivewireAdmin, pReactAdmin,
]);

reportFeatures(demoText, "دموهای مستقل");
reportFeatures(demoCards, "دموهای مستقل");
reportFeatures(demoMenus, "دموهای مستقل");
reportFeatures(demoBaseR, "دموهای مستقل");
reportFeatures(livewireAdmin, "پنل Livewire");
reportFeatures(reactAdmin, "پنل React");

/* ───────── فاز ۴: پر کردن صفحات هر دو پنل (موازی) ───────── */

phase("پر کردن صفحات پنل لاراول و پنل React");

const lwDataPages = agent("صفحات دادهٔ پنل لاراول", {
  system: "توسعه‌دهندهٔ Livewire در پنل NabuXUI هستی؛ صفحات داده‌محور را با جزئیات واقعی می‌سازی. " + NO_FAKE,
});
const lwCommsPages = agent("صفحات ارتباطی پنل لاراول", {
  system: "توسعه‌دهندهٔ Livewire در پنل NabuXUI هستی؛ صفحات ارتباطی پنل را کامل و زنده می‌سازی. " + NO_FAKE,
});
const rxDataPages = agent("صفحات دادهٔ پنل React", {
  system: "توسعه‌دهندهٔ React در پنل NabuXUI هستی؛ صفحات داده‌محور را با state واقعی می‌سازی. " + NO_FAKE,
});
const rxCommsPages = agent("صفحات ارتباطی پنل React", {
  system: "توسعه‌دهندهٔ React در پنل NabuXUI هستی؛ صفحات ارتباطی پنل را کامل و زنده می‌سازی. " + NO_FAKE,
});

const lwNotes = `معماری پنل لاراول: ${JSON.stringify(livewireAdmin.notes)}`;
const rxNotes = `معماری پنل React: ${JSON.stringify(reactAdmin.notes)}`;

const [lwData, lwComms, rxData, rxComms] = await Promise.all([
  lwDataPages.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: صفحات دادهٔ پنل Livewire را پر کن
${lwNotes}
فقط فایل‌های stub صفحه‌های زیر را کامل کن (و در صورت نیاز فایل data کمکی تازه بساز)؛ فایل مشترک/صفحهٔ دیگران را ویرایش نکن:
- کاربران: data-table کامل (جست‌وجو، فیلتر chip، مرتب‌سازی، ردیف انتخاب، دیالوگ تأیید حذف، avatar-group).
- تحلیل‌ها: metric-chart + analytics-card + comparison-table + sparkline + usage-card با دادهٔ معنادار نمونه.
- کانبان: برد kanban تازه با state Livewire (انتقال کارت بین ستون‌ها با wire).
- تقویم: calendar تازه با رویدادهای نمونه.
دوزبانه fa/en از فایل‌های زبان پنل (کلیدها از قبل کامل‌اند؛ فقط مصرف کن — فایل زبان را ویرایش نکن). ${NO_FAKE}`),
  lwCommsPages.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: صفحات ارتباطی پنل Livewire را پر کن
${lwNotes}
فقط فایل‌های stub صفحه‌های زیر را کامل کن:
- گفتگو: chat تازه (گفتگوها + رشته + composer؛ state لوکال Livewire).
- فاکتور: invoice تازه + دکمهٔ چاپ + چند فاکتور نمونه.
- پروفایل: کارت پروفایل (avatar، badge، تب‌ها: نمای کلی/فعالیت/تنظیمات) با timeline-feed.
- تنظیمات: فرم‌ها (field/input/select/switch/checkbox)، theme-switch، language-menu،Danger zone با dialog.
دوزبانه fa/en از فایل‌های زبان پنل (کلیدها از قبل کامل‌اند؛ فقط مصرف کن — فایل زبان را ویرایش نکن). ${NO_FAKE}`),
  rxDataPages.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: صفحات دادهٔ پنل React را پر کن
${rxNotes}
فقط فایل‌های stub صفحه‌های زیر را در apps/admin/src کامل کن: کاربران (DataTable)، تحلیل‌ها (MetricChart/AnalyticsCard/ComparisonTable/UsageCard)، کانبان (Kanban با state واقعی React و درگ‌اند‌دراپ)، تقویم (Calendar). همان ساختار و زبان داشبورد؛ دوزبانه با کلیدهای زبان اپ (فایل زبان را ویرایش نکن). بیلد نهایی را فاز گیت انجام می‌دهد — فقط کد تمیز و بدون خطای تایپ بنویس. ${NO_FAKE}`),
  rxCommsPages.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: صفحات ارتباطی پنل React را پر کن
${rxNotes}
فقط فایل‌های stub صفحه‌های زیر را در apps/admin/src کامل کن: گفتگو (Chat)، فاکتور (Invoice + چاپ)، پروفایل، تنظیمات (فرم‌ها + ThemeSwitch + LanguageMenu + Danger zone)، و نمای ورود (AuthCard) با روت hash #/login. دوزبانه با کلیدهای زبان اپ (فایل زبان را ویرایش نکن). بیلد نهایی را فاز گیت انجام می‌دهد — فقط کد تمیز و بدون خطای تایپ بنویس. ${NO_FAKE}`),
]);

reportFeatures(lwData, "پنل Livewire");
reportFeatures(lwComms, "پنل Livewire");
reportFeatures(rxData, "پنل React");
reportFeatures(rxComms, "پنل React");

const allBuilds = [shell, board, chat, invoice, wireUp, skeleton, demoText, demoCards, demoMenus, demoBaseR, livewireAdmin, reactAdmin, lwData, lwComms, rxData, rxComms];
const allTouched = Array.from(new Set(allBuilds.flatMap((b) => b.filesTouched))).filter((p) => p.length > 0);

/* ───────────────────────── فاز ۵: بازبینی مستقل ───────────────────────── */

phase("بازبینی مستقل کیفیت با چشم تازه");

const motionReviewer = agent("بازبین حرکت و طراحی", {
  system: "بازبین مستقل کیفیت طراحی/حرکت NabuXUI هستی. هیچ فایلی را ویرایش نمی‌کنی؛ فقط می‌خوانی و یافته با شاهد گزارش می‌کنی. " + NO_FAKE,
});
const a11yReviewer = agent("بازبین دسترس‌پذیری و دوزبانگی", {
  system: "بازبین مستقل دسترس‌پذیری و دوزبانگی NabuXUI هستی. هیچ فایلی را ویرایش نمی‌کنی؛ فقط می‌خوانی و یافته با شاهد گزارش می‌کنی. " + NO_FAKE,
});

const reviewFiles = allTouched.join("، ");

const [motionFindings, a11yFindings] = await Promise.all([
  motionReviewer.ask<{ findings: Finding[] }>(`${COMMON}
## وظیفهٔ تو (فقط خواندن، بدون هیچ ویرایشی)
فایل‌های این اجرا را از نظر «کیفیت طراحی و حرکت» بخوان: ${reviewFiles}
ملاک‌ها: توکن‌ها به‌جای رنگ خام؛ روشن/تیره هر دو؛ RTL با property منطقی و --nx-dir و آینه شدن درست؛ حرکت فنری/FLIP هم‌خانوادهٔ بلوک‌های موجود؛ reduced-motion بی‌اثر؛ سلسله‌مراتب بصری صفحات پنل؛ هماهنگی spacing/شعاع/سایه با بقیهٔ سیستم؛ انیمیشن‌های بی‌مصرف یا حواس‌پرت‌کن.
هر مشکل را با where دقیق (فایل:خط) و شاهد (خطوط واقعی خوانده‌شده) بیاور؛ چیزهای خوب را گزارش نکن، فقط یافته‌ها. ${NO_FAKE}`),
  a11yReviewer.ask<{ findings: Finding[] }>(`${COMMON}
## وظیفهٔ تو (فقط خواندن، بدون هیچ ویرایشی)
فایل‌های این اجرا را از نظر «دسترس‌پذیری و دوزبانگی» بخوان: ${reviewFiles}
ملاک‌ها: role/aria-label درست (به‌خصوص درگ‌اند‌دراپ کانبان، تب‌ها، دیالوگ‌ها)؛ پیمایش کیبورد و فوکوس؛ کنتراست متن؛ سمتیکس درست؛ کامل بودن کلیدهای زبان fa/en (کلید جاافتاده = یافته)؛ اعداد فارسی در fa؛ dir/lang درست در اپ‌ها؛ متن سخت‌کدشده‌ای که باید از فایل زبان بیاید.
هر مشکل را با where دقیق و شاهد بیاور؛ فقط یافته‌ها. ${NO_FAKE}`),
]);

const allFindings: Finding[] = [...motionFindings.findings, ...a11yFindings.findings]
  .filter((f) => f && typeof f.where === "string" && typeof f.what === "string");
const toFix = allFindings.filter((f) => f.severity !== "low");
const lowFindings = allFindings.filter((f) => f.severity === "low");
log(`بازبینی ${allFindings.length} یافته داد: ${toFix.length} جدی (رفع می‌شود)، ${lowFindings.length} جزئی (فقط گزارش)`);

/* ───────────────────────── فاز ۶: رفع و تأیید ───────────────────────── */

phase("رفع یافته‌های جدی بازبینی و تأیید مستقلشان");

const styleFixer = agent("اصلاح‌گر استایل و بلید", {
  system: "اصلاح‌گر کیفیت NabuXUI هستی؛ یافته‌های بازبینی را حداقلی و دقیق رفع می‌کنی. " + NO_FAKE,
});
const reactFixer = agent("اصلاح‌گر React و PHP", {
  system: "اصلاح‌گر کیفیت NabuXUI هستی؛ یافته‌های بازبینی را حداقلی و دقیق رفع می‌کنی. " + NO_FAKE,
});
const confirmer = agent("تأییدکنندهٔ اصلاحات", {
  system: "تأییدکنندهٔ مستقل هستی؛ هیچ فایلی را ویرایش نمی‌کنی؛ فقط بررسی می‌کنی که اصلاح واقعاً انجام شده و درست است. " + NO_FAKE,
});

const fixBrief = (fixerName: string) => `${COMMON}
## یافته‌های بازبینی که باید رفع کنی (به‌عنوان ${fixerName})
قبل از هر ویرایش فایل را تازه بخوان؛ حداقلی اصلاح کن و سبک اطراف را حفظ کن. اگر یافته‌ای اشتباه است، آن را در remaining با دلیل بیاور.
${NO_FAKE}

`;

let remaining: Finding[] = toFix;
let fixRounds = 0;
while (remaining.length > 0 && fixRounds < 2) {
  const reactBucket = remaining.filter((f) => f.where.startsWith("apps/") || f.where.includes("packages/react"));
  const styleBucket = remaining.filter((f) => !(f.where.startsWith("apps/") || f.where.includes("packages/react")));
  const fixJobs: Array<Node<FixResult>> = [];
  if (reactBucket.length > 0) fixJobs.push(reactFixer.ask<FixResult>(fixBrief("اصلاح‌گر React و PHP") + JSON.stringify(reactBucket, null, 2)));
  if (styleBucket.length > 0) fixJobs.push(styleFixer.ask<FixResult>(fixBrief("اصلاح‌گر استایل و بلید") + JSON.stringify(styleBucket, null, 2)));
  const fixes = await Promise.all(fixJobs);
  const claimedFixed = fixes.flatMap((f) => f.fixed);
  const carried = fixes.flatMap((f) => f.remaining);
  const claimedJson = JSON.stringify(claimedFixed, null, 2);
  const confirms = await confirmer.ask<{ confirmations: Confirmation[] }>(`${COMMON}
## وظیفهٔ تو (فقط خواندن، بدون ویرایش)
اصلاح‌گران ادعا می‌کنند این یافته‌ها را رفع کرده‌اند — برای هر کدام فایل/خط ذکرشده را بخوان و تأیید کن که مشکل واقعاً برطرف شده و اصلاح، چیزی را خراب نکرده:
${claimedJson}
ادعاهای درست را confirmed=true؛ نادرست یا ناقص را confirmed=false با توضیح. ${NO_FAKE}`);
  const failed: Finding[] = [];
  for (const c of confirms.confirmations) {
    if (!c.confirmed) {
      const match = claimedFixed.find((f) => f.where === c.where && f.what === c.what);
      if (match) failed.push(match);
    }
  }
  remaining = [...failed, ...carried];
  fixRounds += 1;
  log(`دور ${fixRounds} اصلاح: ${claimedFixed.length - failed.length} تأیید شد، ${remaining.length} مانده`);
}

const unfixed = remaining;
if (unfixed.length > 0) log(`${unfixed.length} یافته بعد از دو دور رفع ناتمام ماند — با برچسب «رفع‌نشده» گزارش می‌شود`);

/* ───────────────── فاز ۷: سبز کردن تایپ‌چک، بیلد و تست‌ها ───────────────── */

phase("سبز کردن تایپ‌چک، بیلد و تست‌ها");

interface GateOutcome {
  id: string;
  ok: boolean;
  output: string;
}

async function runGate(id: string): Promise<GateOutcome> {
  let r: WorldRunResult;
  if (id === "typecheck-packages") {
    r = await world.run("pnpm", ["-r", "--filter", "./packages/**", "run", "typecheck"]);
  } else if (id === "build-packages") {
    r = await world.run("pnpm", ["-r", "--filter", "./packages/**", "run", "build"], { timeoutMs: 600000 });
  } else if (id === "test-packages") {
    r = await world.run("pnpm", ["-r", "--filter", "./packages/**", "run", "test"], { timeoutMs: 600000 });
  } else if (id === "build-showcase") {
    r = await world.run("pnpm", ["--filter", "showcase", "run", "build"], { timeoutMs: 600000 });
  } else if (id === "build-admin") {
    r = await world.run("pnpm", ["--filter", "admin", "run", "build"], { timeoutMs: 600000 });
  } else if (id === "build-playground") {
    r = await world.run("npm", ["--prefix", "playground", "run", "build"], { timeoutMs: 600000 });
  } else {
    r = await world.run("bash", ["-c", "find playground/app packages/livewire/src -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null"], { timeoutMs: 300000 });
  }
  return { id, ok: r.exitCode === 0, output: `stdout:\n${short(r.stdout)}\nstderr:\n${short(r.stderr)}` };
}

const GATE_IDS = [
  "typecheck-packages",
  "build-packages",
  "test-packages",
  "build-showcase",
  "build-admin",
  "build-playground",
  "lint-php",
];

const buildDoctor = agent("تعمیرکار بیلد", {
  system: "تعمیرکار بیلد NabuXUI هستی؛ خطاهای typecheck/build/test را تا سبز شدن رفع می‌کنی. اگر خطا از فایل‌های workflow موازیِ backdrop باشد ویرایشش نکن؛ دورش بزن و اگر واقعاً بن‌بست است escalate کن. " + NO_FAKE,
});

const gateResults: GateOutcome[] = [];
let gateRound = 0;
let allGreen = false;
while (gateRound < 4) {
  gateRound += 1;
  const outcomes: GateOutcome[] = [];
  for (const id of GATE_IDS) {
    outcomes.push(await runGate(id));
  }
  const failures = outcomes.filter((o) => !o.ok);
  gateResults.length = 0;
  gateResults.push(...outcomes);
  if (failures.length === 0) {
    allGreen = true;
    break;
  }
  log(`دور ${gateRound} گیت: ${failures.map((f) => f.id).join("، ")} قرمز است — تعمیر می‌شود`);
  if (gateRound === 4) break;
  await buildDoctor.ask<BuildResult>(`${COMMON}
## وظیفهٔ تو: این گیت‌های شکست‌خورده را سبز کن
${failures.map((f) => `### ${f.id}\n${f.output}`).join("\n\n")}
علت را ریشه‌ای پیدا کن (کد این اجرا در: packages/core، packages/react، packages/livewire، playground، apps/admin)؛ فایل‌های backdrop ممنوع؛ بعد از اصلاح، فقط همان گیت شکست‌خورده را خودت اجرا کن تا مطمئن شوی. ${NO_FAKE}`);
}

const verifiedGates = GATE_IDS.filter((id) => gateResults.find((g) => g.id === id && g.ok) !== undefined);
const failedGates = GATE_IDS.filter((id) => gateResults.find((g) => g.id === id && g.ok) === undefined);

/* ───────────────────────── فاز ۸: کامیت و پوش ───────────────────────── */

phase("کامیت و پوش به گیت‌هاب");

const committer = agent("کامیت‌کار", {
  system: "عامل کامیت مخزن NabuXUI هستی؛ فقط کار این اجرا را stage/commit/push می‌کنی و به کار workflowهای موازی دست نمی‌زنی. اگر بن‌بست شد escalate کن. " + NO_FAKE,
});

const commitResult = await committer.ask<CommitResult>(`${COMMON}
## وظیفهٔ تو: کار این اجرا را کامیت و پوش کن
فایل‌های این اجرا (stage فقط همین‌ها را — با git add مسیر-مسیر، هرگز git add -A نکن):
${allTouched.join("\n")}
قواعد:
1. اول git status بگیر؛ اگر فایل‌های backdrop (که مال workflow موازی است) هنوز uncommitted یا modified هستند، آن‌ها را به‌هیچ‌وجهی stage نکن. اگر کامیت backdrop قبلاً در git log هست، مشکلی نیست.
2. git fetch origin و اگر origin/main جلوتر است rebase کن (تداخل فقط در فایل‌های خودت را حل کن).
3. پیام کامیت (فارسی، یک‌خطی): «پنل مدیریت نابو (Livewire + React) + دموهای مستقل کامپوننت‌ها + قطعات جدید admin-shell/kanban/calendar/chat/invoice/auth».
4. push به origin/main؛ اگر رد شد: pull --rebase (فقط فایل‌های خودت) و دوباره — حداکثر ۳ تلاش؛ بعد از آن escalate کن.
5. خروجی: commitHash و pushed و نوتی (چرا اگر نشد). ${NO_FAKE}`);

/* ───────────────── فاز ۹: سند، گزارش و بازخوانی ───────────────── */

phase("سند پنل، گزارش نهایی و بازخوانی آن");

const docWriter = agent("نویسندهٔ سند و گزارش", {
  system: "نویسندهٔ فنی فارسی‌زبان NabuXUI هستی؛ سند دقیق و قابل‌اجرا می‌نویسی. " + NO_FAKE,
});
const reportReader = agent("بازخوان گزارش", {
  system: "بازخوان مستقل هستی؛ گزارش را فقط از روی خودِ متن قضاوت می‌کنی (مثل کاربری که مخزن را ندیده) و نمی‌روی کد راستی‌آزمایی کنی. هیچ فایلی ویرایش نمی‌کنی. " + NO_FAKE,
});

let doc = await docWriter.ask<DocResult>(`${COMMON}
## وظیفهٔ تو: سند و گزارش نهایی
۱) docs/ADMIN.md (فارسی، با همان لحن docs/FRAMEWORKS.md): معرفی پنل، راه‌راه‌اندازی هر طعم (Livewire: روتهای /admin و /login در پلی‌گراوند؛ React: pnpm --filter admin dev پورت 5174)، فهرست صفحات، دوزبانگی و تم، قطعات جدید با جدول مشابه کاتالوگ FRAMEWORKS.md، و راهنمای دموهای مستقل (/components). نکته‌های عامل‌ها: ${JSON.stringify([livewireAdmin.notes, reactAdmin.notes, skeleton.notes])}
۲) جدول‌های کاتالوگ docs/FRAMEWORKS.md را با ردیف بلوک‌های جدید تکمیل کن (فایل را تازه بخوان؛ دست‌کاری بخش‌های موجود حداقلی).
۳) reportMarkdown: گزارش نهایی فارسی برای کاربر — چه ساخته شد (قطعات، دموها، دو پنل با فهرست صفحات)، وضعیت گیت‌ها (${JSON.stringify(verifiedGates)} سبز؛ ${JSON.stringify(failedGates)} قرمز اگر هست)، وضعیت کامیت/push: ${JSON.stringify(commitResult)}، یافته‌های جدی رفع‌شده و ماندده‌ها، و نحوهٔ دیدن نتیجه در مرورگر. ${NO_FAKE}`);

let feedback = await reportReader.ask<ReaderFeedback>(`این گزارش نهایی یک اجرای ساخت پنل مدیریت و دموهاست. فقط از روی همین متن قضاوت کن: چه چیزی مبهم است؟ چه چیزی که کاربر لازم دارد کم است؟ چه سوالی بعد از خواندن برایت می‌ماند؟\n\n${doc.reportMarkdown}`);

if (feedback.unclear.length > 0 || feedback.missing.length > 0) {
  doc = await docWriter.ask<DocResult>(`${COMMON}
## وظیفهٔ تو: گزارش را بر اساس بازخوانی بازخوان اصلاح کن و نسخهٔ نهایی را برگردان
نوتهای بازخوان: مبهم‌ها: ${JSON.stringify(feedback.unclear)} — کمداشته‌ها: ${JSON.stringify(feedback.missing)}
همان DocResult را با reportMarkdown اصلاح‌شده برگردان (سند ADMIN.md اگر لازم شد دست بکش).`);
}

try {
  await artifact.file("admin-doc", doc.adminDocPath, {
    title: "سند پنل مدیریت نابو",
    description: "راه‌اندازی و فهرست صفحات پنل در دو طعم Livewire و React، و قطعات جدید",
    primary: true,
  });
} catch {
  await docWriter.ask("مسیر سند ADMIN.md که در adminDocPath داده بودی درست پاس نشد؛ فایل را در docs/ADMIN.md مطمئن بساز/درست کن.");
  await artifact.file("admin-doc", "docs/ADMIN.md", {
    title: "سند پنل مدیریت نابو",
    description: "راه‌اندازی و فهرست صفحات پنل در دو طعم Livewire و React، و قطعات جدید",
    primary: true,
  });
}

await artifact.markdown("report", doc.reportMarkdown, {
  title: "گزارش نهایی اجرا",
  description: "چه چیزی ساخته شد، چه چیزهایی سبز شد و چگونه نتیجه را ببین",
});

interface ReportFinding {
  where: string;
  what: string;
  evidence: string;
  status: "verified" | "unconfirmed";
  severity: "low" | "medium" | "high";
  note?: string;
}
const reportFindings: ReportFinding[] = [];
for (const f of lowFindings) {
  reportFindings.push({ ...f, status: "unconfirmed", note: "یافتهٔ جزئی — فقط گزارش شد" });
}
for (const f of unfixed) {
  reportFindings.push({ ...f, status: "unconfirmed", note: "بعد از دو دور اصلاح ناتمام ماند" });
}

const workflowReport = {
  conclusion: allGreen && commitResult.pushed
    ? `پنل مدیریت نابو در دو طعم Livewire (/admin) و React (apps/admin) + کاتالوگ دموهای مستقل هر کامپوننت (/components) + ۹ قطعهٔ جدید ساخته شد؛ همهٔ گیت‌ها سبز و کار پوش شد (${commitResult.commitHash}).`
    : `ساخت انجام شد اما ناقص تحویل شد — گیت‌های سبز: ${verifiedGates.join("، ") || "هیچ"}؛ قرمز: ${failedGates.join("، ") || "هیچ"}؛ پوش: ${commitResult.pushed ? "موفق" : "ناموفق"}. جزئیات در گزارش.`,
  findings: reportFindings,
  verified: [
    ...verifiedGates.map((id) => `گیت ${id} سبز شد`),
    "هر یافتهٔ جدی بازبینی بعد از اصلاح، مستقل تأیید شد",
  ],
  notCovered: [
    "تست بصری در مرورگر انجام نشد — پس از پایان اجرا دستی چک می‌شود (پلی‌گراوند، اپ admin و صفحه‌های دمو)",
    "طعم‌های Vue و Svelte برای پنل فقط در سند توضیح داده می‌شود (مخزن ابزار build آن‌ها را ندارد — رویکرد docs/FRAMEWORKS.md)",
    "تست‌های phpunit پلی‌گراوند اجرا نشد (نیازمند محیط دیتابیس/کلید کامل)",
    "استقرار (Coolify) برای اپ تازهٔ apps/admin تنظیم نشد — فقط اجرای محلی مستند شد",
  ],
};

return workflowReport;
