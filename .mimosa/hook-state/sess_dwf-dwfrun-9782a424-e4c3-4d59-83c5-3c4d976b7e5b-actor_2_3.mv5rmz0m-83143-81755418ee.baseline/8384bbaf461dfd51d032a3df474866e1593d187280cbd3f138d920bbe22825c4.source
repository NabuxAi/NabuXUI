interface PhaseResult {
  /** فایل‌های ساخته/تغییریده‌شده، مسیر نسبت به ریشهٔ ریپو */
  files: string[];
  /** نام کامپوننت‌های صادرشدهٔ React همین خانواده */
  exports: string[];
  /** true فقط وقتی همهٔ لایه‌های خانواده کامل شد */
  ok: boolean;
  /** یادداشت فارسی برای گزارش نهایی */
  notes: string;
}
interface VerifyFinding {
  /** یک جمله: چه چیزی مشکل است */
  what: string;
  /** شاهد: خروجی دستور، خطای کنسول یا مسیر عکس */
  evidence: string;
  severity: "low" | "medium" | "high";
}
interface BrowserReview {
  ok: boolean;
  findings: VerifyFinding[];
  /** مسیر عکس‌های گرفته‌شده زیر /tmp/nx-pkg6/ */
  shots: string[];
}
interface JudgeVerdict {
  /** مسیر عکسی که داور دید */
  shot: string;
  pass: boolean;
  /** ایرادها به فارسی؛ خالی اگر قبول */
  issues: string;
}
interface WorkflowReport {
  conclusion: string;
  findings: VerifyFinding[];
  verified: string[];
  notCovered: string[];
}

artifact.table("issues", {
  title: "موارد باز پورت موج انیمیشن‌ها",
  description: "خطاهای build/typecheck/test، خطاهای کنسول showcase و ایرادهای داوری.",
  columns: [
    { field: "what", label: "مورد" },
    { field: "evidence", label: "شاهد" },
    { field: "severity", label: "شدت" },
  ],
  key: "what",
});

/** شش خانوادهٔ موج ۴ که در به‌روزرسانی 0.2.0 نبودند — این موج 0.3.0. */
const FAMILIES = [
  { id: "entrances", show: "EntrancesBlocks", labelFa: "ورودها", labelEn: "Entrances", js: "curtainReveal", spec: "از دموهای گروه entrances پلی‌گراوند تقطیر کن: CurtainReveal (پردهٔ دوپنلی + نشان + شمارندهٔ درصد؛ پس از اتمام پرده‌ها با stagger محتوا؛ props: duration/label)، StaggerList (ورود پله‌ای آیتم‌ها با IntersectionObserver و فنر + ری‌پلی)، SplitFlap (حروف نیم‌کارهٔ مکانیکی با متن قابل تعویض)." },
  { id: "hover-fx", show: "HoverFxBlocks", labelFa: "هاورها", labelEn: "Hover FX", js: "", spec: "ImageTrail (کارت‌های تصویری دنبال موس با lerp — از رفتار pointer هسته شروع کن)، LinkUnderline (هشت هاور لینک با prop variant)، GlareCard (گلیر دنبال موس + سه لایهٔ عمق)، MagneticSet (کشش مغناطیسی با شعاع/شدت — از pointer/spring هسته استفاده کن)، ImageAccordion (پنل‌های بازشونده با هاور/فلش کیبورد)." },
  { id: "ambient", show: "AmbientBlocks", labelFa: "پس‌زمینه‌های محیطی", labelEn: "Ambient", js: "starfield", spec: "رفتار هسته starfield(el, {density, speed}) روی canvas. کامپوننت‌ها: AuroraBackdrop (بلاب‌های نرم نفس‌کش)، PerspectiveGrid (کف رترو با سرعت و مه)، StarfieldBackdrop (میدان ستارهٔ عمق‌دار با پارالکس موس)، ContourLines (خطوط تراز SVG فازگیر)، Metaballs (گوی‌های چسبنده). همه روی بخش واقعی با متن، توقف در reduced-motion و خارج دید." },
  { id: "kinetic", show: "KineticBlocks", labelFa: "تایپوگرافی جنبشی", labelEn: "Kinetic type", js: "scrollVelocity", spec: "رفتار هسته scrollVelocity(el, cb) — سرعت/جهشت اسکرول با نرم‌سازی. کامپوننت‌ها: WordFillScroll (واژه‌ها با پیشرفت خواندن رنگ می‌گیرند)، WordCycle3d (واژهٔ کلیدی در حلقهٔ rotateX)، VelocityBand (نوار متن با سرعتِ اسکرول، دو جهت)، ElasticLetters (فنریِ هاور — لاتین حرف، فارسی واژه)." },
  { id: "micro-fx", show: "MicroFxBlocks", labelFa: "ریزتعامل‌ها", labelEn: "Micro FX", js: "confetti", spec: "رفتار هسته confetti(el, {origin, count}) روی canvas با جاذبه و رنگ‌های تم. کامپوننت‌ها: ConfettiButton (دکمهٔ موفقیت با انفجار)، RippleSurface (موج کلیک از نقطهٔ دقیق روی دکمه/کارت/تب)، DragSpring (کارت کشیدنی با بازگشت فنری و هدف رهاسازی — از swipe/spring هسته کمک بگیر)، ReactionBar (ری‌اکشن با پارتیکل و شمارندهٔ لغزان)، LiveTicker (ارقام چرخان عمودی با فلش رنگی، درست در RTL/LTR)." },
  { id: "depth-3d", show: "Depth3dBlocks", labelFa: "عمق سه‌بعدی", labelEn: "3D depth", js: "dragRotate", spec: "رفتار هسته dragRotate(el, {inertia}) — چرخش preserve-3d با درگ و اینرسی نرم. کامپوننت‌ها: ProductRoom (صحنهٔ چندلایه با نمای انفجاری و برچسب لایه‌ها)، FlipCube (مکعب شش‌وجهی با اسنپ وجه و کیبورد)، OpenBox (جعبهٔ بازشو با محصول فنری و aria-expanded)." },
] as const;

const RULES = [
  "قواعد سخت (قرارداد docs/BLOCKS.md — قبل از هر چیز کاملش را بخوان):",
  "- CSS داخل @layer nx.components در packages/core/src/css/blocks/<group>.css؛ فقط توکن‌ها، دو تم، کلاس‌های nx-<block>، وضعیت با data-*.",
  "- حرکت: فنرهای استاندارد، × var(--nx-motion)، ویژگی‌های منطقی و --nx-dir، transform/opacity نه layout، توقف حلقه‌ها در reduced-motion و خارج دید.",
  "- رفتار JS هسته: (el, options) => cleanup با پاک‌سازی کامل (شنونده/RAF/observer). قبل از نوشتن رفتار تازه، رفتارهای موجود را ببین و بازاستفاده کن: packages/core/src/js/{pointer,spring,swipe,reveal,indicator}.ts و بلاک‌های موج قبل: blocks/{scroll,icon-motion,motion-fx,shaders}.ts.",
  "- React: کامپوننت تابعی، useBehavior، useT/i18n، SmartLink؛ الگو: packages/react/src/blocks/heroes.tsx و sections.tsx و motion-fx.tsx (بلاک‌های موج 0.2.0).",
  "- حس و رفتار را از دموی پلی‌گراوند بگیر (playground/resources/views/demos/components/<id>/)، کدش را کپی نکن؛ متن‌ها واقعی و جهانی؛ هرگز ایران/تهران.",
  "- showcase: apps/showcase/src/blocks/<id>.tsx با export function <Show>() — ۲ تا ۴ نمونهٔ واقعی خانواده.",
].join("\n");

function buildPrompt(f: (typeof FAMILIES)[number]): string {
  return [
    "خانوادهٔ «" + f.labelFa + "» (موج ۴) را به بلاک کتابخانه‌ای تبدیل کن — این موج «0.3.0» است: تعهد بازماندهٔ به‌روزرسانی پکیج‌ها.",
    "",
    "اسکفولد از قبل ساخته شده: فایل‌های استاب و ثبت‌ها (index ها، App.tsx) موجودند — فقط محتوای فایل‌های خودت را پر کن و هیچ فایل اشتراکی را دست نزن.",
    "",
    "فایل‌های تو:",
    "- packages/core/src/css/blocks/" + f.id + ".css",
    (f.js ? "- packages/core/src/js/blocks/" + f.id + ".ts (رفتار پیشنهادی: " + f.js + " — اگر رفتار موجود بهتر جواب داد، همان را بازاستفاده کن و در notes بگو)" : "- رفتار JS جدید لازم نیست مگر واقعاً لازم شود (آن‌وقت js/blocks/" + f.id + ".ts)"),
    "- packages/react/src/blocks/" + f.id + ".tsx",
    "- apps/showcase/src/blocks/" + f.id + ".tsx (export function " + f.show + "() — استاب null را با دموی واقعی جایگزین کن)",
    "",
    "چه بسازی: " + f.spec,
    "",
    RULES,
    "",
    "پس از پر کردن، این سه را بزن و خطاها را همان‌جا درست کن:",
    "- pnpm --filter @nabuxai/ui-core build",
    "- pnpm --filter @nabuxai/ui-react typecheck && pnpm --filter @nabuxai/ui-react build",
    "- pnpm --filter showcase build",
    "",
    "خروجی فقط JSON {files, exports, ok, notes} — exports نام کامپوننت‌های React؛ notes فارسی و کوتاه.",
  ].join("\n");
}

phase("اسکفولد مشترک: استاب‌ها، ثبت‌ها و نسخهٔ 0.3.0");
const scaffold = await agent("اسکفول‌ساز", {
  system:
    "تو مهندس ارشد این مونوریپو هستی. این مرحله فقط زیرساخت است: استاب‌ها باید همان لحظه build شوند. به فایل‌های اشتراکی با کمترین تغییر ممکن دست می‌زنی.",
}).ask<PhaseResult>(
  [
    "برای ۶ خانوادهٔ تازه اسکفولد بساز:",
    "",
    "۱) استاب‌ها:",
    "- packages/core/src/css/blocks/<id>.css برای هر ۶: فقط «@layer nx.components { /* TODO */ }»",
    "- packages/core/src/js/blocks/<id>.ts برای هر ۶ (entrances، hover-fx، ambient، kinetic، micro-fx، depth-3d): فایل خالی معتبر",
    "- packages/react/src/blocks/<id>.tsx برای هر ۶: فایل خالی معتبر TSX",
    "- apps/showcase/src/blocks/<id>.tsx: «export function <Show>() { return null; }» با نام‌ها: " + FAMILIES.map((f) => f.show).join("، "),
    "",
    "۲) ثبت‌ها (فقط سطرهای لازم، به ترتیب الفبا در محل مناسب):",
    "- packages/core/src/css/index.css: @import هر ۶ css تازه",
    "- packages/core/src/js/index.ts: export * from './blocks/<id>' برای هر ۶",
    "- packages/react/src/index.ts: export * from './blocks/<id>' برای هر ۶",
    "- apps/showcase/src/App.tsx: import هر ۶ <Show> + افزودن به BLOCK_GROUPS با id یکتا (مثل 'entrances-blocks') و برچسب fa/en و آیکن هسته: " +
      FAMILIES.map((f) => f.id + "→«" + f.labelFa + "»/" + f.labelEn).join("، "),
    "",
    "۳) نسخه‌ها: packages/core/package.json و packages/react/package.json: 0.2.0 → 0.3.0 (بقیه دست نخورد).",
    "",
    "۴) راستی‌آزمایی استاب — هر سه باید سبز شود:",
    "- pnpm --filter @nabuxai/ui-core build",
    "- pnpm --filter @nabuxai/ui-react typecheck && pnpm --filter @nabuxai/ui-react build && pnpm --filter @nabuxai/ui-react test",
    "- pnpm --filter showcase build",
    "",
    "id ها: " + FAMILIES.map((f) => f.id).join("، "),
    "خروجی فقط JSON {files, exports, ok, notes} به فارسی.",
  ].join("\n"),
);
if (!scaffold.ok) {
  report({ what: "اسکفولد ناتمام", evidence: scaffold.notes, severity: "high" }, "issues");
}
log("اسکفولد " + (scaffold.ok ? "سبز" : "ناقص") + " شد؛ ۶ سازندهٔ خانواده شروع می‌کنند");

phase("ساخت شش خانوادهٔ پکیجی به‌موازاتی");
const settled = await Promise.allSettled(
  FAMILIES.map((f) =>
    agent("سازنده-" + f.id, {
      system:
        "تو سازندهٔ بلاک‌های کتابخانهٔ NabuXUI هستی — کد production-grade برای کاربران پکیج. فقط فایل‌های خانوادهٔ خودت را پر کن؛ فایل‌های اشتراکی از قبل ثبت شده‌اند. اگر قراردادی ناسازگار بود اسکیلیت کن، دور نزن.",
    }).ask<PhaseResult>(buildPrompt(f)),
  ),
);
const builders = settled.map((s, i) => {
  const f = FAMILIES[i];
  if (s.status === "fulfilled") return s.value;
  report({ what: "سازندهٔ " + f.id + " ناتمام ماند", evidence: String(s.reason).slice(0, 300), severity: "high" }, "issues");
  return { files: [], exports: [], ok: false, notes: "اجنت شکست خورد: " + String(s.reason).slice(0, 200) } as PhaseResult;
});

phase("دروازه‌های ساخت پکیج‌ها و حلقهٔ اصلاح");
async function gate(label: string, args: string[]): Promise<string> {
  const r = await world.run("pnpm", args, { timeoutMs: 600000 });
  if (r.exitCode !== 0) {
    report({ what: label + " خراب", evidence: (r.stdout + r.stderr).trim().split("\n").slice(-6).join(" | ").slice(0, 400), severity: "high" }, "issues");
    return label;
  }
  log(label + " سبز");
  return "";
}
let failed: string[] = [];
for (let round = 1; round <= 3; round++) {
  failed = (
    await Promise.all([
      gate("core build", ["--filter", "@nabuxai/ui-core", "build"]),
      gate("react typecheck", ["--filter", "@nabuxai/ui-react", "typecheck"]),
      gate("react build", ["--filter", "@nabuxai/ui-react", "build"]),
      gate("react test", ["--filter", "@nabuxai/ui-react", "test"]),
      gate("showcase build", ["--filter", "showcase", "build"]),
    ])
  ).filter(Boolean);
  if (failed.length === 0) break;
  log("دور " + round + ": " + failed.join(" و ") + " خراب — اصلاح می‌شود");
  const out = await world.run("pnpm", ["--filter", "@nabuxai/ui-react", "typecheck"], { timeoutMs: 600000 });
  await agent("اصلاح‌گر-ساخت-" + round, {
    system:
      "تو تعمیرکار TypeScript/CSS این مونوریپو هستی. فقط فایل‌های مربوط به خطاها را درست کن (بلاک‌های تازه در packages/ و apps/showcase). قرارداد BLOCKS.md و الگوی بلاک‌های موجود را حفظ کن.",
  }).ask(
    "این دروازه‌ها خراب‌اند: " + failed.join("، ") + ". آخرین خطاها:\n" + (out.stdout + out.stderr).trim().split("\n").slice(-40).join("\n").slice(0, 2000) +
      "\nهمهٔ پنج دروازه را سبز کن.",
  );
}
log("دروازه‌ها: " + (failed.length === 0 ? "همه سبز" : failed.join("، ") + " هنوز خراب"));

phase("زلزدن هر نمونهٔ ایرانی از فایل‌های تازه");
const iranTargets = ["packages/core/src/css/blocks", "packages/core/src/js/blocks", "packages/react/src/blocks", "apps/showcase/src/blocks"];
const iran = await world.run("grep", ["-rEni", "ایران|تهران|Iran|Tehran", ...iranTargets]);
if (iran.exitCode === 0) {
  const hitFiles = [...new Set(iran.stdout.trim().split("\n").filter(Boolean).map((l) => l.split(":")[0] ?? ""))].filter(Boolean);
  report({ what: "نمونهٔ ایرانی در فایل‌های پکیج", evidence: iran.stdout.trim().split("\n").slice(0, 4).join(" | "), severity: "high" }, "issues");
  for (const [i, f] of hitFiles.entries()) {
    await agent("پاک‌ساز-ایران-" + i, {
      system: "تو ویراستار محتوای پکیج هستی؛ سیاست: صفر ارجاع به ایران/تهران — مثال‌ها جهانی.",
    }).ask("در " + f + " الگوی ایران/تهران/Iran/Tehran هست (خودت grep کن). با معادل جهانی عوض کن؛ فقط همین فایل.");
  }
} else {
  log("پویش بدون-ایران پاک بود");
}

phase("بازبینی مرورگری showcase: شش بخش تازه");
const browser = await agent("بازبین-پکیج", {
  system:
    "تو راستی‌آزمای مرورگری با playwright هستی (playwright-core در /tmp/nx-shooter نصب است). showcase را با vite preview خودت بالا بیاور و در پایان ببند. ادعا بدون شاهد ممنوع.",
}).ask<BrowserReview>(
  [
    "۱) سرور: pnpm --filter showcase preview --port 5198 (دقت: --port را مستقیم به preview بده؛ سینتکس -- عبور نمی‌کند). صبر کن localhost:5198 جواب بدهد.",
    "۲) از هر ۶ بخش تازه (گروه‌های 0.3 در منو) اسکرین‌شات fullPage از خود بخش در /tmp/nx-pkg6/<id>-light.png؛ برای سه تای اول (entrances، micro-fx، depth-3d) نسخهٔ تیره هم.",
    "۳) «عکس را بعد از اتمام انیمیشن بگیر»: برای دموهای ورودی/پرده‌ای/ترسیمی، تا settle کامل (حداکثر ~۶ ثانیه) صبر کن بعد شات — شاتِ میان-انیمیشن مدرک نیست. برای حلقه‌های بی‌پایان دو شات با فاصله بگیر که حرکت اثبات شود.",
    "۴) خطای کنسول (pageerror + console.error) هر ۶ بخش — هیچ خطایی قابل‌قبول نیست؛ و سرریز: scrollWidth هر بخش در برابر clientW در 375 هم گزارش شود.",
    "۵) تعامل‌های واقعی (قبل از هر تعامل عنصر را scrollIntoViewIfNeeded کن): CurtainReveal ری‌پلی، SplitFlap متن عوض کند، Confetti دکمه ذره بریزد، DragSpring بکشد و رها شود، FlipCube با درگ بچرخد، ImageAccordion با فلش کیبورد جابه‌جا شود — هرکدام یک شات *-interact.png.",
    "۶) انگلیسی: سوییچ زبان، یک شات EN از entrances و micro-fx (<id>-en.png).",
    "۷) سرور را kill کن.",
    "",
    "خروجی فقط JSON {ok, findings:[{what, evidence, severity}], shots:[مسیرها]} — findings فارسی.",
  ].join("\n"),
);

phase("اصلاح ایرادهای showcase و بازتأیید ساخت");
const actionable = (browser.findings ?? []).filter((f) => f.severity !== "low").slice(0, 8);
if (actionable.length > 0) {
  for (const [i, f] of actionable.entries()) {
    await agent("اصلاح‌گر-showcase-" + i, {
      system:
        "تو تعمیرکار بلاک‌های showcase هستی؛ فقط مورد اشاره‌شده را در packages/ یا apps/showcase درست کن و قرارداد BLOCKS.md را نگه دار. پس از اصلاح pnpm --filter showcase build را سبز کن و با عکس/پروب تأیید کن.",
    }).ask("ایراد: " + f.what + " — شاهد: " + f.evidence + ". درست کن، تأیید کن، کوتاه نتیجه بگو.");
  }
  const re = await world.run("pnpm", ["--filter", "showcase", "build"], { timeoutMs: 600000 });
  if (re.exitCode !== 0) {
    report({ what: "showcase build پس از اصلاح خراب", evidence: (re.stdout + re.stderr).trim().split("\n").slice(-4).join(" | "), severity: "high" }, "issues");
  }
} else {
  log("ایراد showcase با شدت بالا/متوسط پیدا نشد");
}

phase("داوری بصری مستقل");
const judgeShots = (browser.shots ?? []).filter((s) => s.startsWith("/tmp/nx-pkg6/") && !s.endsWith("-interact.png")).slice(0, 14);
let verdicts: JudgeVerdict[] = [];
if (judgeShots.length > 0) {
  const judge = await agent("داور-بصری", {
    system:
      "تو داور پذیرش بصری هستی و فقط از تصویر قضاوت می‌کنی؛ ادعای ندیده ممنوع. چیدمان شکسته/ناخوانا/تم تیرهٔ خراب/سرریز = مردود؛ سلیقهٔ جزئی = قبول. یکدستی با زبان طراحی NabuXUI مهم است. این عکس‌ها پس از settle کامل انیمیشن‌ها گرفته شده‌اند.",
  }).ask<{ verdicts: JudgeVerdict[] }>(
    "این عکس‌ها را با Read یکی‌یکی ببین و دربارهٔ هرکدام حکم بده:\n" + judgeShots.join("\n") +
      "\nخروجی فقط JSON: {verdicts:[{shot, pass, issues}]} — issues فارسی.",
  );
  verdicts = judge.verdicts ?? [];
  for (const v of verdicts.filter((v) => !v.pass)) {
    report({ what: "داوری بصری مردود: " + v.shot, evidence: v.issues, severity: "medium" }, "issues");
  }
} else {
  report({ what: "عکسی برای داوری نماند", evidence: "بازبین شاتی برنگرداند", severity: "high" }, "issues");
}

const failedBuilders = builders.filter((b) => !b.ok);
const problems = [
  ...failed.map((g) => "دروازهٔ " + g),
  ...failedBuilders.map((b) => "سازندهٔ ناقص: " + b.notes),
  ...(browser.findings ?? []).filter((f) => f.severity !== "low").map((f) => f.what),
  ...verdicts.filter((v) => !v.pass).map((v) => "داوری: " + v.shot),
];

await artifact.markdown(
  "report",
  [
    "# پورت موج انیمیشن‌ها به پکیج‌ها — 0.3.0",
    "",
    "**شش خانوادهٔ موج ۴ حالا بلاک کتابخانه‌ای‌اند** (ورودها، هاورها، پس‌زمینه‌های محیطی، تایپوگرافی جنبشی، ریزتعامل‌ها، عمق سه‌بعدی) — CSS و رفتارهای تازه در @nabuxai/ui-core و کامپوننت‌های React در @nabuxai/ui-react + شش بخش showcase. نسخه‌ها 0.2.0 → 0.3.0.",
    "",
    "دروازه‌های ساخت: " + (failed.length === 0 ? "هر پنج دروازه سبز" : "باز: " + failed.join("، ")) + ".",
    "",
    "## خانواده‌ها",
    ...FAMILIES.map((f, i) => {
      const b = builders[i];
      return "- " + (b.ok ? "✅" : "❌") + " **" + f.labelFa + "** (" + f.id + ")" + (b.exports.length ? " → " + b.exports.join("، ") : "") + (b.ok ? "" : " — " + b.notes);
    }),
    "",
    "## بازبینی showcase",
    ...((browser.findings ?? []).length === 0 ? ["- مشکلی پیدا نشد."] : (browser.findings ?? []).map((f) => "- " + (f.severity === "high" ? "🔴" : f.severity === "medium" ? "🟠" : "🟡") + " " + f.what + " — " + f.evidence)),
    "",
    "## داوری بصری مستقل (" + verdicts.length + " عکس)",
    ...verdicts.map((v) => "- " + (v.pass ? "✅" : "❌") + " " + v.shot + (v.issues ? " — " + v.issues : "")),
  ].join("\n"),
  { title: "گزارش پورت 0.3.0", description: "شش خانوادهٔ انیمیشنی در ui-core/ui-react + showcase — از اسکفولد تا داوری", primary: true },
);

const report_: WorkflowReport = {
  conclusion:
    problems.length === 0
      ? "پورت موج انیمیشن‌ها کامل شد: شش خانواده به‌صورت بلاک کتابخانه‌ای (CSS هسته + رفتارهای تازه + React + showcase)، نسخهٔ 0.3.0، هر پنج دروازهٔ ساخت سبز و داوری بصری قبول."
      : "موج انجام شد اما " + problems.length + " مورد باز دارد: " + problems.slice(0, 5).join("؛ ") + ".",
  findings: [
    ...failed.map((g) => ({ what: "دروازهٔ " + g + " خراب", evidence: "pnpm", severity: "high" as const })),
    ...failedBuilders.map((b) => ({ what: "سازندهٔ ناقص", evidence: b.notes, severity: "high" as const })),
    ...(browser.findings ?? []),
    ...verdicts.filter((v) => !v.pass).map((v) => ({ what: "داوری تصویر " + v.shot, evidence: v.issues, severity: "medium" as const })),
  ],
  verified: [
    "پنج دروازهٔ قطعی با world.run: build/typecheck/test برای core و react + showcase build (حلقهٔ اصلاح تا ۳ دور)",
    "گrep بدون-ایران روی بلاک‌های تازه",
    "بازبینی مرورگری vite preview: اسکرین‌شات پس از settle کامل انیمیشن‌ها + روشن/تیره + EN + تعامل‌های واقعی (پرده/اسپلیت‌فلپ/کانفتی/فنر/مکعب/آکاردئون) + خطاهای کنسول + سرریز 375",
    "داوری بصری مستقل روی " + verdicts.length + " عکس",
  ],
  notCovered: [
    "کامپوننت‌های آمادهٔ Vue/Svelte برای خانواده‌های تازه (CSS هسته را مستقیم مصرف می‌کنند — تکه‌کد در دموها هست)",
    "majorهای ابزار dev (TypeScript 7، Vitest 5) — جداگانه و با تست کامل",
  ],
};
return report_;
