
<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames((['name' => null, 'title' => null, 'description' => null, 'size' => null, 'variant' => 'modal', 'side' => null, 'closeOnBackdrop' => true, 'hideClose' => false, 'open' => false]));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter((['name' => null, 'title' => null, 'description' => null, 'size' => null, 'variant' => 'modal', 'side' => null, 'closeOnBackdrop' => true, 'hideClose' => false, 'open' => false]), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>
<?php
    $id = \NabuXUI\NabuXUI::id('nx-dialog');
    $model = \NabuXUI\NabuXUI::model($attributes);
?>
<div style="display: contents"
    <?php if($model): ?> x-data="nxDialog(<?php if ((object) ($model) instanceof \Livewire\WireDirective) : ?>window.Livewire.find('<?php echo e($__livewire->getId()); ?>').entangle('<?php echo e($model->value()); ?>')<?php echo e($model->hasModifier('live') ? '.live' : ''); ?><?php else : ?>window.Livewire.find('<?php echo e($__livewire->getId()); ?>').entangle('<?php echo e($model); ?>')<?php endif; ?>)" <?php else: ?> x-data="nxDialog(<?php echo \Illuminate\Support\Js::from((bool) $open)->toHtml() ?>, <?php echo \Illuminate\Support\Js::from($name)->toHtml() ?>)" <?php endif; ?>
    @nx-open.window="openNamed($event.detail)" @nx-close.window="closeNamed($event.detail)">
    <dialog x-ref="dialog" <?php echo e($attributes->whereDoesntStartWith('wire:model')->class('nx-dialog')->merge([
        'data-size' => $size && $size !== 'md' ? $size : null,
        'data-variant' => $variant === 'modal' ? null : $variant,
        'data-side' => $side === 'start' ? 'start' : null,
        'aria-labelledby' => $title ? "{$id}-title" : null,
        'aria-describedby' => $description ? "{$id}-description" : null,
    ])); ?> <?php if($closeOnBackdrop): ?> @click="backdrop($event)" <?php endif; ?>>
        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($title || $description): ?>
            <header class="nx-dialog-header">
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($title): ?><h2 class="nx-dialog-title" id="<?php echo e($id); ?>-title"><?php echo e($title); ?></h2><?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($description): ?><p class="nx-dialog-description" id="<?php echo e($id); ?>-description"><?php echo e($description); ?></p><?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
            </header>
        <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
        <div class="nx-dialog-body"><?php echo e($slot); ?></div>
        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if(isset($footer)): ?><footer class="nx-dialog-footer"><?php echo e($footer); ?></footer><?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if (! ($hideClose)): ?>
            <button type="button" class="nx-dialog-close" aria-label="<?php echo e(__('nabuxui::ui.close')); ?>" @click="open = false"><?php echo e(\NabuXUI\NabuXUI::icon('x')); ?></button>
        <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
    </dialog>
</div>
