/**
 * موج بزرگ تکمیل NabuXUI — صد‌ها عامل موازی
 * ۱۲ بلوک جدید + تکمیل همهٔ دموها + صفحات تازهٔ پنل در Livewire/React
 * + دو طعم تازهٔ واقعی Vue و Svelte + تست، بازبینی، گیت، کامیت و سند.
 */

interface BuildResult {
  /** نام‌های قابل‌نمایش ویژگی‌های ساخته‌شده (فارسی). */
  features: string[];
  /** مسیرهای workspace-relative ساخته/ویرایش‌شده. */
  filesTouched: string[];
  /** نکته برای عامل‌های بعدی. */
  notes: string;
}

interface Finding {
  /** مسیر + خط در صورت امکان: "path:42". */
  where: string;
  /** یک جمله: مشکل چیست. */
  what: string;
  /** شاهد: خطوط خوانده‌شده یا خروجی دستور. */
  evidence: string;
  severity: "low" | "medium" | "high";
}

interface FixResult {
  fixed: Finding[];
  remaining: Finding[];
  filesTouched: string[];
  notes: string;
}

interface Confirmation { where: string; what: string; confirmed: boolean; note: string; }

interface CommitResult { commitHash: string; pushed: boolean; notes: string; }

interface DocResult { adminDocPath: string; reportMarkdown: string; notes: string; }

interface ReaderFeedback { unclear: string[]; missing: string[]; }

interface Attempt<T> { ok: boolean; result?: T; err?: string; label: string; }

const COMMON = `## زمینهٔ مشترک
مخزن NabuXUI (pnpm workspace + composer). لایه‌ها: هسته packages/core (CSS توکن/حرکت + JS رفتاری)، React packages/react، Livewire packages/livewire (بلید x-nx:: + Alpine)، پلی‌گراوند playground (دموها در /components و پنل /admin)، اپ React پنل apps/admin.
اول بخوان: docs/BLOCKS.md (قرارداد بلوک)، docs/ADMIN.md (پنل و صفحاتش)، یک نمونهٔ مشابه موجود (مثل data-table یا kanban در هر سه لایه).
میلهٔ کیفیت: توکن‌ها نه رنگ خام؛ روشن/تیره؛ RTL با property منطقی و --nx-dir؛ اعداد فارسی (numberParts/localeDigits یا NabuXUI::formatNumber)؛ حرکت فنری هم‌خانوادهٔ موجود و بی‌اثر در reduced-motion؛ دسترس‌پذیری (role/aria/کیبورد)؛ واژه‌های خود کامپوننت در i18n هسته (useT/__('nabuxui::ui.<key>') — کلید را به packages/core/src/js/i18n.ts همهٔ زبان‌ها اضافه کن و برای بلید فقط consume کن).
قواعد هم‌زمانی: فقط فایل‌های وظیفهٔ خودت؛ فایل مشترک را قبل از ویرایش تازه بخوان؛ هیچ دستور git؛ فایل‌های backdrop* ممنوع.
پاسخ نهایی: فقط JSON مطابق اسکیمای وظیفه (بدون محتوای فایل).`;

const NO_FAKE = "اگر کاری غیرقابل‌اجراست صادقانه بگو و escalate کن؛ نتیجه را جعل نکن.";

function short(s: string): string { return s.length > 2500 ? s.slice(-2500) : s; }

async function safeAsk<T>(label: string, node: Node<T>): Promise<Attempt<T>> {
  try { const result = await node; return { ok: true, result, label }; }
  catch (e) { return { ok: false, err: String(e).slice(0, 400), label }; }
}

function touched(atts: Attempt<BuildResult>[]): string[] {
  return Array.from(new Set(atts.flatMap(a => a.ok && a.result ? a.result.filesTouched : [])));
}

artifact.table("features", {
  title: "کارهای انجام‌شدهٔ این موج",
  columns: [
    { field: "feature", label: "ویژگی" },
    { field: "area", label: "بخش" },
    { field: "status", label: "وضعیت" },
  ],
  key: "feature",
});

function reportAll(atts: Attempt<BuildResult>[], area: string): void {
  // یک آیتم به‌ازای هر عامل — نه هر ویژگی — تا سقف ۲۵۶ آیتمِ report پر نشود.
  for (const a of atts) {
    if (!a.ok) {
      report({ feature: `${a.label} — شکست`.slice(0, 120), area, status: "ناموفق" }, "features");
      continue;
    }
    const n = a.result?.features.length ?? 0;
    const first = String(a.result?.features[0] ?? "").slice(0, 60);
    report({ feature: `${a.label} (${n} ویژگی) — ${first}`, area, status: "آماده" }, "features");
  }
}

/* ─────────────── فاز ۱: دوازده بلوک جدید ─────────────── */

phase("ساخت دوازده بلوک جدید سیستم به‌موازات");

const BLOCKS: Array<{ slug: string; brief: string }> = [
  { slug: "email", brief: "nx-email — کلاینت ایمیل: ستون پوشه‌ها، لیست پیام‌ها (خوانده/ستاره)، پنل خواندن، composer با diacritics نرم؛ state لوکال/prop." },
  { slug: "file-manager", brief: "nx-file-manager — مدیریت فایل: نوار ابزار (گرید/لیست سوییچ، جست‌وجو، آپلود)، کارت فایل/پوشه با آیکون نوع و متادیتا، details در drawer." },
  { slug: "todo", brief: "nx-todo — لیست کارها: گروه‌ها، تیک فنری، ترتیب با درگ، شمارنده و نوار پیشرفت، افزودن سریع." },
  { slug: "product-card", brief: "nx-product-card — کارت محصول: تصویر با hover zoom، قیمت و تخفیف، rating، افزودن به سبد با مورف دکمه، بج موجودی." },
  { slug: "order-tracking", brief: "nx-order-tracking — رهگیری سفارش: steps افقی + تایم‌لاین رویدادها، وضعیت زنده با status-badge." },
  { slug: "bar-chart", brief: "nx-bar-chart — نمودار میله‌ای CSS: رشد پلکانی هنگام reveal، گروهی/انباشته، محور و tooltip، جدول پنهان برای a11y." },
  { slug: "donut-chart", brief: "nx-donut-chart — دونات conic-gradient با sweep متحرک، legend با درصد رولینگ، مرکز با عدد اصلی." },
  { slug: "gauge", brief: "nx-gauge — گیج نیم‌دایره با عقربه فنری و عدد رولینگ، نواحی رنگی از توکن." },
  { slug: "tree-view", brief: "nx-tree-view — درخت تاشو با role=tree، کیبورد کامل (فلش/هاوم/اند)، شمار فرزند، حالت انتخاب." },
  { slug: "gantt", brief: "nx-gantt — گانت: ردیف‌ها و میله‌های قابل درگ روی گرید زمانی، خط امروز، نقطهٔ وابستگی، zoom ساده." },
  { slug: "wizard", brief: "nx-wizard — پوستهٔ فرم چندمرحله‌ای روی steps موجود: نوار پیشرفت، ولیدیشن هر مرحله، خلاصهٔ پایانی." },
  { slug: "profile-card", brief: "nx-profile-card — کارت پروفایل: کاور گرادیانی، آواتار، آمار رولینگ، دکمه‌های پیگیری/پیام، تب‌های کوچک." },
];

const builderPersona = "سازندهٔ کامپوننت سیستم طراحی NabuXUI با قرارداد docs/BLOCKS.md. " + NO_FAKE;

const blockAtts = await Promise.all(BLOCKS.map(b => {
  const a = agent(`سازندهٔ ${b.slug}`, { system: builderPersona });
  return safeAsk<BuildResult>(`بلوک ${b.slug}`, a.ask<BuildResult>(`${COMMON}
## وظیفه (فقط فایل تازه — سیم‌کشی را integrator انجام می‌دهد)
${b.brief}
در هر سه لایه بساز: CSS در packages/core/src/css/blocks/${b.slug}.css، بلید packages/livewire/resources/views/components/${b.slug}.blade.php، React در packages/react/src/blocks/${b.slug}.tsx (خروجی‌های named). رفتار JS اگر لازم شد: هسته در packages/core/src/js/ (فایل تازه) و Alpine در packages/livewire/resources/js/alpine/blocks/${b.slug}.ts (بدون ثبت در index.ts). واژه‌های کامپوننت را به i18n هسته اضافه کن (en/fa/ar در packages/core/src/js/i18n.ts — فقط در انتهای هر جدول کلید اضافه کن). کانبان و invoice را الگوی کیفیت بگیر.`));
}));
reportAll(blockAtts, "بلوک‌های جدید");
log(`${blockAtts.filter(x => x.ok).length}/${BLOCKS.length} بلوک ساخته شد؛ سیم‌کشی شروع می‌شود`);

/* ─────────────── فاز ۲: سیم‌کشی ─────────────── */

phase("سیم‌کشی بلوک‌های جدید به بسته‌ها");

const wireCss = agent("سیم‌کش CSS و React", { system: "یکپارچه‌ساز NabuXUI، حداقلی و دقیق. " + NO_FAKE });
const wirePhp = agent("سیم‌کش Livewire و زبان‌ها", { system: "یکپارچه‌ساز NabuXUI، حداقلی و دقیق. " + NO_FAKE });

const wiring = await Promise.all([
  safeAsk<BuildResult>("سیم‌کشی CSS/React", wireCss.ask<BuildResult>(`${COMMON}
فایل‌های تازهٔ این موج: ${JSON.stringify(touched(blockAtts))}
۱) هر CSS تازه را به packages/core/src/css/index.css اضافه کن (تازه بخوان؛ خط backdrops دست‌نخورده).
۲) خروجی‌های React تازه را به packages/react/src/index.ts اضافه کن (الگوی موجود).
۳) pnpm -r --filter ./packages/** run typecheck و build را تا سبز اجرا کن؛ خطاهای سیم‌کشی را فقط در فایل‌های همین موج رفع کن.`)),
  safeAsk<BuildResult>("سیم‌کشی Livewire/زبان", wirePhp.ask<BuildResult>(`${COMMON}
۱) installerهای Alpine تازه را در packages/livewire/resources/js/index.ts نصب کن (فایل‌های alpine/blocks تازهٔ این موج: ${JSON.stringify(touched(blockAtts).filter(p => p.includes("alpine/blocks")))}).
۲) فایل‌های زبان resources/lang/*/ui.php را با اسکریپت build بسته بازتولید کن (کلیدهای i18n تازه) و php -l بزن.
۳) بیلد بستهٔ livewire را تا سبز اجرا کن.`)),
]);
reportAll(wiring, "سیم‌کشی");

/* ─────── فاز ۳: دموی مستقل بلوک‌های جدید + پر کردن دموهای جاافتاده ─────── */

phase("نوشتن دموی مستقل برای همهٔ کامپوننت‌های مانده");

const gapFinder = agent("یابندهٔ دموهای جاافتاده", { system: "تحلیلگر پلی‌گراوند NabuXUI. " + NO_FAKE });
const gaps = await gapFinder.ask<{ items: Array<{ group: string; slug: string; title: string }> }>(`${COMMON}
فهرست کامپوننت‌هایی که در منیفست‌های playground/app/Support/Demos/*.php هستند ولی ویوی دموی playground/resources/views/demos/components/<group>/<slug>.blade.php ندارند را استخراج کن (همچنین ۱۲ بلوک تازهٔ همین موج: ${JSON.stringify(BLOCKS.map(b => b.slug))} را با گروه درست اضافه کن: email/todo/gantt/file-manager → data؛ product-card/order-tracking/profile-card/wizard/bar-chart/donut-chart/gauge/tree-view → data یا cards به تشخیح ماهیت). فقط JSON.`);

const demoJobs: Array<{ group: string; slug: string; title: string }> = (gaps.items ?? []).slice(0, 60);
log(`${demoJobs.length} دمو باید نوشته شود — فن‌آور موازی`);

const demoPersona = "نویسندهٔ دموی کامپوننت پلی‌گراوند — دمو با سناریوی واقعی، نه پراپ‌نما. " + NO_FAKE;

const demoAtts = await Promise.all(demoJobs.map(j => {
  const a = agent(`نویسندهٔ دمو ${j.slug}`, { system: demoPersona });
  return safeAsk<BuildResult>(`دمو ${j.slug}`, a.ask<BuildResult>(`${COMMON}
برای کامپوننت «${j.title}» (${j.group}/${j.slug}) صفحهٔ دمو بساز، دقیقاً مطابق الگوی صفحات موجود (نمونه: demos/components/data/kanban.blade.php): مدخل منیفست (فقط گروه خودت را ویرایش کن — تازه بخوان) + ویوی دمو با ۲-۳ سناریوی واقعی فارسی + جدول پراپ‌ها + تکه‌کد قابل‌کپی. فقط فایل خودت.`));
}));
reportAll(demoAtts, "دموهای مستقل");
log(`${demoAtts.filter(x => x.ok).length}/${demoJobs.length} دمو کامل شد`);

/* ─────── فاز ۴: اسکلت صفحات تازه در چهار طعم ─────── */

phase("اسکلت صفحات تازهٔ پنل در Livewire و React و دو طعم تازهٔ Vue/Svelte");

const lwArch = agent("معمار صفحات لاراول", { system: "معمار Laravel/Livewire پنل نابو. " + NO_FAKE });
const rxArch = agent("معمار صفحات React", { system: "معمار React پنل نابو. " + NO_FAKE });
const flavorsArch = agent("معمار طعم‌های Vue و Svelte", { system: "معمار فرانت‌اند چند‌فریم‌ورکی؛ اپ‌های تازهٔ Vite می‌سازی. " + NO_FAKE });
const deployAgent = agent("پیکربندی استقرار", { system: "مهندس استقرار NabuXUI. " + NO_FAKE });

const PAGE_SET = "محصولات (گرید product-card + فیلتر)، سفارش‌ها (data-table + order-tracking در دیالوگ)، ایمیل (nx-email تمام‌صفحه)، فایل‌ها (nx-file-manager)، کارها (nx-todo)، نقش‌ها و دسترسی‌ها (ماتریس جدول + switch)، خطاها (۴۰۴/۵۰۰/تعمیر به‌صورت صفحه‌های مستقل minimal)";

const [lwSkeleton, rxSkeleton, flavors, deploy] = await Promise.all([
  safeAsk<BuildResult>("اسکلت لاراول", lwArch.ask<BuildResult>(`${COMMON}
صفحات تازهٔ پنل Livewire: ${PAGE_SET}. روتهای /admin/... را به playground/routes/web.php اضافه کن (تازه بخوان)، App\\Livewire\\Admin\\* + ویو با <x-admin.page> بساز، منوی سایدبار را در App\\Support\\Panel با آیتم‌های تازه کامل کن (گروه «فروشگاه» و «صفحات»)، کلیدهای زبان fa/en را از پیش کامل در playground/lang اضافه کن (پرکننده‌ها فقط مصرف کنند)، stub اولیهٔ هر صفحه با empty-state. فایل‌های stub را در نوتی فهرست کن.`)),
  safeAsk<BuildResult>("اسکلت React", rxArch.ask<BuildResult>(`${COMMON}
صفحات تازهٔ apps/admin (همان ست: ${PAGE_SET}): فایل صفحات stub در apps/admin/src/pages + ثبت در رجیستری روتر hash + منوی سایدبار + کلیدهای زبان fa/en در apps/admin/src/lang.tsx (فقط تو این فاز ویرایشش می‌کنی — پرکننده‌ها مصرف می‌کنند). pnpm --filter admin run build سبز باشد.`)),
  safeAsk<BuildResult>("طعم‌های Vue/Svelte", flavorsArch.ask<BuildResult>(`${COMMON}
دو اپ تازه بساز — پنل در دو زبان دیگر، با همان استایل و کلاس‌های nx-* و رفتارهای @nabuxai/ui-core:
۱) apps/admin-vue: Vite + vue + @vitejs/plugin-vue؛ نام بسته "admin-vue"، پورت 5175؛ themeScript + CSS هسته از workspace؛ روت hash سبک؛ صفحات: داشبورد، کاربران (DataTable با مارک‌آپ nx-)، کانبان، تنظیمات، ورود؛ دوزبانه fa/en با الگوی apps/admin/src/lang.tsx (کپی کن و SFC بساز).
۲) apps/admin-svelte: Vite + svelte + @sveltejs/vite-plugin-svelte؛ نام "admin-svelte"، پورت 5176؛ همان صفحات در Svelte 5 (runes).
۳) فقط تو package.json ریشه را ویرایش کن: اسکریپت‌های "admin:vue" و "admin:svelte". یک بار pnpm install در ریشه اجرا کن (شبکه هست) و هر دو اپ را build کن تا سبز؛ اگر بیلد یک طعم شکست، خودت رفع کن. فایل‌های stub صفحات را در نوتی فهرست کن. راهنمای markup رفتارها: docs/FRAMEWORKS.md بخش Vue و Svelte.`)),
  safeAsk<BuildResult>("استقرار", deployAgent.ask<BuildResult>(`${COMMON}
در docker-compose.override.yml سرویس‌های dev اپ‌های admin (5174)، admin-vue (5175) و admin-svelte (5176) را به الگوی سرویس‌های موجود اضافه کن (تازه بخوان؛ فایل محلی کاربر است — حداقلی و append-only). docs/ADMIN.md را با بخش استقرار (پورت‌ها و Coolify) تکمیل کن.`)),
]);
reportAll([lwSkeleton, rxSkeleton, flavors, deploy], "اسکلت صفحات");

/* ─────── فاز ۵: پر کردن صفحات ─────── */

phase("پر کردن صفحات تازه در هر چهار طعم");

const pageSets = [
  { area: "پنل Livewire", arch: lwSkeleton },
  { area: "پنل React", arch: rxSkeleton },
];
const flavorSets = [
  { area: "طعم Vue", arch: flavors, dir: "apps/admin-vue" },
  { area: "طعم Svelte", arch: flavors, dir: "apps/admin-svelte" },
];

const fillers = await Promise.all([
  ...pageSets.map(ps => {
    const a = agent(`پرکنندهٔ دادهٔ ${ps.area}`, { system: "توسعه‌دهندهٔ صفحات پنل نابو با جزئیات واقعی. " + NO_FAKE });
    return safeAsk<BuildResult>(`صفحات دادهٔ ${ps.area}`, a.ask<BuildResult>(`${COMMON}
نکتهٔ معمار: ${JSON.stringify(ps.arch.ok ? ps.arch.result?.notes : ps.arch.err)}
صفحات «محصولات، سفارش‌ها، ایمیل، فایل‌ها، کارها» را کامل کن (کامپوننت‌های nx تازهٔ همین موج را استفاده کن: ${JSON.stringify(BLOCKS.map(b => b.slug))})؛ دادهٔ نمونهٔ فارسی معنادار؛ فقط فایل‌های stub خودت؛ کلیدهای زبان از قبل هست — فقط مصرف کن.`));
  }),
  ...pageSets.map(ps => {
    const a = agent(`پرکنندهٔ سیستمی ${ps.area}`, { system: "توسعه‌دهندهٔ صفحات پنل نابو با جزئیات واقعی. " + NO_FAKE });
    return safeAsk<BuildResult>(`صفحات سیستمی ${ps.area}`, a.ask<BuildResult>(`${COMMON}
نکتهٔ معمار: ${JSON.stringify(ps.arch.ok ? ps.arch.result?.notes : ps.arch.err)}
صفحات «نقش‌ها و دسترسی‌ها (ماتریس switch)، ۴۰۴، ۵۰۰، تعمیر» را کامل کن؛ ۴۰۴/۵۰۰ با empty-state و کدهای وضعیت درست؛ فقط فایل‌های خودت.`));
  }),
  ...flavorSets.map(fs => {
    const a = agent(`پرکنندهٔ ${fs.area}`, { system: "توسعه‌دهندهٔ چند‌فریم‌ورکی پنل نابو. " + NO_FAKE });
    return safeAsk<BuildResult>(`صفحات ${fs.area}`, a.ask<BuildResult>(`${COMMON}
نکتهٔ معمار: ${JSON.stringify(fs.arch.ok ? fs.arch.result?.notes : fs.arch.err)}
در ${fs.dir} صفحات stub را کامل کن: داشبورد (ستات/نمودار/فید)، کاربران (جدول nx- با مرتب‌سازی)، کانبان (درگ‌اند‌دراپ با state فریم‌ورک)، تنظیمات (فرم+تم+زبان)، ورود (auth مارک‌آپ nx-). رفتارها را از @nabuxai/ui-core صدا بزن (reveal/indicator/theme...) مطابق docs/FRAMEWORKS.md. در پایان pnpm --filter ${fs.dir.split("/")[1]} run build سبز باشد.`));
  }),
]);
reportAll(fillers, "پر کردن صفحات");

const allRuns = [...blockAtts, ...wiring, ...demoAtts, ...fillers];
const allTouched = Array.from(new Set([
  ...touched(blockAtts), ...touched(wiring), ...touched(fillers),
  ...(lwSkeleton.ok && lwSkeleton.result ? lwSkeleton.result.filesTouched : []),
  ...(rxSkeleton.ok && rxSkeleton.result ? rxSkeleton.result.filesTouched : []),
  ...(flavors.ok && flavors.result ? flavors.result.filesTouched : []),
  ...(deploy.ok && deploy.result ? deploy.result.filesTouched : []),
]));

/* ─────── فاز ۶: تست‌ها ─────── */

phase("نوشتن تست برای بلوک‌های جدید");

const testWriter = agent("نویسندهٔ تست", { system: "مهندس تست NabuXUI (vitest + happy-dom). " + NO_FAKE });
const tests = await safeAsk<BuildResult>("تست بلوک‌ها", testWriter.ask<BuildResult>(`${COMMON}
برای ۱۲ بلوک تازهٔ React تست بنویس به الگوی packages/react/test/blocks-admin.test.tsx (رندر، رفتار کلیدی، واژه‌های i18n با localeهای مختلف، کرش‌نکردن با locale ناشناخته) در فایل‌های تازه packages/react/test/blocks-extra-*.test.tsx. pnpm --filter @nabuxai/ui-react run test سبز باشد.`));
reportAll([tests], "تست‌ها");

/* ─────── فاز ۷: بازبینی موازی شش‌گانه ─────── */

phase("بازبینی مستقل شش‌ناظره");

const reviewLenses: Array<{ name: string; focus: string }> = [
  { name: "ناظر حرکت و CSS", focus: "توکن‌ها به‌جای رنگ خام، روشن/تیره، RTL/--nx-dir، فنر/FLIP هم‌خانواده، reduced-motion، شلوغی انیمیشن" },
  { name: "ناظر دسترس‌پذیری", focus: "role/aria، کیبورد و فوکوس، درگ‌اند‌دراپ جایگزین کیبوردی، جدول پنهان نمودارها، aria-live" },
  { name: "ناظر دوزبانگی", focus: "کلیدهای جاافتادهٔ fa/en/ar، اعداد فارسی، dir/lang، متن سخت‌کدشده" },
  { name: "ناظر React", focus: "کنترل‌شده/نشده، هوک‌های internal، تایپ‌ها، کلیدهای لیست، cleanup رفتارها" },
  { name: "ناظر Livewire و Blade", focus: "wire:model درست، morph-پذیری، x-text سالم (الگوی }} اضافه را بگرد!)، پراپ‌های اختیاری" },
  { name: "ناظر Vue و Svelte", focus: "پارتی‌های تازهٔ admin-vue/admin-svelte: مارک‌آپ nx- درست، import رفتارهای هسته و cleanup، بیلد سبز، دو زبان" },
];

const fileList = allTouched.slice(0, 400).join("، ");

const reviewAtts = await Promise.all(reviewLenses.map(l => {
  const a = agent(l.name, { system: "بازبین مستقل فقط-خواندنی NabuXUI؛ یافته با شاهد path:line؛ ویرایش ممنوع. " + NO_FAKE });
  return safeAsk<{ findings: Finding[] }>(l.name, a.ask<{ findings: Finding[] }>(`${COMMON}
## بازبینی فقط-خواندنی
تمرکز: ${l.focus}
فایل‌های این موج: ${fileList}
همچنین الگوی خطرناک «}} اضافه در انتهای x-text/x-bind» را در همهٔ بلیدهای تازه grep کن (قبلاً یک باگ واقعی بود). فقط یافته‌های واقعی با شاهد.`));
}));

const allFindings: Finding[] = reviewAtts.flatMap(a => a.ok && a.result ? a.result.findings : []).filter(f => f && f.where && f.what);
const toFix = allFindings.filter(f => f.severity !== "low");
const lows = allFindings.filter(f => f.severity === "low");
log(`بازبینی: ${allFindings.length} یافته (${toFix.length} جدی، ${lows.length} جزئی)`);

/* ─────── فاز ۸: رفع و تأیید ─────── */

phase("رفع یافته‌های جدی با چهار اصلاح‌گر و تأیید مستقل");

const fixers = {
  core: agent("اصلاح‌گر هسته", { system: "اصلاح‌گر دقیق و حداقلی NabuXUI. " + NO_FAKE }),
  blade: agent("اصلاح‌گر بلید", { system: "اصلاح‌گر دقیق و حداقلی NabuXUI. " + NO_FAKE }),
  react: agent("اصلاح‌گر React", { system: "اصلاح‌گر دقیق و حداقلی NabuXUI. " + NO_FAKE }),
  flavors: agent("اصلاح‌گر Vue/Svelte", { system: "اصلاح‌گر دقیق و حداقلی NabuXUI. " + NO_FAKE }),
};
const confirmer = agent("تأییدکنندهٔ اصلاحات", { system: "تأییدکنندهٔ مستقل فقط-خواندنی. ویرایش ممنوع. " + NO_FAKE });

function bucketOf(f: Finding): keyof typeof fixers {
  if (f.where.startsWith("apps/admin-vue") || f.where.startsWith("apps/admin-svelte")) return "flavors";
  if (f.where.startsWith("apps/") || f.where.includes("packages/react")) return "react";
  if (f.where.startsWith("playground") || f.where.includes("packages/livewire")) return "blade";
  return "core";
}

let remaining: Finding[] = toFix;
let rounds = 0;
while (remaining.length > 0 && rounds < 2) {
  rounds += 1;
  const byBucket: Record<string, Finding[]> = { core: [], blade: [], react: [], flavors: [] };
  for (const f of remaining) byBucket[bucketOf(f)].push(f);
  const jobs: Array<Attempt<FixResult>> = [];
  for (const key of Object.keys(byBucket)) {
    const list = byBucket[key];
    if (list.length === 0) continue;
    const f = fixers[key as keyof typeof fixers];
    jobs.push(await safeAsk<FixResult>(`دور ${rounds} ${key}`, f.ask<FixResult>(`${COMMON}
این یافته‌ها را رفع کن (فایل را تازه بخوان؛ حداقلی؛ اگر یافته غلط است در remaining با دلیل برگردان):
${JSON.stringify(list, null, 2)}`)));
  }
  const fixed = jobs.flatMap(j => j.ok && j.result ? j.result.fixed : []);
  const carried = jobs.flatMap(j => j.ok && j.result ? j.result.remaining : (j.ok ? [] : []));
  const confirms = await confirmer.ask<{ confirmations: Confirmation[] }>(`${COMMON}
اصلاح‌گران این‌ها را رفع‌شده می‌دانند — هر یک را با خواندن فایل تأیید کن:
${JSON.stringify(fixed, null, 2)}`);
  const failed: Finding[] = [];
  for (const c of confirms.confirmations) {
    if (!c.confirmed) { const m = fixed.find(f => f.where === c.where && f.what === c.what); if (m) failed.push(m); }
  }
  remaining = [...failed, ...carried];
  log(`دور ${rounds}: ${fixed.length - failed.length} تأیید شد، ${remaining.length} مانده`);
}
const unfixed = remaining;

/* ─────── فاز ۹: گیت‌ها ─────── */

phase("سبز کردن همهٔ بیلدها");

interface GateOutcome { id: string; ok: boolean; output: string; }

async function runGate(id: string): Promise<GateOutcome> {
  let r: WorldRunResult;
  if (id === "typecheck-packages") r = await world.run("pnpm", ["-r", "--filter", "./packages/**", "run", "typecheck"]);
  else if (id === "build-packages") r = await world.run("pnpm", ["-r", "--filter", "./packages/**", "run", "build"], { timeoutMs: 600000 });
  else if (id === "test-packages") r = await world.run("pnpm", ["-r", "--filter", "./packages/**", "run", "test"], { timeoutMs: 900000 });
  else if (id === "build-showcase") r = await world.run("pnpm", ["--filter", "showcase", "run", "build"], { timeoutMs: 600000 });
  else if (id === "build-admin") r = await world.run("pnpm", ["--filter", "admin", "run", "build"], { timeoutMs: 600000 });
  else if (id === "build-admin-vue") r = await world.run("pnpm", ["--filter", "admin-vue", "run", "build"], { timeoutMs: 600000 });
  else if (id === "build-admin-svelte") r = await world.run("pnpm", ["--filter", "admin-svelte", "run", "build"], { timeoutMs: 600000 });
  else if (id === "build-playground") r = await world.run("npm", ["--prefix", "playground", "run", "build"], { timeoutMs: 600000 });
  else r = await world.run("bash", ["-c", "find playground/app packages/livewire/src -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null"], { timeoutMs: 300000 });
  return { id, ok: r.exitCode === 0, output: `stdout:\n${short(r.stdout)}\nstderr:\n${short(r.stderr)}` };
}

const GATES = ["typecheck-packages", "build-packages", "test-packages", "build-showcase", "build-admin", "build-admin-vue", "build-admin-svelte", "build-playground", "lint-php"];

const doctor = agent("تعمیرکار بیلد", { system: "تعمیرکار بیلد NabuXUI؛ خطاها را ریشه‌ای رفع می‌کنی. " + NO_FAKE });

let gateOutcomes: GateOutcome[] = [];
let green = false;
let gateRound = 0;
while (gateRound < 4) {
  gateRound += 1;
  gateOutcomes = [];
  for (const id of GATES) gateOutcomes.push(await runGate(id));
  const fails = gateOutcomes.filter(g => !g.ok);
  if (fails.length === 0) { green = true; break; }
  log(`دور ${gateRound}: ${fails.map(f => f.id).join("، ")} قرمز`);
  if (gateRound === 4) break;
  await doctor.ask<BuildResult>(`${COMMON}
این گیت‌ها قرمزند — ریشه‌یابی و رفع کن (فایل‌های backdrop ممنوع):
${fails.map(f => `### ${f.id}\n${f.output}`).join("\n\n")}`);
}
const verifiedGates = GATES.filter(id => gateOutcomes.find(g => g.id === id && g.ok));
const failedGates = GATES.filter(id => !gateOutcomes.find(g => g.id === id && g.ok));

/* ─────── فاز ۱۰: کامیت ─────── */

phase("کامیت و پوش");

const committer = agent("کامیت‌کار", { system: "عامل کامیت؛ فقط کار این اجرا را stage می‌کنی؛ بن‌بست = escalate. " + NO_FAKE });
const commit = await committer.ask<CommitResult>(`${COMMON}
فایل‌های این اجرا (فقط همین‌ها را stage کن — هرگز add -A):
${allTouched.join("\n")}
۱) git status؛ ۲) fetch origin و rebase در صورت عقب‌بودن؛ ۳) کامیت با پیام «موج بزرگ: ۱۲ بلوک جدید (email، file-manager، todo، product-card، order-tracking، bar/donut/gauge، tree-view، gantt، wizard، profile-card) + تکمیل دموها + صفحات تازهٔ پنل + طعم‌های Vue و Svelte»؛ ۴) push (۳ تلاش با pull --rebase). commitHash و pushed را برگردان.`);

/* ─────── فاز ۱۱: سند و گزارش ─────── */

phase("سند نهایی و گزارش با بازخوانی");

const docWriter = agent("نویسندهٔ سند و گزارش", { system: "نویسندهٔ فنی فارسی NabuXUI. " + NO_FAKE });
const reader = agent("بازخوان گزارش", { system: "بازخوان مستقل؛ فقط از متن قضاوت می‌کنی. ویرایش ممنوع. " + NO_FAKE });

let doc = await docWriter.ask<DocResult>(`${COMMON}
۱) docs/ADMIN.md را کامل کن: صفحات تازه، دو طعم تازهٔ Vue (5175) و Svelte (5176) با راه‌راه‌اندازی، استقرار.
۲) docs/FRAMEWORKS.md: ردیف‌های کاتالوگ برای ۱۲ بلوک تازه (تازه بخوان).
۳) reportMarkdown فارسی: چه ساخته شد (تعداد بلوک/دمو/صفحه/طعم)، وضعیت گیت‌ها (${JSON.stringify(verifiedGates)} سبز / ${JSON.stringify(failedGates)} قرمز)، کامیت ${JSON.stringify(commit)}، یافته‌های رفع‌شده و ماندده، راه دیدن در مرورگر.`);

const feedback = await reader.ask<ReaderFeedback>(`این گزارش نهایی «موج بزرگ تکمیل NabuXUI» است — فقط از متن: چه مبهم است؟ چه کم دارد؟\n\n${doc.reportMarkdown}`);
if (feedback.unclear.length > 0 || feedback.missing.length > 0) {
  doc = await docWriter.ask<DocResult>(`${COMMON}
گزارش را بر اساس بازخوان اصلاح کن و نسخهٔ نهایی DocResult را برگردان — مبهم‌ها: ${JSON.stringify(feedback.unclear)}، کمداشته‌ها: ${JSON.stringify(feedback.missing)}`);
}

try {
  await artifact.file("admin-doc", doc.adminDocPath || "docs/ADMIN.md", { title: "سند پنل مدیریت نابو (به‌روزشده)", description: "چهار طعم پنل، صفحات تازه و راه‌راه‌اندازی", primary: true });
} catch { /* سند جای دیگری است — نادیده */ }
await artifact.markdown("report", doc.reportMarkdown, { title: "گزارش نهایی موج بزرگ", description: "چه ساخته شد و چه چیزهایی سبز شد" });

return {
  conclusion: green && commit.pushed
    ? `موج بزرگ کامل شد: ۱۲ بلوک جدید در سه لایه، ~${demoAtts.filter(x => x.ok).length} دموی تازه، صفحات تازه در Livewire/React و دو طعم تازهٔ واقعی Vue و Svelte؛ همهٔ ${GATES.length} گیت سبز و پوش شد (${commit.commitHash}).`
    : `موج اجرا شد اما ناقص — گیت‌های سبز: ${verifiedGates.join("، ") || "هیچ"}؛ قرمز: ${failedGates.join("، ") || "هیچ"}؛ پوش: ${commit.pushed ? "موفق" : "ناموفق"}.`,
  findings: [
    ...lows.map(f => ({ ...f, status: "unconfirmed" as const, note: "جزئی — فقط گزارش" })),
    ...unfixed.map(f => ({ ...f, status: "unconfirmed" as const, note: "بعد از دو دور اصلاح ناتمام" })),
  ],
  verified: [...verifiedGates.map(id => `گیت ${id} سبز`), "یافته‌های جدی بعد از اصلاح مستقل تأیید شدند"],
  notCovered: [
    "تست بصری مرورگر برای صفحات/طعم‌های تازه — بعد از تسویه دستی چک می‌شود",
    "تنظیم اپ واقعی در Coolify فقط پیکربندی-compose شد؛ ثبت سرویس دستی است",
    "phpunit پلی‌گراوند اجرا نشد (نیازمند دیتابیس)",
  ],
};
