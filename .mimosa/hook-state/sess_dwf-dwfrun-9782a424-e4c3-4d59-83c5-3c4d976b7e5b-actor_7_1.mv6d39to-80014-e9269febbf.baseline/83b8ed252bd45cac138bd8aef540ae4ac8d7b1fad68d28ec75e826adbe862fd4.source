
<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames((['variant' => null, 'size' => null, 'interactive' => false, 'spotlight' => false, 'tilt' => false, 'href' => null, 'icon' => null, 'title' => null, 'description' => null, 'titleAs' => 'h3']));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter((['variant' => null, 'size' => null, 'interactive' => false, 'spotlight' => false, 'tilt' => false, 'href' => null, 'icon' => null, 'title' => null, 'description' => null, 'titleAs' => 'h3']), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>
<?php
    $tag = $href ? 'a' : 'article';
    $data = [
        'data-variant' => $variant && $variant !== 'default' ? $variant : null,
        'data-size' => $size && $size !== 'md' ? $size : null,
        'data-interactive' => $interactive ? '' : null,
        'data-spotlight' => $spotlight ? '' : null,
        'href' => $href,
    ];
?>
<<?php echo e($tag); ?> <?php echo e($attributes->class('nx-card')->merge($data)); ?> <?php if($spotlight || $tilt): ?> x-data <?php endif; ?> <?php if($spotlight): ?> x-nx-spotlight <?php endif; ?> <?php if($tilt): ?> x-nx-tilt <?php endif; ?>>
    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($icon || $title || $description): ?>
