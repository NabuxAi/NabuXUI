        <table class="nx-visually-hidden" <?php if($p['id'] !== $active): ?> hidden <?php endif; ?> x-bind:hidden="current !== <?php echo \Illuminate\Support\Js::from($p['id'])->toHtml() ?>">
            <caption><?php echo e(is_string($title) ? $title.' · ' : ''); ?><?php echo e($p['label']); ?></caption>
