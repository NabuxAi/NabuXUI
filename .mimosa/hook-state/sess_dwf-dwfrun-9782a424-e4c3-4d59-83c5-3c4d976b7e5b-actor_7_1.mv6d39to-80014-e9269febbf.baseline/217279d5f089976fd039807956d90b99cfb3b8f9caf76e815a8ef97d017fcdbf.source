    </header>
    <div class="nx-analytics-card-kpi" wire:ignore>
        <span class="nx-analytics-card-value">
            <span class="nx-number" x-ref="value"><span class="nx-visually-hidden"><?php echo e($number($period['value'])); ?></span><span class="nx-number-roll" aria-hidden="true"><?php echo e($number($period['value'])); ?></span></span>
        </span>
        <span class="nx-delta" x-ref="delta" <?php if($period['delta'] === null): ?> hidden <?php else: ?> data-trend="<?php echo e($good ? 'up' : 'down'); ?>" <?php endif; ?>>
            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($period['delta'] !== null): ?><?php echo e(NabuXUI::icon($period['delta'] >= 0 ? 'trend-up' : 'trend-down')); ?><?php echo e(($period['delta'] > 0 ? '+' : '').NabuXUI::formatNumber($period['delta'], 1, $locale)); ?>%<?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
        </span>
    </div>
    <p class="nx-analytics-card-caption" x-text="period.caption ?? ''"><?php echo e($period['caption']); ?></p>
