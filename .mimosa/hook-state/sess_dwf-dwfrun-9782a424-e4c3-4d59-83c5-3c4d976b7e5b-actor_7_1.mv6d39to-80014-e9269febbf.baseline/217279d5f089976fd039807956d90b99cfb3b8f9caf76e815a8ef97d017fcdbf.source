            x-on:pointerover="pick($event)" x-on:pointerleave="hover = null" x-on:keydown="key($event)" x-on:blur="hover = null">
            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php for($i = 0; $i < $slots; $i++): ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
                <span class="nx-analytics-card-slot" data-index="<?php echo e($i); ?>" data-state="<?php echo e($i < $count ? 'on' : 'off'); ?>" <?php if($i === $count - 1): ?> data-current <?php endif; ?>
                    style="--nx-i: <?php echo e($i); ?>; --nx-v: <?php echo e($i < $count ? max(0.02, round($period['values'][$i] / $max, 4)) : 0); ?>"
                    x-bind:data-state="<?php echo e($i); ?> < period.values.length ? 'on' : 'off'" x-bind:data-current="<?php echo e($i); ?> === period.values.length - 1 ? '' : null" x-bind:style="slotStyle(<?php echo e($i); ?>)">
                    <span class="nx-analytics-card-bar"><span class="nx-analytics-card-fill"></span></span>
                </span>
            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::endLoop(); ?><?php endif; ?><?php endfor; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::closeLoop(); ?><?php endif; ?>
        </div>
