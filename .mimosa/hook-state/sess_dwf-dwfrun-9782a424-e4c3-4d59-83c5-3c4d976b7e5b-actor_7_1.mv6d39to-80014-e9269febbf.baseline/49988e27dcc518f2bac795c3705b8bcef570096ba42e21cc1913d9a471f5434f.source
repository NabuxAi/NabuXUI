                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($v === 0): ?>
                        <a class="hlu-a hlu-center" href="#pricing"><?php echo e($label); ?></a>
                    <?php elseif($v === 1): ?>
