
<?php
    $fa = app()->getLocale() === 'fa';
    $say = fn (string $en, string $faText) => $fa ? $faText : $en;

    // The eight members of the family, in display order.
    $variants = [
        ['fa' => 'زیرخط دوسویه', 'en' => 'Centre underline'],
        ['fa' => 'براکت‌ها', 'en' => 'Brackets'],
        ['fa' => 'فلش لغزنده', 'en' => 'Sliding arrow'],
        ['fa' => 'تعویض متن', 'en' => 'Text swap'],
        ['fa' => 'هایلایت مدادی', 'en' => 'Marker highlight'],
        ['fa' => 'دایرهٔ پرشونده', 'en' => 'Bouncing circle'],
        ['fa' => 'موج حروف', 'en' => 'Letter wave'],
        ['fa' => 'آیکون جابه‌جا', 'en' => 'Shifting icon'],
    ];

    // Global SaaS nav labels, one per variant.
    $labels = [
        ['fa' => 'قیمت‌گذاری', 'en' => 'Pricing'],
        ['fa' => 'مستندات', 'en' => 'Docs'],
        ['fa' => 'تغییرات', 'en' => 'Changelog'],
        ['fa' => 'فرصت‌های شغلی', 'en' => 'Careers'],
        ['fa' => 'بلاگ', 'en' => 'Blog'],
        ['fa' => 'انجمن', 'en' => 'Community'],
        ['fa' => 'پشتیبانی', 'en' => 'Support'],
        ['fa' => 'وضعیت سرویس', 'en' => 'Status'],
    ];

    $num = fn (int $n): string => $fa
        ? strtr(sprintf('%02d', $n), ['0' => '۰', '1' => '۱', '2' => '۲', '3' => '۳', '4' => '۴', '5' => '۵', '6' => '۶', '7' => '۷', '8' => '۸', '9' => '۹'])
        : sprintf('%02d', $n);
?>

<style>
    .hlu-root {
        --hlu-fg: #1c1917; --hlu-muted: #78716c; --hlu-border: #e7e5e4;
        --hlu-bg: #ffffff; --hlu-accent: #4f46e5; --hlu-accent-ink: #ffffff;
        --hlu-marker: rgba(250, 204, 21, .6);
        --hlu-font: 'Inter', 'Vazirmatn', ui-sans-serif, sans-serif;
        display: grid; gap: 1rem; font-family: var(--hlu-font); color: var(--hlu-fg);
    }
    html[data-theme="dark"] .hlu-root {
        --hlu-fg: #fafaf9; --hlu-muted: #a8a29e; --hlu-border: #292524;
        --hlu-bg: #1c1917; --hlu-accent: #a5b4fc; --hlu-accent-ink: #1e1b4b;
        --hlu-marker: rgba(161, 98, 7, .55);
    }
    @media (prefers-color-scheme: dark) {
        html:not([data-theme="light"]) .hlu-root {
            --hlu-fg: #fafaf9; --hlu-muted: #a8a29e; --hlu-border: #292524;
            --hlu-bg: #1c1917; --hlu-accent: #a5b4fc; --hlu-accent-ink: #1e1b4b;
            --hlu-marker: rgba(161, 98, 7, .55);
        }
    }
    .hlu-grid {
        display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none;
        grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    }
    .hlu-tile {
        display: grid; gap: .9rem; align-content: start; justify-items: start;
        padding: 1rem 1.1rem 1.25rem; border: 1px solid var(--hlu-border);
        border-radius: .9rem; background: var(--hlu-bg);
    }
    .hlu-name {
        font-size: .68rem; font-weight: 600; letter-spacing: .06em;
        text-transform: uppercase; color: var(--hlu-muted);
    }
    html[dir="rtl"] .hlu-name { letter-spacing: 0; }
    .hlu-demo { display: flex; align-items: center; min-block-size: 2.6rem; }
    .hlu-a {
        position: relative; display: inline-flex; align-items: center;
        color: var(--hlu-fg); text-decoration: none; cursor: pointer;
        font-weight: 600; font-size: 1.05rem; outline: none;
        transition: color .25s ease;
    }
    .hlu-a:focus-visible { border-radius: .3rem; }
    .hlu-a:hover, .hlu-a:focus-visible { color: var(--hlu-accent); }

    /* 1 — centre-out underline, both directions at once */
    .hlu-center::before, .hlu-center::after {
        content: ''; position: absolute; inset-inline: 0; inset-block-end: -.34em;
        block-size: 2px; border-radius: 2px; background: var(--hlu-accent);
    }
    .hlu-center::before { opacity: .22; }
    .hlu-center::after { transform: scaleX(0); transform-origin: 50% 50%;
                         transition: transform .28s cubic-bezier(.22, .9, .3, 1); }
    .hlu-center:hover::after, .hlu-center:focus-visible::after { transform: scaleX(1); }

    /* 2 — brackets drawn with logical borders, sliding in */
    .hlu-brack::before, .hlu-brack::after {
        content: ''; position: absolute; inset-block: .06em; block-size: calc(100% - .12em);
        inline-size: .34em; border: 0 solid var(--hlu-accent);
        transition: translate .25s ease, opacity .25s ease, border-color .25s ease;
        opacity: 0;
    }
    .hlu-brack::before { inset-inline-start: -.62em; border-inline-start-width: 2px;
                         border-block-start-width: 2px; border-block-end-width: 2px;
                         border-start-start-radius: .18em; border-end-start-radius: .18em;
                         translate: .35em 0; }
    .hlu-brack::after { inset-inline-end: -.62em; border-inline-end-width: 2px;
                        border-block-start-width: 2px; border-block-end-width: 2px;
                        border-start-end-radius: .18em; border-end-end-radius: .18em;
                        translate: -.35em 0; }
    .hlu-brack:hover::before, .hlu-brack:focus-visible::before,
    .hlu-brack:hover::after, .hlu-brack:focus-visible::after { opacity: 1; translate: 0 0; }

    /* 3 — arrow slides in from the inline-start while the text makes room */
    .hlu-slide { padding-inline-start: 0; transition: padding-inline-start .28s cubic-bezier(.22, .9, .3, 1), color .25s ease; }
    .hlu-slide svg {
        position: absolute; inset-inline-start: -1.15em; inline-size: .95em; block-size: .95em;
        stroke: currentColor; stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round;
        opacity: 0; translate: -.45em 0; transition: translate .28s cubic-bezier(.22, .9, .3, 1), opacity .22s ease;
    }
    html[dir="rtl"] .hlu-slide svg { translate: .45em 0; }
    .hlu-slide:hover, .hlu-slide:focus-visible { padding-inline-start: 1.28em; }
    .hlu-slide:hover svg, .hlu-slide:focus-visible svg { opacity: 1; translate: .3em 0; }
    html[dir="rtl"] .hlu-slide:hover svg,
    html[dir="rtl"] .hlu-slide:focus-visible svg { translate: -.3em 0; }

    /* 4 — two-layer roll: the word leaves upward, its twin rises from below */
    .hlu-swap-t {
        position: relative; display: block; overflow: clip;
        block-size: 1.35em; line-height: 1.35em;
    }
    .hlu-swap-a { display: block; transition: translate .32s cubic-bezier(.3, .8, .3, 1); }
    .hlu-swap-t::after {
        content: attr(data-text); position: absolute; inset: 0;
        color: var(--hlu-accent); translate: 0 105%;
        transition: translate .32s cubic-bezier(.3, .8, .3, 1);
    }
    .hlu-a:hover .hlu-swap-a, .hlu-a:focus-visible .hlu-swap-a { translate: 0 -105%; }
    .hlu-a:hover .hlu-swap-t::after, .hlu-a:focus-visible .hlu-swap-t::after { translate: 0 0; }

    /* 5 — marker highlight sweeping in from the inline-start */
    .hlu-mark {
        background-image: linear-gradient(var(--hlu-marker), var(--hlu-marker));
        background-repeat: no-repeat; background-size: 0% 44%; background-position: 0 72%;
        transition: background-size .3s cubic-bezier(.25, .9, .3, 1), color .25s ease;
    }
    html[dir="rtl"] .hlu-mark { background-position: 100% 72%; }
    .hlu-mark:hover, .hlu-mark:focus-visible { background-size: 100% 44%; }

    /* 6 — a circle springing up behind the text */
    .hlu-circle { z-index: 0; isolation: isolate; padding-inline: .35em; }
    .hlu-circle::before {
        content: ''; position: absolute; z-index: -1; inset-block: .02em; inset-inline: -.12em;
        border-radius: 999px; background: var(--hlu-accent);
        scale: 0; transition: scale .38s cubic-bezier(.34, 1.56, .64, 1);
    }
    .hlu-circle:hover, .hlu-circle:focus-visible { color: var(--hlu-accent-ink); }
    .hlu-circle:hover::before, .hlu-circle:focus-visible::before { scale: 1; }

    /* 7 — the wave: letters for Latin, whole words for Persian */
    .hlu-w { display: inline-block; transition: translate .32s cubic-bezier(.3, 1.4, .5, 1), color .32s ease;
             transition-delay: calc(var(--i) * 32ms); }
    .hlu-a:hover .hlu-w, .hlu-a:focus-visible .hlu-w { translate: 0 -.3em; color: var(--hlu-accent); }
    .hlu-word { display: inline-block; white-space: nowrap; }
    .hlu-word + .hlu-word, .hlu-w-word + .hlu-w-word { margin-inline-start: .32em; }

    /* 8 — the icon walks through its clipped window and a twin follows */
    .hlu-nudge svg { inline-size: 1em; block-size: 1em; display: block;
                     stroke: currentColor; stroke-width: 2.2; fill: none;
                     stroke-linecap: round; stroke-linejoin: round; }
    .hlu-nudge-win {
        display: inline-block; overflow: clip; inline-size: 1em; block-size: 1em;
        margin-inline-start: .42em;
    }
    .hlu-nudge-strip { display: flex; transition: translate .3s cubic-bezier(.25, .9, .3, 1); }
    .hlu-a:hover .hlu-nudge-strip, .hlu-a:focus-visible .hlu-nudge-strip { translate: -1.05em 0; }
    html[dir="rtl"] .hlu-nudge-strip { translate: 1.05em 0; }
    html[dir="rtl"] .hlu-a:hover .hlu-nudge-strip,
    html[dir="rtl"] .hlu-a:focus-visible .hlu-nudge-strip { translate: 0 0; }

    .hlu-hint { margin: 0; font-size: .74rem; color: var(--hlu-muted); text-align: center; }
    @media (prefers-reduced-motion: reduce) {
        .hlu-a, .hlu-a *, .hlu-a::before, .hlu-a::after {
            transition: none !important; translate: 0 0 !important; transform: none !important;
            scale: initial !important;
        }
        .hlu-center::after { transform: scaleX(1); opacity: .5; }
        .hlu-brack::before, .hlu-brack::after { opacity: 1; translate: 0 0; }
        .hlu-slide { padding-inline-start: 1.28em; }
        .hlu-slide svg { opacity: 1; translate: .3em 0; }
        html[dir="rtl"] .hlu-slide svg { translate: -.3em 0; }
        .hlu-mark { background-size: 100% 44%; }
        .hlu-circle::before { scale: 1; opacity: .3; }
        .hlu-a .hlu-nudge-strip { translate: -1.05em 0; }
        html[dir="rtl"] .hlu-a .hlu-nudge-strip { translate: 0 0; }
    }
</style>

<section class="pg-box hlu-root" style="gap: 1rem">
    <div>
        <h3 class="pg-title" style="font-size: var(--nx-text-xl)"><?php echo e($say('Eight ways a link can answer back', 'هشت راه که یک لینک جواب شما را می‌دهد')); ?></h3>
        <p style="margin: .25rem 0 0; color: var(--nx-text-muted)">
            <?php echo e($say('One nav, eight hover languages — each tile carries its name. Everything is pure CSS and answers focus exactly like hover. The wave splits Latin letter by letter but Persian word by word, so the joined script never breaks.', 'یک منو، هشت زبان هاور — هر کاشی نامش را روی خودش دارد. همه چیز CSS خالص است و فوکوس کیبورد دقیقاً مثل هاور جواب می‌گیرد. موج، متن لاتین را حرف‌به‌حرف ولی فارسی را واژه‌به‌واژه می‌شکند تا خط پیوستهٔ فارسی هرگز نشکند.')); ?>

        </p>
