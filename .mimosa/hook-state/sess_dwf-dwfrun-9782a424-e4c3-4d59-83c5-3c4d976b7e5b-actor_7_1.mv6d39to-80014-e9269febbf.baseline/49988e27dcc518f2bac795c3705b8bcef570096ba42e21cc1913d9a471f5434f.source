                    <?php elseif($v === 3): ?>
                        <a class="hlu-a hlu-swap" href="#careers"><span class="hlu-swap-t" data-text="<?php echo e($label); ?>"><span class="hlu-swap-a"><?php echo e($label); ?></span></span></a>
                    <?php elseif($v === 4): ?>
                        <a class="hlu-a hlu-mark" href="#blog"><?php echo e($label); ?></a>
                    <?php elseif($v === 5): ?>
