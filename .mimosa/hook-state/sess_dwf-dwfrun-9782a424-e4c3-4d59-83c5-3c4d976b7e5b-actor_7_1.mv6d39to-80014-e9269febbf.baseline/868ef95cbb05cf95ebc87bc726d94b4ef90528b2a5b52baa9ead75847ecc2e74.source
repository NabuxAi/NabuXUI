    :options="['recent' => ['label' => 'تازه‌ها', 'icon' => 'sparkles'], 'popular' => ['label' => 'محبوب‌ها', 'icon' => 'heart'], 'top' => ['label' => 'بالاترین امتیاز', 'icon' => 'trend-up']]"
