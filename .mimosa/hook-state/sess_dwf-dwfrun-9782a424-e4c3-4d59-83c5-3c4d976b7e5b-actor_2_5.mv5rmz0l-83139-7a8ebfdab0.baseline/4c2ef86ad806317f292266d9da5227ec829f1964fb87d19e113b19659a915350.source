const RULES = [
  "قواعد سخت (تخلف = بازسازی):",
  "- دوزبانه با الگوی $say؛ اعداد فارسی در رشته‌های fa؛ بدون lorem ipsum؛ متن محصولی واقعی با نام‌های جهانی.",
  "- هرگز نام ایران/تهران یا هر نمونهٔ ایرانی در محتوا؛ مثال‌ها جهانی (فرانکفورت، دوبلین، سنگاپور، …).",
  "- استایل اسکوپ با پیشوند کلاس یکتا برای هر دمو؛ id های SVG (گرادیان/فیلتر/mask/clipPath) حتماً پیشونددار.",
  "- آینهٔ تیره دو بار: html[data-theme=dark] و @media (prefers-color-scheme: dark) با html:not([data-theme=light]).",
  "- prefers-reduced-motion: انیمیشن/شیدر به حالت نهایی/ثابت فرو برود.",
  "- بدون position:fixed (sticky مجاز)؛ بدون wire: (تعامل فقط Alpine داخل پارشال)؛ هرگز data-nx-reveal؛ هرگز {{ داخل <style> (@media و @keyframes مجاز).",
  "- ویژگی‌های منطقی برای RTL؛ در 375px سرریز افقی نده؛ حروف‌چینی فارسی را نشکن (split حرف‌به‌حرف فقط برای لاتین).",
  "- اگر قاعده‌ای با واقعیت ریپو ناسازگار بود، در notes صادقانه بگو — دور نزن.",
].join("\n");

function buildPrompt(g: (typeof GROUPS)[number]): string {
  const demos = g.demos.map((d) => "- " + d.slug + " — " + d.titleFa + " / " + d.titleEn + ": " + d.spec).join("\n");
  return [
    "گروه «" + g.labelFa + "» برای کاتالوگ /components با " + g.demos.length + " دموی تازه — سرور dev از قبل روی " + BASE + " بالاست؛ ری‌استارت نکن. ریشهٔ ریپو همان جایی است که فرمان‌ها را در آن اجرا می‌کنی.",
    "",
    "فایل مانیفست: " + g.manifest + " — نام فایل تعیین‌کنندهٔ id گروه «" + g.id + "» است (پیشینهٔ نام‌گذاری: Charts-plus.php) و __group برچسب گروه: fa «" + g.labelFa + "» / en «" + g.labelEn + "».",
    g.kind === "extend"
      ? "این مانیفست موجود است: اول کامل بخوانش و مدخل‌های تازه را فقط پیش از بستن آرایه — دقیقاً به همان سبک — اضافه کن؛ محتوای موجود دست نخورد."
      : "این فایل را تازه بساز.",
    "docs هر مدخل = " + g.docs + " (گالری الهام این موج).",
    "",
    "دموها (دقیقاً همین اسلاگ‌ها، همین ترتیب):",
    demos,
    "",
    "پیش از نوشتن، الگوها را بخوان:",
    "- مانیفست: playground/app/Support/Demos/Android.php (شکل مدخل) و playground/app/Support/Demos/Carbon.php (شکل نقشهٔ کد پنج‌فریم‌ورکی — این موج دقیقاً همین شکل را می‌خواهد).",
    "- پارشال: playground/resources/views/demos/components/text/text-hero.blade.php و playground/resources/views/demos/components/carbon/structured-list.blade.php و playground/resources/views/demos/components/effects/scroll-progress.blade.php (الگوی شنونده با پاک‌سازی).",
    "",
    "هر دمو = یک مدخل کامل در مانیفست + پارشال playground/resources/views/demos/components/" + g.id + "/{slug}.blade.php:",
    "- title / oneLiner دوزبانه با لحن فروشندهٔ موج‌های قبلی؛ icon فقط از فهرست مجاز؛ js درست/غلط؛ props سه تا پنج ردیف واقعی با note دوزبانه.",
    "- code باید نقشهٔ کامل پنج‌کلیدی مثل کربن باشد: livewire (جفت fa/en) + inertia + react + vue + svelte — هر قطعه همان سناریوی اصلی دمو را در آن فریم‌ورک می‌سازد (خودکفا با استایل داخل خودش).",
    "",
    "راهنمای اختصاصی این گروه: " + g.hint,
    "",
    RULES,
    "",
    "آیکن‌های مجاز کاتالوگ: " + ICONS + ".",
    "",
    "بعد از هر دمو این دو را بزن تا سبز شود و بعد بروی بعدی:",
    "- php -l " + g.manifest,
    "- curl -s -o /dev/null -w '%{http_code}' " + BASE + "/components/" + g.id + "/{slug} باید ۲۰۰ باشد (۵۰۰ یعنی Blade خراب — درستش کن؛ ۴۰۴ یعنی مدخل/پارشال جا نیفتاده).",
    "",
    "خروجی فقط JSON {files, slugs, ok, notes} — slugs دقیقاً همین اسلاگ‌ها؛ notes فارسی و کوتاه.",
  ].join("\n");
}

phase("شمارش پیش از ساخت و ساخت هشت خانوادهٔ تازه");
const before = await world.run("php", [
  "playground/artisan",
  "tinker",
  "--execute=echo count(App\\Support\\DemoCatalog::flat()).' '.count(App\\Support\\DemoCatalog::groups());",
]);
const beforeCount = (before.stdout.trim().split("\n").pop() ?? "").split(" ");
const totalDemos = GROUPS.reduce((n, g) => n + g.demos.length, 0);
log("شمارش پیش از موج: " + beforeCount.join(" ") + " — " + GROUPS.length + " سازنده به‌موازاتی " + totalDemos + " دمو می‌سازند");
const settled = await Promise.allSettled(
  GROUPS.map((g) =>
    agent("سازنده-" + g.id, {
      system:
        "تو سازندهٔ گروه‌های دموی کتابخانهٔ NabuXUI هستی (الگوی موج‌های قبلی: android، ios، کربن، هیروها). فایل‌ها را یک‌به‌یک و افزایشی بساز؛ هرگز کل مانیفست را دوباره بازنویسی نکن. اگر قاعده‌ای ناسازگار با واقعیت ریپو بود اسکیلیت کن، دور نزن.",
    }).ask<PhaseResult>(buildPrompt(g)),
  ),
);
const builders = settled.map((s, i) => {
  const g = GROUPS[i];
  if (s.status === "fulfilled") return s.value;
  report({ what: "سازندهٔ " + g.id + " ناتمام ماند", evidence: String(s.reason).slice(0, 300), severity: "high" }, "issues");
  return { files: [], slugs: g.demos.map((d) => d.slug), ok: false, notes: "اجنت شکست خورد: " + String(s.reason).slice(0, 200) } as PhaseResult;
});

phase("دروازه‌های قطعی: لینت مانیفست‌ها و شمارش دموها");
const allPages: { group: string; slug: string }[] = GROUPS.flatMap((g) => g.demos.map((d) => ({ group: g.id, slug: d.slug })));
const manifestFiles = GROUPS.map((g) => g.manifest);
let gateProblems: string[] = [];
for (const m of manifestFiles) {
  const r = await world.run("php", ["-l", m]);
  if (r.exitCode !== 0) {
    gateProblems.push(m);
    report({ what: "لینت PHP خراب: " + m, evidence: r.stdout.trim().split("\n").slice(-2).join(" "), severity: "high" }, "issues");
  }
}
for (let round = 1; round <= 2 && gateProblems.length > 0; round++) {
  const still: string[] = [];
  for (const [i, m] of gateProblems.entries()) {
    await agent("اصلاح‌گر-لینت-" + i + "-" + round, {
      system: "تو تعمیرکار PHP/Blade این ریپو هستی؛ فقط مانیفست تعیین‌شده را درست کن و سبک موج‌های موجود را حفظ کن.",
    }).ask("php -l روی " + m + " خطا می‌دهد. درستش کن تا لینت سبز شود و ساختار مدخل‌ها (شکل Android.php/Carbon.php) سالم بماند. اگر خطا از ادغان بد ساختگی است، بازسازی تمیز کن.");
    const r = await world.run("php", ["-l", m]);
    if (r.exitCode !== 0) still.push(m);
  }
  gateProblems = still;
}
const expectedDemos = Number(beforeCount[0] ?? "0") + totalDemos;
const expectedGroups = Number(beforeCount[1] ?? "0") + GROUPS.filter((g) => g.kind === "new").length;
let counted = "";
for (let round = 1; round <= 2; round++) {
  const t = await world.run("php", [
    "playground/artisan",
    "tinker",
    "--execute=echo count(App\\Support\\DemoCatalog::flat()).' '.count(App\\Support\\DemoCatalog::groups());",
  ]);
  counted = t.stdout.trim().split("\n").pop() ?? "";
  if (counted === expectedDemos + " " + expectedGroups) break;
  report({ what: "شمارش دموها ناهماهنگ: " + counted, evidence: "انتظار: " + expectedDemos + " " + expectedGroups, severity: "high" }, "issues");
  await agent("اصلاح‌گر-شمارش-" + round, {
    system: "تو تعمیرکار مانیفست‌های دمو در این ریپو هستی.",
  }).ask(
    "شمارش کاتالوگ " + counted + " شد ولی انتظار " + expectedDemos + " دمو در " + expectedGroups + " گروه است. مانیفست‌های این موج (" +
      manifestFiles.join("، ") +
      ") را با فهرست دموهای موردنظر مقایسه کن: مدخل جاافتاده، کلید تکراری یا id خراب را درست کن (نام فایل = id گروه؛ اسلاگ‌ها دقیقاً: " +
      allPages.map((p) => p.group + "/" + p.slug).join("، ") + ").",
  );
}
log("شمارش کاتالوگ: " + counted + " (انتظار " + expectedDemos + " " + expectedGroups + ")");

phase("زلزدن هر نمونهٔ ایرانی از فایل‌های تازه");
const iranTargets = [
  ...GROUPS.filter((g) => g.kind === "new").map((g) => "playground/resources/views/demos/components/" + g.id),
  "playground/resources/views/demos/components/actions",
  ...manifestFiles,
];
const iran = await world.run("grep", ["-rEni", "ایران|تهران|Iran|Tehran", ...iranTargets]);
if (iran.exitCode === 0) {
  const hitFiles = [...new Set(iran.stdout.trim().split("\n").filter(Boolean).map((l) => l.split(":")[0] ?? ""))].filter(Boolean);
  report({ what: "نمونهٔ ایرانی در فایل‌های تازه", evidence: iran.stdout.trim().split("\n").slice(0, 4).join(" | "), severity: "high" }, "issues");
  for (const [i, f] of hitFiles.entries()) {
    await agent("پاک‌ساز-ایران-" + i, {
      system: "تو ویراستار محتوای دموهای این ریپو هستی؛ سیاست: صفر ارجاع به ایران/تهران در دموها — مثال‌ها جهانی.",
    }).ask("در " + f + " الگوی ایران/تهران/Iran/Tehran پیدا شده (خودت grep کن). همه را با معادل جهانی عوض کن؛ معنا و وزن جمله حفظ شود؛ فقط همین فایل را دست بزن.");
  }
  const recheck = await world.run("grep", ["-rEni", "ایران|تهران|Iran|Tehran", ...iranTargets]);
  if (recheck.exitCode === 0) {
    report({ what: "پاک‌سازی ایرانی ناتمام", evidence: recheck.stdout.trim().split("\n").slice(0, 3).join(" | "), severity: "medium" }, "issues");
  }
} else {
  log("پویش بدون-ایران پاک بود");
}

phase("پویش HTTP هر صفحهٔ تازه و اصلاح تا ۲۰۰");
let broken: { group: string; slug: string; code: string }[] = [];
for (const p of allPages) {
  const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", BASE + "/components/" + p.group + "/" + p.slug]);
  const code = r.stdout.trim();
  if (code !== "200") {
    broken.push({ ...p, code });
    report({ what: p.group + "/" + p.slug + " کد " + code, evidence: "curl → " + code, severity: "high" }, "issues");
  }
}
log("پویش اول: " + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰");
for (let round = 1; round <= 2 && broken.length > 0; round++) {
  const still: typeof broken = [];
  for (const b of broken) {
    await agent("اصلاح‌گر-" + b.group + "-" + b.slug + "-" + round, {
      system:
        "تو تعمیرکار Blade این ریپو هستی؛ فقط دموی تعیین‌شده را درست کن. الگوها: مانیفست گروه در playground/app/Support/Demos/ و پارشال‌های هم‌گروه در playground/resources/views/demos/components/. اگر مدخل یا پارشال جا افتاده، همان را با سبک هم‌گروه بساز (شکل مدخل و نقشهٔ کد پنج‌فریم‌ورکی را از Carbon.php بگیر).",
    }).ask(
      "صفحهٔ " + BASE + "/components/" + b.group + "/" + b.slug + " کد " + b.code + " می‌دهد. مدخل مانیفست و پارشال playground/resources/views/demos/components/" +
        b.group + "/" + b.slug + ".blade.php را وارسی و اصلاح کن تا ۲۰۰ بدهد؛ قواعد موج (دوزبانه، بدون fixed، بدون data-nx-reveal، بدون {{ داخل style، آینهٔ تیرهٔ دوبار) را نگه دار. اگر نشد صادقانه بگو.",
    );
    const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", BASE + "/components/" + b.group + "/" + b.slug]);
    if (r.stdout.trim() !== "200") still.push(b);
  }
  broken = still;
}
log("پس از اصلاح: " + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰");

phase("بازبینی مرورگری: عکاسی روشن، تیره، موبایل و انگلیسی");
const browser = await agent("بازبین-مرورگر", {
  system:
    "تو راستی‌آزمای مرورگری با playwright هستی. در /tmp/nx-shooter همه‌چیز آماده است: با node /tmp/nx-shooter/shoot.mjs <url> <outBase> از هر نشانی سه عکس light/dark/mobile (fullPage با اسکرول پیش از عکس) می‌گیری. ادعا بدون تصویر ممنوع؛ چیزی را که ندیدی گزارش نکن.",
}).ask<BrowserReview>(
  [
    "پوشهٔ /tmp/nx-vibe را بساز (mkdir -p).",
    "",
    "۱) از هر گروه تازه دو دموی اول و از actions هر سه دموی گرادیانی تازه عکاسی کامل:",
    ...GROUPS.map((g) =>
      (g.kind === "new" ? g.demos.slice(0, 2) : g.demos)
        .map((d) => "   node /tmp/nx-shooter/shoot.mjs " + BASE + "/components/" + g.id + "/" + d.slug + " /tmp/nx-vibe/" + g.id + "-" + d.slug),
    ).flat(),
    "۲) انگلیسی: دموی اول هر گروه تازه + یک دکمهٔ گرادیانی را با ?lang=en باز کن و یک عکس روشن بگیر (فایل *-en.png؛ مستقیم با playwright) — متن باید کامل انگلیسی و LTR باشد؛ فقط بخش‌های عمدیِ نمایش RTL مجازند فارسی باشند.",
    "۳) تعامل‌ها: در shaders مطمئن شو بوم رندر می‌شود (نه سیاهِ خالی؛ شات دوم بعد از دو ثانیه اگر لازم شد)، در flows چند قدم جلو برو و شات بگیر، در maps یک پاپ‌اور باز کن و عکس بگیر.",
    "۴) خطاهای کنسول: با یک اسکریپت کوچک pageerror و console.error همهٔ نشانی‌ها را جمع کن و فقط خطاهای واقعی را گزارش کن (به‌ویژه خطای WebGL در shaders).",
    "۵) خودت هم عکس‌ها را ببین: چیدمان شکسته، سرریز افقی موبایل، تم تیرهٔ خراب، متن رونده. هر ایراد با مسیر عکس شاهد.",
    "",
    "نام‌گذاری: /tmp/nx-vibe/{group}-{slug}-light.png و -dark.png و -mobile.png؛ عکس‌های EN هم *-en.png.",
    "خروجی فقط JSON {ok, findings:[{what, evidence, severity}], shots:[همهٔ مسیرها]} — findings فارسی.",
  ].join("\n"),
);

phase("اصلاح ایرادهای بصری و بازتأیید HTTP");
const actionable = (browser.findings ?? []).filter((f) => f.severity !== "low").slice(0, 8);
if (actionable.length > 0) {
  for (const [i, f] of actionable.entries()) {
    const target = f.evidence.match(/\/tmp\/nx-vibe\/([a-z0-9-]+)-[a-z]+\.png/);
    const guess = target?.[1] ?? "";
    const page = allPages.find((p) => guess.startsWith(p.group + "-" + p.slug));
    await agent("اصلاح‌گر-بصری-" + i, {
      system: "تو تعمیرکار بصری دموهای این ریپو هستی؛ فقط دموی اشاره‌شده را اصلاح کن و قواعد موج (دوزبانه، آینهٔ تیرهٔ دوبار، بدون fixed، بدون data-nx-reveal) را نگه دار.",
    }).ask(
      "ایراد بصری در دمو" + (page ? " " + page.group + "/" + page.slug : "") + ": " + f.what + " — شاهد: " + f.evidence +
        ". فایل پارشال مربوطه را در playground/resources/views/demos/components/ پیدا و درست کن؛ برای اطمینان دوباره با node /tmp/nx-shooter/shoot.mjs عکس بگیر و ببین. نتیجه را کوتاه بگو.",
    );
    if (page) {
      const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", BASE + "/components/" + page.group + "/" + page.slug]);
      if (r.stdout.trim() !== "200") {
        report({ what: "بعد از اصلاح بصری " + page.group + "/" + page.slug + " صفحه ۲۰۰ نیست", evidence: "curl → " + r.stdout.trim(), severity: "high" }, "issues");
      }
    }
  }
} else {
  log("ایراد بصری با شدت بالا/متوسط پیدا نشد — اصلاح لازم نبود");
}

phase("داوری بصری مستقل");
const judgeShots = (browser.shots ?? [])
  .filter((s) => s.startsWith("/tmp/nx-vibe/") && !s.includes("-mobile") && !s.endsWith("-en.png"))
  .slice(0, 20);
let verdicts: JudgeVerdict[] = [];
if (judgeShots.length > 0) {
  const judge = await agent("داور-بصری", {
    system: "تو داور پذیرش بصری هستی و فقط از تصویر قضاوت می‌کنی؛ ادعای ندیده ممنوع. چیدمان شکسته/ناخوانا/تم تیرهٔ خراب/سرریز = مردود؛ سلیقهٔ جزئی = قبول.",
  }).ask<{ verdicts: JudgeVerdict[] }>(
    "این عکس‌ها را با Read یکی‌یکی ببین و دربارهٔ هرکدام حکم بده:\n" + judgeShots.join("\n") +
      "\nخروجی فقط JSON: {verdicts:[{shot, pass, issues}]} — issues فارسی.",
  );
  verdicts = judge.verdicts ?? [];
  for (const v of verdicts.filter((v) => !v.pass)) {
    report({ what: "داوری بصری مردود: " + v.shot, evidence: v.issues, severity: "medium" }, "issues");
  }
} else {
  report({ what: "عکسی برای داوری نماند", evidence: "بازبین مرورگر شاتی برنگرداند", severity: "high" }, "issues");
}

const failedBuilders = builders.filter((b) => !b.ok);
const problems = [
  ...broken.map((b) => b.group + "/" + b.slug + " کد " + b.code),
  ...failedBuilders.map((b) => "سازندهٔ ناقص: " + b.notes),
  ...(browser.findings ?? []).filter((f) => f.severity !== "low").map((f) => f.what),
  ...verdicts.filter((v) => !v.pass).map((v) => "داوری: " + v.shot),
];

await artifact.markdown(
  "report",
  [
    "# موج افکت‌ها و بخش‌های لندینگ — منابع وایب‌کدینگ",
    "",
    "**" + allPages.length + " دموی تازه در ۷ گروه تازه + گسترش actions**: جادوی متن (text-effects)، بارگذارها (circleloaders)، حرکت‌های تعاملی (kinetics/motion-primitives/aceternity/magicui/uiverse/animejs)، نقشه (mapcn)، شیدرها (shadertoy)، جریان‌های واقعی (mobbin)، بخش‌های لندینگ (shadcnblocks/vibeprompts/godly/awwwards/minimal) و سه دکمهٔ گرادیانی (gradientbuttons).",
    "",
    "پویش HTTP: " + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰ — شمارش کاتالوگ " + counted + " (دمو/گروه؛ پیش از موج: " + beforeCount.join(" ") + ").",
    "",
    "## سازندگان",
    ...GROUPS.map((g, i) => {
      const b = builders[i];
      const names = g.demos.map((d) => d.titleFa).join("، ");
      return "- " + (b.ok ? "✅" : "❌") + " **" + g.labelFa + "** (" + g.demos.length + " دمو): " + names + (b.ok ? "" : " — " + b.notes);
    }),
    "",
    "## بازبینی مرورگری",
    ...((browser.findings ?? []).length === 0 ? ["- مشکلی پیدا نشد."] : (browser.findings ?? []).map((f) => "- " + (f.severity === "high" ? "🔴" : f.severity === "medium" ? "🟠" : "🟡") + " " + f.what + " — " + f.evidence)),
    "",
    "## داوری بصری مستقل (" + verdicts.length + " عکس)",
    ...verdicts.map((v) => "- " + (v.pass ? "✅" : "❌") + " " + v.shot + (v.issues ? " — " + v.issues : "")),
  ].join("\n"),
  { title: "گزارش موج افکت‌ها و بخش‌های لندینگ", description: allPages.length + " دموی تازه از فهرست ۲۵ منبع وایب‌کدینگ — از ساخت تا داوری بصری", primary: true },
);

const report_: WorkflowReport = {
  conclusion:
    problems.length === 0
      ? "موج افکت‌ها و بخش‌های لندینگ کامل شد: " + allPages.length + " دموی تازه در ۷ گروه (متن، بارگذار، حرکت، نقشه، شیدر، جریان، بخش لندینگ) + ۳ دکمهٔ گرادیانی، همه با تکه‌کد پنج‌فریم‌ورکی؛ لینت، شمارش، پویش HTTP، سیاست بدون-ایران، بازبینی مرورگر و داوری بصری همه سبز."
      : "موج انجام شد (" + (allPages.length - broken.length) + "/" + allPages.length + " صفحه ۲۰۰) اما " + problems.length + " مورد باز دارد: " + problems.slice(0, 5).join("؛ ") + ".",
  findings: [
    ...broken.map((b) => ({ what: b.group + "/" + b.slug + " کد " + b.code, evidence: "curl", severity: "high" as const })),
    ...failedBuilders.map((b) => ({ what: "سازندهٔ ناقص", evidence: b.notes, severity: "high" as const })),
    ...(browser.findings ?? []),
    ...verdicts.filter((v) => !v.pass).map((v) => ({ what: "داوری تصویر " + v.shot, evidence: v.issues, severity: "medium" as const })),
  ],
  verified: [
    "php -l روی هر ۸ مانیفست (هفت تازه + Actions.php) + حلقهٔ اصلاح تا ۲ دور",
    "شمارش قطعی کاتالوگ با tinker قبل و بعد ساخت (انتظار " + expectedDemos + "/" + expectedGroups + " — دیدیم: " + counted + ")",
    "curl تک‌تک " + allPages.length + " صفحهٔ تازه (world.run) + حلقهٔ اصلاح تا ۲ دور",
    "گrep بدون-ایران روی پارشال‌های تازه و مانیفست‌ها",
    "عکاسی مرورگری روشن/تیره/موبایل نمونه‌های هر گروه + صفحات EN با ?lang=en + رندر WebGL در shaders + پیشروی در flows و maps + خطاهای کنسول",
    "داوری بصری مستقل داور تازه روی " + verdicts.length + " عکس",
  ],
  notCovered: [
    "عکاسی نمونه‌ای بود نه هر ۳۴ صفحه؛ EN هم نمونه‌ای سنجیده شد",
    "shadcn/ui و پایهٔ clean UI با گروه base موجود پوشش داده شده؛ designmd/21st.dev ابزار عامل‌اند نه دموی UI — دمو نساختیم",
    "پورت دموها به پکیج‌های React/Vue هنوز منتقل نشده — فعلاً دموی پلی‌گراوندند (تکه‌کد پنج‌فریم‌ورکی در هر دمو هست)",
  ],
};
return report_;
