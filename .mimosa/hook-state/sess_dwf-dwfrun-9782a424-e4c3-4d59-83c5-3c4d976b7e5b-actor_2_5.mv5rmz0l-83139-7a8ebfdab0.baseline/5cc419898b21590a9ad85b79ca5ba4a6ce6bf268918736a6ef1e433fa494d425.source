interface PageVerdict {
  /** مسیر صفحه به شکل "group/slug" */
  page: string;
  /** true یعنی صفحه از نظر بصری قابل قبول است */
  pass: boolean;
  /** توضیح مشکلات به فارسی؛ وقتی pass خالی باشد */
  issues: string;
}
interface Shot {
  /** "group/slug" */
  page: string;
  light: string;
  dark: string;
  mobile: string;
}
interface JudgeOut {
  /** یک حکم به‌ازای هر صفحهٔ داده‌شده */
  verdicts: PageVerdict[];
}
interface Finding {
  /** مسیر فایل پارشال یا صفحه */
  where: string;
  /** یک جمله: چه چیزی مشکل دارد */
  what: string;
  /** شاهد: حکم داور روی اسکرین‌شات، یا کد HTTP */
  evidence: string;
  status: "verified" | "unconfirmed";
  severity: "low" | "medium" | "high";
}
interface WorkflowReport {
  conclusion: string;
  findings: Finding[];
  verified: string[];
  notCovered: string[];
}

const BASE = "http://127.0.0.1:8765/components";
const PLATFORMS: { id: string; slugs: string[] }[] = [
  { id: "android", slugs: ["buttons", "fab", "chips", "selection", "slider", "cards", "bottom-sheet", "navigation-bar", "app-bar", "snackbar", "dialog", "search", "progress", "dynamic-color", "home-screen"] },
  { id: "ios", slugs: ["controls", "tab-bar", "nav-bar", "search-field", "sheet", "alert", "context-menu", "picker", "widgets", "progress", "liquid-glass", "home-screen"] },
  { id: "windows", slugs: ["window-chrome", "acrylic-mica", "buttons", "selection", "command-bar", "navigation-view", "tab-view", "dialogs", "progress", "expander", "desktop"] },
  { id: "macos", slugs: ["window", "menu-bar", "dock", "controls", "sidebar", "sheet-alert", "popover", "widgets", "spotlight", "notifications", "desktop"] },
];
const ALL: { group: string; slug: string }[] = PLATFORMS.flatMap((p) => p.slugs.map((s) => ({ group: p.id, slug: s })));

artifact.board("pages", {
  title: "وضعیت دموی هر صفحه",
  description: "هر کارت یک دموی پلتفرمی است و همراه با راستی‌آزمایی جابه‌جا می‌شود.",
  key: "key",
  status: "status",
  columns: ["سالم", "خراب", "در حال اصلاح", "ردِ بازبینی", "قبول"],
  cardTitle: "key",
  detail: [{ field: "note", label: "یادداشت" }],
});

const RENDERER_PERSONA =
  "تو عکاس وب هستی؛ با npx -y playwright screenshot صفحه عکاسی می‌کنی و مسیر فایل‌های ساخته‌شده را دقیق برمی‌گردانی. " +
  "هیچ فایلی از ریپو را ویرایش نمی‌کنی.";
const JUDGE_PERSONA =
  "تو داور پذیرش بصری هستی و فقط از روی تصویر قضاوت می‌کنی؛ هیچ فایلی را ویرایش نمی‌کنی و سراغ مرورگر نمی‌روی. " +
  "اگر تصویری باز نشد، همان صفحه را مردود کن و بنویس «تصویر در دسترس نبود». معیار تو پذیرش کاربر است، نه سلیقه: " +
  "چیدمان شکسته، سرریز افقی، متن ناخوانا یا بی‌کنتراست (به‌خصوص وارونگی خراب در تم تیره)، همپوشانی عناصر، بریدگی، " +
  "ناحیهٔ خالی یا نیمه‌کاره، و استایل پلتفرمیِ بی‌ربط را مردود کن؛ تفاوت‌های جزئی سلیقه‌ای را نادیده بگیر.";
const FIXER_PERSONA =
  "تو تعمیرکار دموهای پلتفرمی این ریپو هستی. قواعد خانه: پارشال دمو در playground/resources/views/demos/components/{group}/{slug}.blade.php " +
  "زندگی می‌کند؛ مدخل.spec آن در playground/app/Support/Demos است؛ استایل‌ها اسکوپ‌شده با پیشوند یکتا، متن‌ها دوزبانه با helper $say، " +
  "ویژگی‌های منطقی برای RTL، بازتاب تم تیره دو بار (html[data-theme=dark] و prefers-color-scheme با html:not([data-theme=light]))، " +
  "بدون position: fixed، بدون wire:، و هرگز «{{» داخل بلوک style. فقط فایل تعیین‌شده را تغییر بده و بعد از هر تغییر با curl کد ۲۰۰ را چک کن. " +
  "اگر مشکلی اصلاح‌نشدنی بود، صادقانه در خروجی بگو، به‌جای وانمود کردن به موفقیت.";

phase("بررسی پاسخ سرور برای هر ۴۹ دمو");
log(`پویش ${ALL.length} صفحهٔ دمو روی ${BASE}`);
let httpIssues: { group: string; slug: string; code: string }[] = [];
for (const it of ALL) {
  const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", `${BASE}/${it.group}/${it.slug}`]);
  const code = r.stdout.trim();
  if (code === "200") {
    report({ key: `${it.group}/${it.slug}`, status: "سالم", note: "HTTP 200" }, "pages");
  } else {
    log(`${it.group}/${it.slug} کد ${code} داد`);
    httpIssues.push({ group: it.group, slug: it.slug, code });
    report({ key: `${it.group}/${it.slug}`, status: "خراب", note: `HTTP ${code}` }, "pages");
  }
}

phase("اصلاح خطاهای سرور");
for (let round = 1; round <= 3 && httpIssues.length > 0; round++) {
  const still: { group: string; slug: string; code: string }[] = [];
  for (const b of httpIssues) {
    const file = `playground/resources/views/demos/components/${b.group}/${b.slug}.blade.php`;
    await agent(`اصلاح‌گر-HTTP-${b.group}-${b.slug}`, { system: FIXER_PERSONA }).ask(
      `صفحهٔ ${BASE}/${b.group}/${b.slug} به‌جای ۲۰۰ کد ${b.code} می‌دهد و فایل پارشالش ${file} است. ` +
        `خطای Blade یا منطقی را پیدا و رفع کن تا صفحه ۲۰۰ بدهد. اگر موفق نشدی، دلیلش را صادقانه در خروجی بنویس.`,
    );
    const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", `${BASE}/${b.group}/${b.slug}`]);
    const code = r.stdout.trim();
    if (code === "200") {
      report({ key: `${b.group}/${b.slug}`, status: "سالم", note: `پس از اصلاح دور ${round}` }, "pages");
    } else {
      still.push({ group: b.group, slug: b.slug, code });
    }
  }
  httpIssues = still;
}

phase("رندر و بازبینی بصری چهار پلتفرم");
const outcomes = await Promise.all(
  PLATFORMS.map(async (p) => {
    const photographer = agent(`عکاس-${p.id}`, { system: RENDERER_PERSONA });
    const deskJudge = agent(`داور-دسکتاپ-${p.id}`, { system: JUDGE_PERSONA });
    const mobJudge = agent(`داور-موبایل-${p.id}`, { system: JUDGE_PERSONA });

    log(`عکاسی از ${p.slugs.length} صفحهٔ گروه ${p.id} (روشن + تیره + موبایل)`);
    const shots = await photographer.ask<Shot[]>(
      `برای هر ${p.slugs.length} صفحهٔ گروه «${p.id}» سه عکس بگیر و هر سه فایل را واقعاً بساز: ` +
        `اول «mkdir -p /tmp/nx-shots/${p.id}» و بعد برای هر slug این سه فرمان (URL = ${BASE}/${p.id}/SLUG):\n` +
        `1) روشن دسکتاپ: npx -y playwright screenshot --full-page --viewport-size=1280,900 --wait-for-timeout=4500 --color-scheme=light URL /tmp/nx-shots/${p.id}/SLUG-light.png\n` +
        `2) تیره دسکتاپ: همان با --color-scheme=dark و پسوند -dark.png\n` +
        `3) موبایل: --viewport-size=375,812 --color-scheme=light و پسوند -mobile.png\n` +
        `بعد از هر عکس، با ls -la از نبود فایل یا حجم زیر ۱۰ کیلوبایت مطمئن شو؛ اگر خراب بود یک‌بار دیگر بگیر. ` +
        `خروجی: آرایه‌ای از {page: "${p.id}/SLUG", light, dark, mobile} با مسیرهای مطلق فایل‌ها.`,
    );

    const deskList = shots.map((s) => `دسکتاپ روشن: ${s.light}\nدسکتاپ تیره: ${s.dark}  ← صفحه ${s.page}`).join("\n");
    const mobList = shots.map((s) => `موبایل ۳۷۵: ${s.mobile}  ← صفحه ${s.page}`).join("\n");

    log(`داوری بصری ${shots.length} صفحهٔ گروه ${p.id}`);
    const [desk, mob] = await Promise.all([
      deskJudge.ask<JudgeOut>(
        `برای گروه «${p.id}» این تصاویر را با ابزار Read ببین و دربارهٔ هر صفحه یک حکم بده (تم روشن و تیره با هم یک حکم‌اند):\n${deskList}\n` +
          `در تم تیره مخصوصاً وارونگی رنگ‌ها را بسنج: متنی که در تیره ناخوانا شد یا پس‌زمینهٔ سوخته، مردود است. ` +
          `خروجی فقط JSON آرایه‌ای از {page, pass, issues} به فارسی؛ issues برای صفحهٔ قبول خالی.`,
      ),
      mobJudge.ask<JudgeOut>(
        `برای گروه «${p.id}» این تصاویر موبایل ۳۷۵ پیکسلی را با ابزار Read ببین و دربارهٔ هر صفحه یک حکم بده:\n${mobList}\n` +
          `معیار اصلی: سرریز افقی، بریدگی محتوا، همپوشانی، و چیدمان شکسته در عرض باریک. ` +
          `خروجی فقط JSON آرایه‌ای از {page, pass, issues} به فارسی؛ issues برای صفحهٔ قبول خالی.`,
      ),
    ]);

    const merged = new Map<string, PageVerdict>();
    for (const v of desk.verdicts) merged.set(v.page, { ...v });
    for (const v of mob.verdicts) {
      const d = merged.get(v.page);
      if (!d) {
        merged.set(v.page, { ...v });
        continue;
      }
      const issues = [d.pass ? "" : d.issues, v.pass ? "" : `موبایل: ${v.issues}`].filter(Boolean).join(" | ");
      merged.set(v.page, { page: v.page, pass: d.pass && v.pass, issues });
    }

    for (let round = 1; round <= 2; round++) {
      const failed = [...merged.values()].filter((v) => !v.pass);
      if (failed.length === 0) break;
      log(`دور ${round} اصلاح بصری گروه ${p.id}: ${failed.length} صفحه`);
      for (const f of failed) {
        report({ key: f.page, status: "در حال اصلاح", note: f.issues.slice(0, 140) }, "pages");
      }
      await Promise.all(
        failed.map((f) => {
          const file = `playground/resources/views/demos/components/${f.page}.blade.php`;
          return agent(`اصلاح‌گر-${f.page.replace("/", "-")}-دور${round}`, { system: FIXER_PERSONA }).ask(
            `داور بصری این مشکلات را در ${file} دیده است:\n${f.issues}\n` +
              `رفعشان کن (فقط همین فایل) تا داور دوباره تصویر را ببیند و قبول شود. محتوای پلتفرمی و متن‌ها را حفظ کن؛ فقط ایراد را درست کن. ` +
              `بعد از اصلاح با curl چک کن صفحه ۲۰۰ بدهد. اگر ایرادی واقعاً قابل رفع نبود، صادقانه بگو کدام است.`,
          );
        }),
      );
      const redoPages = failed.map((f) => f.page);
      const reshots = await photographer.ask<Shot[]>(
        `فقط این صفحه‌ها را دوباره عکاسی کن — این‌بار با روش «اسکرول تا انتهای صفحه، سپس عکس تمام‌صفحه». دلیل: مکانیزم reveal-on-scroll سایت بخش‌های دارای data-nx-reveal زیرِ فولد را با opacity:0 نگه می‌دارد و در npx playwright screenshot بدون اسکرول، بدنهٔ جدول‌ها و بخش‌های پایین صفحه خالی دیده می‌شود. این آرتیفکت عکاسی بود، نه ایراد صفحه:\n${redoPages.join("\n")}\n` +
          `راه‌اندازی (یک‌بار): ` +
          `cd /tmp && mkdir -p nx-shooter && cd nx-shooter && (test -d node_modules/playwright || npm i playwright --no-save) ` +
          `و فایل shoot.mjs با این محتوا بساز:\n` +
          `---\n` +
          `import { chromium } from 'playwright';\n` +
          `const [url, outBase] = process.argv.slice(2);\n` +
          `const browser = await chromium.launch();\n` +
          `async function shot(colorScheme, viewport, out) {\n` +
          `  const ctx = await browser.newContext({ colorScheme, viewport });\n` +
          `  const page = await ctx.newPage();\n` +
          `  await page.goto(url, { waitUntil: 'networkidle' });\n` +
          `  await page.evaluate(async () => {\n` +
          `    const step = 400;\n` +
          `    for (let y = 0; y < document.body.scrollHeight; y += step) {\n` +
          `      window.scrollTo(0, y);\n` +
          `      await new Promise((r) => setTimeout(r, 90));\n` +
          `    }\n` +
          `    window.scrollTo(0, document.body.scrollHeight);\n` +
          `    await new Promise((r) => setTimeout(r, 250));\n` +
          `    window.scrollTo(0, 0);\n` +
          `  });\n` +
          `  await page.waitForTimeout(600);\n` +
          `  await page.screenshot({ path: out, fullPage: true });\n` +
          `  await ctx.close();\n` +
          `}\n` +
          `await shot('light', { width: 1280, height: 900 }, outBase + '-light.png');\n` +
          `await shot('dark', { width: 1280, height: 900 }, outBase + '-dark.png');\n` +
          `await shot('light', { width: 375, height: 812 }, outBase + '-mobile.png');\n` +
          `await browser.close();\n` +
          `console.log('done ' + outBase);\n` +
          `---\n` +
          `برای هر صفحه: node shoot.mjs URL /tmp/nx-shots/${p.id}/SLUG — سه فایل -light.png و -dark.png و -mobile.png می‌سازد. ` +
          `حجم هر فایل را با ls -la چک کن (زیر ۱۰ کیلوبایت یعنی خراب؛ یک‌بار دیگر بگیر). ` +
          `خروجی مثل قبل: آرایه‌ای از {page, light, dark, mobile} با مسیرهای مطلق.`,
      );
      const redoDesk = reshots.map((s) => `دسکتاپ روشن: ${s.light}\nدسکتاپ تیره: ${s.dark}  ← صفحه ${s.page}`).join("\n");
      const redoMob = reshots.map((s) => `موبایل ۳۷۵: ${s.mobile}  ← صفحه ${s.page}`).join("\n");
      const [desk2, mob2] = await Promise.all([
        deskJudge.ask<JudgeOut>(
          `فقط این صفحه‌ها را پس از اصلاح دوباره ببین و حکم تازه بده:\n${redoDesk}\nخروجی فقط JSON آرایه‌ای از {page, pass, issues}.`,
        ),
        mobJudge.ask<JudgeOut>(
          `فقط این صفحه‌ها را پس از اصلاح در نمای موبایل دوباره ببین و حکم تازه بده:\n${redoMob}\nخروجی فقط JSON آرایه‌ای از {page, pass, issues}.`,
        ),
      ]);
      for (const v of desk2.verdicts) {
        const m = merged.get(v.page);
        const mob2v = mob2.verdicts.find((x) => x.page === v.page);
        const pass = v.pass && (mob2v ? mob2v.pass : true);
        const issues = [v.pass ? "" : v.issues, mob2v && !mob2v.pass ? `موبایل: ${mob2v.issues}` : ""]
          .filter(Boolean)
          .join(" | ");
        merged.set(v.page, { page: v.page, pass, issues });
      }
    }

    const finalVerdicts = [...merged.values()];
    for (const v of finalVerdicts) {
      report({ key: v.page, status: v.pass ? "قبول" : "ردِ بازبینی", note: v.issues.slice(0, 140) }, "pages");
    }
    return { platform: p.id, verdicts: finalVerdicts };
  }),
);

phase("پویش پایانی و تهیهٔ گزارش");
const findings: Finding[] = [];
for (const it of ALL) {
  const r = await world.run("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", `${BASE}/${it.group}/${it.slug}`]);
  const code = r.stdout.trim();
  if (code !== "200") {
    findings.push({
      where: `playground/resources/views/demos/components/${it.group}/${it.slug}.blade.php`,
      what: `صفحه پس از همهٔ اصلاح‌ها کد ${code} می‌دهد`,
      evidence: `curl ${BASE}/${it.group}/${it.slug} → ${code}`,
      status: "verified",
      severity: "high",
    });
  }
}
let passed = 0;
const visualSections: string[] = [];
for (const o of outcomes) {
  const ok = o.verdicts.filter((v) => v.pass);
  const bad = o.verdicts.filter((v) => !v.pass);
  passed += ok.length;
  for (const f of bad) {
    findings.push({
      where: `playground/resources/views/demos/components/${f.page}.blade.php`,
      what: "داور بصری این صفحه را مردود کرد",
      evidence: f.issues,
      status: "verified",
      severity: "medium",
    });
  }
  const rows = o.verdicts
    .map((v) => `| ${v.page} | ${v.pass ? "✅ قبول" : "❌ مردود"} | ${v.issues || "—"} |`)
    .join("\n");
  visualSections.push(`### گروه ${o.platform}\n\n| صفحه | حکم | ایرادها |\n|---|---|---|\n${rows}\n`);
}

await artifact.markdown(
  "report",
  [
    `# راستی‌آزمایی ۴۹ دموی پلتفرمی (اندروید، iOS، ویندوز، مک)`,
    ``,
    `**نتیجهٔ بصری: ${passed} از ۴۹ صفحه قبول شد.** همهٔ صفحات HTTP ۲۰۰ می‌دهند مگر خلاف این جدول.`,
    ``,
    ...visualSections,
    `---`,
    `## چه چیزهایی بررسی شد`,
    `- کد HTTP هر ۴۹ صفحه، دو بار (ابتدای کار و در پویش پایانی) با curl.`,
    `- اسکرین‌شات تمام‌صفحه از هر دمو در سه نما: دسکتاپ روشن، دسکتاپ تیره، موبایل ۳۷۵px روشن — و داوری بصری مستقل روی تک‌تک آن‌ها.`,
    `- حلقهٔ اصلاح: صفحات مردود به تعمیرگر رفتند و حداکثر دو دور دوباره عکاسی و دوباره داوری شدند.`,
  ].join("\n"),
  { title: "گزارش راستی‌آزمایی دموهای پلتفرمی", description: "حکم داوری بصری و وضعیت HTTP برای هر ۴۹ دمو", primary: true },
);

const visuallyFailed = findings.filter((f) => f.severity === "medium").length;
const conclusion =
  httpIssues.length === 0 && visuallyFailed === 0
    ? `هر ۴۹ دموی پلتفرمی هم HTTP ۲۰۰ می‌دهند هم از داوری بصری (روشن/تیره/موبایل) عبور کردند.`
    : `از ۴۹ دمو، ${passed} صفحه داوری بصری را عبور دادند و ${visuallyFailed} صفحه مردود ماند${httpIssues.length > 0 ? ` و ${httpIssues.length} صفحه هنوز خطای HTTP دارد` : ""}. جزئیات هر صفحه در گزارش و جدول وضعیت آمده است.`;

return {
  conclusion,
  findings,
  verified: [
    "curl تک‌تک ۴۹ صفحه در ابتدا و در پویش پایانی (world.run)",
    `اسکرین‌شات تمام‌صفحه + داوری بصری مستقل برای هر صفحه در سه نما (روشن، تیره، موبایل ۳۷۵) — مجموعاً ${ALL.length * 3}+ تصویر`,
    "اصلاح و داوری مجدد صفحات مردود تا دو دور",
  ],
  notCovered: [
    "نمای انگلیسی صفحات فقط با HTTP سنجیده شد؛ داوری بصری فقط روی زبان فارسی (پیش‌فرض) انجام شد",
    "نمای موبایل در تم تیره عکاسی نشد",
    "تعامل‌های لمسی (کشیدن پنجره، سوایپ صفحه‌ها، ژست‌ها) از روی کد و تصویر ساکن سنجیده شد، نه لمس واقعی",
  ],
};