{
  "name": "nabuxui-workspace",
  "private": true,
  "description": "NabuXUI — the Nabux design system: one motion language for Livewire, Inertia and React",
  "packageManager": "pnpm@8.7.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "test": "pnpm -r --filter ./packages/** run test",
    "typecheck": "pnpm -r --filter ./packages/** run typecheck",
    "showcase": "pnpm --filter showcase dev",
    "showcase:build": "pnpm --filter showcase build"
  }
}
