{
  "name": "@nabuxai/ui-svelte",
  "version": "0.3.0",
  "description": "NabuXUI for Svelte: animated, accessible components on the shared NabuXUI core",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/nabuxui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.emit.json && node scripts/ship.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@nabuxai/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "happy-dom": "^21.0.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
