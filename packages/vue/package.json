{
  "name": "@nabuxai/ui-vue",
  "version": "0.3.0",
  "description": "NabuXUI for Vue: animated, accessible components on the shared NabuXUI core",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/nabuxui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json && node scripts/ship.mjs",
    "typecheck": "vue-tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@nabuxai/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^21.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.13"
  }
}
